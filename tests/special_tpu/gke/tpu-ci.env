# Settings of the TPU CI (tests/special_tpu/run_tpu_e2e_ci.sh). Every value can be overridden by an environment
# variable of the same name (e.g. a repository variable mapped into the workflow, or by hand).

# Label of the self-hosted TPU CI runners (gke/github-runner.yaml). The `setup` job of every TPU workflow takes the
# repository variable TPU_CI_RUNNER, else this value; empty skips the TPU jobs. GitHub does not pass repository
# variables to pull requests from forks, so the value for those lives here.
TPU_CI_RUNNER="${TPU_CI_RUNNER:-}"

# GKE cluster with the TPU node pools, Kueue and the self-hosted runners (see tests/special_tpu/README.md). Runner pods
# use their in-cluster service account; the cluster name, region and project are only used by runs from a workstation.
TPU_CI_GKE_CLUSTER="${TPU_CI_GKE_CLUSTER:-jialeic-ci-v6e8-2s-spot}"
TPU_CI_GKE_REGION="${TPU_CI_GKE_REGION:-us-central2}"
TPU_CI_GKE_PROJECT="${TPU_CI_GKE_PROJECT:-tpu-pytorch}"
# Namespace of the CI RayClusters and of the Kueue LocalQueues ${TPU_CI_KUEUE_QUEUE_PREFIX}-{1chip,2chip,4chip,8chip}.
TPU_CI_NAMESPACE="${TPU_CI_NAMESPACE:-default}"
TPU_CI_KUEUE_QUEUE_PREFIX="${TPU_CI_KUEUE_QUEUE_PREFIX:-verl-tpu-ci}"
# Kubernetes service account of the Ray pods (Workload Identity: reads TPU_CI_BUCKET).
TPU_CI_RAY_SERVICE_ACCOUNT="${TPU_CI_RAY_SERVICE_ACCOUNT:-ray-ksa}"

# GCS bucket mounted at /data in the Ray pods, and the directory in it with the models (<dir>/assets/hf/Qwen3-*) and
# the data (<dir>/data/gsm8k, <dir>/data/gsm8k_sft), laid out as in step 3 of examples/tpu/grpo/README.md. The example
# scripts get it as RAY_DATA_HOME.
TPU_CI_BUCKET="${TPU_CI_BUCKET:-torchprime}"
TPU_CI_DATA_HOME="${TPU_CI_DATA_HOME:-/data/jialei}"

# Image of the Ray pods: TPU_CI_IMAGE_REPO:df-<first 16 hex digits of the sha256 of examples/tpu/grpo/Dockerfile>, so
# the image always matches the Dockerfile under test. It is built in the cluster with BuildKit (TPU_CI_BUILDKIT_IMAGE)
# by docker-build-tpu.yml, or by a test run for code that is already in the repository (TPU_CI_ALLOW_IMAGE_BUILD).
# Set TPU_CI_IMAGE to run a prebuilt image instead.
TPU_CI_IMAGE="${TPU_CI_IMAGE:-}"
TPU_CI_IMAGE_REPO="${TPU_CI_IMAGE_REPO:-us-west2-docker.pkg.dev/tpu-pytorch/raycluster/verl-tpu-ci}"
TPU_CI_BUILDKIT_IMAGE="${TPU_CI_BUILDKIT_IMAGE:-moby/buildkit:v0.34.0}"

# verl-hardware-plugin under test. Empty (default): the repository and the commit that examples/tpu/grpo/README.md
# tells users to clone and check out, so CI tests what the README documents. Set them to test another commit, e.g. of
# a fork (a full 40-character commit id, a branch or a tag).
VERL_HARDWARE_PLUGIN_REPO="${VERL_HARDWARE_PLUGIN_REPO:-}"
VERL_HARDWARE_PLUGIN_COMMIT="${VERL_HARDWARE_PLUGIN_COMMIT:-}"
