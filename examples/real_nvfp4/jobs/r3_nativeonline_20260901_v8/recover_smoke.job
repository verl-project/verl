#!/usr/bin/env bash
#SBATCH --account=general_sa
#SBATCH --partition=36x2-a01r,tcpo,batch
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --job-name=verl-rn4pt-audit

set -euo pipefail
export RN4PT_SKIP_UV_LOCK_CHECK=1
source "${RN4PT_MANIFEST_OVERRIDE:-/lustre/fsw/general_sa/shuazhang/python_space/verl_for_nvfp4_20251031/verl_nvfp4_e2e_r3_20260831_v3/examples/real_nvfp4/jobs/r3_nativeonline_20260901_v8/manifest.sh}"
rn4pt_validate_static
rn4pt_require_runtime_image

readonly RECOVER_JOB_ID=${RECOVER_JOB_ID:?set RECOVER_JOB_ID to the completed smoke job}
[[ "$RECOVER_JOB_ID" =~ ^[0-9]+$ ]] || rn4pt_die "invalid smoke job id: $RECOVER_JOB_ID"
readonly EXP_NAME=${RN4PT_SMOKE_EXP}_j${RECOVER_JOB_ID}
readonly JOB_LOG=$RN4PT_LOGS/${EXP_NAME}_${RECOVER_JOB_ID}.log
readonly SLURM_LOG=$RN4PT_LOGS/verl-rn4pt-train_${RECOVER_JOB_ID}.out
readonly FINAL_CHECKPOINT=$RN4PT_CHECKPOINTS/$EXP_NAME/global_step_3/actor
readonly CHECKPOINT_MANIFEST=$FINAL_CHECKPOINT/ckpt_contents.json
readonly OPTIMIZER_CHECKPOINT=$FINAL_CHECKPOINT/optimizer/dist_ckpt

[[ -s "$JOB_LOG" && -s "$SLURM_LOG" ]] || rn4pt_die "smoke logs are incomplete"
grep -Eq "Job '[^']+' succeeded" "$SLURM_LOG" || rn4pt_die "Ray smoke task did not report success"
grep -q 'VERL_REAL_NVFP4_PRECISION_RECIPE PASS scope=all_mlp attention=bf16' "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_ATTESTATION PASS.*scope=all_mlp attention=bf16.*te_version=2.18.0+e7c550c5.*mlp_fc1_nvfp4=48 mlp_fc2_nvfp4=48' "$JOB_LOG"
grep -q '"cudagraph_mode": "FULL_DECODE_ONLY"' "$JOB_LOG"
grep -q "'flashinfer_trtllm'" "$JOB_LOG"
grep -q 'Capturing CUDA graphs (decode, FULL): 100%' "$JOB_LOG"
grep -q "'max_num_seqs': 128" "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_ROLLOUT_ATTESTATION PASS dense_layers=0 moe_layers=48 expected=48' "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_EXPORT PASS location=vllm_receive.*expert_weights=18432 expected=18432' "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_NATIVE_REFIT PASS refit=0 changed=1' "$JOB_LOG"
grep -Eq 'VERL_REAL_NVFP4_NATIVE_REFIT PASS refit=1 changed=[01]' "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_SYNC PASS transport=bf16 quantization=vllm_native_online reload=native' "$JOB_LOG"
grep -q 'VERL_R3_MONOLITHIC_CAPTURE_PATCH PASS' "$JOB_LOG"
grep -q 'routing replay layers: 48' "$JOB_LOG"
grep -q 'Training Progress: 100%' "$JOB_LOG"
grep -q 'Final validation metrics:' "$JOB_LOG"
grep -Eq 'step:3([^0-9]|$).*actor/loss:' "$JOB_LOG" || rn4pt_die "final training metric is missing"
if grep -E 'step:[0-9]+.*actor/loss:' "$JOB_LOG" | \
  grep -Eiq 'actor/(loss|pg_loss|grad_norm):[[:space:]]*(nan|[-+]?inf)|rollout_corr/rollout_log_ppl:[[:space:]]*(nan|[-+]?inf)|training/rollout_probs_diff_(mean|max):[[:space:]]*(nan|[-+]?inf)'; then
  rn4pt_die "non-finite rollout/training metric"
fi

[[ -s "$CHECKPOINT_MANIFEST" ]] || rn4pt_die "completed checkpoint manifest is missing"
grep -q '"optimizer"' "$CHECKPOINT_MANIFEST" || rn4pt_die "checkpoint manifest lacks full optimizer state"
[[ -s "$OPTIMIZER_CHECKPOINT/.metadata" && -s "$OPTIMIZER_CHECKPOINT/common.pt" ]] || \
  rn4pt_die "full-Adam optimizer metadata is incomplete"
readonly OPTIMIZER_SHARDS=$(find "$OPTIMIZER_CHECKPOINT" -maxdepth 1 -type f -name '*.distcp' -size +1G | wc -l)
[[ "$OPTIMIZER_SHARDS" = 4 ]] || rn4pt_die "expected four nonempty optimizer shards, found $OPTIMIZER_SHARDS"

printf 'job_id=%s\naudit_job_id=%s\nlog=%s\nexp=%s\n' \
  "$RECOVER_JOB_ID" "$SLURM_JOB_ID" "$JOB_LOG" "$EXP_NAME" >"$RN4PT_SMOKE_PASS"
echo "REAL_NVFP4_FULL_ADAM_CHECKPOINT_PASS path=$FINAL_CHECKPOINT optimizer_shards=$OPTIMIZER_SHARDS"
echo "REAL_NVFP4_PERTOKEN_SMOKE_RECOVERY_PASS job_id=$RECOVER_JOB_ID audit_job_id=$SLURM_JOB_ID"
