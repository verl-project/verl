#!/usr/bin/env bash
#SBATCH --account=general_sa
#SBATCH --partition=36x2-a01r,tcpo,batch
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:15:00
#SBATCH --job-name=verl-rn4pt-probe

set -euo pipefail
export RN4PT_SKIP_UV_LOCK_CHECK=1
source /lustre/fsw/general_sa/shuazhang/python_space/verl_for_nvfp4_20251031/verl_nvfp4_e2e_r3_20260831_v3/examples/real_nvfp4/jobs/r3_nativeonline_20260901_v8/manifest.sh
rn4pt_validate_static
mkdir -p "$RN4PT_STATE"
readonly PROBE_LOG=$RN4PT_STATE/probe_${SLURM_JOB_ID:?}.log

read -r -d '' INNER <<'INNER_EOF' || true
set -euo pipefail
echo "arch=$(uname -m) default_python=$(command -v python3) uv=$(command -v uv || true)"
UV_BIN=$(command -v uv || true)
if [[ -z "$UV_BIN" && -x /opt/verl-real-nvfp4/.venv/bin/uv ]]; then
  UV_BIN=/opt/verl-real-nvfp4/.venv/bin/uv
fi
if [[ -n "$UV_BIN" && -x "$UV_BIN" ]]; then
  echo "UV_CANDIDATE=$UV_BIN"
  "$UV_BIN" --version
else
  echo "UV_CANDIDATE=MISSING"
fi
find /opt -maxdepth 4 -name pyvenv.cfg -print 2>/dev/null | sort
for candidate in \
  /opt/verl-real-nvfp4/.venv/bin/python \
  /opt/verl/.venv/bin/python \
  /opt/venv/bin/python \
  "$(command -v python3)"; do
  [[ -x "$candidate" ]] || continue
  echo "PYTHON_CANDIDATE=$candidate"
  "$candidate" - <<'PY'
import os
import platform
import sys
from importlib.metadata import PackageNotFoundError, version
print(f"executable={sys.executable} version={platform.python_version()}")
print(f"prefix={sys.prefix} base_prefix={sys.base_prefix}")
for name in (
    "torch", "vllm", "transformers", "megatron-core", "megatron-bridge",
    "transformer-engine", "nvidia-modelopt", "flashinfer-python",
    "flashinfer-cubin", "flashinfer-jit-cache", "nvidia-cutlass-dsl",
    "quack-kernels", "ray", "hydra-core",
):
    try:
        value = version(name)
    except PackageNotFoundError:
        value = "MISSING"
    print(f"{name}={value}", flush=True)
try:
    import torch
    print(f"torch_cuda={torch.version.cuda} cuda_available={torch.cuda.is_available()}")
except Exception as exc:
    print(f"torch_probe_error={exc!r}")
PY
  "$candidate" -m pip --version || true
done
for required_command in gcc g++ cmake ninja git; do
  command -v "$required_command"
done
df -h /tmp /opt | tail -n +2
INNER_EOF

srun --container-image="$RN4PT_BASE_IMAGE" \
  --container-mounts=/lustre/fsw/general_sa/shuazhang:/lustre/fsw/general_sa/shuazhang \
  bash -lc "export CUDA_VISIBLE_DEVICES=0; $INNER" 2>&1 | tee "$PROBE_LOG"

grep -q '^arch=aarch64 ' "$PROBE_LOG" || rn4pt_die "base image is not aarch64"
grep -q '^PYTHON_CANDIDATE=' "$PROBE_LOG" || rn4pt_die "base image has no usable Python"
grep -q '^pip ' "$PROBE_LOG" || rn4pt_die "base image has neither uv nor a usable pip bootstrap"
for required_command in gcc g++ cmake ninja git; do
  grep -q "/$required_command$" "$PROBE_LOG" || rn4pt_die "base image lacks $required_command"
done
printf 'job_id=%s\nlog=%s\nbase_image=%s\n' \
  "$SLURM_JOB_ID" "$PROBE_LOG" "$RN4PT_BASE_IMAGE" >"$RN4PT_PROBE_PASS"
echo "REAL_NVFP4_PERTOKEN_PROBE_PASS job_id=$SLURM_JOB_ID log=$PROBE_LOG"
