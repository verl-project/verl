#!/usr/bin/env bash
#SBATCH --account=general_sa
#SBATCH --partition=36x2-a01r,tcpo,batch
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --time=01:20:00
#SBATCH --job-name=verl-rn4pt-reloadrepro

# Isolates vLLM 0.26's layerwise reload from verl: no Ray, no training, no
# weight transport.  See repro.py for what a PASS/FAIL means.
set -euo pipefail

readonly RN4PT_WORKSPACE=/lustre/fsw/general_sa/shuazhang/python_space/verl_for_nvfp4_20251031
readonly RN4PT_VERL=$RN4PT_WORKSPACE/verl_nvfp4_e2e_r3_20260831_v3
readonly RN4PT_IMAGE=/lustre/fsw/general_sa/shuazhang/images/verl.vllm026.mcore018.te218e7.realnvfp4.nativeonline.pdl-off.v8base.20260901.v12.sqsh
readonly RN4PT_IMAGE_ENV=/opt/verl-rn4pt-20260831-v5
readonly RN4PT_MOUNTS=/lustre/fsw/general_sa/shuazhang:/lustre/fsw/general_sa/shuazhang
readonly MODEL_PATH=${MODEL_PATH:-/lustre/fsw/general_sa/shuazhang/models/Qwen/Qwen3-30B-A3B-Base}
readonly LOGS=$RN4PT_WORKSPACE/ray_log/verl_real_nvfp4_bf16_reload_repro_20260904_v24
readonly REPRO=$RN4PT_VERL/examples/real_nvfp4/jobs/bf16_reload_repro_20260904_v24/repro.py

[[ -s "$RN4PT_IMAGE" ]] || { echo "image missing: $RN4PT_IMAGE" >&2; exit 1; }
[[ -f "$MODEL_PATH/config.json" ]] || { echo "model missing: $MODEL_PATH" >&2; exit 1; }
mkdir -p "$LOGS"

# One backend per process: a crashed engine cannot be reused, and each variant
# must start from a clean allocator anyway.
readonly VARIANTS=${REPRO_VARIANTS:-triton trtllm trtllm_pdl_off}

srun --nodes=1 --ntasks=1 \
  --container-image="$RN4PT_IMAGE" --container-mounts="$RN4PT_MOUNTS" \
  bash -lc "
    set -uo pipefail
    export PATH=$RN4PT_IMAGE_ENV/.venv/bin:\$PATH
    export PYTHONPATH=$RN4PT_VERL:\${PYTHONPATH:-}
    export MODEL_PATH=$MODEL_PATH
    # Keep the worker in-process so collective_rpc can read live tensor stats.
    export VLLM_ENABLE_V1_MULTIPROCESSING=0
    export CUDA_VISIBLE_DEVICES=0
    for variant in $VARIANTS; do
      echo \"########## REPRO_VARIANT_BEGIN \$variant ##########\"
      REPRO_VARIANT=\$variant python3 -u $REPRO
      echo \"########## REPRO_VARIANT_END \$variant exit=\$? ##########\"
    done
  " 2>&1 | tee "$LOGS/repro_${SLURM_JOB_ID}.log"

echo "REPRO_ALL_VARIANTS_DONE"
