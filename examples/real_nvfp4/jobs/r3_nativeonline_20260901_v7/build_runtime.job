#!/usr/bin/env bash
#SBATCH --account=general_sa
#SBATCH --partition=36x2-a01r,tcpo,batch
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:45:00
#SBATCH --job-name=verl-rn4pt-build

set -euo pipefail
export RN4PT_SKIP_UV_LOCK_CHECK=1
# shellcheck disable=SC1091
source /lustre/fsw/general_sa/shuazhang/python_space/verl_for_nvfp4_20251031/verl_nvfp4_e2e_r3_20260831_v3/examples/real_nvfp4/jobs/r3_nativeonline_20260901_v7/manifest.sh
rn4pt_validate_static
[[ -s "$RN4PT_PROBE_PASS" ]] || rn4pt_die "runtime probe has not passed"
[[ ! -e "$RN4PT_RUNTIME_IMAGE" && ! -e "$RN4PT_RUNTIME_IMAGE.sha256" ]] || \
  rn4pt_die "versioned runtime image already exists"

mkdir -p "$RN4PT_STATE"
readonly BUILD_LOG=$RN4PT_STATE/build_${SLURM_JOB_ID:?}.log
readonly TMP_IMAGE=$RN4PT_RUNTIME_IMAGE.building.${SLURM_JOB_ID}
[[ "$TMP_IMAGE" = "$RN4PT_RUNTIME_IMAGE.building.${SLURM_JOB_ID}" && ! -e "$TMP_IMAGE" ]]

cleanup_failed_build() {
  local rc=$?
  if [[ $rc -ne 0 && -e "$TMP_IMAGE" ]]; then
    rm -f -- "$TMP_IMAGE"
  fi
  return "$rc"
}
trap cleanup_failed_build EXIT

read -r -d '' INNER <<INNER_EOF || true
set -euo pipefail
readonly PYTHON=$RN4PT_IMAGE_PYTHON
[[ -x "\$PYTHON" ]]

# v6 already contains the exact vLLM upstream b07ec92faa2d534ed97fe97f44ca71c816404849
# writable-scale backport. Assert that immutable dependency contract before
# binding the v7 source revision; do not mutate or reinstall the environment.
"\$PYTHON" - <<'PY'
from importlib.metadata import distribution

path = distribution("vllm").locate_file(
    "vllm/model_executor/layers/quantization/utils/flashinfer_fp4_moe.py"
)
text = path.read_text()
assert text.count(".repeat(num_experts)") >= 4
assert ".expand(num_experts)" not in text
print(
    "REAL_NVFP4_VLLM_WRITABLE_SCALES_BACKPORT_PASS",
    "upstream=b07ec92faa2d534ed97fe97f44ca71c816404849",
    path,
    flush=True,
)
PY

"\$PYTHON" - <<'PY'
import inspect
import platform
from importlib.metadata import PackageNotFoundError, distribution, version
from pathlib import Path
from types import SimpleNamespace

import torch

expected = {
    "vllm": "0.26.0",
    "megatron-core": "0.18.0+ba7b5ebce",
    "megatron-bridge": "0.5.2",
    "transformer-engine": "2.18.0+e7c550c5",
    "flashinfer-python": "0.6.14",
    "flashinfer-cubin": "0.6.14",
    "flashinfer-jit-cache": "0.6.14+cu130",
    "nvidia-cutlass-dsl": "4.6.0",
    "transformers": "5.12.1",
}
actual = {name: version(name) for name in expected}
assert actual == expected, (actual, expected)
assert platform.machine() == "aarch64"
try:
    version("flash-attn-4")
except PackageNotFoundError:
    pass
else:
    raise AssertionError("flash-attn-4 must not collide with the FA2 training wheel")

mcore_attention = Path(
    __import__("megatron.core.transformer.attention", fromlist=["__file__"]).__file__
)
assert "VERL_MCORE_FA4_DIST_GUARD" in mcore_attention.read_text()

from vllm.model_executor.layers.fused_moe.oracle.nvfp4 import NvFp4MoeBackend
from vllm.model_executor.layers.quantization.utils import flashinfer_fp4_moe
from vllm.model_executor.layers.quantization.utils.flashinfer_fp4_moe import (
    prepare_nvfp4_moe_layer_for_fi_or_cutlass,
)

# Backport the upstream regression test semantics.  Distinct per-expert values
# must be copyable into the returned scales; an expand()-based stride-zero view
# raises the exact RuntimeError seen in smoke job 2693601.
original_swizzle = flashinfer_fp4_moe.swizzle_blockscale
flashinfer_fp4_moe.swizzle_blockscale = lambda value: value
try:
    num_experts = 3
    layer = SimpleNamespace(activation=SimpleNamespace(is_gated=False))
    w13 = torch.zeros((num_experts, 2, 1), dtype=torch.uint8)
    w2 = torch.zeros((num_experts, 2, 1), dtype=torch.uint8)
    w13_scale = torch.zeros((num_experts, 2, 1), dtype=torch.float8_e4m3fn)
    w2_scale = torch.zeros((num_experts, 2, 1), dtype=torch.float8_e4m3fn)
    weight_scale = torch.ones(num_experts)
    outputs = prepare_nvfp4_moe_layer_for_fi_or_cutlass(
        backend=NvFp4MoeBackend.FLASHINFER_CUTLASS,
        layer=layer,
        w13=w13,
        w13_scale=w13_scale,
        w13_scale_2=weight_scale,
        a13_scale=torch.tensor([1.0, 2.0, 3.0]),
        w2=w2,
        w2_scale=w2_scale,
        w2_scale_2=weight_scale,
        a2_scale=torch.tensor([4.0, 5.0, 6.0]),
        is_act_and_mul=False,
    )
finally:
    flashinfer_fp4_moe.swizzle_blockscale = original_swizzle
a13_scale, a2_scale = outputs[3], outputs[7]
distinct = torch.arange(num_experts, dtype=torch.float32)
a13_scale.copy_(distinct)
a2_scale.copy_(distinct)
torch.testing.assert_close(a13_scale, distinct)
torch.testing.assert_close(a2_scale, distinct)
assert a13_scale.stride() == (1,) and a2_scale.stride() == (1,)

source = distribution("vllm").locate_file(
    "vllm/model_executor/layers/quantization/utils/flashinfer_fp4_moe.py"
).read_text()
assert source.count(".repeat(num_experts)") >= 4
assert ".expand(num_experts)" not in source

from vllm.model_executor.layers.fused_moe.oracle.nvfp4 import make_nvfp4_moe_kernel
from vllm.model_executor.layers.quantization import get_quantization_config
from vllm.v1.worker.gpu_model_runner import GPUModelRunner

assert "per_token_activation" in inspect.signature(make_nvfp4_moe_kernel).parameters
assert get_quantization_config("nvfp4_per_token").__name__ == "OnlineQuantizationConfig"
reload_signature = inspect.signature(GPUModelRunner.reload_weights)
assert tuple(reload_signature.parameters) == (
    "self", "weights_iterator", "weights_path", "is_checkpoint_format"
)
assert reload_signature.parameters["is_checkpoint_format"].default is True

from verl.workers.rollout.vllm_rollout.utils import vLLMColocateWorkerExtension
from verl.workers.rollout.vllm_rollout.vllm_async_server import vLLMHttpServer

assert vLLMColocateWorkerExtension is not None and vLLMHttpServer is not None
print("REAL_NVFP4_PERTOKEN_IMAGE_DEPS_PASS", actual, flush=True)
PY
INNER_EOF

srun --container-image="$RN4PT_BASE_IMAGE" \
  --container-name="verl-rn4pt-build-${SLURM_JOB_ID}" \
  --container-mounts=/lustre/fsw/general_sa/shuazhang:/lustre/fsw/general_sa/shuazhang \
  --container-save="$TMP_IMAGE" \
  bash -lc "export CUDA_VISIBLE_DEVICES=0; $INNER" 2>&1 | tee "$BUILD_LOG"

grep -q 'REAL_NVFP4_VLLM_WRITABLE_SCALES_BACKPORT_PASS' "$BUILD_LOG"
grep -q 'REAL_NVFP4_PERTOKEN_IMAGE_DEPS_PASS' "$BUILD_LOG"
[[ -s "$TMP_IMAGE" ]]
mv "$TMP_IMAGE" "$RN4PT_RUNTIME_IMAGE"
sha256sum "$RN4PT_RUNTIME_IMAGE" >"$RN4PT_RUNTIME_IMAGE.sha256"
printf 'job_id=%s\nlog=%s\nimage=%s\nsource_commit=%s\nlock_sha256=%s\n' \
  "$SLURM_JOB_ID" "$BUILD_LOG" "$RN4PT_RUNTIME_IMAGE" \
  "$RN4PT_SOURCE_COMMIT" "$RN4PT_LOCK_SHA256" >"$RN4PT_BUILD_PASS"
trap - EXIT
echo "REAL_NVFP4_PERTOKEN_BUILD_PASS job_id=$SLURM_JOB_ID image=$RN4PT_RUNTIME_IMAGE"
