#!/usr/bin/env bash
#SBATCH --account=general_sa
#SBATCH --partition=36x2-a01r,tcpo,batch
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:45:00
#SBATCH --job-name=verl-rn4pt-preflight

set -euo pipefail
export RN4PT_SKIP_UV_LOCK_CHECK=1
# shellcheck disable=SC1091
source /lustre/fsw/general_sa/shuazhang/python_space/verl_for_nvfp4_20251031/verl_nvfp4_e2e_r3_20260831_v3/examples/real_nvfp4/jobs/r3_nativeonline_20260831_v3/manifest.sh
rn4pt_validate_static
[[ -s "$RN4PT_BUILD_PASS" ]] || rn4pt_die "runtime build has not passed"
rn4pt_require_runtime_image
mkdir -p "$RN4PT_STATE"
readonly PREFLIGHT_LOG=$RN4PT_STATE/preflight_${SLURM_JOB_ID:?}.log

read -r -d '' INNER <<INNER_EOF || true
set -euo pipefail
export PATH=$RN4PT_IMAGE_ENV/.venv/bin:\$PATH
export PYTHONPATH=$RN4PT_VERL:\${PYTHONPATH:-}
export CUDA_VISIBLE_DEVICES=0
export NVTE_BACKWARD_OVERRIDE=dequantized
export NVTE_NVFP4_ROW_SCALED_ACTIVATION=1
export NVTE_NVFP4_DISABLE_RHT=1
export NVTE_NVFP4_DISABLE_STOCHASTIC_ROUNDING=1
export NVTE_NVFP4_DISABLE_2D_QUANTIZATION=1
export NVTE_NVFP4_4OVER6=none
export NVTE_NVFP4_4OVER6_E4M3_USE_256=all
export NVTE_NVFP4_4OVER6_ERR_MODE=MAE
export FLASHINFER_DISABLE_FP4_QUANT_FAST_MATH=1
export TRTLLM_DISABLE_FP4_QUANT_FAST_MATH=1
cd $RN4PT_VERL

python - <<'PY'
import inspect
import json
from importlib.metadata import version

import torch
import transformer_engine.pytorch as te
from megatron.core.quantization.utils import load_quantization_recipe
from megatron.core.transformer.transformer_config import TransformerConfig
from transformer_engine.common.recipe import NVFP4BlockScaling
from transformer_engine.pytorch.module.grouped_linear import GroupedLinear
from vllm.model_executor.layers.fused_moe.oracle.nvfp4 import make_nvfp4_moe_kernel
from vllm.model_executor.layers.quantization import get_quantization_config
from vllm.model_executor.layers.quantization.online.nvfp4 import (
    Nvfp4OnlineMoEMethod,
    _quantize_moe_weight_to_nvfp4,
)
from vllm.v1.worker.gpu_model_runner import GPUModelRunner

expected = {
    "vllm": "0.26.0",
    "megatron-core": "0.18.0+ba7b5ebce",
    "transformer-engine": "2.18.0+e7c550c5",
    "transformers": "5.12.1",
}
actual = {name: version(name) for name in expected}
assert actual == expected, (actual, expected)
assert torch.cuda.is_available()
assert "per_token_activation" in inspect.signature(make_nvfp4_moe_kernel).parameters
assert get_quantization_config("nvfp4_per_token").__name__ == "OnlineQuantizationConfig"
assert Nvfp4OnlineMoEMethod.__name__ == "Nvfp4OnlineMoEMethod"
reload_signature = inspect.signature(GPUModelRunner.reload_weights)
assert tuple(reload_signature.parameters) == (
    "self", "weights_iterator", "weights_path", "is_checkpoint_format"
)
assert reload_signature.parameters["is_checkpoint_format"].default is True
assert callable(getattr(GPUModelRunner, "get_model", None))
assert {
    "first_last_layers_bf16",
    "num_layers_at_start_in_bf16",
    "num_layers_at_end_in_bf16",
} <= TransformerConfig.__dataclass_fields__.keys()

recipe_path = "examples/real_nvfp4/config/attn_bf16_mlp_nvfp4.yaml"
recipe = load_quantization_recipe(recipe_path)
assert len(recipe.matchers) == 4

torch.manual_seed(1234)
linear = te.Linear(64, 64, bias=False, params_dtype=torch.bfloat16).cuda()
x = torch.randn(16, 64, device="cuda", dtype=torch.bfloat16, requires_grad=True)
with te.fp8_autocast(enabled=True, fp8_recipe=NVFP4BlockScaling()):
    loss = linear(x).float().square().mean()
loss.backward()
assert torch.isfinite(loss) and torch.isfinite(x.grad).all()

# Qwen3 routed experts use TE GroupedLinear, not te.Linear.  Exercise two
# complete NVFP4 updates so the packed-wgrad and dequantized-saved-operand
# fixes are both required before we spend 32 GPUs on the model smoke.
grouped = GroupedLinear(
    4,
    64,
    64,
    bias=False,
    params_dtype=torch.bfloat16,
).cuda()
m_splits = torch.tensor([16, 16, 16, 16], dtype=torch.int64, device="cpu")
grouped_losses = []
for step in range(2):
    grouped.zero_grad(set_to_none=True)
    grouped_x = torch.randn(
        64,
        64,
        device="cuda",
        dtype=torch.bfloat16,
        requires_grad=True,
    )
    with te.fp8_autocast(enabled=True, fp8_recipe=NVFP4BlockScaling()):
        grouped_loss = grouped(
            grouped_x,
            m_splits,
            is_first_microbatch=True,
        ).float().square().mean()
    grouped_loss.backward()
    grouped_losses.append(float(grouped_loss))
    assert torch.isfinite(grouped_loss)
    assert grouped_x.grad is not None and torch.isfinite(grouped_x.grad).all()
    grouped_grads = [param.grad for param in grouped.parameters() if param.requires_grad]
    assert grouped_grads and all(grad is not None for grad in grouped_grads)
    assert all(torch.isfinite(grad).all() for grad in grouped_grads)

from verl.utils.real_nvfp4 import validate_real_nvfp4_te_recipe

validate_real_nvfp4_te_recipe(
    NVFP4BlockScaling(),
    backward_override="dequantized",
)

weight = torch.randn(4, 128, 64, device="cuda", dtype=torch.bfloat16)
packed, scale, scale2 = _quantize_moe_weight_to_nvfp4(weight)
assert packed.dtype == torch.uint8 and tuple(packed.shape) == (4, 128, 32)
assert scale.dtype == torch.float8_e4m3fn and tuple(scale.shape) == (4, 128, 4)
assert scale2.dtype == torch.float32 and tuple(scale2.shape) == (4,)

from verl.utils.real_nvfp4.r3_monolithic_capture import patch_vllm_monolithic_moe_r3_capture
from verl.utils.real_nvfp4.vllm_runtime import NVFP4_PER_TOKEN_METHOD, REAL_NVFP4_MOE_BACKEND
from verl.workers.rollout.vllm_rollout.utils import vLLMColocateWorkerExtension
from verl.workers.rollout.vllm_rollout.vllm_async_server import vLLMHttpServer

patch_result = patch_vllm_monolithic_moe_r3_capture()
assert patch_result in {"verl_wrapper", "already_patched", "upstream_native"}
assert NVFP4_PER_TOKEN_METHOD == "nvfp4_per_token"
assert REAL_NVFP4_MOE_BACKEND == "flashinfer_trtllm"
assert vLLMColocateWorkerExtension is not None and vLLMHttpServer is not None
print(
    "REAL_NVFP4_PERTOKEN_GPU_API_PASS",
    actual,
    f"te_loss={float(loss):.8f}",
    f"te_grouped_losses={grouped_losses}",
    f"r3_patch={patch_result}",
    flush=True,
)
PY

pytest -q \
  tests/utils/real_nvfp4/test_te_contract.py \
  tests/utils/real_nvfp4/test_vllm_native_online.py \
  tests/utils/test_bucketed_weight_transfer.py \
  tests/utils/test_vllm_weight_name_normalization_on_cpu.py

for precision in bf16 real_nvfp4; do
  CONFIG_ONLY=1 RUN_PROFILE=smoke PRECISION_MODE=\$precision NNODES=1 N_GPUS_PER_NODE=4 \
    WORKING_DIR=$RN4PT_VERL EXP_NAME=config-only-\$precision TOTAL_TRAINING_STEPS=2 \
    bash examples/real_nvfp4/run_qwen3_30b_megatron.sh >/tmp/rn4pt-config-\$precision.yaml
done
CONFIG_ONLY=1 RUN_PROFILE=formal PRECISION_MODE=real_nvfp4 NNODES=8 N_GPUS_PER_NODE=4 \
  WORKING_DIR=$RN4PT_VERL EXP_NAME=config-only-real-nvfp4-formal TOTAL_TRAINING_STEPS=2 \
  bash examples/real_nvfp4/run_qwen3_30b_megatron.sh >/tmp/rn4pt-config-formal.yaml
grep -q 'mode: R3' /tmp/rn4pt-config-formal.yaml
grep -q 'enable_rollout_routing_replay: true' /tmp/rn4pt-config-formal.yaml
grep -q 'enforce_eager: false' /tmp/rn4pt-config-formal.yaml
grep -q 'max_num_seqs: 128' /tmp/rn4pt-config-formal.yaml
grep -q 'cudagraph_mode: FULL_DECODE_ONLY' /tmp/rn4pt-config-formal.yaml
grep -q 'loss_agg_mode: token-mean' /tmp/rn4pt-config-formal.yaml
grep -q 'rollout_is: token' /tmp/rn4pt-config-formal.yaml
grep -q 'first_last_layers_bf16: false' /tmp/rn4pt-config-formal.yaml
grep -q 'num_layers_at_start_in_bf16: 0' /tmp/rn4pt-config-formal.yaml
grep -q 'num_layers_at_end_in_bf16: 0' /tmp/rn4pt-config-formal.yaml
echo REAL_NVFP4_PERTOKEN_PREFLIGHT_INNER_PASS
INNER_EOF

srun --container-image="$RN4PT_RUNTIME_IMAGE" \
  --container-mounts="$RN4PT_MOUNTS" \
  bash -lc "$INNER" 2>&1 | tee "$PREFLIGHT_LOG"

grep -q 'REAL_NVFP4_PERTOKEN_GPU_API_PASS' "$PREFLIGHT_LOG"
grep -q 'REAL_NVFP4_PERTOKEN_PREFLIGHT_INNER_PASS' "$PREFLIGHT_LOG"
printf 'job_id=%s\nlog=%s\nimage=%s\n' \
  "$SLURM_JOB_ID" "$PREFLIGHT_LOG" "$RN4PT_RUNTIME_IMAGE" >"$RN4PT_PREFLIGHT_PASS"
echo "REAL_NVFP4_PERTOKEN_PREFLIGHT_PASS job_id=$SLURM_JOB_ID log=$PREFLIGHT_LOG"
