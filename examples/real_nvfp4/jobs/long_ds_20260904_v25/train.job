#!/usr/bin/env bash
#SBATCH --account=general_sa
#SBATCH --partition=36x2-a01r,tcpo,batch
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --job-name=verl-rn4pt-v25

set -euo pipefail
export RN4PT_SKIP_UV_LOCK_CHECK=1
# shellcheck disable=SC1091
source "${RN4PT_MANIFEST_OVERRIDE:-/lustre/fsw/general_sa/shuazhang/python_space/verl_for_nvfp4_20251031/verl_nvfp4_e2e_r3_20260831_v3/examples/real_nvfp4/jobs/long_ds_20260904_v25/manifest.sh}"
rn4pt_validate_static
rn4pt_require_runtime_image

readonly ARM=${ARM:?ARM must be w4a4 or bf16}
readonly PHASE=${PHASE:?PHASE must be smoke or long}
rn4pt_arm_settings "$ARM"

case "$PHASE" in
  smoke)
    readonly EXPECTED_NODES=1
    readonly RUN_PROFILE=smoke
    readonly EXP_NAME=${LONG_SMOKE_EXP}_j${SLURM_JOB_ID:?}
    # verl starts the trainer loop at global_step=1, so 3 steps means two real
    # optimizer updates plus a final validation.
    readonly TARGET_STEP=3
    readonly RESUME_MODE=disable
    readonly CKPT_DIR=$RN4PT_CHECKPOINTS/$EXP_NAME
    readonly CHUNK_INDEX=0
    ;;
  long)
    readonly EXPECTED_NODES=8
    readonly RUN_PROFILE=formal
    readonly EXP_NAME=$LONG_EXP
    readonly CHUNK_INDEX=${LONG_CHUNK_INDEX:?LONG_CHUNK_INDEX is required}
    readonly TARGET_STEP=${LONG_TARGET_STEP:?LONG_TARGET_STEP is required}
    readonly CKPT_DIR=$RN4PT_CHECKPOINTS/$EXP_NAME
    [[ "$CHUNK_INDEX" =~ ^[1-9][0-9]*$ ]] || rn4pt_die "chunk index must be a positive integer"
    (( CHUNK_INDEX <= ${#LONG_TARGET_STEPS[@]} )) || rn4pt_die "chunk index past the end of the chain"
    # submit.sh and this job must agree on the schedule, or a later chunk would
    # resume from a checkpoint that was never written.
    [[ "$TARGET_STEP" = "${LONG_TARGET_STEPS[$((CHUNK_INDEX - 1))]}" ]] || \
      rn4pt_die "chunk $CHUNK_INDEX must target step ${LONG_TARGET_STEPS[$((CHUNK_INDEX - 1))]}"
    if (( CHUNK_INDEX == 1 )); then
      [[ ! -e "$CKPT_DIR" ]] || rn4pt_die "fresh checkpoint collision: $CKPT_DIR"
      readonly RESUME_MODE=disable
    else
      previous_target=${LONG_TARGET_STEPS[$((CHUNK_INDEX - 2))]}
      previous_pass=$RN4PT_STATE/${LONG_JOB_TAG}_chunk_$((CHUNK_INDEX - 1)).pass
      [[ -s "$previous_pass" ]] || rn4pt_die "previous chunk PASS is missing: $previous_pass"
      grep -Fxq "target_step=$previous_target" "$previous_pass" || \
        rn4pt_die "previous chunk target does not match"
      [[ -s "$CKPT_DIR/global_step_$previous_target/actor/ckpt_contents.json" ]] || \
        rn4pt_die "previous full-Adam checkpoint is missing"
      readonly RESUME_MODE=auto
    fi
    ;;
  *) rn4pt_die "invalid PHASE=$PHASE" ;;
esac
[[ "${SLURM_JOB_NUM_NODES:?}" = "$EXPECTED_NODES" ]] || rn4pt_die "phase $PHASE requires $EXPECTED_NODES nodes"

readonly CHUNK_PASS=$RN4PT_STATE/${LONG_JOB_TAG}_chunk_${CHUNK_INDEX}.pass
[[ "$PHASE" = smoke || ! -e "$CHUNK_PASS" ]] || rn4pt_die "chunk PASS collision: $CHUNK_PASS"
mkdir -p "$RN4PT_STATE" "$RN4PT_LOGS"
readonly JOB_LOG=$RN4PT_LOGS/${EXP_NAME}_${PHASE}${CHUNK_INDEX}_${SLURM_JOB_ID:?}.log

nodes=$(scontrol show hostnames "$SLURM_JOB_NODELIST")
readarray -t nodes_array <<<"$nodes"
readonly head_node=${nodes_array[0]}
readonly head_port=$((19000 + SLURM_JOB_ID % 10000))
readonly dashboard_port=$((29000 + SLURM_JOB_ID % 10000))
readonly ip_head=$head_node:$head_port
readonly COMMON_ENV="export PATH=$RN4PT_IMAGE_ENV/.venv/bin:\$PATH; export PYTHONPATH=$RN4PT_VERL:\${PYTHONPATH:-}; export RAY_RUNTIME_ENV_TEMPORARY_REFERENCE_EXPIRATION_S=3600"

ray_pids=()
cleanup_ray_steps() {
  local pid
  for pid in "${ray_pids[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
}
trap cleanup_ray_steps EXIT

srun --overlap --nodes=1 --ntasks=1 -w "$head_node" \
  --container-image="$RN4PT_RUNTIME_IMAGE" --container-mounts="$RN4PT_MOUNTS" \
  bash -lc "$COMMON_ENV; ray start --head --node-ip-address=$head_node --port=$head_port --dashboard-port=$dashboard_port --dashboard-host=0.0.0.0 --block" &
ray_pids+=("$!")

for ((index=1; index<EXPECTED_NODES; index++)); do
  node=${nodes_array[$index]}
  srun --overlap --nodes=1 --ntasks=1 -w "$node" \
    --container-image="$RN4PT_RUNTIME_IMAGE" --container-mounts="$RN4PT_MOUNTS" \
    bash -lc "$COMMON_ENV; ray start --address=$ip_head --block" &
  ray_pids+=("$!")
done

sleep 15

read -r -d '' DRIVER <<DRIVER_EOF || true
set -euo pipefail
$COMMON_ENV
export WORKING_DIR=$RN4PT_VERL
export RUNTIME_ENV=$LONG_RUNTIME_ENV
export NNODES=$EXPECTED_NODES N_GPUS_PER_NODE=4
export PRECISION_MODE=$LONG_PRECISION_MODE RUN_PROFILE=$RUN_PROFILE
export FIRST_LAST_BF16=$LONG_FIRST_LAST_BF16
export BF16_LAYERS_AT_START=$LONG_BF16_LAYERS_AT_START
export BF16_LAYERS_AT_END=$LONG_BF16_LAYERS_AT_END
export FILTER_GROUPS=$LONG_FILTER_GROUPS
export MAX_GEN_BATCHES=$LONG_MAX_GEN_BATCHES
export GEN_PROMPT_BSZ_MULT=$LONG_GEN_PROMPT_BSZ_MULT
export ROLLOUT_IS=$LONG_ROLLOUT_IS
export PROJECT_NAME=$RN4PT_PROJECT EXP_NAME=$EXP_NAME
export WANDB_ENTITY=shawnzzz WANDB_PROJECT=$RN4PT_PROJECT
export WANDB_RUN_ID=$EXP_NAME WANDB_RESUME=allow
export VERL_WANDB_RUN_ID=$EXP_NAME VERL_WANDB_RESUME=allow
export CKPTS_DIR=$CKPT_DIR TOTAL_TRAINING_STEPS=$TARGET_STEP RESUME_MODE=$RESUME_MODE
cd $RN4PT_VERL
[[ -f /root/.netrc && ! -L /root/.netrc ]]
ray start --address=$ip_head --num-cpus=0 --num-gpus=0
RAY_ADDRESS=$ip_head ray status
export RAY_ADDRESS=http://127.0.0.1:$dashboard_port
echo "REAL_NVFP4_V25_BEGIN arm=$ARM phase=$PHASE chunk=$CHUNK_INDEX target_step=$TARGET_STEP resume=$RESUME_MODE exp=$EXP_NAME"
stdbuf -oL -eL bash examples/real_nvfp4/run_qwen3_30b_megatron.sh 2>&1 | tee -a $JOB_LOG
DRIVER_EOF

set +e
srun --overlap --nodes=1 --ntasks=1 -w "$head_node" \
  --container-image="$RN4PT_RUNTIME_IMAGE" --container-mounts="$RN4PT_MOUNTS" \
  bash -lc "$DRIVER"
readonly DRIVER_STEP_STATUS=$?
set -e

# ------------------------------------------------------------------- gates
# Shared contract: both arms must be R3 on, token TIS, 0/3 losses, CUDA graph on.
grep -q "VERL_REAL_NVFP4_CONTRACT profile=$RUN_PROFILE precision=$LONG_PRECISION_MODE .*reload=native r3=1 losses=0of3 bf16_layers=${LONG_BF16_LAYERS_AT_START}/${LONG_BF16_LAYERS_AT_END} token_mean=1 tis=$LONG_ROLLOUT_IS " "$JOB_LOG"
grep -q "'max_num_seqs': 128" "$JOB_LOG"
grep -q '"cudagraph_mode": "FULL_DECODE_ONLY"' "$JOB_LOG"
grep -q 'VERL_R3_MONOLITHIC_CAPTURE_PATCH PASS' "$JOB_LOG"
grep -q 'routing replay layers: 48' "$JOB_LOG"
# Dynamic sampling and TIS have to be visible in the resolved config, not just
# in the launcher's environment.
grep -q "'filter_groups': {'enable': True" "$JOB_LOG" || \
  grep -q "'enable': True, 'metric': 'acc'" "$JOB_LOG" || rn4pt_die "dynamic sampling is not enabled in the resolved config"
grep -q "'rollout_is': 'token'" "$JOB_LOG" || rn4pt_die "token-level TIS is not enabled in the resolved config"

if [[ "$ARM" = w4a4 ]]; then
  grep -q 'VERL_REAL_NVFP4_PRECISION_RECIPE PASS scope=all_mlp attention=bf16' "$JOB_LOG"
  # The whole point of this arm: 6 of 48 decoder layers stay BF16, so only 42
  # MoE layers carry NVFP4 MLP GEMMs. This is the independent confirmation that
  # the carve-out actually reached Megatron.
  grep -q "VERL_REAL_NVFP4_ATTESTATION PASS.*te_version=$RN4PT_TE_VERSION.*mlp_fc1_nvfp4=$LONG_NVFP4_MLP_LAYERS mlp_fc2_nvfp4=$LONG_NVFP4_MLP_LAYERS" "$JOB_LOG"
  grep -q 'VERL_REAL_NVFP4_ROLLOUT_ATTESTATION PASS dense_layers=0 moe_layers=48 expected=48' "$JOB_LOG"
  grep -q 'VERL_REAL_NVFP4_EXPORT PASS location=vllm_receive.*expert_weights=18432 expected=18432' "$JOB_LOG"
  grep -q 'VERL_REAL_NVFP4_NATIVE_REFIT PASS refit=0 changed=1' "$JOB_LOG"
  grep -q 'VERL_REAL_NVFP4_SYNC PASS transport=bf16 quantization=vllm_native_online reload=native' "$JOB_LOG"
else
  # A "bf16" baseline that silently keeps a quantized rollout has bitten this
  # workspace before, so fail closed if any NVFP4 attestation fires at all.
  if grep -q 'VERL_REAL_NVFP4_ATTESTATION PASS\|VERL_REAL_NVFP4_ROLLOUT_ATTESTATION PASS' "$JOB_LOG"; then
    rn4pt_die "BF16 arm reported an NVFP4 attestation"
  fi
  grep -q 'VERL_VLLM_NATIVE_RELOAD PASS reload=native' "$JOB_LOG"
fi

grep -q 'Training Progress: 100%' "$JOB_LOG"
grep -q 'Final validation metrics:' "$JOB_LOG"
grep -Eq "step:$TARGET_STEP([^0-9]|$).*actor/loss:" "$JOB_LOG" || rn4pt_die "final post-update metric is missing"
if grep -E 'step:[0-9]+.*actor/loss:' "$JOB_LOG" | \
  grep -Eiq 'actor/(loss|pg_loss|grad_norm):[[:space:]]*(nan|[-+]?inf)|rollout_corr/rollout_log_ppl:[[:space:]]*(nan|[-+]?inf)|training/rollout_probs_diff_(mean|max):[[:space:]]*(nan|[-+]?inf)'; then
  rn4pt_die "non-finite rollout/training metric"
fi

# The rollout has to actually agree with the trainer. Three earlier BF16 smokes
# were called "passing" on structural gates alone while the rollout was random
# (entropy 6.1, rollout KL 13.9), so gate on the numbers too.
readonly LAST_METRICS=$(grep -E 'step:[0-9]+.*rollout_corr/kl:' "$JOB_LOG" | tail -1)
[[ -n "$LAST_METRICS" ]] || rn4pt_die "no rollout correlation metrics were logged"
python3 - "$LAST_METRICS" <<'PYEOF'
import re
import sys

line = sys.argv[1]
def metric(name, default=None):
    match = re.search(rf"{re.escape(name)}:(-?[0-9.eE+]+)", line)
    if match is None:
        if default is not None:
            return default
        raise SystemExit(f"REAL_NVFP4_PERTOKEN_REFUSED: {name} missing from {line!r}")
    return float(match.group(1))

kl = metric("rollout_corr/kl")
entropy = metric("actor/entropy")
# A healthy rollout on this recipe sits at kl ~0.004-0.01 and entropy ~0.9.
# A desynced one sits at kl ~14 and entropy ~6, so these bounds are loose.
if kl > 0.5:
    raise SystemExit(f"REAL_NVFP4_PERTOKEN_REFUSED: rollout_corr/kl={kl} indicates a desynced rollout")
if entropy > 3.0:
    raise SystemExit(f"REAL_NVFP4_PERTOKEN_REFUSED: actor/entropy={entropy} indicates a desynced rollout")
print(f"REAL_NVFP4_V25_NUMERIC_PASS rollout_corr/kl={kl} actor/entropy={entropy}")
PYEOF

if [[ "$PHASE" = long ]]; then
  readonly FINAL_CHECKPOINT=$CKPT_DIR/global_step_$TARGET_STEP/actor
  [[ -s "$FINAL_CHECKPOINT/ckpt_contents.json" ]] || rn4pt_die "completed checkpoint manifest is missing"
  grep -q '"optimizer"' "$FINAL_CHECKPOINT/ckpt_contents.json" || rn4pt_die "checkpoint lacks full optimizer state"
  [[ -d "$FINAL_CHECKPOINT/optimizer/dist_ckpt" ]] || rn4pt_die "full-Adam optimizer checkpoint directory is missing"
  [[ "$(find "$FINAL_CHECKPOINT/optimizer/dist_ckpt" -type f -size +1G | wc -l)" = 32 ]] || \
    rn4pt_die "full-Adam optimizer checkpoint must contain 32 large rank shards"
  echo "REAL_NVFP4_V25_FULL_ADAM_PASS chunk=$CHUNK_INDEX target_step=$TARGET_STEP path=$FINAL_CHECKPOINT"
fi

if (( DRIVER_STEP_STATUS != 0 )); then
  echo "REAL_NVFP4_DRIVER_CLEANUP_SIGNAL_ACCEPTED status=$DRIVER_STEP_STATUS reason=all_gates_passed"
fi
printf 'arm=%s\nphase=%s\nchunk=%s\ntarget_step=%s\njob_id=%s\n' \
  "$ARM" "$PHASE" "$CHUNK_INDEX" "$TARGET_STEP" "$SLURM_JOB_ID" >"$CHUNK_PASS"
echo "REAL_NVFP4_V25_PASS arm=$ARM phase=$PHASE chunk=$CHUNK_INDEX target_step=$TARGET_STEP exp=$EXP_NAME log=$JOB_LOG"
