#!/usr/bin/env bash
#SBATCH --account=general_sa
#SBATCH --partition=36x2-a01r,tcpo,batch
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --job-name=verl-rn4pt-long-v9

set -euo pipefail
export RN4PT_SKIP_UV_LOCK_CHECK=1
# shellcheck disable=SC1091
source "${LONG_MANIFEST_OVERRIDE:-/lustre/fsw/general_sa/shuazhang/python_space/verl_for_nvfp4_20251031/verl_nvfp4_e2e_r3_20260831_v3/examples/real_nvfp4/jobs/r3_nativeonline_long_20260901_v13/manifest.sh}"
long_validate_static
rn4pt_require_runtime_image

readonly CHUNK_INDEX=${LONG_CHUNK_INDEX:?LONG_CHUNK_INDEX is required}
readonly TARGET_STEP=${LONG_TARGET_STEP:?LONG_TARGET_STEP is required}
# Must stay in sync with submit.sh. Shrinking chunks because step time tracks
# response length; every target is a save_freq multiple so the chunk's final
# full-Adam checkpoint is written on the regular cadence.
readonly -a TARGET_STEPS=(0 80 150 210 260)
[[ "$CHUNK_INDEX" =~ ^[1-4]$ ]] || long_die "chunk index must be 1..4"
[[ "$TARGET_STEP" = "${TARGET_STEPS[$CHUNK_INDEX]}" ]] || \
  long_die "chunk $CHUNK_INDEX must target step ${TARGET_STEPS[$CHUNK_INDEX]}"
[[ "${SLURM_JOB_NUM_NODES:?}" = 8 ]] || long_die "formal long run requires 8 nodes"

readonly CKPT_DIR=$LONG_CHECKPOINTS/$LONG_EXP
readonly CHUNK_PASS=$LONG_STATE/chunk_${CHUNK_INDEX}.pass
if (( CHUNK_INDEX == 1 )); then
  [[ ! -e "$CKPT_DIR" ]] || long_die "fresh checkpoint collision: $CKPT_DIR"
  readonly RESUME_MODE=disable
else
  readonly PREVIOUS_CHUNK=$((CHUNK_INDEX - 1))
  readonly PREVIOUS_TARGET=${TARGET_STEPS[$PREVIOUS_CHUNK]}
  readonly PREVIOUS_PASS=$LONG_STATE/chunk_${PREVIOUS_CHUNK}.pass
  [[ -s "$PREVIOUS_PASS" ]] || long_die "previous chunk PASS is missing: $PREVIOUS_PASS"
  grep -Fxq "target_step=$PREVIOUS_TARGET" "$PREVIOUS_PASS" || \
    long_die "previous chunk target does not match"
  [[ -s "$CKPT_DIR/global_step_$PREVIOUS_TARGET/actor/ckpt_contents.json" ]] || \
    long_die "previous full-Adam checkpoint is missing"
  readonly RESUME_MODE=auto
fi
[[ ! -e "$CHUNK_PASS" ]] || long_die "chunk PASS collision: $CHUNK_PASS"

mkdir -p "$LONG_STATE" "$LONG_LOGS"
readonly JOB_LOG=$LONG_LOGS/${LONG_EXP}_chunk${CHUNK_INDEX}_${SLURM_JOB_ID:?}.log

nodes=$(scontrol show hostnames "$SLURM_JOB_NODELIST")
readarray -t nodes_array <<<"$nodes"
readonly head_node=${nodes_array[0]}
readonly head_port=$((19000 + SLURM_JOB_ID % 10000))
readonly dashboard_port=$((29000 + SLURM_JOB_ID % 10000))
readonly ip_head=$head_node:$head_port
readonly COMMON_ENV="export PATH=$RN4PT_IMAGE_ENV/.venv/bin:\$PATH; export PYTHONPATH=$RN4PT_VERL:\${PYTHONPATH:-}; export RAY_RUNTIME_ENV_TEMPORARY_REFERENCE_EXPIRATION_S=3600"

ray_pids=()
cleanup_ray_steps() {
  local pid
  for pid in "${ray_pids[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
}
trap cleanup_ray_steps EXIT

srun --overlap --nodes=1 --ntasks=1 -w "$head_node" \
  --container-image="$RN4PT_RUNTIME_IMAGE" --container-mounts="$RN4PT_MOUNTS" \
  bash -lc "$COMMON_ENV; ray start --head --node-ip-address=$head_node --port=$head_port --dashboard-port=$dashboard_port --dashboard-host=0.0.0.0 --block" &
ray_pids+=("$!")

for ((index=1; index<8; index++)); do
  node=${nodes_array[$index]}
  srun --overlap --nodes=1 --ntasks=1 -w "$node" \
    --container-image="$RN4PT_RUNTIME_IMAGE" --container-mounts="$RN4PT_MOUNTS" \
    bash -lc "$COMMON_ENV; ray start --address=$ip_head --block" &
  ray_pids+=("$!")
done

sleep 15

read -r -d '' DRIVER <<DRIVER_EOF || true
set -euo pipefail
$COMMON_ENV
export WORKING_DIR=$RN4PT_VERL
export RUNTIME_ENV=$RN4PT_ROOT/runtime_env.yaml
export NNODES=8 N_GPUS_PER_NODE=4
export PRECISION_MODE=real_nvfp4 RUN_PROFILE=formal
export PROJECT_NAME=$RN4PT_PROJECT EXP_NAME=$LONG_EXP
export WANDB_ENTITY=shawnzzz WANDB_PROJECT=$RN4PT_PROJECT
export WANDB_RUN_ID=$LONG_EXP WANDB_RESUME=allow
export VERL_WANDB_RUN_ID=$LONG_EXP VERL_WANDB_RESUME=allow
export CKPTS_DIR=$CKPT_DIR TOTAL_TRAINING_STEPS=$TARGET_STEP RESUME_MODE=$RESUME_MODE
cd $RN4PT_VERL
[[ -f /root/.netrc && ! -L /root/.netrc ]]
ray start --address=$ip_head --num-cpus=0 --num-gpus=0
RAY_ADDRESS=$ip_head ray status
export RAY_ADDRESS=http://127.0.0.1:$dashboard_port
echo "REAL_NVFP4_LONG_BEGIN chunk=$CHUNK_INDEX target_step=$TARGET_STEP resume=$RESUME_MODE exp=$LONG_EXP"
stdbuf -oL -eL bash examples/real_nvfp4/run_qwen3_30b_megatron.sh 2>&1 | tee -a $JOB_LOG
DRIVER_EOF

set +e
srun --overlap --nodes=1 --ntasks=1 -w "$head_node" \
  --container-image="$RN4PT_RUNTIME_IMAGE" --container-mounts="$RN4PT_MOUNTS" \
  bash -lc "$DRIVER"
readonly DRIVER_STEP_STATUS=$?
set -e

grep -q 'VERL_REAL_NVFP4_CONTRACT profile=formal precision=real_nvfp4.*rollout_activation=per_token.*reload=native r3=1 losses=0of3.*max_num_seqs=128 full_adam=1' "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_PRECISION_RECIPE PASS scope=all_mlp attention=bf16' "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_ATTESTATION PASS.*scope=all_mlp attention=bf16.*te_version=2.18.0+e7c550c5.*mlp_fc1_nvfp4=48 mlp_fc2_nvfp4=48' "$JOB_LOG"
grep -q '"cudagraph_mode": "FULL_DECODE_ONLY"' "$JOB_LOG"
grep -q "'flashinfer_trtllm'" "$JOB_LOG"
grep -q 'Capturing CUDA graphs (decode, FULL): 100%' "$JOB_LOG"
grep -q "'max_num_seqs': 128" "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_ROLLOUT_ATTESTATION PASS dense_layers=0 moe_layers=48 expected=48' "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_EXPORT PASS location=vllm_receive.*expert_weights=18432 expected=18432' "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_NATIVE_REFIT PASS refit=0 changed=1' "$JOB_LOG"
grep -Eq 'VERL_REAL_NVFP4_NATIVE_REFIT PASS refit=1 changed=[01]' "$JOB_LOG"
grep -q 'VERL_REAL_NVFP4_SYNC PASS transport=bf16 quantization=vllm_native_online reload=native' "$JOB_LOG"
grep -q 'VERL_R3_MONOLITHIC_CAPTURE_PATCH PASS' "$JOB_LOG"
grep -q 'routing replay layers: 48' "$JOB_LOG"
grep -q 'Training Progress: 100%' "$JOB_LOG"
grep -q 'Final validation metrics:' "$JOB_LOG"
grep -Eq "step:$TARGET_STEP([^0-9]|$).*actor/loss:" "$JOB_LOG" || \
  long_die "final post-update metric is missing"
if grep -E 'step:[0-9]+.*actor/loss:' "$JOB_LOG" | \
  grep -Eiq 'actor/(loss|pg_loss|grad_norm):[[:space:]]*(nan|[-+]?inf)|rollout_corr/rollout_log_ppl:[[:space:]]*(nan|[-+]?inf)|training/rollout_probs_diff_(mean|max):[[:space:]]*(nan|[-+]?inf)'; then
  long_die "non-finite rollout/training metric"
fi

readonly FINAL_CHECKPOINT=$CKPT_DIR/global_step_$TARGET_STEP/actor
readonly CHECKPOINT_MANIFEST=$FINAL_CHECKPOINT/ckpt_contents.json
readonly OPTIMIZER_CHECKPOINT=$FINAL_CHECKPOINT/optimizer/dist_ckpt
[[ -s "$CHECKPOINT_MANIFEST" ]] || long_die "completed checkpoint manifest is missing"
grep -q '"optimizer"' "$CHECKPOINT_MANIFEST" || long_die "checkpoint lacks full optimizer state"
[[ -d "$OPTIMIZER_CHECKPOINT" ]] || long_die "full-Adam optimizer checkpoint directory is missing"
[[ "$(find "$OPTIMIZER_CHECKPOINT" -type f -size +1G | wc -l)" = 32 ]] || \
  long_die "full-Adam optimizer checkpoint must contain 32 large rank shards"
echo "REAL_NVFP4_LONG_FULL_ADAM_PASS chunk=$CHUNK_INDEX target_step=$TARGET_STEP path=$FINAL_CHECKPOINT"

if (( DRIVER_STEP_STATUS != 0 )); then
  echo "REAL_NVFP4_DRIVER_CLEANUP_SIGNAL_ACCEPTED status=$DRIVER_STEP_STATUS reason=all_long_run_gates_passed"
fi
printf 'chunk=%s\ntarget_step=%s\njob_id=%s\ncheckpoint=%s\n' \
  "$CHUNK_INDEX" "$TARGET_STEP" "$SLURM_JOB_ID" "$FINAL_CHECKPOINT" >"$CHUNK_PASS"
echo "REAL_NVFP4_LONG_PASS chunk=$CHUNK_INDEX target_step=$TARGET_STEP exp=$LONG_EXP log=$JOB_LOG"
