msgid ""
"MindSpeed和Megatron及相关依赖的源码安装指令：\n"
""
msgstr ""
"Instructions for installing MindSpeed, Megatron, and related dependencies from source:\n"
""

msgid ""
"    # 配置环境变量\n"
"    export PYTHONPATH=$PYTHONPATH:your_path/Megatron-LM\n"
"    export PYTHONPATH=$PYTHONPATH:your_path/MindSpeed\n"
""
msgstr ""
"    # Configure environment variables\n"
"    export PYTHONPATH=$PYTHONPATH:your_path/Megatron-LM\n"
"    export PYTHONPATH=$PYTHONPATH:your_path/MindSpeed\n"
""

msgid ""
"    # 安装 mbridge\n"
"    pip install mbridge\n"
""
msgstr ""
"    # Install mbridge\n"
"    pip install mbridge\n"
""

