+def _prenorm_gemm_tiles(num_tokens: int) -> tuple[int, int]:
+    """(tile_n, block_m) for the 512-thread prenorm GEMM, tuned on MI355X;
+    the numerics do not depend on either."""
+    if num_tokens <= 32:
+        return 1, 1
+    if num_tokens <= 64:
+        return 2, 1
+    if num_tokens <= 128:
+        return 4, 1
+    if num_tokens <= 256:
+        return 3, 2
+    if num_tokens <= 512:
+        return 6, 2
+    return 12, 2
+
+
+def _pre_big_fuse_h_split(num_tokens: int) -> int:
+    """Hidden-dim blocks per token for the big_fuse kernel, tuned on MI355X;
+    the numerics do not depend on it. (16 splits leave each thread too few
+    elements and are not bitwise equal; do not use.)"""
+    if num_tokens <= 512:
+        return 8
+    if num_tokens <= 2048:
+        return 4
+    return 2
+
+
+def _post_hsplit_cfg(num_tokens: int) -> tuple[int, int] | None:
+    """(threads, hidden chunk) per block for mhc_post, tuned on MI355X, or
+    None for the one-block-per-token kernel. The numerics do not depend on
+    it as long as each thread holds >= 16 elements (fewer is not bitwise
+    equal on ROCm)."""
+    if num_tokens <= 64:
+        return 64, 256
+    if num_tokens <= 256:
+        return 128, 512
+    if num_tokens <= 2048:
+        return 64, 256
+    return None
+
