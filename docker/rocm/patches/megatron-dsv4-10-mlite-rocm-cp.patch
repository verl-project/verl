+@dataclass(frozen=True)
+class CPRequestSlices:
+    """One contiguous-CP rank's view of the packed requests (ROCm impl=vllm).
+
+    The packed THD buffer (each request padded to ``2 * cp``) is split
+    contiguously; this rank owns global rows ``[local_start, local_start +
+    local_rows)``.  ``requests`` are the requests with at least one *real* row
+    there.  For each: its real ``lengths``, global ``padded_starts``, and the
+    owned positions ``[query_starts, query_stops)``.  ``boundaries`` packs the
+    selected requests' real rows back to back -- the CP=1 layout of exactly
+    those requests -- which is where the key side (SWA rows, compressors,
+    indexer keys) is evaluated.
+    """
+
+    local_start: int
+    local_rows: int
+    requests: tuple[int, ...]
+    lengths: tuple[int, ...]
+    padded_starts: tuple[int, ...]
+    query_starts: tuple[int, ...]
+    query_stops: tuple[int, ...]
+    boundaries: tuple[int, ...]
+
+
+def cp_request_slices(
+    seq_lens: tuple[int, ...],
+    sequence_boundaries: tuple[int, ...],
+    *,
+    cp_rank: int,
+    cp_size: int,
+) -> CPRequestSlices:
+    """Map this rank's contiguous CP rows to request-local query chunks."""
+    if cp_size < 1 or not 0 <= cp_rank < cp_size:
+        raise ValueError("cp_rank must lie in [0, cp_size)")
+    if len(sequence_boundaries) != len(seq_lens) + 1 or sequence_boundaries[0] != 0:
+        raise ValueError("sequence boundaries do not match the request count")
+    total = sequence_boundaries[-1]
+    if total % cp_size:
+        raise ValueError("padded token count must be divisible by cp_size")
+    local_rows = total // cp_size
+    local_start = cp_rank * local_rows
+    local_stop = local_start + local_rows
+    requests, lengths, starts, q_starts, q_stops, bounds = [], [], [], [], [], [0]
+    for index, length in enumerate(seq_lens):
+        start, stop = sequence_boundaries[index], sequence_boundaries[index + 1]
+        if length <= 0 or start + length > stop:
+            raise ValueError("real request length exceeds its padded slot")
+        owned_start = max(local_start, start)
+        owned_stop = min(local_stop, start + length)
+        if owned_stop <= owned_start:
+            continue
+        requests.append(index)
+        lengths.append(length)
+        starts.append(start)
+        q_starts.append(owned_start - start)
+        q_stops.append(owned_stop - start)
+        bounds.append(bounds[-1] + length)
+    return CPRequestSlices(
+        local_start=local_start,
+        local_rows=local_rows,
+        requests=tuple(requests),
+        lengths=tuple(lengths),
+        padded_starts=tuple(starts),
+        query_starts=tuple(q_starts),
+        query_stops=tuple(q_stops),
+        boundaries=tuple(bounds),
+    )
