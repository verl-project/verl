+    rank0 = cp_request_slices(seq_lens, bounds, cp_rank=0, cp_size=2)
+    assert (rank0.local_start, rank0.local_rows) == (0, 8)
+    assert rank0.requests == (0,)
+    assert (rank0.query_starts, rank0.query_stops) == ((0,), (8,))
+    assert rank0.boundaries == (0, 10)
+    rank1 = cp_request_slices(seq_lens, bounds, cp_rank=1, cp_size=2)
+    assert rank1.local_start == 8
+    assert rank1.requests == (0, 1)
+    assert rank1.padded_starts == (0, 12)
+    assert (rank1.query_starts, rank1.query_stops) == ((8, 0), (10, 3))
+    assert rank1.boundaries == (0, 10, 13)
