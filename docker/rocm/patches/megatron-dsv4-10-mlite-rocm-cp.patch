+@dataclass(frozen=True)
+class ROCmCPLayout:
+    """Host request chunks of one CP rank plus their device row maps.
+
+    ``gather_index`` selects, from the CP all-gather of the padded packed rows,
+    the real rows of ``slices.requests`` back to back; ``cu_seqlens`` are that
+    buffer's request boundaries.  Built once per forward step.
+    """
+
+    slices: CPRequestSlices
+    gather_index: torch.Tensor
+    cu_seqlens: torch.Tensor
+
+
+def build_rocm_cp_layout(
+    seq_lens: tuple[int, ...],
+    sequence_boundaries: tuple[int, ...],
+    *,
+    cp_rank: int,
+    cp_size: int,
+    device: torch.device,
+) -> ROCmCPLayout:
+    from megatron.lite.model.deepseek_v4.vllm.primitive.attention.host_geometry import (
+        cp_request_slices,
+    )
+
+    slices = cp_request_slices(
+        seq_lens, sequence_boundaries, cp_rank=cp_rank, cp_size=cp_size
+    )
+    rows = [
+        index
+        for start, length in zip(slices.padded_starts, slices.lengths)
+        for index in range(start, start + length)
+    ]
+    return ROCmCPLayout(
+        slices=slices,
+        gather_index=torch.tensor(rows, dtype=torch.int64).to(device),
+        cu_seqlens=torch.tensor(slices.boundaries, dtype=torch.int32).to(device),
+    )
+
+
+class _CPAllGatherRows(torch.autograd.Function):
+    """All-gather CP-local rows; the VJP reduce-scatters in FP32.
+
+    Rank partials of a row's gradient (one per CP rank whose queries read it)
+    are added in FP32 and rounded once to the input dtype.
+    """
+
+    @staticmethod
+    def forward(ctx, value: torch.Tensor, group) -> torch.Tensor:
+        import torch.distributed as dist
+
+        ctx.group = group
+        size = dist.get_world_size(group)
+        output = value.new_empty((size * value.shape[0], *value.shape[1:]))
+        dist.all_gather_into_tensor(output, value.contiguous(), group=group)
+        return output
+
+    @staticmethod
+    def backward(ctx, grad_output: torch.Tensor):
+        import torch.distributed as dist
+
+        size = dist.get_world_size(ctx.group)
+        grad = grad_output.float().contiguous()
+        output = grad.new_empty((grad.shape[0] // size, *grad.shape[1:]))
+        dist.reduce_scatter_tensor(output, grad, group=ctx.group)
+        return output.to(grad_output.dtype), None
+
+
+def cp_gather_request_rows(
+    local_rows: torch.Tensor, layout: ROCmCPLayout, *, cp_group
+) -> torch.Tensor:
+    """The real rows of this rank's requests, gathered across CP (CP=1 layout)."""
+    gathered = _CPAllGatherRows.apply(local_rows, cp_group)
+    return gathered.index_select(0, layout.gather_index)
 
 
