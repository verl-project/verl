+def test_cp_request_slices_skip_padding_only_intersections() -> None:
+    # (5,) at CP4 pads to 8: rank 3 owns padded rows 6, 7 only.
+    bounds = padded_sequence_boundaries((5,), cp_size=4)
+    owned = [
+        cp_request_slices((5,), bounds, cp_rank=rank, cp_size=4) for rank in range(4)
+    ]
+    assert [s.requests for s in owned] == [(0,), (0,), (0,), ()]
+    assert [(s.query_starts, s.query_stops) for s in owned[:3]] == [
+        ((0,), (2,)),
+        ((2,), (4,)),
+        ((4,), (5,)),
+    ]
+    assert owned[3].boundaries == (0,)
+    # Every real position is owned exactly once.
+    positions = [
+        p
+        for s in owned
+        for start, stop in zip(s.query_starts, s.query_stops)
+        for p in range(start, stop)
+    ]
+    assert positions == list(range(5))
