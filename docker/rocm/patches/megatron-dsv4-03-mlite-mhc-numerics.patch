+def test_mhc_pre_vjp_is_fp32_and_uses_the_forward_rms(broadcast, magnitude) -> None:
+    # BF16 residual at embedding scale: a BF16 recomputation or the
+    # 1 / (|x| / sqrt(n) + eps) scaling misses this FP64 reference by >1e-2.
+    torch.manual_seed(5)
+    mult, hidden, eps, rms_eps, iters = 4, 256, 1e-6, 1e-6, 20
+    mix = (2 + mult) * mult
+    shape = (33, hidden) if broadcast else (33, mult, hidden)
+    inputs = (
+        (torch.randn(shape) * magnitude).to(torch.bfloat16).requires_grad_(True),
+        (torch.randn(mix, mult * hidden) * 0.05).requires_grad_(True),
+        torch.rand(3).requires_grad_(True),
+        (torch.randn(mix) * 0.1).requires_grad_(True),
+        (1 + 0.1 * torch.randn(hidden)).to(torch.bfloat16).requires_grad_(True),
+    )
+    refs = tuple(value.detach().double().requires_grad_(True) for value in inputs)
+    reference = _mhc_pre_float64(
+        *refs, mult=mult, iters=iters, eps=eps, rms_eps=rms_eps
+    )
+
+    def visible(*values):
+        with torch.no_grad():
+            out = _mhc_pre_float64(
+                *(value.double() for value in values),
+                mult=mult, iters=iters, eps=eps, rms_eps=rms_eps,
+            )
+        return (
+            out[0].to(values[0].dtype),
+            out[1].float(),
+            out[2].float(),
+            out[3].to(torch.bfloat16),
+        )
+
+    outputs = mhc_pre_broadcast(
+        visible, *inputs, mult=mult, iters=iters, eps=eps, norm_eps=eps, rms_eps=rms_eps
+    )
+    grads = tuple(torch.randn(value.shape).to(value.dtype) for value in outputs)
+    torch.autograd.backward(outputs, grads)
+    torch.autograd.backward(reference, tuple(grad.double() for grad in grads))
+    # x and the norm weight carry one BF16 rounding; fn / scale / base are FP32.
+    for actual, expected, tolerance in zip(
+        inputs, refs, (3e-3, 2e-4, 2e-4, 2e-4, 3e-3), strict=True
+    ):
+        error = (actual.grad.double() - expected.grad).norm() / expected.grad.norm()
+        assert error < tolerance, (actual.shape, float(error))
