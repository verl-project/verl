+def _mhc_pre_float64(x, fn, scale, base, norm_weight, *, mult, iters, eps, rms_eps):
+    # vLLM's mhc_pre_torch (FP32 there, FP64 here) + the RMSNorm of the layer input.
+    residual = x.unsqueeze(-2).expand(*x.shape[:-1], mult, x.shape[-1]) if x.ndim == 2 else x
+    flat = residual.flatten(-2)
+    mixes = F.linear(flat, fn) * torch.rsqrt(flat.square().mean(-1, keepdim=True) + rms_eps)
+    pre_mix, post_mix, comb_mix = mixes.split([mult, mult, mult * mult], dim=-1)
+    base_pre, base_post, base_comb = base.split([mult, mult, mult * mult], dim=-1)
+    pre = torch.sigmoid(pre_mix * scale[0] + base_pre) + eps
+    post = 2 * torch.sigmoid(post_mix * scale[1] + base_post)
+    logits = (comb_mix * scale[2] + base_comb).view(*comb_mix.shape[:-1], mult, mult)
+    comb = torch.softmax(logits, dim=-1) + eps
+    comb = comb / (comb.sum(-2, keepdim=True) + eps)
+    for _ in range(iters - 1):
+        comb = comb / (comb.sum(-1, keepdim=True) + eps)
+        comb = comb / (comb.sum(-2, keepdim=True) + eps)
+    hidden = (pre.unsqueeze(-1) * residual).sum(-2)
+    normed = F.rms_norm(hidden, (hidden.shape[-1],), norm_weight, eps)
+    return residual, post.unsqueeze(-1), comb, normed
+
