+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+"""Lite's DeepSeek-V4 HyperConnection follows vLLM's mHC numerics.
+
+The rollout's mHC is vLLM's ``mhc_pre`` / ``mhc_post``; the Lite (native) trainer must compute the same function:
+FP32 mixes, separate RMS / pre / Sinkhorn epsilons, ``post_mult`` = 2.0, and the comb applied so that stream ``j``
+receives ``sum_i comb[i, j] * residual_i``.
+"""
+import pytest
+import torch
+
+from megatron.lite.primitive.modules.attention.hca import HyperConnection, mhc_post
+
+HIDDEN, HC, ITERS = 256, 4, 20
+RMS_EPS, HC_EPS = 1e-6, 1e-6
+
+
+def _module(rms_eps=RMS_EPS):
+    torch.manual_seed(0)
+    module = HyperConnection(HIDDEN, HC, ITERS, HC_EPS, rms_eps=rms_eps)
+    with torch.no_grad():
+        for param in module.parameters():
+            param.copy_(torch.randn_like(param) * 0.02)
+    return module
+
+
+def test_post_mixes_streams_by_comb_columns():
+    torch.manual_seed(1)
+    x = torch.randn(5, 1, HIDDEN, dtype=torch.bfloat16)
+    residual = torch.randn(5, 1, HC, HIDDEN, dtype=torch.bfloat16)
+    post = torch.rand(5, 1, HC)
+    comb = torch.rand(5, 1, HC, HC)
+    out = HyperConnection.post(x, residual, post, comb)
+    expected = torch.stack(
+        [
+            sum(comb[..., i, j, None] * residual[..., i, :].float() for i in range(HC))
+            + post[..., j, None] * x.float()
+            for j in range(HC)
+        ],
+        dim=-2,
+    ).to(residual.dtype)
+    assert torch.equal(out, expected)
+
+
+def test_rms_eps_is_separate_from_hc_eps():
+    x = torch.randn(3, 1, HC, HIDDEN, dtype=torch.bfloat16) * 1e-4
+    a, _, _ = _module(rms_eps=1e-6)(x)
+    b, _, _ = _module(rms_eps=1e-2)(x)
+    assert not torch.equal(a, b)
+
+
+def test_matches_vllm_torch_reference_bitwise():
+    vllm_mhc = pytest.importorskip("vllm.model_executor.kernels.mhc.torch")
+    module = _module()
+    x = torch.randn(37, 1, HC, HIDDEN, dtype=torch.bfloat16)
+    with torch.no_grad():
+        y, post, comb = module(x)
+        post_ref, comb_ref, y_ref = vllm_mhc.mhc_pre_torch(
+            x,
+            module.fn.float(),
+            module.scale.float(),
+            module.base.float(),
+            RMS_EPS,
+            HC_EPS,
+            HC_EPS,
+            2.0,
+            ITERS,
+        )
+        assert torch.equal(y, y_ref.to(y.dtype))
+        assert torch.equal(post, post_ref.squeeze(-1))
+        assert torch.equal(comb, comb_ref)
+        layer_out = torch.randn(37, 1, HIDDEN, dtype=torch.bfloat16)
+        assert torch.equal(
+            mhc_post(layer_out, x, post, comb),
+            vllm_mhc.mhc_post_torch(layer_out, x, post_ref, comb_ref),
+        )
+
+
+def test_is_differentiable_in_all_parameters():
+    module = _module()
+    x = torch.randn(7, 1, HC, HIDDEN, dtype=torch.bfloat16, requires_grad=True)
+    y, post, comb = module(x)
+    (y.float().sum() + post.sum() + comb.sum()).backward()
+    assert x.grad is not None
+    for param in module.parameters():
+        assert param.grad is not None and torch.isfinite(param.grad).all()
