+def _resolve_dsa_kernel_fusion(requested: bool | None) -> bool:
+    available = torch.version.hip is None
+    if requested is None:
+        return available
+    if requested and not available:
+        raise NotImplementedError(
+            "DeepSeek V4 fused DSA kernels are CUDA-only; set dsa_kernel_fusion=False "
+            "(or leave it unset) on ROCm."
+        )
+    return bool(requested)
+
+
+def _configure_dsa_kernel_fusion(chunks: list[nn.Module], *, enabled: bool) -> None:
+    for chunk in chunks:
+        for module in chunk.modules():
+            if hasattr(module, "apply_dsa_kernel_fusion"):
+                module.apply_dsa_kernel_fusion = enabled
+
+
+def post_optimizer_step(chunks: list[nn.Module]) -> None:
+    """After an update the masters no longer sit on the checkpoint's FP8 grid:
+    drop the bound source scales (the export then re-quantizes from the master)
+    and any cached deployment weights."""
+    from megatron.lite.primitive.ckpt.hf_weights import unwrap_model
+
+    for chunk in chunks:
+        chunk = unwrap_model(chunk)
+        invalidate_bound_source_scales(chunk)
+        for module in chunk.modules():
+            clear_cache = getattr(module, "clear_deployment_weight_cache", None)
+            if clear_cache is not None:
+                clear_cache()
+
