+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+"""DS4 impl=lite protocol: DSA kernel-fusion selection and the post-optimizer-step hook."""
+import pytest
+import torch
+import torch.nn as nn
+
+from megatron.lite.model.deepseek_v4.lite import protocol
+
+
+class _Attention(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.apply_dsa_kernel_fusion = True
+        self.weight = nn.Parameter(torch.zeros(2, 2))
+        self.cleared = 0
+
+    def clear_deployment_weight_cache(self):
+        self.cleared += 1
+
+
+class _Wrapper(nn.Module):  # DDP-style wrapper: the model is .module
+    def __init__(self, module):
+        super().__init__()
+        self.module = module
+
+
+def test_dsa_kernel_fusion_default_follows_platform(monkeypatch):
+    monkeypatch.setattr(torch.version, "hip", "7.2")
+    assert protocol._resolve_dsa_kernel_fusion(None) is False
+    with pytest.raises(NotImplementedError):
+        protocol._resolve_dsa_kernel_fusion(True)
+    monkeypatch.setattr(torch.version, "hip", None)
+    assert protocol._resolve_dsa_kernel_fusion(None) is True
+    assert protocol._resolve_dsa_kernel_fusion(False) is False
+
+
+def test_configure_dsa_kernel_fusion_reaches_every_csa_module():
+    model = nn.Sequential(_Attention(), nn.Sequential(_Attention()))
+    protocol._configure_dsa_kernel_fusion([model], enabled=False)
+    assert [m.apply_dsa_kernel_fusion for m in model.modules() if isinstance(m, _Attention)] == [
+        False,
+        False,
+    ]
+
+
+def test_post_optimizer_step_invalidates_source_scales_through_wrappers():
+    inner = nn.Sequential(_Attention())
+    inner._fp8_source_scales_valid = True
+    inner._fp8_source_scales_by_name = {"x": torch.ones(1)}
+    inner[0].weight._fp8_source_scales = torch.ones(1)
+    protocol.post_optimizer_step([_Wrapper(inner)])
+    assert inner._fp8_source_scales_valid is False
+    assert inner._fp8_source_scales_by_name == {}
+    assert not hasattr(inner[0].weight, "_fp8_source_scales")
+    assert inner[0].cleared == 1
