index 0000000000000000000000000000000000000000..ff8bd15c6e8c187d29a47a09d6a1d96667001c37
--- /dev/null
+++ b/experimental/lite/megatron/lite/primitive/kernels/k31_backend.py
@@ -0,0 +1,78 @@
+"""Which kernel set the K31 vLLM-visible model runs on.
+
+* ``vllm_cuda`` (the original design): forward values from the NVIDIA K31 rollout image's kernels and BI
+  overlays through the strict adapters of :mod:`vllm_k31` / :mod:`vllm_k31_moe` (sm_10x only).
+* ``rocm``: BI=0 trainer on AMD.  Same adapter names and call signatures, implemented in
+  :mod:`rocm_k31` with PyTorch / Triton (FLA) / the ROCm vLLM image's ops; no batch invariance, no
+  bit-equality claim with the rollout (old log-probs are recomputed by the trainer, TIS corrects the rest).
+
+Select with ``MLITE_K31_BACKEND`` (``vllm_cuda`` | ``rocm``); default ``rocm`` on a HIP build of torch,
+else ``vllm_cuda``.  Layer modules must take adapters from :func:`adapters`, never import them directly
+from ``vllm_k31``, so DSA / KDA / MoE pieces of either backend plug in the same way.
+"""
+
+from __future__ import annotations
+
+import functools
+import os
+import types
+
+import torch
+
+BACKENDS = ("vllm_cuda", "rocm")
+
+
+@functools.lru_cache(maxsize=1)
+def backend() -> str:
+    value = os.environ.get("MLITE_K31_BACKEND")
+    if value is None:
+        value = "rocm" if getattr(torch.version, "hip", None) else "vllm_cuda"
+    if value not in BACKENDS:
+        raise ValueError(f"MLITE_K31_BACKEND must be one of {BACKENDS}, got {value!r}")
+    return value
+
+
+def is_rocm() -> bool:
+    return backend() == "rocm"
+
+
+@functools.lru_cache(maxsize=1)
+def adapters() -> types.SimpleNamespace:
+    """The adapter classes of the active backend (one namespace, same attribute names)."""
+
+    from megatron.lite.primitive.kernels import vllm_k31 as V
+
+    names = (
+        "AttnResAdapter",
+        "BILinearAdapter",
+        "BIRouterAdapter",
+        "LoRALeafAdapter",
+        "PunicaLoRADeltaAdapter",
+        "RMSNormAdapter",
+        "SiTUAndMulAdapter",
+        "TemperatureAdapter",
+        "TokenLogprobAdapter",
+        # DSA (ROCm side in primitive/dsa_rocm.py)
+        "DSAAbsorbBmmAdapter",
+        "DSAFP8KVUpconvertAdapter",
+        "DSAIndexerAdapter",
+        "DSAMLAKVInsertAdapter",
+        "DSASparseMLAAdapter",
+        # KDA
+        "KDACausalConvAdapter",
+        "KDACFBIPrefillAdapter",
+        "KDAGatedNormAdapter",
+    )
+    if not is_rocm():
+        return types.SimpleNamespace(**{n: getattr(V, n) for n in names}, backend="vllm_cuda")
+    from megatron.lite.primitive.kernels import rocm_k31 as Rk
+
+    ns = {}
+    for n in names:
+        # ROCm implementations override; anything not ported keeps the CUDA adapter, which fails
+        # closed (NotImplementedError / sm_10x checks) when it is actually called.
+        ns[n] = getattr(Rk, n, None) or getattr(V, n)
+    return types.SimpleNamespace(**ns, backend="rocm")
+
+
+__all__ = ["BACKENDS", "adapters", "backend", "is_rocm"]
diff --git a/experimental/lite/megatron/lite/primitive/kernels/rocm_k31.py b/experimental/lite/megatron/lite/primitive/kernels/rocm_k31.py
new file mode 100644
index 0000000000000000000000000000000000000000..577611ab0009ba169e571569e5ba5b7fd861bcd7
--- /dev/null
+++ b/experimental/lite/megatron/lite/primitive/kernels/rocm_k31.py
@@ -0,0 +1,624 @@
+"""ROCm (AMD) BI=0 adapters for the K31 vLLM-visible model.
+
+Same class names and call signatures as :mod:`vllm_k31` (and the MoE helpers of
+:mod:`vllm_k31_moe`), so ``model.py`` / ``moe.py`` / ``kda.py`` switch implementation through
+:func:`megatron.lite.primitive.kernels.k31_backend.adapters` only.
+
+There is no batch invariance on this path: the rollout (the ROCm vLLM build with
+Kimi-K3.1 support, AITER kernels) and this forward agree to kernel rounding, not bitwise.  The verl recipe's
+``--bi 0`` arm accounts for it (old log-probs recomputed by the trainer, token TIS, R3 routing replay).
+
+Op choice (``MLITE_K31_ROCM_OPS``):
+
+* ``torch`` (default): PyTorch math in the precision the rollout uses at each boundary (BF16 GEMMs
+  with FP32 accumulate, FP32 norm / activation math, BF16 outputs);
+* ``vllm``: where the ROCm vLLM image registers the same op the rollout calls (``_C.situ_and_mul``,
+  ``_C.rms_norm``, the AMD ``attn_res`` kernel), call it; anything missing falls back to ``torch``.
+
+Adapters stay parameter-free and stateless, outputs go through ``_output_boundary`` like the CUDA
+adapters (the autograd owners in ``model/k31/vllm/primitive`` supply the backward).
+"""
+
+from __future__ import annotations
+
+import functools
+import importlib
+import os
+from typing import Any
+
+import torch
+import torch.nn.functional as F
+from torch import Tensor
+
+from megatron.lite.primitive.kernels.vllm_k31 import (
+    ATTN_RES_HIDDEN,
+    _Adapter,
+    _output_boundary,
+    _same_device,
+    _tensor,
+)
+
+
+def _ops_mode() -> str:
+    # under dense BI the rollout's own kernels are the contract (measured: torch attn_res / rms_norm differ by ~1e-5 rel)
+    mode = os.environ.get("MLITE_K31_ROCM_OPS", "vllm" if dense_bi() else "torch")
+    if mode not in ("torch", "vllm"):
+        raise ValueError(f"MLITE_K31_ROCM_OPS must be torch|vllm, got {mode!r}")
+    return mode
+
+
+@functools.lru_cache(maxsize=None)
+def _c_op(name: str):
+    """``torch.ops._C.<name>`` if the image's vLLM registered it (imports ``vllm._C``)."""
+
+    try:
+        importlib.import_module("vllm._C")
+    except ImportError:
+        return None
+    return getattr(torch.ops._C, name, None) if hasattr(torch.ops, "_C") else None
+
+
+# ---------------------------------------------------------------------------
+# dense linear / router / LoRA
+# ---------------------------------------------------------------------------
+def mm_f32out(a: Tensor, b: Tensor) -> Tensor:
+    """``a @ b`` with BF16 operands and an FP32 result (no intermediate BF16 rounding)."""
+
+    if a.is_cuda:
+        return torch.mm(a, b, out_dtype=torch.float32)
+    return torch.mm(a.float(), b.float())  # CPU (tests): same value up to accumulation order
+
+
+def _gemm_pad() -> int:
+    """``MLITE_K31_ROCM_GEMM_PAD``: pad the token rows of every BF16 linear to a multiple of this (0 = off).
+
+    Workaround for hipBLASLt ``HIPBLAS_STATUS_INTERNAL_ERROR`` on some odd-M shapes (torch then retries on the slower
+    hipBLAS path); GEMM rows are independent, so padding changes no value of
+    the real rows beyond the algorithm choice."""
+
+    return int(os.environ.get("MLITE_K31_ROCM_GEMM_PAD", "0"))
+
+
+def dense_bi() -> bool:
+    """Trainer forward == BI rollout for the dense GEMMs / LoRA / router / head (``VLLM_BATCH_INVARIANT=1``; opt out with
+    ``MLITE_K31_DENSE_BI=0``): call the same vLLM functions the rollout runs under BI on ROCm."""
+
+    return os.environ.get("VLLM_BATCH_INVARIANT", "0") not in ("", "0") and os.environ.get("MLITE_K31_DENSE_BI", "1") == "1"
+
+
+@functools.lru_cache(maxsize=None)
+def _bi_lib():
+    """vLLM's batch-invariant library with the rollout's tile/config state (``init_batch_invariance`` resolves the tuned
+    matmul configs and block sizes; the aten overrides themselves are NOT installed in the trainer process)."""
+
+    m = importlib.import_module("vllm.model_executor.determinism.batch_invariant")
+    for name in ("resolve_tuned_matmul_configs", "_resolve_block_sizes"):
+        fn = getattr(m, name, None)
+        if fn is not None:
+            fn()
+    return m
+
+
+@functools.lru_cache(maxsize=None)
+def _bi_lora_epilogue() -> str:
+    """Mirror the rollout's punica expand epilogue: the k31lora overlay (``k31lora.bi_lora.install``, K31_BI_LORA_F32ADD=1:
+    ``bf16(fp32(delta) + fp32(base))``) when the rollout runs it, else vLLM's default kernel."""
+
+    if os.environ.get("K31_BI_LORA_F32ADD", "0") != "1":
+        return "default"
+    try:
+        bi_lora = importlib.import_module("k31lora.bi_lora")
+    except ImportError as exc:
+        raise RuntimeError("K31_BI_LORA_F32ADD=1 needs the k31lora plugin on PYTHONPATH in the trainer") from exc
+    return bi_lora.install()
+
+
+def vtp_size() -> int:
+    """``MLITE_K31_BI_VTP=N`` (N > 1, dense BI only): the trainer reproduces a TP=N BI rollout's row-parallel layers --
+    per-rank K-sliced BI GEMMs (+ punica LoRA on the sliced A), reduced like ``all_reduce_batch_invariant`` (K31_BI_AR=1:
+    all-gather + fixed rank-order FP32 sum, one rounding).  Column-parallel / per-head / replicated layers are per-element
+    identical to TP1 and need nothing."""
+
+    n = int(os.environ.get("MLITE_K31_BI_VTP", "0") or 0)
+    return n if n > 1 and dense_bi() else 1
+
+
+def vtp_fixed_sum(partials: Tensor) -> Tensor:
+    """``all_reduce_batch_invariant`` on stacked per-rank partials ``[N, ...]`` (its ``_fixed_order_sum_kernel``)."""
+
+    lib = _bi_lib()
+    n = partials.shape[0]
+    gathered = partials.reshape(n, -1).contiguous()
+    numel = gathered.shape[1]
+    out = torch.empty(numel, dtype=partials.dtype, device=partials.device)
+    import triton
+
+    lib._fixed_order_sum_kernel[(triton.cdiv(numel, 1024),)](
+        gathered, out, numel, numel, WORLD_SIZE=n, BLOCK_SIZE=1024, LARGE=gathered.numel() > 2**31
+    )
+    return out.view(partials.shape[1:])
+
+
+def _vtp_slices(k: int, n: int):
+    if k % n:
+        raise ValueError(f"virtual TP={n} does not divide K={k}")
+    s = k // n
+    return [slice(r * s, (r + 1) * s) for r in range(n)]
+
+
+def vtp_row_partials(value: Tensor, weight: Tensor, n: int, lora=None) -> Tensor:
+    """Per-rank partial outputs ``[n, T, out]`` of a row-parallel linear (RowParallelLinear / RowParallelLinearWithLoRA
+    before its all-reduce): rank r = BI linear of the r-th K slice, plus (LoRA) the punica leaf with A sliced on its input."""
+
+    parts = []
+    for ks in _vtp_slices(value.shape[-1], n):
+        xr = value[:, ks].contiguous()
+        wr = weight[:, ks].contiguous()
+        if lora is None:
+            parts.append(rocm_linear(xr, wr))
+        else:
+            a_st, b_st, slices, meta = lora
+            a_r = tuple(a[..., ks].contiguous() for a in a_st)
+            parts.append(_punica_leaf(xr, wr, a_r, b_st, slices, meta))
+    return torch.stack(parts)
+
+
+def _punica_leaf(value, weight, lora_a_stacked, lora_b_stacked, output_slices, meta, specialize_active_lora=False):
+    """``PunicaWrapperGPU.add_lora_linear`` on the BI base output (rollout epilogue, see ``_bi_lora_epilogue``)."""
+
+    _bi_lora_epilogue()
+    from megatron.lite.primitive.kernels.vllm_k31 import _drop_punica_ptr_cache
+
+    lops = importlib.import_module("vllm.lora.ops.triton_ops")
+    y = rocm_linear(value, weight).contiguous()
+    tokens = value.shape[0]
+    rank = lora_b_stacked[0].size(-1)
+    buffer = torch.empty((len(output_slices), tokens, rank), dtype=torch.float32, device=value.device)
+    _drop_punica_ptr_cache(lora_a_stacked, lora_b_stacked)
+    try:
+        lops.lora_shrink(value, lora_a_stacked, buffer, *meta.meta_args(tokens, specialize_active_lora), 1.0)
+        lops.lora_expand(buffer, lora_b_stacked, y, *meta.meta_args(tokens, specialize_active_lora), offset_start=0,
+                         add_inputs=True)
+    finally:
+        _drop_punica_ptr_cache(lora_a_stacked, lora_b_stacked)
+    return y
+
+
+def rocm_linear(value: Tensor, weight: Tensor) -> Tensor:
+    """BF16 ``x @ W^T`` (FP32 accumulate, BF16 out): what ``UnquantizedLinearMethod`` computes.
+
+    Under BI: ``rocm_unquantized_gemm_impl`` -> ``linear_batch_invariant`` (persistent Triton matmul), as the rollout."""
+
+    if dense_bi():
+        return _bi_lib().linear_batch_invariant(value, weight, None)
+    pad = _gemm_pad()
+    if pad <= 1 or value.ndim != 2 or value.shape[0] % pad == 0:
+        return F.linear(value, weight)
+    t = value.shape[0]
+    tp = -(-t // pad) * pad
+    padded = torch.cat([value, value.new_zeros(tp - t, value.shape[1])])
+    return F.linear(padded, weight)[:t]
+
+
+class BILinearAdapter(_Adapter):
+    """Plain BF16 linear (BI: ``linear_batch_invariant``).  ``row_parallel`` (set by the caller) + virtual TP: the TP=N
+    rollout's row-parallel layer (per-rank partials, fixed-order all-reduce)."""
+
+    row_parallel = False
+
+    def forward(self, value: Tensor, weight: Tensor) -> Tensor:
+        _tensor(value, "x", dtype=torch.bfloat16, contiguous=False)
+        _tensor(weight, "weight", ndim=2, dtype=torch.bfloat16, contiguous=False)
+        if value.shape[-1] != weight.shape[1]:
+            raise ValueError("x and weight inner dimensions differ")
+        _same_device({"x": value, "weight": weight})
+        n = vtp_size() if self.row_parallel else 1
+        if n > 1:
+            x2 = value.reshape(-1, value.shape[-1])
+            out = vtp_fixed_sum(vtp_row_partials(x2, weight, n)).reshape(*value.shape[:-1], weight.shape[0])
+            return _output_boundary(out, value, weight)
+        return _output_boundary(rocm_linear(value, weight), value, weight)
+
+
+def _router_mode() -> str:
+    # "mm_f32out" (rollout prefill: GateLinear -> fp32_router_gemm_dispatch -> torch.mm(x, W^T,
+    # out_dtype=fp32), BF16 operands, FP32 accumulate and output); "fp32": FP32 operands.
+    return os.environ.get("MLITE_K31_ROCM_ROUTER", "mm_f32out")
+
+
+class BIRouterAdapter(_Adapter):
+    """Router logits, FP32 ``[T, E]``."""
+
+    def forward(self, value: Tensor, weight: Tensor) -> Tensor:
+        _tensor(value, "x", ndim=2, dtype=torch.bfloat16, contiguous=False)
+        _tensor(weight, "weight", ndim=2, dtype=torch.bfloat16)
+        _same_device({"x": value, "weight": weight})
+        if dense_bi():
+            # GateLinear(out_dtype=fp32) under BI: tiers 1-6 are off, tier 7 = ReplicatedLinear (BI linear, BF16) .to(fp32)
+            out = rocm_linear(value, weight).to(torch.float32)
+        elif _router_mode() == "fp32":
+            out = F.linear(value.float(), weight.float())
+        else:
+            out = mm_f32out(value, weight.t())
+        return _output_boundary(out, value, weight)
+
+
+class PunicaLoRADeltaAdapter(_Adapter):
+    """LoRA delta of one (packed) projection, FP32 ``[T, sum(out)]``.
+
+    Same values as vLLM's Triton punica shrink (FP32 accumulate into an FP32 buffer) followed by
+    expand (buffer cast to the weight dtype, FP32 accumulate), with ``scale = 1`` and the vLLM-folded
+    ``B``; ``meta`` is ignored (one adapter, every token on slot 0).
+    """
+
+    def forward(
+        self,
+        value: Tensor,
+        lora_a_stacked: tuple[Tensor, ...],
+        lora_b_stacked: tuple[Tensor, ...],
+        output_slices: tuple[int, ...],
+        meta: Any,
+        *,
+        specialize_active_lora: bool = False,
+    ) -> Tensor:
+        del meta, specialize_active_lora
+        _tensor(value, "x", ndim=2, dtype=torch.bfloat16)
+        if not (len(lora_a_stacked) == len(lora_b_stacked) == len(output_slices)):
+            raise ValueError("LoRA slice tuples must have equal length")
+        pieces = []
+        for i, (a, b) in enumerate(zip(lora_a_stacked, lora_b_stacked, strict=True)):
+            a2 = a.reshape(-1, a.shape[-2], a.shape[-1])[0]  # [r, in]
+            b2 = b.reshape(-1, b.shape[-2], b.shape[-1])[0]  # [out, r]
+            if a2.shape[-1] != value.shape[1] or b2.shape[0] != output_slices[i]:
+                raise ValueError(f"LoRA slice {i} shape mismatch")
+            shrink = mm_f32out(value, a2.t())
+            pieces.append(mm_f32out(shrink.to(b2.dtype), b2.t()))
+        delta = torch.cat(pieces, dim=-1) if len(pieces) > 1 else pieces[0]
+        return _output_boundary(delta, value, lora_a_stacked, lora_b_stacked)
+
+
+class LoRALeafAdapter(_Adapter):
+    """``bf16(fp32(bf16(x W^T)) + fp32(delta))``: punica expand with ``add_inputs`` into the base output.
+
+    Under BI the leaf is FUSED (``fused_lora()``): exactly ``PunicaWrapperGPU.add_lora_linear`` on the BI base output --
+    ``lora_shrink`` into an FP32 buffer, ``lora_expand(add_inputs=True)`` into ``y`` with the rollout's epilogue -- since the
+    epilogue rounds ``delta + base`` once and the delta alone is never materialized in the rollout."""
+
+    @staticmethod
+    def fused_lora() -> bool:
+        return dense_bi()
+
+    def fused_forward(self, value, weight, lora_a_stacked, lora_b_stacked, output_slices, meta,
+                      specialize_active_lora: bool = False):
+        _tensor(value, "x", ndim=2, dtype=torch.bfloat16)
+        _tensor(weight, "weight", ndim=2, dtype=torch.bfloat16, contiguous=False)
+        if weight.shape[0] != sum(output_slices):
+            raise ValueError("LoRA slices must cover the base output")
+        n = vtp_size() if getattr(self, "row_parallel", False) else 1
+        if n > 1:
+            y = vtp_fixed_sum(vtp_row_partials(value, weight, n,
+                                               lora=(lora_a_stacked, lora_b_stacked, output_slices, meta)))
+        else:
+            y = _punica_leaf(value, weight, lora_a_stacked, lora_b_stacked, output_slices, meta, specialize_active_lora)
+        return _output_boundary(y, value, weight, lora_a_stacked, lora_b_stacked)
+
+    def forward(self, value: Tensor, weight: Tensor, delta: Tensor) -> Tensor:
+        _tensor(value, "x", ndim=2, dtype=torch.bfloat16)
+        _tensor(weight, "weight", ndim=2, dtype=torch.bfloat16, contiguous=False)
+        if delta.shape != (value.shape[0], weight.shape[0]):
+            raise ValueError("delta must be [tokens, out_features]")
+        _same_device({"x": value, "weight": weight, "delta": delta})
+        base = rocm_linear(value, weight)
+        out = (base.float() + delta.float()).to(torch.bfloat16)
+        return _output_boundary(out, value, weight, delta)
+
+
+# ---------------------------------------------------------------------------
+# norms and activations
+# ---------------------------------------------------------------------------
+def rms_norm_reference(value: Tensor, weight: Tensor, eps: float) -> Tensor:
+    """FP32 normalize, FP32 weight multiply, one rounding (AITER / ``_C.rms_norm`` semantics)."""
+
+    x = value.float()
+    y = x * torch.rsqrt(x.square().mean(dim=-1, keepdim=True) + eps)
+    return (y * weight.float()).to(value.dtype)
+
+
+class RMSNormAdapter(_Adapter):
+    def forward(self, value: Tensor, weight: Tensor, eps: float) -> Tensor:
+        _tensor(value, "x", dtype=torch.bfloat16, contiguous=False)
+        _tensor(weight, "weight", ndim=1)
+        if weight.shape[0] != value.shape[-1]:
+            raise ValueError("RMSNorm weight must match the hidden dimension")
+        if eps <= 0:
+            raise ValueError("eps must be positive")
+        _same_device({"x": value, "weight": weight})
+        op = _c_op("rms_norm") if _ops_mode() == "vllm" else None
+        if dense_bi():
+            # vLLM RMSNorm.forward_cuda under BI: rms_norm_batch_invariant (Triton), measured bitwise vs the BI rollout
+            out = _bi_lib().rms_norm_batch_invariant(value, weight, float(eps))
+        elif op is not None and weight.dtype == value.dtype:
+            x2 = value.reshape(-1, value.shape[-1]).contiguous()
+            out = torch.empty_like(x2)
+            op(out, x2, weight.contiguous(), float(eps))
+            out = out.view(value.shape)
+        else:
+            out = rms_norm_reference(value, weight, eps)
+        return _output_boundary(out, value, weight)
+
+
+def situ_and_mul_fp32(value: Tensor, beta: float, linear_beta: float | None) -> Tensor:
+    d = value.shape[-1] // 2
+    gate = value[..., :d].float()
+    up = value[..., d:].float()
+    gate = beta * torch.tanh(gate / beta) * torch.sigmoid(gate)
+    if linear_beta is not None:
+        up = linear_beta * torch.tanh(up / linear_beta)
+    return (gate * up).to(value.dtype)
+
+
+class SiTUAndMulAdapter(_Adapter):
+    def forward(self, value: Tensor, beta: float, linear_beta: float | None) -> Tensor:
+        _tensor(value, "x", dtype=torch.bfloat16)
+        if value.shape[-1] % 2:
+            raise ValueError("SiTU input must hold gate and up halves")
+        op = _c_op("situ_and_mul") if _ops_mode() == "vllm" else None
+        if op is not None:
+            d = value.shape[-1] // 2
+            out = torch.empty(value.shape[:-1] + (d,), dtype=value.dtype, device=value.device)
+            op(out, value, float(beta), -1.0 if linear_beta is None else float(linear_beta))
+        else:
+            out = situ_and_mul_fp32(value, beta, linear_beta)
+        return _output_boundary(out, value)
+
+
+# ---------------------------------------------------------------------------
+# AttnRes
+# ---------------------------------------------------------------------------
+def attn_res_math(
+    prefix: Tensor,
+    delta: Tensor | None,
+    rows_blocks: list[Tensor],
+    norm_weight: Tensor,
+    qk_weight: Tensor,
+    output_norm_weight: Tensor | None,
+    eps: float,
+    output_norm_eps: float,
+) -> tuple[Tensor, Tensor]:
+    """``(output, updated_prefix)``; FP32 math of ``primitive.attn_res.attn_res_reference``."""
+
+    updated = prefix if delta is None else (prefix.float() + delta.float()).to(prefix.dtype)
+    if not rows_blocks:
+        mixed = updated.float()
+    else:
+        rows = torch.stack([*rows_blocks, updated], dim=-2).float()
+        qk = norm_weight.float() * qk_weight.float()
+        rstd = torch.rsqrt(rows.square().mean(dim=-1, keepdim=True) + eps)
+        logits = (rows * qk).sum(dim=-1, keepdim=True) * rstd
+        probs = torch.softmax(logits, dim=-2)
+        mixed = (probs * rows).sum(dim=-2)
+    if output_norm_weight is not None:
+        rstd_out = torch.rsqrt(mixed.square().mean(dim=-1, keepdim=True) + output_norm_eps)
+        mixed = mixed * rstd_out * output_norm_weight.float()
+    return mixed.to(prefix.dtype), updated
+
+
+class AttnResAdapter(_Adapter):
+    """The rollout ``attn_res`` wrapper semantics (mutates ``prefix`` and the bank in place)."""
+
+    def forward(
+        self,
+        prefix: Tensor,
+        delta: Tensor | None,
+        blocks: Tensor,
+        norm_weight: Tensor,
+        qk_weight: Tensor,
+        output_norm_weight: Tensor | None,
+        num_blocks: int,
+        block_write_idx: int,
+        eps: float,
+        output_norm_eps: float,
+    ) -> Tensor:
+        _tensor(prefix, "prefix", ndim=2, dtype=torch.bfloat16)
+        if delta is not None:
+            _tensor(delta, "delta", ndim=2, dtype=torch.bfloat16)
+            if delta.shape != prefix.shape:
+                raise ValueError("delta must match prefix")
+        _tensor(blocks, "blocks", ndim=3, dtype=torch.bfloat16)
+        tokens, hidden = prefix.shape
+        if hidden != ATTN_RES_HIDDEN and os.environ.get("MLITE_K31_ROCM_ANY_HIDDEN") != "1":
+            raise ValueError(f"K31 AttnRes expects hidden={ATTN_RES_HIDDEN}")
+        if blocks.shape[0] != tokens or blocks.shape[2] != hidden:
+            raise ValueError("blocks must be [tokens, slots, hidden]")
+        if not 0 <= num_blocks <= blocks.shape[1]:
+            raise ValueError(f"num_blocks={num_blocks} outside the bank")
+        out = None
+        if _ops_mode() == "vllm":
+            out = _vllm_attn_res(
+                prefix, delta, blocks, norm_weight, qk_weight, output_norm_weight,
+                num_blocks, block_write_idx, eps, output_norm_eps,
+            )
+        if out is None:
+            out, updated = attn_res_math(
+                prefix,
+                delta,
+                [blocks[:, i] for i in range(num_blocks)],
+                norm_weight,
+                qk_weight,
+                output_norm_weight,
+                eps,
+                output_norm_eps,
+            )
+            if delta is not None:
+                prefix.copy_(updated)
+            if block_write_idx >= 0:
+                blocks[:, block_write_idx].copy_(prefix)
+        return _output_boundary(
+            out, prefix, delta, blocks, norm_weight, qk_weight, output_norm_weight
+        )
+
+
+def _vllm_attn_res(*args) -> Tensor | None:
+    """The ROCm image's AMD ``attn_res`` (same wrapper signature as the NVIDIA one), if present."""
+
+    if dense_bi() and os.environ.get("K31_BI_ATTNRES", "1") == "1":
+        return _bi_attn_res()(*args)
+    for mod in ("vllm.models.kimi_k3.amd.ops.attn_res", "vllm.models.kimi_k3.common.ops.attn_res"):
+        try:
+            fn = getattr(importlib.import_module(mod), "attn_res")
+        except (ImportError, AttributeError):
+            continue
+        return fn(*args)
+    return None
+
+
+@functools.lru_cache(maxsize=None)
+def _bi_attn_res():
+    """BI rollout's AttnRes (``k31lora.bi_attnres``): the image's ``_attn_res_kernel`` with its batch-size-dependent
+    launch tiling pinned (the default picks BLOCK_L/num_warps from num_tokens once num_blocks >= 2).  Same pin as the rollout."""
+
+    bi = None
+    for name in ("k31lora.bi_attnres", "k31bi_attnres"):   # the k31lora copy first, a standalone k31bi_attnres second
+        try:
+            bi = importlib.import_module(name)
+            break
+        except ImportError:
+            continue
+    if bi is None:
+        raise RuntimeError("VLLM_BATCH_INVARIANT=1: the trainer needs k31lora.bi_attnres on PYTHONPATH, "
+                           "or K31_BI_ATTNRES=0 on both rollout and trainer")
+    return bi._pinned_attn_res(importlib.import_module("vllm.models.kimi_k3.amd.ops.attn_res"))
+
+
+# ---------------------------------------------------------------------------
+# head
+# ---------------------------------------------------------------------------
+class TokenLogprobAdapter(_Adapter):
+    """Selected-token log-softmax in FP32 (``[T, n]`` for ``token_ids [T, n]``)."""
+
+    def forward(self, logits: Tensor, token_ids: Tensor) -> Tensor:
+        _tensor(logits, "logits", ndim=2, dtype=(torch.bfloat16, torch.float32))
+        _tensor(token_ids, "token_ids", ndim=2, contiguous=False)
+        if dense_bi():
+            # rollout sampler: logits.log_softmax(dim=-1, dtype=fp32) -> aten::_log_softmax override (BI Triton kernel)
+            lp = _bi_lib()._log_softmax_batch_invariant(logits.float(), -1, False)
+        else:
+            lp = torch.log_softmax(logits.float(), dim=-1)
+        return _output_boundary(lp.gather(-1, token_ids.long()), logits)
+
+
+class TemperatureAdapter(_Adapter):
+    def forward(self, logits: Tensor, temperature: float) -> Tensor:
+        _tensor(logits, "logits", ndim=2, dtype=(torch.bfloat16, torch.float32))
+        return logits.detach().float() / float(temperature)
+
+
+# ---------------------------------------------------------------------------
+# MoE helpers (replace the vllm_k31_moe entries)
+# ---------------------------------------------------------------------------
+class TorchK31Router:
+    """``select_experts`` of the K31 router: sigmoid scores, bias for selection only, top-k,
+    renormalize, ``routed_scaling_factor``; FP32 weights, int32 ids (vLLM's return types)."""
+
+    def __init__(
+        self,
+        *,
+        top_k: int,
+        num_experts: int,
+        e_score_correction_bias: Tensor,
+        renormalize: bool = True,
+        num_expert_group: int = 1,
+        topk_group: int = 1,
+        scoring_func: str = "sigmoid",
+        routed_scaling_factor: float = 1.0,
+    ) -> None:
+        if scoring_func != "sigmoid" or num_expert_group != 1 or topk_group != 1:
+            raise NotImplementedError("K31 router: sigmoid, no expert groups")
+        self.top_k = top_k
+        self.num_experts = num_experts
+        self.bias = e_score_correction_bias
+        self.renormalize = renormalize
+        self.scale = routed_scaling_factor
+
+    def select_experts(self, hidden_states: Tensor, router_logits: Tensor) -> tuple[Tensor, Tensor]:
+        if dense_bi():
+            # the rollout's FusedTopKBiasRouter: vLLM fused_topk_bias, which dispatches (same env as the rollout:
+            # VLLM_ROCM_USE_AITER) to AITER biased_grouped_topk or the _C topk_sigmoid kernel
+            FT = importlib.import_module("vllm.model_executor.layers.fused_moe.router.fused_topk_bias_router")
+            A = importlib.import_module("vllm._aiter_ops").rocm_aiter_ops
+            n_exp = router_logits.shape[-1]
+            if A.is_fused_moe_enabled():
+                # measured (against a BI rollout dump): the rollout's top-k ids/weights are AITER
+                # biased_grouped_topk's, bitwise (its router reaches the kernel without fused_topk_bias's eligibility gate)
+                g = FT._aiter_get_num_expert_group(n_exp)
+                w = torch.empty(router_logits.shape[0], self.top_k, dtype=torch.float32, device=router_logits.device)
+                i = torch.empty(router_logits.shape[0], self.top_k, dtype=torch.int32, device=router_logits.device)
+                A.biased_grouped_topk(router_logits.float().contiguous(), self.bias, w, i, num_expert_group=g, topk_group=g,
+                                      need_renorm=self.renormalize)
+                if self.scale != 1.0:
+                    w *= self.scale
+                return w, i
+            w, i = FT.fused_topk_bias(hidden_states, router_logits, "sigmoid", self.bias, self.top_k, self.renormalize,
+                                      routed_scaling_factor=self.scale)
+            return w.float(), i.to(torch.int32)
+        del hidden_states
+        scores = torch.sigmoid(router_logits.float())
+        choice = scores + self.bias.float().unsqueeze(0)
+        ids = torch.topk(choice, self.top_k, dim=-1, sorted=True).indices
+        weights = scores.gather(-1, ids)
+        if self.renormalize:
+            weights = weights / weights.sum(dim=-1, keepdim=True)
+        if self.scale != 1.0:
+            weights = weights * self.scale
+        return weights.float(), ids.to(torch.int32)
+
+
+def build_k31_router(**kwargs) -> TorchK31Router:
+    return TorchK31Router(**kwargs)
+
+
+def tree16_root(leaves: Tensor) -> Tensor:
+    """FP32 adjacent-pair tree over ``leaves[16, n]`` (the CUDA ``local_subtree`` order)."""
+
+    if leaves.dtype != torch.float32 or leaves.ndim != 2 or leaves.shape[0] != 16:
+        raise ValueError("tree16_root expects fp32 [16, n] leaves")
+    values = leaves
+    while values.shape[0] > 1:
+        values = values[0::2] + values[1::2]
+    return values[0]
+
+
+class MoELatentUpAdapter:
+    """``torch.mm(normed_latent, routed_expert_up_proj.weight.t())`` (BF16, no BI pins)."""
+
+    def __call__(self, latent: Tensor, weight: Tensor) -> Tensor:
+        if latent.dtype != torch.bfloat16 or weight.dtype != torch.bfloat16:
+            raise TypeError("latent up-projection is BF16 x BF16")
+        if latent.ndim != 2 or weight.ndim != 2 or latent.shape[1] != weight.shape[1]:
+            raise ValueError("latent [T, L] and weight [H, L] expected")
+        if dense_bi():
+            # TP1 rollout under BI: routed_output_transform.up_proj (BI linear). NOTE TP>1 rollouts fold the shared-expert
+            # partial into hidden_shard.addmm_(latent, W_shard.T) (BI addmm epilogue): not mirrored here (TP1 only).
+            return rocm_linear(latent, weight)
+        return torch.mm(latent, weight.t())
+
