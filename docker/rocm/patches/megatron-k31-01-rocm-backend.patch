index 0000000000000000000000000000000000000000..1a2aec487049caa9e84c37e51f81a0634d4ffa8d
--- /dev/null
+++ b/experimental/lite/megatron/lite/primitive/alignment/rocm_mxfp4_moe.py
@@ -0,0 +1,442 @@
+"""K31 routed experts on ROCm (BI=0): exact MXFP4 dequant + BF16 grouped GEMM, optional expert LoRA.
+
+Replaces the FlashInfer W4A16 / CUDA expert-LoRA path of ``vllm_fi_w4a16_moe`` for the BI=0 trainer
+on AMD.  No vLLM, FlashInfer or CUDA extension is needed: everything is PyTorch.
+
+Per routed slot ``(t, k)`` with local expert ``e`` (weights dequantized exactly from the checkpoint
+MXFP4 bytes, rows ``[gate; up]`` = ``[w1; w3]``)::
+
+    xq    = act_quant(x_t)                                 (identity, or MXFP4 fake-quant)
+    gu    = xq @ W13_e^T              (BF16 GEMM, FP32 accumulate)
+    gate += (x_t A1^T) B1_e^T * s ;  up += (x_t A3^T) B3_e^T * s      (expert LoRA, if any)
+    act   = SiTU(gate, up)           (FP32 math)            -> BF16
+    y     = act_quant(act) @ W2_e^T  (BF16 GEMM, FP32 accumulate)
+    leaf  = w_tk * (y + (act A2_e^T) B2^T * s)               FP32
+
+The leaves are returned as FP32 rows in ``rows_index`` order (``plan.expert_rows`` of
+``primitive.moe.plan_canonical_combine``), exactly the contract of
+``VLLMFiW4A16LeafRowsFunction``, so the canonical combine / EP transport are reused unchanged.
+
+Grouped GEMM: local experts with routed rows are processed in chunks; a chunk is a padded
+``[c, n_max, .]`` batch (``torch.bmm``), experts sorted by row count to bound the padding.  Only the
+experts of the chunk are dequantized (``dequantize_k31_mxfp4_bf16``: exact, BF16).
+
+Backward: chunk by chunk recompute of the same graph under autograd (BF16 GEMMs with FP32
+accumulate, FP32 SiTU), returning dX, d(route weight) and the LoRA grads; base weights are frozen.
+``act_quant`` is straight-through in the backward.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+from torch import Tensor
+
+from megatron.lite.primitive.alignment.vllm_fi_w4a16_moe import dequantize_k31_mxfp4_bf16
+
+# Rows (padded) per chunk and experts per chunk; bound the FP32 temporaries.
+CHUNK_ROWS = int(os.environ.get("MLITE_K31_ROCM_MOE_CHUNK_ROWS", "32768"))
+CHUNK_EXPERTS = int(os.environ.get("MLITE_K31_ROCM_MOE_CHUNK_EXPERTS", "64"))
+ACT_QUANTS = ("none", "mxfp4")
+
+
+@dataclass
+class RocmMxfp4Experts:
+    """EP-local checkpoint MXFP4 buffers (rows ``[gate; up]``) and the SiTU parameters."""
+
+    ckpt_w13: Tensor  # uint8 [E, 2I, H/2]
+    ckpt_w13_scale: Tensor  # uint8 [E, 2I, H/32]
+    ckpt_w2: Tensor  # uint8 [E, H, I/2]
+    ckpt_w2_scale: Tensor  # uint8 [E, H, I/32]
+    num_experts: int
+    local_offset: int
+    situ_beta: float
+    situ_linear_beta: float | None
+
+    @property
+    def num_local_experts(self) -> int:
+        return int(self.ckpt_w13.shape[0])
+
+    @property
+    def intermediate(self) -> int:
+        return int(self.ckpt_w13.shape[1]) // 2
+
+    @property
+    def hidden(self) -> int:
+        return int(self.ckpt_w2.shape[1])
+
+    def dequant(self, ex: Tensor) -> tuple[Tensor, Tensor]:
+        """BF16 ``W13 [c, 2I, H]`` and ``W2 [c, H, I]`` of the local experts ``ex`` (exact)."""
+
+        if self.ckpt_w13.is_cuda and os.environ.get("MLITE_K31_ROCM_DEQUANT", "triton") == "triton":
+            from megatron.lite.primitive.kernels.rocm_mxfp4_dequant import dequant_experts
+
+            return (
+                dequant_experts(self.ckpt_w13, self.ckpt_w13_scale, ex),
+                dequant_experts(self.ckpt_w2, self.ckpt_w2_scale, ex),
+            )
+        w13 =dequantize_k31_mxfp4_bf16(
+            self.ckpt_w13.index_select(0, ex), self.ckpt_w13_scale.index_select(0, ex)
+        )
+        w2 = dequantize_k31_mxfp4_bf16(
+            self.ckpt_w2.index_select(0, ex), self.ckpt_w2_scale.index_select(0, ex)
+        )
+        return w13, w2
+
+
+# --------------------------------------------------------------------------- activation quant
+def _mxfp4_fake_quant_rule() -> str:
+    # "ceil" (default): 2^ceil(log2(amax / 6)), AITER's HIP dynamic MXFP4 quant (kDefaultMxScaleRoundMode
+    # = RoundUp, mx_quant_utils.h) used by the FlyDSL a4w4 MoE stage 1 and its stage-1 epilogue;
+    # "floor": OCP / AITER Triton "even" mode floor(log2(amax)) - 2 (may saturate to 6).
+    return os.environ.get("MLITE_K31_ROCM_ACT_QUANT_SCALE", "ceil")
+
+
+_E2M1_MIDS = (0.25, 0.75, 1.25, 1.75, 2.5, 3.5, 5.0)
+_E2M1_LEVELS = (0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0)
+
+
+def mxfp4_fake_quant(x: Tensor) -> Tensor:
+    """BF16 -> MXFP4 (group 32 along the last dim, E8M0 scale) -> BF16, round-half-to-even on E2M1.
+
+    The rollout's AITER A4W4 kernels quantize activations on the fly; this reproduces the value
+    grid (not necessarily every tie / scale rule, see ``MLITE_K31_ROCM_ACT_QUANT_SCALE``).
+    """
+
+    shape = x.shape
+    if shape[-1] % 32:
+        raise ValueError("MXFP4 activation quant needs the last dim divisible by 32")
+    xf = x.float().reshape(*shape[:-1], -1, 32)
+    amax = xf.abs().amax(-1, keepdim=True)
+    if _mxfp4_fake_quant_rule() == "ceil":
+        e = torch.ceil(torch.log2(amax / 6.0).clamp(min=-127.0))
+    else:
+        e = (torch.floor(torch.log2(amax)) - 2.0).clamp(min=-127.0)
+    e = torch.where(amax > 0, e, torch.full_like(e, -127.0))
+    scale = torch.exp2(e)
+    v = (xf / scale).abs().clamp(max=6.0)
+    levels = torch.tensor(_E2M1_LEVELS, device=x.device)
+    mids = torch.tensor(_E2M1_MIDS, device=x.device)
+    idx = torch.bucketize(v, mids, right=False)  # ties down
+    # round-half-to-even on ties: E2M1 codes with even mantissa are 0,1.0,2.0,4.0 (idx 0,2,4,6)
+    tie = (idx < 7) & (v == mids[idx.clamp(max=6)])
+    idx = torch.where(tie & (idx % 2 == 1), idx + 1, idx)
+    q = levels[idx] * torch.sign(xf) * scale
+    return q.reshape(shape).to(x.dtype)
+
+
+def _aq(x: Tensor, mode: str) -> Tensor:
+    if mode == "none":
+        return x
+    if mode == "mxfp4":
+        return mxfp4_fake_quant(x)
+    raise ValueError(f"act_quant must be one of {ACT_QUANTS}")
+
+
+def _aq_ste(x: Tensor, mode: str) -> Tensor:
+    """Fake-quant value, identity gradient."""
+
+    if mode == "none":
+        return x
+    if torch.is_grad_enabled() and x.requires_grad:
+        return _STEQuant.apply(x, mode)
+    return _aq(x, mode)
+
+
+def situ_fp32(gate: Tensor, up: Tensor, beta: float, linear_beta: float | None) -> Tensor:
+    act = beta * torch.tanh(gate / beta) * torch.sigmoid(gate)
+    if linear_beta is not None:
+        up = linear_beta * torch.tanh(up / linear_beta)
+    return act * up
+
+
+# --------------------------------------------------------------------------- chunk planning
+def _plan(topk_ids: Tensor, rows_index: Tensor, experts: RocmMxfp4Experts):
+    """Group the listed routed slots by local expert; returns chunk tables (host lists)."""
+
+    k = topk_ids.shape[1]
+    e_loc = experts.num_local_experts
+    flat_ids = topk_ids.reshape(-1).long().index_select(0, rows_index) - experts.local_offset
+    if flat_ids.numel() and (int(flat_ids.min()) < 0 or int(flat_ids.max()) >= e_loc):
+        raise RuntimeError("ROCm MoE: a listed route is not on this rank")
+    order = torch.argsort(flat_ids, stable=True)  # positions in rows_index, grouped by expert
+    counts = torch.bincount(flat_ids, minlength=e_loc)
+    starts = torch.cumsum(counts, 0) - counts
+    both = torch.cat((counts, starts)).tolist()
+    counts_l, starts_l = both[:e_loc], both[e_loc:]
+    items = [(e, starts_l[e], counts_l[e]) for e in range(e_loc) if counts_l[e]]
+    items.sort(key=lambda it: -it[2])
+    chunks, cur = [], []
+    for it in items:
+        n_first = -(-(cur[0][2] if cur else it[2]) // 8) * 8
+        if cur and (len(cur) == CHUNK_EXPERTS or (len(cur) + 1) * n_first > CHUNK_ROWS):
+            chunks.append(cur)
+            cur = []
+        cur.append(it)
+    if cur:
+        chunks.append(cur)
+    del k
+    return order, chunks
+
+
+def _chunk_tensors(chunk, order: Tensor, rows_index: Tensor, topk: int, dev):
+    c = len(chunk)
+    n = -(-chunk[0][2] // 8) * 8
+    ex = torch.tensor([it[0] for it in chunk], dtype=torch.long, device=dev)
+    cnt = torch.tensor([it[2] for it in chunk], dtype=torch.long, device=dev)
+    first = torch.tensor([it[1] for it in chunk], dtype=torch.long, device=dev)
+    col = torch.arange(n, device=dev)
+    real = col.unsqueeze(0) < cnt.unsqueeze(1)  # [c, n]
+    pos = first.unsqueeze(1) + torch.minimum(col.unsqueeze(0), cnt.unsqueeze(1) - 1)
+    out_pos = order.index_select(0, pos.reshape(-1))  # position in rows_index (pads repeat)
+    flat = rows_index.index_select(0, out_pos)  # flat route n * K + k
+    tok = flat // topk
+    return c, n, ex, real, out_pos, flat, tok
+
+
+def _chunk_leaves(
+    experts: RocmMxfp4Experts,
+    ex: Tensor,
+    xp: Tensor,  # [c, n, H] bf16
+    wp: Tensor,  # [c, n, 1] fp32 (0 on pads)
+    lora: tuple | None,
+    scaling: float,
+    act_quant: str,
+) -> Tensor:
+    """Differentiable leaves ``[c, n, H]`` fp32 of one chunk (grad flows to xp, wp, LoRA)."""
+
+    inter = experts.intermediate
+    w13, w2 = experts.dequant(ex)
+    gu = torch.bmm(_aq_ste(xp, act_quant), w13.transpose(1, 2)).float()  # [c, n, 2I]
+    if lora is not None:
+        a1, a3, b1, b3, a2, b2 = lora
+        xa1 = torch.matmul(xp.float(), a1.to(torch.bfloat16).float().t())  # [c, n, r]
+        xa3 = torch.matmul(xp.float(), a3.to(torch.bfloat16).float().t())
+        b1e = b1.index_select(0, ex).float() * scaling  # [c, I, r]
+        b3e = b3.index_select(0, ex).float() * scaling
+        gate = gu[..., :inter] + torch.bmm(xa1, b1e.transpose(1, 2))
+        up = gu[..., inter:] + torch.bmm(xa3, b3e.transpose(1, 2))
+    else:
+        gate, up = gu[..., :inter], gu[..., inter:]
+    act = situ_fp32(gate, up, experts.situ_beta, experts.situ_linear_beta).to(torch.bfloat16)
+    y = torch.bmm(_aq_ste(act, act_quant), w2.transpose(1, 2)).float()  # [c, n, H]
+    if lora is not None:
+        a2e = a2.index_select(0, ex).to(torch.bfloat16).float()  # [c, r, I]
+        d2 = torch.matmul(torch.bmm(act.float(), a2e.transpose(1, 2)), b2.float().t() * scaling)
+        y = y + d2
+    return wp * y
+
+
+def _moe_bi() -> bool:
+    """``MLITE_K31_MOE_BI=1``: forward leaves through k31lora's batch-invariant MoE kernels (``k31lora.bi_moe``: pinned Triton grouped
+    GEMMs with in-register exact MXFP4 dequant), the same code the BI rollout runs, so trainer == rollout bitwise. Backward unchanged."""
+
+    return os.environ.get("MLITE_K31_MOE_BI", "0") == "1"
+
+
+def bi_moe_slot_leaves(experts: "RocmMxfp4Experts", x: Tensor, topk_ids: Tensor, topk_weights: Tensor,
+                       scaling: float, lora: tuple | None) -> Tensor:
+    """FP32 leaves ``[T * K, H]`` in flat slot order, computed by ``k31lora.bi_moe.bi_moe_forward`` itself (the BI rollout
+    code; its ``leaf_reduce`` hook hands us the slot leaves right before the expert-ascending combine), so the trainer cannot
+    drift from the contract (canonical 8-chunk W2 contraction, pinned grouped GEMMs, exact in-register dequant).
+    Non-local slots (EP) are zero; the canonical combine only reads ``plan.expert_rows``. Expert LoRA uses bi_moe's dict layout
+    (A1/A3/B1/B3/A2/B2 + scaling)."""
+    import importlib
+
+    BM = importlib.import_module("k31lora.bi_moe")
+    lora_dict = None
+    if lora is not None:
+        # k31lora.bi_moe expert-LoRA contract: d13 = [d1 | d3] with separate shared A1 / A3, per-expert B1 / B3;
+        # d2 over the 8 canonical N-chunks with per-expert A2, shared B2 -- 1:1 with vLLM --enable-moe-shared-loras and mLite.
+        a1, a3, b1, b3, a2, b2 = (t.detach().to(torch.bfloat16) for t in lora)
+        lora_dict = {"A1": a1[None].contiguous(), "A3": a3[None].contiguous(), "B1": b1.contiguous(), "B3": b3.contiguous(),
+                     "A2": a2.contiguous(), "B2": b2[None].contiguous(), "scaling": float(scaling),
+                     "shared_A1": True, "shared_A3": True, "shared_B1": False, "shared_B3": False,
+                     "shared_A2": False, "shared_B2": True}
+    expert_map = None
+    if experts.num_local_experts != experts.num_experts:
+        expert_map = torch.full((experts.num_experts,), -1, dtype=torch.int64, device=x.device)
+        expert_map[experts.local_offset: experts.local_offset + experts.num_local_experts] = torch.arange(
+            experts.num_local_experts, device=x.device)
+    got = []
+
+    def capture(slots):
+        got.append(slots)
+        return slots
+
+    BM.bi_moe_forward(x.contiguous(), experts.ckpt_w13, experts.ckpt_w13_scale, experts.ckpt_w2, experts.ckpt_w2_scale,
+                      topk_weights.to(torch.float32), topk_ids, experts.situ_beta, experts.situ_linear_beta,
+                      lora=lora_dict, expert_map=expert_map, leaf_reduce=capture)
+    # bi_moe_forward calls leaf_reduce once per token block (K31_BI_MOE_TOK_CHUNK), in token order: concatenate
+    return got[0] if len(got) == 1 else torch.cat(got, 0)
+
+
+class _STEQuant(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, mode):
+        return _aq(x, mode)
+
+    @staticmethod
+    def backward(ctx, g):
+        return g, None
+
+
+class RocmExpertLeafRowsFunction(torch.autograd.Function):
+    """FP32 leaves of the listed routed slots (``rows_index``), forward no-grad, chunked recompute bwd."""
+
+    @staticmethod
+    def forward(ctx, experts, scaling, act_quant, rows_index, x, topk_ids, topk_weights, *lora):
+        has_lora = len(lora) > 0 and lora[0] is not None
+        dev = x.device
+        h = x.shape[1]
+        topk = topk_ids.shape[1]
+        if _moe_bi():
+            if act_quant != "none":
+                raise ValueError("MLITE_K31_MOE_BI needs BF16 expert activations (act_quant none)")
+            with torch.no_grad():
+                slots = bi_moe_slot_leaves(experts, x.detach(), topk_ids, topk_weights.detach(), scaling,
+                                           tuple(lora) if has_lora else None)
+            out = slots.index_select(0, rows_index)
+            ctx.experts = experts
+            ctx.scaling = scaling
+            ctx.act_quant = act_quant
+            ctx.has_lora = has_lora
+            ctx.save_for_backward(rows_index, x, topk_ids, topk_weights, *(lora if has_lora else ()))
+            ctx.mark_non_differentiable(topk_ids)
+            return out
+        out = torch.zeros((rows_index.numel(), h), dtype=torch.float32, device=dev)
+        order, chunks = _plan(topk_ids, rows_index, experts)
+        we_flat = topk_weights.detach().reshape(-1).float()
+        with torch.no_grad():
+            for chunk in chunks:
+                c, n, ex, real, out_pos, flat, tok = _chunk_tensors(chunk, order, rows_index, topk, dev)
+                xp = x.detach().index_select(0, tok).view(c, n, h)
+                wp = torch.where(real.reshape(-1), we_flat.index_select(0, flat), 0.0).view(c, n, 1)
+                leaves = _chunk_leaves(
+                    experts, ex, xp, wp, tuple(lora) if has_lora else None, scaling, act_quant
+                )
+                sel = real.reshape(-1)
+                out.index_copy_(0, out_pos[sel], leaves.reshape(-1, h)[sel])
+        ctx.experts = experts
+        ctx.scaling = scaling
+        ctx.act_quant = act_quant
+        ctx.has_lora = has_lora
+        ctx.save_for_backward(rows_index, x, topk_ids, topk_weights, *(lora if has_lora else ()))
+        ctx.mark_non_differentiable(topk_ids)
+        return out
+
+    @staticmethod
+    def backward(ctx, grad_rows):
+        rows_index, x, topk_ids, topk_weights, *lora = ctx.saved_tensors
+        experts: RocmMxfp4Experts = ctx.experts
+        dev = x.device
+        h = x.shape[1]
+        m, topk = topk_ids.shape
+        order, chunks = _plan(topk_ids, rows_index, experts)
+        need_x = ctx.needs_input_grad[4]
+        need_w = ctx.needs_input_grad[6]
+        dx = torch.zeros((m, h), dtype=torch.float32, device=dev)
+        dw = torch.zeros((m * topk,), dtype=torch.float32, device=dev)
+        lora_grads = [torch.zeros(t.shape, dtype=torch.float32, device=dev) for t in lora]
+        we_flat = topk_weights.detach().reshape(-1).float()
+        grad_rows = grad_rows.float()
+        for chunk in chunks:
+            c, n, ex, real, out_pos, flat, tok = _chunk_tensors(chunk, order, rows_index, topk, dev)
+            sel = real.reshape(-1)
+            g = torch.where(sel.unsqueeze(1), grad_rows.index_select(0, out_pos), 0.0).view(c, n, h)
+            with torch.enable_grad():
+                xp = x.detach().index_select(0, tok).view(c, n, h).requires_grad_(need_x)
+                wp = (
+                    torch.where(sel, we_flat.index_select(0, flat), 0.0)
+                    .view(c, n, 1)
+                    .requires_grad_(need_w)
+                )
+                lp = tuple(t.detach().requires_grad_(True) for t in lora) if ctx.has_lora else None
+                leaves = _chunk_leaves(experts, ex, xp, wp, lp, ctx.scaling, ctx.act_quant)
+                inputs = [t for t in (xp, wp) if t.requires_grad] + (list(lp) if lp else [])
+                grads = torch.autograd.grad(leaves, inputs, g, allow_unused=True)
+            it = iter(grads)
+            if need_x:
+                gx = next(it)
+                dx.index_add_(0, tok[sel], gx.reshape(-1, h)[sel].float())
+            if need_w:
+                gw = next(it)
+                dw.index_add_(0, flat[sel], gw.reshape(-1)[sel].float())
+            if lp:
+                for acc, gl in zip(lora_grads, it):
+                    if gl is not None:
+                        acc += gl.float()
+        out_lora = tuple(
+            gl.to(t.dtype) for gl, t in zip(lora_grads, lora)
+        ) if ctx.has_lora else ()
+        return (
+            None,
+            None,
+            None,
+            None,
+            dx.to(x.dtype) if need_x else None,
+            None,
+            dw.view(m, topk).to(topk_weights.dtype) if need_w else None,
+            *out_lora,
+        )
+
+
+def rocm_expert_leaf_rows(
+    experts: RocmMxfp4Experts,
+    rows_index: Tensor,
+    x: Tensor,
+    topk_ids: Tensor,
+    topk_weights: Tensor,
+    *,
+    scaling: float = 1.0,
+    lora: tuple[Tensor, ...] | None = None,
+    act_quant: str = "none",
+) -> Tensor:
+    """``lora`` = ``(w1_a [r,H], w3_a [r,H], w1_b [E,I,r], w3_b [E,I,r], w2_a [E,r,I], w2_b [H,r])``."""
+
+    if act_quant not in ACT_QUANTS:
+        raise ValueError(f"act_quant must be one of {ACT_QUANTS}")
+    return RocmExpertLeafRowsFunction.apply(
+        experts, float(scaling), act_quant, rows_index, x, topk_ids, topk_weights, *(lora or ())
+    )
+
+
+def expert_leaves_dense_reference(
+    experts: RocmMxfp4Experts,
+    x: Tensor,
+    topk_ids: Tensor,
+    topk_weights: Tensor,
+    *,
+    scaling: float = 1.0,
+    lora: tuple[Tensor, ...] | None = None,
+    act_quant: str = "none",
+) -> Tensor:
+    """Per-expert loop reference ``[M, K, H]`` (tests only)."""
+
+    m, topk = topk_ids.shape
+    out = torch.zeros((m, topk, experts.hidden), dtype=torch.float32, device=x.device)
+    local = topk_ids.long() - experts.local_offset
+    for e in torch.unique(local).tolist():
+        if e < 0 or e >= experts.num_local_experts:
+            continue
+        n_idx, k_idx = torch.nonzero(local == e, as_tuple=True)
+        ex = torch.tensor([e], device=x.device)
+        xp = x[n_idx].unsqueeze(0)
+        wp = topk_weights[n_idx, k_idx].float().view(1, -1, 1)
+        leaves = _chunk_leaves(experts, ex, xp, wp, lora, scaling, act_quant)
+        out[n_idx, k_idx] = leaves[0]
+    return out
+
+
+__all__ = [
+    "ACT_QUANTS",
+    "RocmExpertLeafRowsFunction",
+    "RocmMxfp4Experts",
+    "expert_leaves_dense_reference",
+    "mxfp4_fake_quant",
+    "rocm_expert_leaf_rows",
+    "situ_fp32",
+]
diff --git a/experimental/lite/megatron/lite/primitive/kernels/k31_backend.py b/experimental/lite/megatron/lite/primitive/kernels/k31_backend.py
