+# Opaque ops for the per-row path, as rocm_block32_gemm does for the block32 one:
+# _mxfp8_dot_scaled_linear / _gemm pick the fused-quant branch and the tile
+# config from the token count M. Called directly from a torch.compile'd
+# forward, that choice is made once at trace time (vLLM compiles in its profile
+# run, at max_num_batched_tokens), so every CUDA graph, decode included, runs
+# the large-M prefill tile. Behind an op the choice is made per call, with each
+# captured graph's own M.
+def _rocm_mxfp8_linear_impl(
+    x: torch.Tensor, w: torch.Tensor, w_scale: torch.Tensor
+) -> torch.Tensor:
+    if x.shape[0] == 0:
+        return x.new_empty((0, w.shape[0]))
+    return _mxfp8_dot_scaled_linear(x, w, w_scale)
+
+
+def _rocm_mxfp8_linear_fake(
+    x: torch.Tensor, w: torch.Tensor, w_scale: torch.Tensor
+) -> torch.Tensor:
+    return x.new_empty((x.shape[0], w.shape[0]))
+
+
+direct_register_custom_op(
+    op_name="rocm_mxfp8_linear",
+    op_func=_rocm_mxfp8_linear_impl,
+    fake_impl=_rocm_mxfp8_linear_fake,
+)
+
+
+def _rocm_mxfp8_gemm_impl(
+    x_q: torch.Tensor,
+    x_scale: torch.Tensor,
+    w: torch.Tensor,
+    w_scale: torch.Tensor,
+    out_dtype: torch.dtype,
+) -> torch.Tensor:
+    if x_q.shape[0] == 0:
+        return x_q.new_empty((0, w.shape[0]), dtype=out_dtype)
+    return _mxfp8_dot_scaled_gemm(x_q, x_scale, w, w_scale, out_dtype)
+
+
+def _rocm_mxfp8_gemm_fake(
+    x_q: torch.Tensor,
+    x_scale: torch.Tensor,
+    w: torch.Tensor,
+    w_scale: torch.Tensor,
+    out_dtype: torch.dtype,
+) -> torch.Tensor:
+    return x_q.new_empty((x_q.shape[0], w.shape[0]), dtype=out_dtype)
+
+
+direct_register_custom_op(
+    op_name="rocm_mxfp8_gemm",
+    op_func=_rocm_mxfp8_gemm_impl,
+    fake_impl=_rocm_mxfp8_gemm_fake,
+)
+
