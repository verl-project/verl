+"""impl=vllm on ROCm with VLLM_BATCH_INVARIANT=0: native-kernel dispatch and
+the summed EP combine, checked against the batch-invariant per-slot path.
+
+Needs a ROCm GPU and vLLM; two-rank tests need two GPUs.
+"""
+
+from __future__ import annotations
+
+import os
+import tempfile
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+pytestmark = pytest.mark.skipif(
+    torch.version.hip is None or not torch.cuda.is_available(),
+    reason="ROCm GPU required",
+)
+
+H, I, K, E = 256, 128, 6, 16
+LIMIT = 7.0
+
+
+def _rocm():
+    from megatron.lite.model.deepseek_v4.vllm.primitive import rocm
+
+    return rocm
+
+
+def _moe():
+    from megatron.lite.model.deepseek_v4.vllm.primitive.moe import module
+
+    return module
+
+
+# ---------------------------------------------------------------------------
+# D2: linear / rms_norm dispatch
+# ---------------------------------------------------------------------------
+
+
+def test_linear_dispatch(monkeypatch):
+    rocm = _rocm()
+    from vllm.model_executor.layers.batch_invariant import linear_batch_invariant
+
+    torch.manual_seed(0)
+    x = torch.randn(37, 512, device="cuda", dtype=torch.bfloat16)
+    w = torch.randn(96, 512, device="cuda", dtype=torch.bfloat16)
+    monkeypatch.setattr(rocm, "batch_invariant", lambda: True)
+    assert torch.equal(rocm.linear(x, w), linear_batch_invariant(x, w))
+    monkeypatch.setattr(rocm, "batch_invariant", lambda: False)
+    assert torch.equal(rocm.linear(x, w), F.linear(x, w))
+
+
+@pytest.mark.parametrize("weight_dtype", [torch.bfloat16, torch.float32])
+def test_rms_norm_dispatch(monkeypatch, weight_dtype):
+    rocm = _rocm()
+    from vllm.model_executor.layers.batch_invariant import rms_norm_batch_invariant
+
+    torch.manual_seed(0)
+    x = torch.randn(41, 4096, device="cuda", dtype=torch.bfloat16)
+    w = torch.randn(4096, device="cuda", dtype=weight_dtype)
+    monkeypatch.setattr(rocm, "batch_invariant", lambda: True)
+    assert torch.equal(rocm.rms_norm(x, w, 1e-6), rms_norm_batch_invariant(x, w, 1e-6))
+    monkeypatch.setattr(rocm, "batch_invariant", lambda: False)
+    ref = F.rms_norm(x.float(), (x.shape[-1],), w.to(x.dtype).float(), 1e-6)
+    out = rocm.rms_norm(x, w, 1e-6)
+    assert out.dtype == x.dtype and out.shape == x.shape
+    torch.testing.assert_close(out.float(), ref, rtol=1.6e-2, atol=1e-2)
+
+
+# ---------------------------------------------------------------------------
+# D3: summed EP combine
+# ---------------------------------------------------------------------------
+
+
+def _inputs(tokens, num_local, seed):
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    hidden = torch.randn(tokens, H, device="cuda", dtype=torch.bfloat16, generator=g)
+    logits = torch.randn(tokens, E, device="cuda", generator=g)
+    ids = logits.topk(K, dim=-1).indices.to(torch.int32)
+    weights = torch.rand(tokens, K, device="cuda", generator=g) + 0.1
+    w13 = [
+        (torch.randn(2 * I, H, device="cuda", generator=g) * 0.05).to(torch.bfloat16)
+        for _ in range(num_local)
+    ]
+    w2 = [
+        (torch.randn(H, I, device="cuda", generator=g) * 0.05).to(torch.bfloat16)
+        for _ in range(num_local)
+    ]
+    grad = torch.randn(tokens, H, device="cuda", dtype=torch.bfloat16, generator=g)
+    return hidden, weights, ids, w13, w2, grad
+
+
+def _experts(summed, group, ep_size, ep_rank):
+    from megatron.lite.model.deepseek_v4.vllm.primitive.block_fp8 import (
+        DeploymentGroupedBlockFP8Adapter,
+    )
+
+    return SimpleNamespace(
+        ps=SimpleNamespace(ep_group=group, ep_size=ep_size, ep_rank=ep_rank),
+        num_local_experts=E // ep_size,
+        num_experts=E,
+        swiglu_limit=LIMIT,
+        grouped_fp8=DeploymentGroupedBlockFP8Adapter(cache_weight=False),
+        summed_combine=summed,
+    )
+
+
+def _run(summed, inputs, *, group=None, ep_size=1, ep_rank=0, rollout_ep=1):
+    """Forward + backward of one path; returns output and leaf grads."""
+    moe, rocm = _moe(), _rocm()
+    hidden, weights, ids, w13, w2, grad = inputs
+    hidden = hidden.clone().requires_grad_()
+    weights = weights.clone().requires_grad_()
+    w13 = [w.clone().requires_grad_() for w in w13]
+    w2 = [w.clone().requires_grad_() for w in w2]
+    experts = _experts(summed, group, ep_size, ep_rank)
+    out = moe._ROCmEPSlotValues.apply(hidden, weights, ids, experts, *w13, *w2)
+    if not summed:
+        out = rocm.rollout_ep_combine(out, ids, num_experts=E, rollout_ep=rollout_ep)
+    assert out.shape == hidden.shape and out.dtype == hidden.dtype
+    out.backward(grad)
+    return (
+        out.detach(),
+        hidden.grad,
+        weights.grad,
+        [w.grad for w in w13],
+        [w.grad for w in w2],
+    )
+
+
+@pytest.mark.parametrize("tokens", [1, 7, 300])
+def test_summed_ep1_matches_per_slot(tokens):
+    inputs = _inputs(tokens, E, seed=tokens)
+    ref = _run(False, inputs)
+    new = _run(True, inputs)
+    # Forward: both are the FP32 slot-order sum rounded once to BF16.
+    assert torch.equal(new[0], ref[0])
+    # Router-weight and expert-weight grads: same per-route math.
+    assert torch.equal(new[2], ref[2])
+    for a, b in zip(new[3] + new[4], ref[3] + ref[4]):
+        assert torch.equal(a, b)
+    # Hidden grad: same FP32 terms, different summation order.
+    torch.testing.assert_close(new[1].float(), ref[1].float(), rtol=1.6e-2, atol=1e-3)
+
+
+def test_summed_bf16_rs_opt_in(monkeypatch):
+    moe = _moe()
+    monkeypatch.setenv("MLITE_DSV4_MOE_RS_DTYPE", "bf16")
+    assert moe._summed_rs_dtype() is torch.bfloat16
+    inputs = _inputs(64, E, seed=1)
+    torch.testing.assert_close(_run(True, inputs)[0], _run(False, inputs)[0])
+    monkeypatch.setenv("MLITE_DSV4_MOE_RS_DTYPE", "fp16")
+    with pytest.raises(ValueError):
+        moe._summed_rs_dtype()
+
+
+def test_summed_empty_routes():
+    # No token routed to this rank's experts: zero output and zero grads.
+    moe = _moe()
+    hidden, weights, ids, w13, w2, grad = _inputs(5, E, seed=3)
+    # This "rank" owns experts 0-1; every route goes to experts 8-13.
+    ids = torch.zeros_like(ids) + 8 + torch.arange(K, device="cuda", dtype=ids.dtype)
+    experts = _experts(True, None, 1, 0)
+    experts.num_local_experts = 2
+    hidden.requires_grad_()
+    w13 = [w.requires_grad_() for w in w13[:2]]
+    w2 = [w.requires_grad_() for w in w2[:2]]
+    out = moe._ROCmEPSlotValues.apply(hidden, weights, ids, experts, *w13, *w2)
+    assert not out.any()
+    out.backward(grad)
+    assert not hidden.grad.any()
+    for w in w13 + w2:
+        assert not w.grad.any()
+
+
+def _worker(rank, world, init_file, results):
+    torch.cuda.set_device(rank)
+    torch.distributed.init_process_group(
+        "nccl", init_method=f"file://{init_file}", rank=rank, world_size=world
+    )
+    try:
+        group = torch.distributed.group.WORLD
+        num_local = E // world
+        full = _inputs(96 + 13 * rank, E, seed=10 + rank)
+        hidden, weights, ids, _, _, grad = full
+        # Same expert weights on every rank: build all E, keep this rank's slice.
+        g_inputs = _inputs(1, E, seed=99)
+        w13 = g_inputs[3][rank * num_local : (rank + 1) * num_local]
+        w2 = g_inputs[4][rank * num_local : (rank + 1) * num_local]
+        inputs = (hidden, weights, ids, w13, w2, grad)
+        # rollout_ep=1: the reference rounds the FP32 slot sum once, like the
+        # summed path (rollout_ep=world would add the BI rollout's per-rank
+        # BF16 rounding). Only FP32 association differs: at most one BF16 ulp.
+        kw = dict(group=group, ep_size=world, ep_rank=rank, rollout_ep=1)
+        ref = _run(False, inputs, **kw)
+        new = _run(True, inputs, **kw)
+        torch.testing.assert_close(new[0].float(), ref[0].float(), rtol=2**-7, atol=1e-6)
+        torch.testing.assert_close(new[1].float(), ref[1].float(), rtol=1.6e-2, atol=1e-3)
+        assert torch.equal(new[2], ref[2])
+        for a, b in zip(new[3] + new[4], ref[3] + ref[4]):
+            assert torch.equal(a, b)
+        results[rank] = "ok"
+    except Exception as exc:  # surfaced by the parent
+        results[rank] = repr(exc)
+    finally:
+        torch.distributed.destroy_process_group()
+
+
+@pytest.mark.skipif(torch.cuda.device_count() < 2, reason="two GPUs required")
+def test_summed_ep2_matches_per_slot():
+    import torch.multiprocessing as mp
+
+    world = 2
+    with tempfile.TemporaryDirectory() as tmp:
+        manager = mp.Manager()
+        results = manager.dict()
+        mp.spawn(
+            _worker,
+            args=(world, os.path.join(tmp, "init"), results),
+            nprocs=world,
+            join=True,
+        )
+        assert dict(results) == {0: "ok", 1: "ok"}
