+def _mla_non_absorbed(q, kv_c, k_pe, kv_b_w, packed, *, heads, nope, rope, v, scale):
+    """Textbook MLA: k_nope/v from kv_b_proj(kv_c), k = [k_nope, k_pe] (shared pe)."""
+    T = q.shape[0]
+    kvb = (kv_c @ kv_b_w.T).view(T, heads, nope + v)
+    k_nope, val = kvb.split([nope, v], dim=-1)
+    k = torch.cat([k_nope, k_pe[:, None, :].expand(T, heads, rope)], dim=-1)
+    mask = torch.zeros(T, T, dtype=torch.bool)
+    valid = packed >= 0
+    mask[torch.arange(T)[:, None].expand_as(packed)[valid], packed[valid]] = True
+    s = torch.einsum("thd,shd->hts", q, k) * scale
+    s = s.masked_fill(~mask[None], float("-inf"))
+    p = torch.softmax(s, dim=-1)
+    return torch.einsum("hts,shv->thv", p, val).reshape(T, heads * v)
+
