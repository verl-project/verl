+def test_absorbed_core_equals_mla_and_grads():
+    gen = torch.Generator().manual_seed(7)
+    counts, topk = [7, 12], 5
+    heads, nope, rope, v, lr = 3, 8, 4, 6, 10
+    meta, logical, packed = _packed_indices(counts, topk, gen=gen, drop=0.2)
+    T = sum(counts)
+    f64 = dict(dtype=torch.float64)
+    q = torch.randn(T, heads, nope + rope, generator=gen, **f64).requires_grad_()
+    kv_c = torch.randn(T, lr, generator=gen, **f64).requires_grad_()
+    k_pe = torch.randn(T, rope, generator=gen, **f64).requires_grad_()
+    kv_b_w = torch.randn(heads * (nope + v), lr, generator=gen, **f64) * lr**-0.5
+    w_uk_t, w_uv = absorbed_weights(
+        kv_b_w, kv_lora_rank=lr, num_heads=heads, qk_nope_head_dim=nope, v_head_dim=v
+    )
+    scale = (nope + rope) ** -0.5
+    out = R.attention_core_rocm(
+        q, kv_c, k_pe, logical, meta, w_uk_t=w_uk_t, w_uv=w_uv,
+        softmax_scale=scale, qk_nope_head_dim=nope, sparse="reference",
+    )
+    ref = _mla_non_absorbed(
+        q, kv_c, k_pe, kv_b_w, packed, heads=heads, nope=nope, rope=rope, v=v, scale=scale
+    )
+    # absorb / v_up VJPs run in fp32 (as the NVIDIA core), so fp64 inputs see fp32-level error
+    torch.testing.assert_close(out, ref, rtol=1e-10, atol=1e-10)
+    go = torch.randn_like(out)
+    g = torch.autograd.grad(out, (q, kv_c, k_pe), go)
+    gr = torch.autograd.grad(ref, (q, kv_c, k_pe), go)
+    for a, b in zip(g, gr):
+        torch.testing.assert_close(a, b, rtol=1e-5, atol=1e-6)
+
