+++ b/experimental/lite/megatron/lite/model/k31/vllm/primitive/dsa_rocm.py
@@ -0,0 +1,657 @@
+"""K31 DSA on ROCm, BI off: frozen indexer top-k + absorbed sparse MLA forward/backward.
+
+The NVIDIA path (``primitive/attention.py`` + ``primitive/kernels/vllm_k31.py``)
+drives FlashMLA fp8 / DeepSelect / cuDNN entries that do not exist on ROCm.  This
+module is the ROCm replacement with BI off.  The reference it matches is the
+rollout of the ROCm vLLM build with Kimi-K3.1 support:
+
+* indexer (``rocm_aiter_sparse_attn_indexer``): ``index_q = wq_b(q_c)`` (32 x 128,
+  NoPE), ``index_k = LayerNorm_fp32(wk(h))``, per-head weights
+  ``weights_proj(h) * H^-1/2``; Q quantized to FP8 e4m3 per (token, head) with a
+  ue8m0 scale folded into the fp32 weights together with ``D^-1/2``; K quantized
+  to FP8 per token (ue8m0, ``max(amax, 1e-4) / 448``) on cache insert; logits
+  ``sum_h relu(q_h . k * k_scale) * w_h`` over the causal window of the request;
+  top-2048 per row, request-local indices, ``-1`` tail.
+* sparse MLA (``ROCM_AITER_MLA_SPARSE``, BF16 KV cache): exact softmax attention
+  of the absorbed query (T, H, 576 = 512 latent + 64 NoPE tail) over the 576-wide
+  KV rows the top-k selects; values are the first 512 columns; scale
+  ``(qk_nope + qk_rope)^-1/2``; no sink.  The ragged index stream holds
+  ``min(pos + 1, topk)`` rows per token, i.e. the ``-1`` entries are dropped.
+
+What is here:
+
+* :func:`reference_indexer_topk`: a chunked PyTorch emulation of the indexer
+  (FP8 Q/K value rounding included).  Frozen, forward only.
+* :class:`VllmRocmIndexer`: calls the image's ``rocm_aiter_sparse_attn_indexer``
+  op when it is registered (the rollout's own scorer and top-k).
+* :class:`SparseMLAFunction` / :func:`sparse_mla`: chunked FP32 sparse MLA with
+  an explicit backward (dq, dkv via ``index_add_``).  Memory is bounded by
+  ``chunk_tokens``; no (T, T) tensor is materialised.
+* :func:`tilelang_sparse_mla`: Miles' gfx950 TileLang kernels
+  (``miles.kernels.attention.dsa.sparse_attention``) as the fast option, run in
+  head groups of 48 because the forward asserts ``heads % 64 == 0`` above 64.
+* :func:`attention_core_rocm`: the absorbed-MLA core (W_UK^T absorb, sparse MLA,
+  W_UV up-projection) with the same FP32 VJPs as the NVIDIA core.
+* :class:`K31DSARocmMetadata` / :func:`build_dsa_rocm_metadata`: packed-batch
+  bookkeeping (no vLLM caches, no BI init).
+
+Selection (``dsa.py``): ``MLITE_K31_DSA_IMPL`` = ``vllm`` (NVIDIA path) or
+``rocm`` (this module; the default when ``k31_backend.is_rocm()``);
+``MLITE_K31_DSA_INDEXER`` = ``reference`` (default) or ``vllm_rocm``;
+``MLITE_K31_DSA_SPARSE`` = ``reference`` (default) or ``tilelang``.
+"""
+
+from __future__ import annotations
+
+import importlib
+import math
+import os
+from dataclasses import dataclass
+from typing import Any, Callable
+
+import torch
+import torch.nn.functional as F
+
+FP8_E4M3_MAX = 448.0
+INDEXER_K_SCALE_FLOOR = 1e-4  # indexer_k_quant_and_cache_triton
+INDEXER_Q_SCALE_FLOOR = 1e-10  # per_token_group_quant_fp8 eps
+LATENT_DIM = 512
+ROPE_DIM = 64
+HEAD_DIM = LATENT_DIM + ROPE_DIM
+
+# Bound for each chunk's fp32 temporaries (scores / gathered KV), in bytes.
+_DEFAULT_CHUNK_BYTES = 512 * 1024 * 1024
+
+
+def _env(name: str, default: str) -> str:
+    return os.environ.get(name, default).strip().lower()
+
+
+def dsa_impl() -> str:
+    from megatron.lite.primitive.kernels import k31_backend
+
+    default = "rocm" if k31_backend.is_rocm() else "vllm"
+    value = _env("MLITE_K31_DSA_IMPL", default)
+    if value not in ("vllm", "rocm"):
+        raise ValueError(f"MLITE_K31_DSA_IMPL must be vllm or rocm, got {value!r}")
+    return value
+
+
+def indexer_impl() -> str:
+    value = _env("MLITE_K31_DSA_INDEXER", "reference")
+    if value not in ("reference", "vllm_rocm"):
+        raise ValueError(f"MLITE_K31_DSA_INDEXER must be reference or vllm_rocm, got {value!r}")
+    return value
+
+
+def sparse_impl() -> str:
+    value = _env("MLITE_K31_DSA_SPARSE", "reference")
+    if value not in ("reference", "tilelang"):
+        raise ValueError(f"MLITE_K31_DSA_SPARSE must be reference or tilelang, got {value!r}")
+    return value
+
+
+def kv_fp8_mode() -> str:
+    """``ds_mla`` (default): the rollout's fp8_ds_mla KV rounding (ROCm default cache dtype for
+    K3.1 DSA, ``KimiK3ForConditionalGenerationConfig``); ``off``: BF16 KV."""
+    value = _env("MLITE_K31_DSA_KV_FP8", "ds_mla")
+    if value not in ("ds_mla", "off"):
+        raise ValueError(f"MLITE_K31_DSA_KV_FP8 must be ds_mla or off, got {value!r}")
+    return value
+
+
+def _fp8_dtype() -> torch.dtype:
+    # gfx950 (MI355X) uses OCP e4m3fn, like the image (IS_FNUZ is False there).
+    return torch.float8_e4m3fn
+
+
+# ---------------------------------------------------------------------------
+# fp8_ds_mla KV rounding (forward value of the rollout cache, identity gradient)
+# ---------------------------------------------------------------------------
+DS_MLA_TILE = 128
+
+
+def ds_mla_round(kv_c: torch.Tensor) -> torch.Tensor:
+    """bf16 value the rollout reads back for the 512-wide latent of an fp8_ds_mla row.
+
+    Per 128-wide tile (csrc ``concat_and_cache_ds_mla``): ``scale = 2^ceil(log2(max(amax / 448,
+    1e-4)))`` (fp32, power of two), value ``e4m3(x / scale)``, read back as ``fp8 * scale``.
+    The 64-wide rope tail is stored as raw bf16 (exact).
+    """
+
+    t, d = kv_c.shape
+    if d % DS_MLA_TILE:
+        raise ValueError(f"fp8_ds_mla rounding needs a latent width multiple of 128, got {d}")
+    x = kv_c.float().view(t, d // DS_MLA_TILE, DS_MLA_TILE)
+    amax = x.abs().amax(dim=-1, keepdim=True)
+    scale = _ue8m0(torch.clamp(amax / FP8_E4M3_MAX, min=1e-4))
+    q = torch.clamp(x / scale, -FP8_E4M3_MAX, FP8_E4M3_MAX).to(_fp8_dtype()).float()
+    return (q * scale).view(t, d).to(kv_c.dtype)
+
+
+class _STERound(torch.autograd.Function):
+    """Forward: the rounded value; backward: identity (as zm's STE through fp8_ds_mla)."""
+
+    @staticmethod
+    def forward(ctx, x, fn):
+        return fn(x.detach())
+
+    @staticmethod
+    def backward(ctx, grad):
+        return grad, None
+
+
+def kv_latent_for_attention(kv_c_normed: torch.Tensor, mode: str | None = None) -> torch.Tensor:
+    mode = mode or kv_fp8_mode()
+    if mode == "off":
+        return kv_c_normed
+    return _STERound.apply(kv_c_normed, ds_mla_round)
+
+
+# ---------------------------------------------------------------------------
+# metadata
+# ---------------------------------------------------------------------------
+@dataclass
+class K31DSARocmMetadata:
+    """Packed batch of fresh requests (context 0), the trainer's only shape."""
+
+    token_counts: tuple[int, ...]
+    cu_seqlens: torch.Tensor  # (R + 1,) int64
+    req_id_per_token: torch.Tensor  # (T,) int64
+    positions: torch.Tensor  # (T,) int64, request-local
+    token_starts: torch.Tensor  # (T,) int64, packed row of the token's request start
+    topk: int
+
+
+def build_dsa_rocm_metadata(
+    seq_lens: list[int] | tuple[int, ...], *, device: torch.device | str, topk: int = 2048
+) -> K31DSARocmMetadata:
+    counts = [int(c) for c in seq_lens]
+    if not counts or min(counts) <= 0:
+        raise ValueError("seq_lens must be positive")
+    dev = torch.device(device)
+    lens = torch.tensor(counts, dtype=torch.int64, device=dev)
+    cu = torch.zeros(len(counts) + 1, dtype=torch.int64, device=dev)
+    cu[1:] = lens.cumsum(0)
+    req = torch.repeat_interleave(torch.arange(len(counts), device=dev), lens)
+    starts = cu[:-1].index_select(0, req)
+    positions = torch.arange(int(cu[-1]), device=dev) - starts
+    return K31DSARocmMetadata(
+        token_counts=tuple(counts),
+        cu_seqlens=cu,
+        req_id_per_token=req,
+        positions=positions,
+        token_starts=starts,
+        topk=int(topk),
+    )
+
+
+def logical_to_packed(logical_topk: torch.Tensor, metadata: K31DSARocmMetadata) -> torch.Tensor:
+    """Request-local top-k (-1 tail) -> packed KV-row indices (-1 kept), int64."""
+
+    logical = logical_topk.long()
+    return torch.where(logical >= 0, logical + metadata.token_starts[:, None], -1)
+
+
+# ---------------------------------------------------------------------------
+# indexer: FP8 emulation + causal top-k (frozen, forward only)
+# ---------------------------------------------------------------------------
+def _ue8m0(scale: torch.Tensor) -> torch.Tensor:
+    return torch.exp2(torch.ceil(torch.log2(scale)))
+
+
+def quant_fp8_ue8m0(x: torch.Tensor, floor: float) -> tuple[torch.Tensor, torch.Tensor]:
+    """Per-row (last dim) FP8 e4m3 quantization with a power-of-two scale.
+
+    Returns the dequantization *factors*: ``fp8 values as fp32`` and the fp32
+    scale, so ``value ~= q * scale``.  Matches ``per_token_group_quant_fp8``
+    (group = row, ``use_ue8m0=True``) and ``indexer_k_quant_and_cache``.
+    """
+
+    xf = x.float()
+    amax = xf.abs().amax(dim=-1, keepdim=True)
+    scale = _ue8m0(torch.clamp(amax, min=floor) / FP8_E4M3_MAX)
+    q = torch.clamp(xf / scale, -FP8_E4M3_MAX, FP8_E4M3_MAX).to(_fp8_dtype()).float()
+    return q, scale
+
+
+def _index_k_norm(k_lin, weight, bias, eps):
+    """``amd/dsa.py`` KimiK3DSAIndexerKNorm: fp32 params cast to the activation dtype, then
+    ``F.layer_norm`` on the bf16 key (fp32 accumulation, bf16 affine)."""
+    d = k_lin.shape[-1]
+    return F.layer_norm(k_lin, (d,), weight.to(k_lin.dtype), bias.to(k_lin.dtype), eps)
+
+
+@dataclass
+class IndexerInputs:
+    """FP8-rounded indexer operands: q (T, H, D) fp32 values on the fp8 grid,
+    k (T, D) likewise, k_scale (T,), weights (T, H) fp32 with q scale and
+    softmax scale folded in."""
+
+    q: torch.Tensor
+    k: torch.Tensor
+    k_scale: torch.Tensor
+    weights: torch.Tensor
+
+
+def indexer_inputs(
+    hidden_states: torch.Tensor,
+    q_c: torch.Tensor,
+    *,
+    wq: torch.Tensor,
+    wk: torch.Tensor,
+    wv: torch.Tensor,
+    k_norm_weight: torch.Tensor,
+    k_norm_bias: torch.Tensor,
+    k_norm_eps: float,
+    num_heads: int,
+    head_dim: int,
+    emulate_fp8: bool = True,
+) -> IndexerInputs:
+    """The indexer's projections and quantization, as the rollout computes them."""
+
+    with torch.no_grad():
+        h = hidden_states.detach()
+        index_q = F.linear(q_c.detach(), wq.detach()).view(-1, num_heads, head_dim)
+        k_lin = F.linear(h, wk.detach())
+        index_k = _index_k_norm(k_lin, k_norm_weight, k_norm_bias, k_norm_eps)
+        # bf16 head weights scaled by H^-1/2 (vLLM: index_weights * indexer_weight_scale)
+        index_v = F.linear(h, wv.detach()) * (num_heads**-0.5)
+        if emulate_fp8:
+            q_val, q_scale = quant_fp8_ue8m0(index_q, INDEXER_Q_SCALE_FLOOR)  # (T, H, D), (T, H, 1)
+            k_val, k_scale = quant_fp8_ue8m0(index_k, INDEXER_K_SCALE_FLOOR)  # (T, D), (T, 1)
+            weights = index_v.float() * q_scale.squeeze(-1) * (head_dim**-0.5)
+            return IndexerInputs(q_val, k_val, k_scale.squeeze(-1), weights)
+        weights = index_v.float() * (head_dim**-0.5)
+        ones = torch.ones(index_k.shape[0], dtype=torch.float32, device=index_k.device)
+        return IndexerInputs(index_q.float(), index_k.float(), ones, weights)
+
+
+def indexer_logits(inputs: IndexerInputs, rows: slice, keys: slice) -> torch.Tensor:
+    """fp32 logits (len(rows), len(keys)) = sum_h relu(q_h . k * k_scale) * w_h."""
+
+    q = inputs.q[rows]  # (m, H, D)
+    k = inputs.k[keys]  # (n, D)
+    score = torch.einsum("mhd,nd->mhn", q, k) * inputs.k_scale[keys]
+    return (score.relu() * inputs.weights[rows].unsqueeze(-1)).sum(dim=1)
+
+
+def reference_indexer_topk(
+    inputs: IndexerInputs,
+    metadata: K31DSARocmMetadata,
+    *,
+    topk: int,
+    chunk_bytes: int = _DEFAULT_CHUNK_BYTES,
+) -> torch.Tensor:
+    """Causal per-request top-k: (T, topk) int32 request-local indices, -1 tail.
+
+    Rows with ``pos + 1 <= topk`` keep their whole causal window (indices
+    ``0..pos``), as the rollout does.  Order within a row is by descending
+    score; attention is order-invariant.
+    """
+
+    total = int(metadata.cu_seqlens[-1])
+    heads = inputs.q.shape[1]
+    out = torch.full((total, topk), -1, dtype=torch.int32, device=inputs.q.device)
+    cu = metadata.cu_seqlens.tolist()
+    for r, n in enumerate(metadata.token_counts):
+        start = cu[r]
+        # rows whose window fits in topk: the whole causal prefix, no scoring needed
+        short = min(n, topk)
+        if short > 0:
+            ar = torch.arange(topk, device=out.device, dtype=torch.int32)
+            pos = torch.arange(short, device=out.device, dtype=torch.int32)[:, None]
+            out[start : start + short] = torch.where(ar[None, :] <= pos, ar[None, :], -1)
+        if n <= topk:
+            continue
+        # per-row bytes: scores (H x n) + logits (n), fp32
+        per_row = max(1, (heads + 2) * n * 4)
+        step = max(1, chunk_bytes // per_row)
+        for lo in range(topk, n, step):
+            hi = min(n, lo + step)
+            logits = indexer_logits(inputs, slice(start + lo, start + hi), slice(start, start + hi))
+            cols = torch.arange(hi, device=logits.device)
+            pos = torch.arange(lo, hi, device=logits.device)[:, None]
+            logits = logits.masked_fill(cols[None, :] > pos, float("-inf"))
+            out[start + lo : start + hi] = logits.topk(topk, dim=-1).indices.to(torch.int32)
+    return out
+
+
+class VllmRocmIndexer:
+    """The image's ``torch.ops.vllm.rocm_aiter_sparse_attn_indexer`` (scorer + top-k).
+
+    Builds the minimal vLLM state the op reads: an fp8 index-K cache of
+    ``block_size``-row blocks (132 bytes/token), ``DeepseekV32IndexerMetadata``
+    for an all-prefill batch, and a forward context.  Validated on node only.
+    """
+
+    def __init__(self, *, max_model_len: int, block_size: int = 64) -> None:
+        self.max_model_len = int(max_model_len)
+        self.block_size = int(block_size)
+
+    def __call__(
+        self,
+        hidden_states: torch.Tensor,
+        q_fp8: torch.Tensor,
+        index_k: torch.Tensor,
+        weights: torch.Tensor,
+        metadata: K31DSARocmMetadata,
+        *,
+        head_dim: int,
+        topk: int,
+    ) -> torch.Tensor:
+        from megatron.lite.model.k31.vllm.dsa import K31DSAMetadataBuilder
+
+        op = torch.ops.vllm.rocm_aiter_sparse_attn_indexer
+        encode = importlib.import_module("vllm.utils.torch_utils")._encode_layer_name
+        workspace = importlib.import_module("vllm.v1.worker.workspace")
+        dev = hidden_states.device
+        if not workspace.is_workspace_manager_initialized():
+            workspace.init_workspace_manager(dev, num_ubatches=1)
+        builder = K31DSAMetadataBuilder(
+            device=dev, max_model_len=self.max_model_len, topk=topk, block_size=self.block_size
+        )
+        meta = builder.build(list(metadata.token_counts), layer_name="k31.dsa.rocm")
+        ind = meta.indexer
+        forward_module = importlib.import_module("vllm.forward_context")
+        context = forward_module.ForwardContext(
+            no_compile_layers={},
+            attn_metadata={ind.k_cache_prefix: ind.attention_metadata},
+            slot_mapping={},
+        )
+        with forward_module.override_forward_context(context):
+            op(
+                hidden_states.detach(),
+                encode(ind.k_cache_prefix),
+                ind.k_cache,
+                q_fp8,
+                index_k,
+                weights,
+                head_dim,
+                "ue8m0",
+                topk,
+                head_dim,
+                ind.max_model_len,
+                ind.max_total_seq_len,
+                ind.topk_buffer,
+                cache_layout="NORMAL",  # as amd/dsa.py _indexer (image op signature)
+            )
+        return ind.topk_buffer[: hidden_states.shape[0]].clone()
+
+
+def indexer_topk_rocm(
+    hidden_states: torch.Tensor,
+    q_c: torch.Tensor,
+    *,
+    weights: dict[str, Any],
+    num_heads: int,
+    head_dim: int,
+    topk: int,
+    metadata: K31DSARocmMetadata,
+    impl: str | None = None,
+    max_model_len: int | None = None,
+) -> torch.Tensor:
+    """Frozen indexer selection on ROCm: (T, topk) int32 request-local, -1 tail."""
+
+    impl = impl or indexer_impl()
+    kw = dict(
+        wq=weights["wq"],
+        wk=weights["wk"],
+        wv=weights["wv"],
+        k_norm_weight=weights["k_norm_weight"],
+        k_norm_bias=weights["k_norm_bias"],
+        k_norm_eps=weights["k_norm_eps"],
+        num_heads=num_heads,
+        head_dim=head_dim,
+    )
+    if impl == "reference":
+        return reference_indexer_topk(indexer_inputs(hidden_states, q_c, **kw), metadata, topk=topk)
+    with torch.no_grad():
+        h = hidden_states.detach()
+        index_q = F.linear(q_c.detach(), kw["wq"].detach()).view(-1, num_heads, head_dim)
+        k_lin = F.linear(h, kw["wk"].detach())
+        index_k = _index_k_norm(k_lin, kw["k_norm_weight"], kw["k_norm_bias"], kw["k_norm_eps"])
+        index_v = F.linear(h, kw["wv"].detach()) * (num_heads**-0.5)
+        quant = importlib.import_module(
+            "vllm.model_executor.layers.quantization.utils.fp8_utils"
+        ).per_token_group_quant_fp8
+        q_fp8, q_scale = quant(
+            index_q.reshape(-1, head_dim).contiguous(), head_dim,
+            column_major_scales=False, use_ue8m0=True,
+        )
+        q_fp8 = q_fp8.view(index_q.shape)
+        w = (index_v.float() * q_scale.view(-1, num_heads) * head_dim**-0.5).contiguous()
+        if max_model_len is None:
+            max_model_len = max(metadata.token_counts)
+        return VllmRocmIndexer(max_model_len=max_model_len)(
+            h, q_fp8, index_k, w, metadata, head_dim=head_dim, topk=topk
+        )
+
+
+# ---------------------------------------------------------------------------
+# sparse MLA: chunked fp32 reference with explicit backward
+# ---------------------------------------------------------------------------
+def _chunk_rows(heads: int, topk: int, dim: int, chunk_bytes: int) -> int:
+    # gathered KV (topk x dim) + scores/probs/dS (3 x heads x topk), fp32 per row
+    per_row = 4 * (topk * dim + 3 * heads * topk + 2 * heads * dim)
+    return max(1, chunk_bytes // per_row)
+
+
+def _acc(dtype: torch.dtype) -> torch.dtype:
+    return torch.promote_types(dtype, torch.float32)
+
+
+def _sparse_fwd_chunk(q, kv, idx, scale, d_v):
+    acc = _acc(q.dtype)
+    valid = idx >= 0
+    kvg = kv.index_select(0, idx.clamp(min=0).reshape(-1)).view(*idx.shape, kv.shape[-1]).to(acc)
+    s = torch.einsum("chd,ckd->chk", q.to(acc), kvg) * scale
+    s = s.masked_fill(~valid[:, None, :], float("-inf"))
+    lse = torch.logsumexp(s, dim=-1)  # (c, H); -inf for empty rows
+    safe = torch.where(torch.isfinite(lse), lse, torch.zeros_like(lse))
+    p = torch.exp(s - safe[..., None])
+    out = torch.einsum("chk,ckd->chd", p, kvg[..., :d_v])
+    return out, lse, p, kvg
+
+
+class SparseMLAFunction(torch.autograd.Function):
+    """out[t, h] = softmax_k(scale * q[t, h] . kv[idx[t, k]]) @ kv[idx[t, k], :d_v].
+
+    q (T, H, 576) bf16, kv (S, 576) bf16 shared by all heads, idx (T, K) int
+    packed KV rows with -1 padding.  Forward returns out (T, H, d_v) in q's dtype;
+    ``lse`` (natural log, fp32) is kept for backward.  All math in fp32.
+    """
+
+    @staticmethod
+    def forward(ctx, q, kv, idx, scale, d_v, chunk_bytes):
+        T, H, D = q.shape
+        rows = _chunk_rows(H, idx.shape[1], D, chunk_bytes)
+        out = q.new_empty((T, H, d_v))
+        lse = torch.empty((T, H), dtype=_acc(q.dtype), device=q.device)
+        idx = idx.long()
+        for lo in range(0, T, rows):
+            hi = min(T, lo + rows)
+            o, l, _p, _k = _sparse_fwd_chunk(q[lo:hi], kv, idx[lo:hi], scale, d_v)
+            out[lo:hi] = o.to(out.dtype)
+            lse[lo:hi] = l
+        ctx.save_for_backward(q, kv, idx, lse)
+        ctx.scale, ctx.d_v, ctx.chunk_bytes = scale, d_v, chunk_bytes
+        ctx.mark_non_differentiable(lse)
+        return out, lse
+
+    @staticmethod
+    def backward(ctx, grad_out, _grad_lse):
+        q, kv, idx, lse = ctx.saved_tensors
+        scale, d_v = ctx.scale, ctx.d_v
+        T, H, D = q.shape
+        rows = _chunk_rows(H, idx.shape[1], D, ctx.chunk_bytes)
+        dq = torch.zeros_like(q) if ctx.needs_input_grad[0] else None
+        acc = _acc(q.dtype)
+        dkv = (
+            torch.zeros(kv.shape, dtype=acc, device=kv.device)
+            if ctx.needs_input_grad[1]
+            else None
+        )
+        for lo in range(0, T, rows):
+            hi = min(T, lo + rows)
+            ix = idx[lo:hi]
+            valid = ix >= 0
+            kvg = kv.index_select(0, ix.clamp(min=0).reshape(-1)).view(*ix.shape, D).to(acc)
+            qf = q[lo:hi].to(acc)
+            s = torch.einsum("chd,ckd->chk", qf, kvg) * scale
+            l = lse[lo:hi]
+            safe = torch.where(torch.isfinite(l), l, torch.zeros_like(l))
+            p = torch.exp(s - safe[..., None]).masked_fill(~valid[:, None, :], 0.0)
+            do = grad_out[lo:hi].to(acc)
+            dp = torch.einsum("chd,ckd->chk", do, kvg[..., :d_v])
+            delta = (p * dp).sum(dim=-1, keepdim=True)  # = rowsum(dO * O) in fp32
+            ds = p * (dp - delta) * scale
+            if dq is not None:
+                dq[lo:hi] = torch.einsum("chk,ckd->chd", ds, kvg).to(dq.dtype)
+            if dkv is not None:
+                dkvg = torch.einsum("chk,chd->ckd", ds, qf)
+                dkvg[..., :d_v] += torch.einsum("chk,chd->ckd", p, do)
+                dkvg = dkvg.masked_fill(~valid[..., None], 0.0)
+                dkv.index_add_(0, ix.clamp(min=0).reshape(-1), dkvg.reshape(-1, D))
+        return dq, (dkv.to(kv.dtype) if dkv is not None else None), None, None, None, None
+
+
+def sparse_mla(
+    q: torch.Tensor,
+    kv: torch.Tensor,
+    indices: torch.Tensor,
+    *,
+    softmax_scale: float,
+    d_v: int = LATENT_DIM,
+    chunk_bytes: int = _DEFAULT_CHUNK_BYTES,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Reference sparse MLA; returns (out (T, H, d_v), lse (T, H) natural log)."""
+
+    if q.ndim != 3 or kv.ndim != 2 or indices.ndim != 2:
+        raise ValueError("q (T, H, D), kv (S, D), indices (T, K)")
+    if q.shape[-1] != kv.shape[-1] or q.shape[0] != indices.shape[0]:
+        raise ValueError(f"shape mismatch q={tuple(q.shape)} kv={tuple(kv.shape)} idx={tuple(indices.shape)}")
+    return SparseMLAFunction.apply(q, kv, indices, float(softmax_scale), int(d_v), int(chunk_bytes))
+
+
+def tilelang_sparse_mla(
+    q: torch.Tensor,
+    kv: torch.Tensor,
+    indices: torch.Tensor,
+    *,
+    softmax_scale: float,
+    d_v: int = LATENT_DIM,
+    head_group: int = 48,
+) -> torch.Tensor:
+    """Miles' TileLang sparse attention (gfx950), heads split into groups of ``head_group``.
+
+    Needs ``miles`` importable (``MLITE_K31_MILES_PATH`` is prepended to
+    ``sys.path``) and sets ``MILES_HARDWARE_PLATFORM=rocm`` for its backward.
+    Each group goes through Miles' own autograd (dkv of the groups add up).
+    """
+
+    import sys
+
+    path = os.environ.get("MLITE_K31_MILES_PATH")
+    if path and path not in sys.path:
+        sys.path.insert(0, path)
+    os.environ.setdefault("MILES_HARDWARE_PLATFORM", "rocm")
+    sparse_attention = importlib.import_module(
+        "miles.kernels.attention.dsa.sparse_attention"
+    ).sparse_attention
+    T, H, _ = q.shape
+    kv4 = kv.view(1, kv.shape[0], 1, kv.shape[1])
+    idx4 = indices.to(torch.int32).view(1, T, 1, -1)
+    outs = []
+    for lo in range(0, H, head_group):
+        hi = min(H, lo + head_group)
+        q4 = q[:, lo:hi].unsqueeze(0)
+        outs.append(sparse_attention(q4, kv4, idx4, softmax_scale, d_v=d_v).squeeze(0))
+    return torch.cat(outs, dim=1)
+
+
+# ---------------------------------------------------------------------------
+# absorbed MLA core (ROCm): absorb bmm, sparse MLA, V up-projection
+# ---------------------------------------------------------------------------
+class TorchAbsorbBmm:
+    """``torch.bmm`` with vLLM's layouts (the BF16 path of ``MLAAttention``)."""
+
+    def absorb(self, q_nope: torch.Tensor, w_uk_t: torch.Tensor) -> torch.Tensor:
+        b, n, _p = q_nope.shape
+        out = q_nope.new_empty((b, n, w_uk_t.shape[-1]))
+        torch.bmm(q_nope.transpose(0, 1), w_uk_t, out=out.transpose(0, 1))
+        return out
+
+    def v_up(self, attn: torch.Tensor, w_uv: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+        n, lr, v = w_uv.shape
+        x = attn.reshape(-1, n, lr).transpose(0, 1)
+        torch.bmm(x, w_uv, out=out.view(-1, n, v).transpose(0, 1))
+        return out
+
+
+def attention_core_rocm(
+    q: torch.Tensor,
+    kv_c_normed: torch.Tensor,
+    k_pe: torch.Tensor,
+    logical_topk: torch.Tensor,
+    metadata: K31DSARocmMetadata,
+    *,
+    w_uk_t: torch.Tensor,
+    w_uv: torch.Tensor,
+    softmax_scale: float,
+    qk_nope_head_dim: int,
+    sparse: str | Callable[..., torch.Tensor] | None = None,
+) -> torch.Tensor:
+    """ROCm absorbed sparse MLA: pre-gate attention output (T, H * V).
+
+    Same contract as ``attention.attention_core``: ``q`` (T, H, nope + rope) is
+    the q_b_proj output, ``kv_c_normed`` (T, 512), ``k_pe`` (T, 64) (NoPE, not
+    rotated), ``logical_topk`` (T, K) request-local indices with a -1 tail.
+    """
+
+    from megatron.lite.model.k31.vllm.primitive.attention import _AbsorbFunction, _VUpFunction
+
+    if q.ndim != 3:
+        raise ValueError("q must be (T, H, qk_head_dim)")
+    bmm = TorchAbsorbBmm()
+    q_nope, q_pe = q.split([qk_nope_head_dim, q.shape[-1] - qk_nope_head_dim], dim=-1)
+    ql_nope = _AbsorbFunction.apply(bmm, q_nope, w_uk_t)
+    q_cat = torch.cat((ql_nope, q_pe), dim=-1)
+    kv_rows = torch.cat((kv_latent_for_attention(kv_c_normed), k_pe), dim=-1)
+    packed = logical_to_packed(logical_topk.detach(), metadata)
+    d_v = kv_c_normed.shape[-1]
+    sparse = sparse or sparse_impl()
+    if sparse == "reference":
+        attn, _lse = sparse_mla(q_cat, kv_rows, packed, softmax_scale=softmax_scale, d_v=d_v)
+    elif sparse == "tilelang":
+        attn = tilelang_sparse_mla(q_cat, kv_rows, packed, softmax_scale=softmax_scale, d_v=d_v)
+    elif callable(sparse):
+        attn = sparse(q_cat, kv_rows, packed, softmax_scale=softmax_scale, d_v=d_v)
+    else:
+        raise ValueError(f"unknown sparse MLA impl {sparse!r}")
+    return _VUpFunction.apply(bmm, attn, w_uv)
+
+
