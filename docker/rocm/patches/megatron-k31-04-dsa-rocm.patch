+def test_ds_mla_kv_rounding_and_ste():
+    """fp8_ds_mla latent: per-128 power-of-two scale >= 1e-4, e4m3 grid, identity gradient."""
+    gen = torch.Generator().manual_seed(12)
+    kv = (torch.randn(9, 512, generator=gen) * torch.logspace(-6, 2, 9)[:, None]).bfloat16()
+    r = R.ds_mla_round(kv)
+    x = kv.float().view(9, 4, 128)
+    amax = x.abs().amax(-1, keepdim=True)
+    scale = torch.exp2(torch.ceil(torch.log2(torch.clamp(amax / 448, min=1e-4))))
+    q = r.float().view(9, 4, 128) / scale
+    assert torch.equal(q, q.to(torch.float8_e4m3fn).float()), "values are fp8 * pow2 scale"
+    assert ((r.float() - kv.float()).abs().view(9, 4, 128) <= scale * 32 + 1e-12).all()
+    kv.requires_grad_()
+    out = R.kv_latent_for_attention(kv, "ds_mla")
+    assert torch.equal(out.detach(), r)
+    g = torch.randn_like(out)
+    (gk,) = torch.autograd.grad(out, (kv,), g)
+    assert torch.equal(gk, g)
+    assert R.kv_latent_for_attention(kv, "off") is kv
