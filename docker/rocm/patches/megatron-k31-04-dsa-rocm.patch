+def test_dsa_layer_lora_on_rocm_backend(monkeypatch):
+    """zm LoRA layout on the DSA projections (fused_qkv_a, q_b, g, o; never kv_b / indexer), real
+    ROCm backend adapters: adapter grads flow, base frozen, B = 0 leaves the output."""
+    import sys
+    from pathlib import Path
+    from types import SimpleNamespace
+
+    sys.path.insert(0, str(Path(__file__).parent))
+    from _tiny import tiny_config, tiny_lora
+
+    from megatron.lite.model.k31.vllm import dsa as dsa_mod
+    from megatron.lite.primitive.kernels import k31_backend
+
+    monkeypatch.setenv("MLITE_K31_BACKEND", "rocm")
+    monkeypatch.delenv("MLITE_K31_DSA_IMPL", raising=False)
+    k31_backend.backend.cache_clear()
+    k31_backend.adapters.cache_clear()
+    try:
+        assert R.dsa_impl() == "rocm"
+        cfg = tiny_config(index_topk=4, index_head_dim=8, index_num_heads=2)
+        layer = dsa_mod.K31DSAAttention(
+            cfg, layer_idx=2, ps=None, selected_stages=frozenset(), lora=tiny_lora()
+        )
+        lora_names = [n for n, _ in layer.named_parameters() if "lora" in n]
+        wrapped = {n.split(".")[0] for n in lora_names}
+        assert wrapped == {"fused_qkv_a_proj", "q_b_proj", "g_proj", "o_proj"}, wrapped
+        gen = torch.Generator().manual_seed(11)
+        for n, p in layer.named_parameters():
+            with torch.no_grad():
+                p.copy_((torch.randn(p.shape, generator=gen) * 0.3).to(p.dtype))
+            p.requires_grad_("lora" in n)
+        # The ROCm linear VJP uses torch.mm(out_dtype=fp32), GPU-only: backward runs on GPU only.
+        dev = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+        layer = layer.to(dev)
+        counts = [5, 8]
+        runtime = SimpleNamespace(
+            cu_seqlens=torch.tensor([0, 5, 13], device=dev), seq_lens=counts,
+            lora_meta="rocm-single-adapter",
+        )
+        meta = dsa_mod.build_dsa_metadata(runtime, max_model_len=64, topk=cfg.index_topk)
+        h = torch.randn(sum(counts), cfg.hidden_size, generator=gen).bfloat16().to(dev)
+        h.requires_grad_(dev.type == "cuda")
+        out = layer(h, metadata=meta, runtime=runtime)
+        if dev.type == "cuda":
+            out.float().square().sum().backward()
+            for n, p in layer.named_parameters():
+                if "lora" in n:
+                    assert p.grad is not None and torch.isfinite(p.grad.float()).all(), n
+                    assert p.grad.abs().sum() > 0, n
+                else:
+                    assert p.grad is None, n
+            assert h.grad is not None and torch.isfinite(h.grad.float()).all()
+        # B = 0  ->  identical to the LoRA-free layer with the same base weights
+        base = dsa_mod.K31DSAAttention(
+            cfg, layer_idx=2, ps=None, selected_stages=frozenset(), lora=None
+        ).to(dev)
+        base.load_state_dict({k: v for k, v in layer.state_dict().items() if "lora" not in k})
+        with torch.no_grad():
+            for n, p in layer.named_parameters():
+                if ".lora_B." in n:
+                    p.zero_()
+            o_lora = layer(h.detach(), metadata=meta, runtime=runtime)
+            o_base = base(h.detach(), metadata=meta, runtime=runtime)
+        torch.testing.assert_close(o_lora, o_base, rtol=0, atol=0)
+        assert not torch.equal(o_lora, out.detach()), "nonzero LoRA must change the output"
+    finally:
+        k31_backend.backend.cache_clear()
+        k31_backend.adapters.cache_clear()
+
