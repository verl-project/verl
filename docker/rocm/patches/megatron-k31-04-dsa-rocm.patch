+@pytest.mark.parametrize("chunk_bytes", [1 << 30, 3000], ids=["one-chunk", "many-chunks"])
+def test_reference_indexer_topk_brute_force(chunk_bytes):
+    gen = torch.Generator().manual_seed(5)
+    counts, topk, H, Dh, hidden, q_lora = [3, 20, 9], 6, 4, 16, 32, 24
+    T = sum(counts)
+    meta = R.build_dsa_rocm_metadata(counts, device="cpu", topk=topk)
+    h = torch.randn(T, hidden, generator=gen).bfloat16()
+    q_c = torch.randn(T, q_lora, generator=gen).bfloat16()
+    w = _indexer_weights(gen, hidden, q_lora, H, Dh)
+    inputs = R.indexer_inputs(h, q_c, num_heads=H, head_dim=Dh, **w)
+    got = R.reference_indexer_topk(inputs, meta, topk=topk, chunk_bytes=chunk_bytes)
+    assert got.shape == (T, topk) and got.dtype == torch.int32
+
+    full = R.indexer_logits(inputs, slice(0, T), slice(0, T))  # (T, T)
+    start = 0
+    for n in counts:
+        for pos in range(n):
+            t = start + pos
+            row = got[t]
+            k = min(pos + 1, topk)
+            assert (row[k:] == -1).all(), (t, row)
+            sel = row[:k].long()
+            assert sel.min() >= 0 and sel.max() <= pos and sel.unique().numel() == k
+            scores = full[t, start : start + pos + 1]
+            if pos + 1 > topk:
+                # chosen set == top-k set (no exact ties with random inputs)
+                expect = set(scores.topk(topk).indices.tolist())
+                assert set(sel.tolist()) == expect, (t, sorted(sel.tolist()), sorted(expect))
+        start += n
