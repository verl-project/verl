+def _indexer_weights(gen, hidden, q_lora, H, Dh):
+    bf = dict(dtype=torch.bfloat16)
+    return dict(
+        wq=(torch.randn(H * Dh, q_lora, generator=gen) * q_lora**-0.5).to(**bf),
+        wk=(torch.randn(Dh, hidden, generator=gen) * hidden**-0.5).to(**bf),
+        wv=(torch.randn(H, hidden, generator=gen) * hidden**-0.5).to(**bf),
+        k_norm_weight=1 + 0.1 * torch.randn(Dh, generator=gen),
+        k_norm_bias=0.1 * torch.randn(Dh, generator=gen),
+        k_norm_eps=1e-5,
+    )
