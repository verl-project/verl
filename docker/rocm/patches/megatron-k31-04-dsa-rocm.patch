+"""K31 DSA, ROCm BI-off path (primitive/dsa_rocm.py): CPU contracts.
+
+* sparse MLA forward == dense masked softmax reference (fp64), packed + padded;
+* sparse MLA backward: fp64 gradcheck, and fp32 grads == autograd of the dense reference;
+* chunking does not change results;
+* FP8 ue8m0 quantization matches the vLLM rules (power-of-two scale, e4m3 grid);
+* reference indexer top-k == brute force over full causal logits, request-local, -1 tail;
+* absorbed core (W_UK^T absorb + sparse + W_UV) == the non-absorbed MLA it stands for;
+* K31DSAAttention dispatches to the ROCm path on K31DSARocmMetadata and backprops.
+"""
+
+from __future__ import annotations
+
+import math
+
+import pytest
+import torch
+
+from megatron.lite.model.k31.vllm.primitive import dsa_rocm as R
+from megatron.lite.model.k31.vllm.primitive.attention import absorbed_weights
+
+
+@pytest.fixture(autouse=True)
+def _exact_kv(monkeypatch):
+    # Tiny latents (8-10 wide) cannot take the 128-tile fp8_ds_mla rounding; the exact-reference
+    # tests run on BF16 KV.  test_ds_mla_kv_rounding_and_ste covers the rounding itself.
+    monkeypatch.setenv("MLITE_K31_DSA_KV_FP8", "off")
+
+
+def _packed_indices(counts, topk, *, gen, drop=0.0):
+    """Random request-local causal top-k (sorted random subset), -1 tail, + packed form."""
+    meta = R.build_dsa_rocm_metadata(counts, device="cpu", topk=topk)
+    rows = []
+    for n in counts:
+        for pos in range(n):
+            window = pos + 1
+            k = min(window, topk)
+            if drop and window > 1:
+                k = max(1, int(k * (1 - drop)))
+            pick = torch.randperm(window, generator=gen)[:k]
+            row = torch.full((topk,), -1, dtype=torch.int32)
+            row[:k] = pick.to(torch.int32)
+            rows.append(row)
+    logical = torch.stack(rows)
+    return meta, logical, R.logical_to_packed(logical, meta)
+
+
+def _dense_ref(q, kv, packed, scale, d_v):
+    """Dense masked softmax with a (T, S) selection mask (duplicates impossible here)."""
+    T, S = q.shape[0], kv.shape[0]
+    mask = torch.zeros(T, S, dtype=torch.bool)
+    valid = packed >= 0
+    mask[torch.arange(T)[:, None].expand_as(packed)[valid], packed[valid]] = True
+    s = torch.einsum("thd,sd->ths", q, kv) * scale
+    s = s.masked_fill(~mask[:, None, :], float("-inf"))
+    p = torch.softmax(s, dim=-1)
+    return torch.einsum("ths,sd->thd", p, kv[:, :d_v]), torch.logsumexp(s, dim=-1)
+
+
+@pytest.mark.parametrize("chunk_bytes", [1 << 30, 4096], ids=["one-chunk", "many-chunks"])
+def test_sparse_forward_matches_dense(chunk_bytes):
+    gen = torch.Generator().manual_seed(0)
+    counts, topk, H, d_v, D = [5, 11, 3], 6, 3, 8, 12
+    meta, _logical, packed = _packed_indices(counts, topk, gen=gen, drop=0.3)
+    T = sum(counts)
+    q = torch.randn(T, H, D, dtype=torch.float64, generator=gen)
+    kv = torch.randn(T, D, dtype=torch.float64, generator=gen)
+    out, lse = R.sparse_mla(q, kv, packed, softmax_scale=D**-0.5, d_v=d_v, chunk_bytes=chunk_bytes)
+    ref, ref_lse = _dense_ref(q, kv, packed, D**-0.5, d_v)
+    torch.testing.assert_close(out, ref, rtol=1e-12, atol=1e-12)
+    torch.testing.assert_close(lse, ref_lse, rtol=1e-12, atol=1e-12)
+
+
+def test_sparse_backward_gradcheck_fp64():
+    gen = torch.Generator().manual_seed(1)
+    counts, topk, H, d_v, D = [4, 6], 4, 2, 4, 6
+    _meta, _logical, packed = _packed_indices(counts, topk, gen=gen)
+    T = sum(counts)
+    q = torch.randn(T, H, D, dtype=torch.float64, generator=gen, requires_grad=True)
+    kv = torch.randn(T, D, dtype=torch.float64, generator=gen, requires_grad=True)
+
+    def fn(q, kv):
+        return R.sparse_mla(q, kv, packed, softmax_scale=0.7, d_v=d_v, chunk_bytes=2048)[0]
+
+    assert torch.autograd.gradcheck(fn, (q, kv), eps=1e-6, atol=1e-8, rtol=1e-6)
+
+
+def test_sparse_backward_matches_dense_autograd_fp32():
+    gen = torch.Generator().manual_seed(2)
+    counts, topk, H, d_v, D = [9, 17], 8, 4, 16, 24
+    _meta, _logical, packed = _packed_indices(counts, topk, gen=gen, drop=0.25)
+    T = sum(counts)
+    q0 = torch.randn(T, H, D, generator=gen)
+    kv0 = torch.randn(T, D, generator=gen)
+    go = torch.randn(T, H, d_v, generator=gen)
+
+    q, kv = q0.clone().requires_grad_(), kv0.clone().requires_grad_()
+    out, _ = R.sparse_mla(q, kv, packed, softmax_scale=D**-0.5, d_v=d_v, chunk_bytes=8192)
+    out.backward(go)
+    qr, kvr = q0.double().requires_grad_(), kv0.double().requires_grad_()
+    ref, _ = _dense_ref(qr, kvr, packed, D**-0.5, d_v)
+    ref.backward(go.double())
+    torch.testing.assert_close(q.grad.double(), qr.grad, rtol=1e-4, atol=1e-5)
+    torch.testing.assert_close(kv.grad.double(), kvr.grad, rtol=1e-4, atol=1e-5)
+
+
+def test_sparse_bf16_io_fp32_math():
+    gen = torch.Generator().manual_seed(3)
+    counts, topk, H, d_v, D = [33], 16, 4, 32, 40
+    _meta, _logical, packed = _packed_indices(counts, topk, gen=gen)
+    q = torch.randn(33, H, D, generator=gen).bfloat16().requires_grad_()
+    kv = torch.randn(33, D, generator=gen).bfloat16().requires_grad_()
+    out, lse = R.sparse_mla(q, kv, packed, softmax_scale=D**-0.5, d_v=d_v)
+    assert out.dtype == torch.bfloat16 and lse.dtype == torch.float32
+    ref, _ = _dense_ref(q.double(), kv.double(), packed, D**-0.5, d_v)
+    torch.testing.assert_close(out.double(), ref, rtol=1e-2, atol=1e-2)
+    out.float().square().sum().backward()
+    assert q.grad.dtype == torch.bfloat16 and kv.grad.dtype == torch.bfloat16
