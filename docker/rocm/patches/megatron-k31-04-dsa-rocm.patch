+def test_fp8_ue8m0_quant_rules():
+    gen = torch.Generator().manual_seed(4)
+    x = torch.randn(7, 3, 128, generator=gen) * torch.logspace(-3, 3, 7)[:, None, None]
+    q, scale = R.quant_fp8_ue8m0(x, R.INDEXER_Q_SCALE_FLOOR)
+    log2 = torch.log2(scale)
+    assert torch.equal(log2, log2.round()), "ue8m0 scales are powers of two"
+    assert torch.equal(q, q.to(torch.float8_e4m3fn).float()), "values on the e4m3 grid"
+    assert (q.abs() <= R.FP8_E4M3_MAX).all()
+    amax = x.abs().amax(-1, keepdim=True)
+    # smallest power of two >= amax / 448
+    assert (scale >= amax / R.FP8_E4M3_MAX).all() and (scale / 2 < amax / R.FP8_E4M3_MAX).all()
+    rel = ((q * scale - x).abs() / amax).max()
+    assert rel < 2**-3, rel
