+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+"""DS4 block-FP8 resync: fp8_scale_rule='checkpoint' honours quantization_config.scale_fmt=ue8m0."""
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from megatron.lite.model.deepseek_v4.lite.resync import (
+    deployed_block_fp8_value,
+    export_resync_weights,
+)
+from megatron.lite.primitive.quantization.block_fp8 import (
+    dequantize_block_fp8,
+    quantize_block_fp8,
+)
+
+NAME = "layers.0.ffn.experts.0.w1.weight"
+SCALE = "layers.0.ffn.experts.0.w1.scale"
+CONFIG = SimpleNamespace(
+    expert_dtype="fp8",
+    quantization_config={"scale_fmt": "ue8m0", "weight_block_size": [128, 128]},
+)
+
+
+def _checkpoint_value() -> torch.Tensor:
+    """A BF16 value that a UE8M0 block-FP8 checkpoint represents exactly."""
+    torch.manual_seed(0)
+    source = torch.randn(256, 384) * torch.logspace(-3, 1, 384)
+    q, s = quantize_block_fp8(source, (128, 128), scale_format="e8m0")
+    scale = torch.exp2(s.view(torch.uint8).float() - 127.0)
+    value = dequantize_block_fp8(q, scale).to(torch.bfloat16)
+    assert torch.equal(value.float(), dequantize_block_fp8(q, scale))
+    return value, q, scale
+
+
+def _export(value, rule):
+    return dict(
+        export_resync_weights(
+            [(NAME, value)],
+            CONFIG,
+            resync_config={"expert_dtype": "fp8", "fp8_scale_rule": rule},
+        )
+    )
+
+
+def test_checkpoint_rule_reproduces_ue8m0_checkpoint_values():
+    # Values, not bytes: a block whose largest code is not the E4M3 maximum may come
+    # back with its power-of-two scale halved and its codes doubled -- same weights.
+    value, _, _ = _checkpoint_value()
+    out = _export(value, "checkpoint")
+    assert out[SCALE].dtype == torch.float32
+    assert torch.equal(torch.exp2(torch.log2(out[SCALE]).round()), out[SCALE])
+    assert torch.equal(dequantize_block_fp8(out[NAME], out[SCALE]), value.float())
+
+
+def test_amax_rule_is_the_default_and_moves_ue8m0_values():
+    value, _, _ = _checkpoint_value()
+    default = dict(export_resync_weights([(NAME, value)], CONFIG, resync_config={"expert_dtype": "fp8"}))
+    amax = _export(value, "amax")
+    assert torch.equal(default[SCALE], amax[SCALE])
+    assert not torch.equal(dequantize_block_fp8(amax[NAME], amax[SCALE]), value.float())
+
+
+@pytest.mark.parametrize("rule", ["amax", "checkpoint"])
+def test_deployed_value_is_dequantized_export(rule):
+    torch.manual_seed(1)
+    value = torch.randn(256, 384).to(torch.bfloat16)
+    out = _export(value, rule)
+    expected = dequantize_block_fp8(out[NAME], out[SCALE]).to(torch.bfloat16)
+    actual = deployed_block_fp8_value(
+        value, CONFIG, resync_config={"expert_dtype": "fp8", "fp8_scale_rule": rule}
+    )
+    assert torch.equal(actual, expected)
+
+
+def test_unknown_rule_is_rejected():
+    value, _, _ = _checkpoint_value()
+    with pytest.raises(ValueError, match="fp8_scale_rule"):
+        _export(value, "nearest")
