+def _fp8_pow2_scales(config: Any, resync_config: Mapping[str, Any] | None) -> bool:
+    rule = dict(resync_config or {}).get("fp8_scale_rule", "amax")
+    if rule not in _FP8_SCALE_RULES:
+        raise ValueError(
+            f"unsupported fp8_scale_rule={rule!r}; expected one of {sorted(_FP8_SCALE_RULES)}"
+        )
+    if rule == "amax":
