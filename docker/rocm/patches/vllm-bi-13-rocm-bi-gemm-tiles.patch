# vLLM v0.26.0 patch 13/18 (apply after the four DeepSeek-V4 patches above it).
#
# Opt-in M-dependent tiles for the batch-invariant BF16 / block-FP8 GEMMs on ROCm.
#
# VLLM_BI_GEMM_TILES=1 (default off; the true-on-policy recipe sets it) picks the
# tile config of matmul_persistent, bmm_batch_invariant and the BI
# w8a8_triton_block_scaled_mm by row count. No split-K, no atomics; every listed
# tile gives outputs bitwise identical to the default BI tile on MI355X (gfx950),
# so it is a speed change only on that architecture.
#
# Upstream: not yet proposed. Main added a per-arch tuned BI matmul framework
# (CUDA archs only) with a fixed BLOCK_K per shape; a gfx950 entry needs a
# re-design.
#
# Source commits:
#   [ROCm][BatchInvariant] Opt-in M-dependent tiles for the BI BF16 / block-FP8 GEMMs
#
diff --git a/vllm/model_executor/layers/batch_invariant.py b/vllm/model_executor/layers/batch_invariant.py
index 4525f3b7e3..3fef8b99a1 100644
--- a/vllm/model_executor/layers/batch_invariant.py
+++ b/vllm/model_executor/layers/batch_invariant.py
@@ -38,6 +38,92 @@ def _compute_pid(tile_id, num_pid_in_group, num_pid_m, GROUP_SIZE_M):
     return pid_m, pid_n
 
 
+# ROCm tiles chosen by M for the batch-invariant BF16 GEMMs (opt-in,
+# VLLM_BI_GEMM_TILES=1). The default 128x128x64 tile leaves most CUs idle at
+# decode (e.g. N=256 -> 2 programs, each looping over all of K). Per output
+# element both kernels compute one chain of MFMAs over K in increasing K order
+# into a single FP32 accumulator; on gfx950 neither the MFMA shape Triton
+# picks for a tile (32x32x16 vs 16x16x32 bf16) nor BLOCK_SIZE_K (64/128/256/
+# 512: more chained MFMAs per loop iteration) changes the result bits. So these
+# configs give outputs bitwise identical to the default one for every M
+# (tested: ops/parity/bigemm/bench.py) and may be chosen by M. There is no
+# split-K and no atomic: every output tile is still owned by one program.
+# The equality is a property of the compiled code: re-run the bench after any
+# Triton / ROCm / GPU change before enabling this.
+_BI_GEMM_TILES = os.environ.get("VLLM_BI_GEMM_TILES", "0") == "1"
+_BI_BF16_DEFAULT = {
+    "BLOCK_SIZE_M": 128,
+    "BLOCK_SIZE_N": 128,
+    "BLOCK_SIZE_K": 64,
+    "GROUP_SIZE_M": 8,
+    "num_stages": 3,
+    "num_warps": 8,
+}
+# Rows: (max M, min N, max N, config); the first matching row wins. Measured
+# on MI355X (gfx950) at DeepSeek-V4-Flash shapes (ops/parity/bigemm/sweep.py);
+# every config here was checked bitwise equal to the default one.
+_INF = 1 << 62
+
+
+def _t(bm: int, bn: int, bk: int, nw: int) -> dict[str, int]:
+    return dict(
+        BLOCK_SIZE_M=bm, BLOCK_SIZE_N=bn, BLOCK_SIZE_K=bk, num_warps=nw, num_stages=2
+    )
+
+
+_BI_BF16_MM_TILES: list[tuple[int, int, int, dict[str, int]]] = [
+    # lm_head-like (very wide N): memory bound at decode, compute bound at prefill
+    (16, 65536, _INF, _t(16, 64, 256, 4)),
+    (32, 65536, _INF, _t(32, 64, 512, 2)),
+    (64, 65536, _INF, _t(64, 128, 256, 4)),
+    (128, 65536, _INF, _t(128, 128, 256, 8)),
+    (256, 65536, _INF, _t(128, 256, 128, 8)),
+    (_INF, 65536, _INF, _t(256, 128, 128, 8)),
+    # router gate / compressor / indexer projections (N = 64 .. 2048)
+    (32, 0, _INF, _t(16, 16, 512, 4)),
+    (64, 0, _INF, _t(32, 16, 512, 4)),
+    (256, 0, _INF, _t(64, 16, 256, 4)),
+    (_INF, 0, 512, _t(128, 64, 256, 8)),
+    (_INF, 0, 1024, _t(128, 128, 256, 8)),
+    (_INF, 0, _INF, _t(128, 256, 128, 8)),
+]
+_BI_BF16_BMM_TILES: list[tuple[int, int, int, dict[str, int]]] = [
+    # DeepSeek-V4 wo_a: (G=8, T, 4096) x (8, 4096, 1024)
+    (16, 0, _INF, _t(16, 16, 512, 4)),
+    (32, 0, _INF, _t(32, 16, 512, 4)),
+    (64, 0, _INF, _t(32, 32, 256, 2)),
+    (128, 0, _INF, _t(64, 64, 256, 4)),
+    (256, 0, _INF, _t(128, 64, 256, 8)),
+    (_INF, 0, _INF, _t(128, 256, 64, 8)),
+]
+
+
+def _bf16_tile_config(
+    M: int,
+    N: int,
+    K: int,
+    out_dtype=None,
+    enabled: bool | None = None,
+    kind: str = "mm",
+) -> dict[str, int]:
+    """Tile config for the batch-invariant BF16 persistent matmul (kind="mm",
+    with GROUP_SIZE_M) or bmm (kind="bmm")."""
+    on = _BI_GEMM_TILES if enabled is None else enabled
+    cfg = dict(_BI_BF16_DEFAULT)
+    if on and current_platform.is_rocm():
+        table = _BI_BF16_MM_TILES if kind == "mm" else _BI_BF16_BMM_TILES
+        for max_m, min_n, max_n, tile in table:
+            if max_m >= M and min_n <= N and max_n >= N:
+                # Only whole K tiles: a partial last tile would add zero-padded
+                # MFMA steps the default config does not run (-0 vs +0).
+                if K % tile["BLOCK_SIZE_K"] == 0 and K % 64 == 0:
+                    cfg.update(tile)
+                break
+    if kind == "bmm":
+        cfg.pop("GROUP_SIZE_M")
+    return cfg
+
+
