-            "GROUP_SIZE_M": 8,
-            "num_stages": 3,
-            "num_warps": 8,
-        },
+        torch.bfloat16: _bf16_tile_config(M, N, K, out_dtype),
         torch.float16: {
             "BLOCK_SIZE_M": 128,
             "BLOCK_SIZE_N": _fp16_block_size_n,
@@ -700,6 +779,8 @@ def bmm_batch_invariant(a, b, *, out=None):
     }
 
     cfg = configs[dtype]
+    if dtype == torch.bfloat16:
+        cfg = _bf16_tile_config(M, N, K, kind="bmm")
     # grid = (B, num_tiles_per_matrix)
     grid = (
         B,
diff --git a/vllm/model_executor/layers/quantization/utils/fp8_utils.py b/vllm/model_executor/layers/quantization/utils/fp8_utils.py
index 108b867fcc..0142b4254d 100644
--- a/vllm/model_executor/layers/quantization/utils/fp8_utils.py
+++ b/vllm/model_executor/layers/quantization/utils/fp8_utils.py
@@ -851,6 +851,166 @@ def _w8a8_triton_block_scaled_mm(
     tl.store(c_ptrs, c, mask=c_mask)
 
 
+@triton.jit
+def _w8a8_triton_block_scaled_mm_ku(
+    A,
+    B,
+    C,
+    As,
+    Bs,
+    M,
+    N,
+    K,
+    group_n,
+    group_k,
+    stride_am,
+    stride_ak,
+    stride_bk,
+    stride_bn,
+    stride_cm,
+    stride_cn,
+    stride_As_m,
+    stride_As_k,
+    stride_Bs_k,
+    stride_Bs_n,
+    BLOCK_SIZE_M: tl.constexpr,
+    BLOCK_SIZE_N: tl.constexpr,
+    BLOCK_SIZE_K: tl.constexpr,
+    GROUP_SIZE_M: tl.constexpr,
+    K_UNROLL: tl.constexpr,
+):
+    """Small-M variant of ``_w8a8_triton_block_scaled_mm`` for batch-invariant
+    mode: identical per-element arithmetic, in the same order.
+
+    Each K block of BLOCK_SIZE_K (== group_k) still does
+    ``acc += dot(a_blk, b_blk) * a_s * b_s`` with a fresh dot per block, in
+    increasing K order; the only change is that K_UNROLL consecutive blocks are
+    issued per loop iteration so a narrow tile has more loads in flight.
+    Requires K % (BLOCK_SIZE_K * K_UNROLL) == 0 (checked by the caller).
+    """
+    pid = tl.program_id(axis=0)
+    num_pid_m = tl.cdiv(M, BLOCK_SIZE_M)
+    num_pid_n = tl.cdiv(N, BLOCK_SIZE_N)
+    num_pid_in_group = GROUP_SIZE_M * num_pid_n
+    group_id = pid // num_pid_in_group
+    first_pid_m = group_id * GROUP_SIZE_M
+    group_size_m = min(num_pid_m - first_pid_m, GROUP_SIZE_M)
+    pid_m = first_pid_m + (pid % group_size_m)
+    pid_n = (pid % num_pid_in_group) // group_size_m
+
+    offs_am = (pid_m * BLOCK_SIZE_M + tl.arange(0, BLOCK_SIZE_M)) % M
+    offs_bn = (pid_n * BLOCK_SIZE_N + tl.arange(0, BLOCK_SIZE_N)) % N
+    offs_k = tl.arange(0, BLOCK_SIZE_K)
+    a_ptrs = A + (offs_am[:, None] * stride_am + offs_k[None, :] * stride_ak)
+    b_ptrs = B + (offs_k[:, None] * stride_bk + offs_bn[None, :] * stride_bn)
+    As_ptrs = As + offs_am * stride_As_m
+    Bs_ptrs = Bs + (offs_bn // group_n) * stride_Bs_n
+
+    accumulator = tl.zeros((BLOCK_SIZE_M, BLOCK_SIZE_N), dtype=tl.float32)
+    for k in range(0, tl.cdiv(K, BLOCK_SIZE_K * K_UNROLL)):
+        for u in tl.static_range(K_UNROLL):
+            kb = k * K_UNROLL + u
+            a = tl.load(a_ptrs + kb * BLOCK_SIZE_K * stride_ak)
+            b = tl.load(b_ptrs + kb * BLOCK_SIZE_K * stride_bk)
+            offs_ks = (kb * BLOCK_SIZE_K) // group_k
+            a_s = tl.load(As_ptrs + offs_ks * stride_As_k)
+            b_s = tl.load(Bs_ptrs + offs_ks * stride_Bs_k)
+            accumulator += tl.dot(a, b) * a_s[:, None] * b_s[None, :]
+
+    if C.dtype.element_ty == tl.bfloat16:
+        c = accumulator.to(tl.bfloat16)
+    elif C.dtype.element_ty == tl.float16:
+        c = accumulator.to(tl.float16)
+    else:
+        c = accumulator.to(tl.float32)
+
+    offs_cm = pid_m * BLOCK_SIZE_M + tl.arange(0, BLOCK_SIZE_M)
+    offs_cn = pid_n * BLOCK_SIZE_N + tl.arange(0, BLOCK_SIZE_N)
+    c_ptrs = C + stride_cm * offs_cm[:, None] + stride_cn * offs_cn[None, :]
+    c_mask = (offs_cm[:, None] < M) & (offs_cn[None, :] < N)
+    tl.store(c_ptrs, c, mask=c_mask)
+
+
+# ROCm batch-invariant tiles for the block-FP8 GEMM, chosen by M (opt-in,
+# VLLM_BI_GEMM_TILES=1). The default BI config (64x128x128) launches only
+# N/128 programs at decode. Every tile below keeps BLOCK_SIZE_K == group_k and
+# the per-block ``acc += dot * a_s * b_s`` order (no split-K, no atomics), and
+# was measured on gfx950 to give outputs bitwise identical to the default
+# config for every M, so choosing it by the row count does not make a row's
+# result depend on its batch (tested: ops/parity/bigemm/bench.py). That
+# equality is a property of the compiled code, not of the source: re-run the
+# bench after any Triton / ROCm / GPU change before enabling this.
+_BI_FP8_TILES = os.environ.get("VLLM_BI_GEMM_TILES", "0") == "1"
+_BI_FP8_DEFAULT = {
+    "BLOCK_SIZE_M": 64,
+    "BLOCK_SIZE_N": 128,
+    "BLOCK_SIZE_K": 128,
+    "GROUP_SIZE_M": 32,
+    "num_warps": 4,
+    "num_stages": 2,
+}
+# Measured on MI355X (gfx950) at DeepSeek-V4-Flash shapes
+# (ops/parity/bigemm/sweep.py). NOT every tile is safe: BLOCK_SIZE_N=16 with
+# >= 64 rows per warp (e.g. 64x16 with 1 warp, 128x16 with 2 warps) uses the
+# same 16x16x128 MFMA and the same FMA epilogue but gives different bits; only
+# tiles checked bitwise equal to the default config are listed.
+# Rows: (max M, min N, max N, config, K_UNROLL); the first row whose M range
+# matches decides (N outside its range -> default config); no match keeps the
+# default config (e.g. wq_b N=32768 at M=64..256, where the
+# default already fills the GPU, or N=1536 at prefill sizes).
+_INF = 1 << 62
+_BI_FP8_TILES_BY_M: list[tuple[int, int, int, dict[str, int], int]] = [
+    (16, 0, _INF, dict(BLOCK_SIZE_M=16, BLOCK_SIZE_N=16, num_warps=2, num_stages=3), 4),
+    (32, 0, _INF, dict(BLOCK_SIZE_M=32, BLOCK_SIZE_N=16, num_warps=2, num_stages=2), 4),
+    (
+        64,
+        0,
+        16384,
+        dict(BLOCK_SIZE_M=32, BLOCK_SIZE_N=16, num_warps=2, num_stages=2),
+        4,
+    ),
+    (
+        128,
+        0,
+        16384,
+        dict(BLOCK_SIZE_M=64, BLOCK_SIZE_N=16, num_warps=4, num_stages=2),
+        2,
+    ),
+    (
+        256,
+        0,
+        16384,
+        dict(BLOCK_SIZE_M=64, BLOCK_SIZE_N=32, num_warps=2, num_stages=2),
+        2,
+    ),
+    (
+        _INF,
+        4096,
+        _INF,
+        dict(BLOCK_SIZE_M=128, BLOCK_SIZE_N=256, num_warps=8, num_stages=2),
+        0,
+    ),
+]
+
+
+def _fp8_bi_tile_config(
+    M: int, N: int, K: int, enabled: bool | None = None
+) -> tuple[dict[str, Any], int]:
+    """(config, K_UNROLL) for the batch-invariant block-FP8 GEMM; K_UNROLL 0
+    means the default kernel."""
+    on = _BI_FP8_TILES if enabled is None else enabled
+    if on and current_platform.is_rocm():
+        for max_m, min_n, max_n, cfg, ku in _BI_FP8_TILES_BY_M:
+            if max_m >= M and min_n <= N and max_n >= N:
+                full = dict(_BI_FP8_DEFAULT, GROUP_SIZE_M=8, **cfg)
+                if ku and K % (full["BLOCK_SIZE_K"] * ku) != 0:
+                    ku = 0
+                return full, ku
+            if max_m >= M and max_m < _INF and max_n < N:
+                break
+    return dict(_BI_FP8_DEFAULT), 0
+
+
