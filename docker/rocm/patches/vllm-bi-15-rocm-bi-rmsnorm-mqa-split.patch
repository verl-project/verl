# vLLM v0.26.0 patch 15/18 (apply after the four DeepSeek-V4 patches above it).
#
# Row-in-registers BI RMSNorm; KV-split DeepSeek-V4 decode indexer logits.
#
# - rms_norm_batch_invariant: rows of <= 8 x 1024 columns use a kernel that
#   loads the row once instead of once per loop trip, with the same block
#   layout and summation order (VLLM_BI_RMSNORM_ROWREG=0 keeps the loop kernel).
# - rocm_dsv4_mqa_logits_split (new file): splits AITER's single-wave
#   fp8_mqa_logits over the compressed context, same score arithmetic, with
#   nan_to_num(nan=-inf) fused into the store.
# Both are bitwise equal to the kernels they replace (3720 and 136 cases on
# MI355X); they are decode latency changes.
#
# Upstream: the RMSNorm part is prepared as a separate vLLM change, not yet
# proposed; the indexer part belongs to the DeepSeek-V4 ROCm RFC.
#
# Source commits:
#   [ROCm][DSv4][BI] Row-in-registers BI RMSNorm; KV-split decode indexer logits
#   [ROCm][DSv4][BI] Fuse nan_to_num into split indexer logits; opt-in RMSNorm+FP8 group quant
#   [ROCm][BI] Drop the opt-in RMSNorm + FP8 group-quant stash
#
diff --git a/vllm/model_executor/layers/batch_invariant.py b/vllm/model_executor/layers/batch_invariant.py
index 3fef8b99a1..9e60fcdde1 100644
--- a/vllm/model_executor/layers/batch_invariant.py
+++ b/vllm/model_executor/layers/batch_invariant.py
@@ -944,6 +944,140 @@ def _rms_norm_kernel(
         tl.store(output_row_start_ptr + col_idx, output, mask=mask)
 
 
+@triton.jit
+def _rms_norm_blk_load(row_ptr, w_ptr, col_offset, n_cols, BLOCK_SIZE: tl.constexpr,
+                       HAS_WEIGHT: tl.constexpr):
+    col_idx = col_offset + tl.arange(0, BLOCK_SIZE)
+    mask = col_idx < n_cols
+    vals = tl.load(row_ptr + col_idx, mask=mask, other=0.0)
+    if HAS_WEIGHT:
+        weight = tl.load(w_ptr + col_idx, mask=mask, other=1.0)
+    else:
+        weight = vals
+    return vals, weight
+
+
+@triton.jit
+def _rms_norm_blk_sumsq(vals, col_offset, n_cols, BLOCK_SIZE: tl.constexpr):
+    col_idx = col_offset + tl.arange(0, BLOCK_SIZE)
+    mask = col_idx < n_cols
+    vals_f32 = vals.to(tl.float32)
+    sq_vals = vals_f32 * vals_f32
+    return tl.sum(tl.where(mask, sq_vals, 0.0))
+
+
+@triton.jit
+def _rms_norm_blk_store(out_ptr, vals, weight, inv_rms, col_offset, n_cols,
+                        BLOCK_SIZE: tl.constexpr, HAS_WEIGHT: tl.constexpr):
+    col_idx = col_offset + tl.arange(0, BLOCK_SIZE)
+    mask = col_idx < n_cols
+    vals_f32 = vals.to(tl.float32)
+    output_f32 = vals_f32 * inv_rms
+    if HAS_WEIGHT:
+        output_f32 = output_f32 * weight.to(tl.float32)
+    output = output_f32.to(vals.dtype)
+    tl.store(out_ptr + col_idx, output, mask=mask)
+
+
+@triton.jit
+def _rms_norm_rowreg_kernel(
+    input_ptr,
+    weight_ptr,
+    output_ptr,
+    input_row_stride,
+    output_row_stride,
+    n_cols,
+    eps,
+    BLOCK_SIZE: tl.constexpr,
+    NUM_BLOCKS: tl.constexpr,
+    HAS_WEIGHT: tl.constexpr,
+):
+    """``_rms_norm_kernel`` with the row held in registers (n_cols <=
+    NUM_BLOCKS * BLOCK_SIZE, NUM_BLOCKS <= 8): every block of the row and of
+    the weight is loaded up front instead of once per serial loop trip in each
+    of two passes. The arithmetic is the same per element and in the same
+    order: one ``tl.sum`` per BLOCK_SIZE block of the same 1-D layout, added
+    to the fp32 running sum block by block from the left, the same rms /
+    inverse, then ``(x * inv_rms) * w`` rounded once."""
+    row_idx = tl.program_id(0).to(tl.int64)
+    row_ptr = input_ptr + row_idx * input_row_stride
+    out_ptr = output_ptr + row_idx * output_row_stride
+
+    v0, w0 = _rms_norm_blk_load(row_ptr, weight_ptr, 0 * BLOCK_SIZE, n_cols,
+                                BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 1:
+        v1, w1 = _rms_norm_blk_load(row_ptr, weight_ptr, 1 * BLOCK_SIZE, n_cols,
+                                    BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 2:
+        v2, w2 = _rms_norm_blk_load(row_ptr, weight_ptr, 2 * BLOCK_SIZE, n_cols,
+                                    BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 3:
+        v3, w3 = _rms_norm_blk_load(row_ptr, weight_ptr, 3 * BLOCK_SIZE, n_cols,
+                                    BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 4:
+        v4, w4 = _rms_norm_blk_load(row_ptr, weight_ptr, 4 * BLOCK_SIZE, n_cols,
+                                    BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 5:
+        v5, w5 = _rms_norm_blk_load(row_ptr, weight_ptr, 5 * BLOCK_SIZE, n_cols,
+                                    BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 6:
+        v6, w6 = _rms_norm_blk_load(row_ptr, weight_ptr, 6 * BLOCK_SIZE, n_cols,
+                                    BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 7:
+        v7, w7 = _rms_norm_blk_load(row_ptr, weight_ptr, 7 * BLOCK_SIZE, n_cols,
+                                    BLOCK_SIZE, HAS_WEIGHT)
+
+    sum_sq = tl.zeros([1], dtype=tl.float32)
+    sum_sq += _rms_norm_blk_sumsq(v0, 0 * BLOCK_SIZE, n_cols, BLOCK_SIZE)
+    if NUM_BLOCKS > 1:
+        sum_sq += _rms_norm_blk_sumsq(v1, 1 * BLOCK_SIZE, n_cols, BLOCK_SIZE)
+    if NUM_BLOCKS > 2:
+        sum_sq += _rms_norm_blk_sumsq(v2, 2 * BLOCK_SIZE, n_cols, BLOCK_SIZE)
+    if NUM_BLOCKS > 3:
+        sum_sq += _rms_norm_blk_sumsq(v3, 3 * BLOCK_SIZE, n_cols, BLOCK_SIZE)
+    if NUM_BLOCKS > 4:
+        sum_sq += _rms_norm_blk_sumsq(v4, 4 * BLOCK_SIZE, n_cols, BLOCK_SIZE)
+    if NUM_BLOCKS > 5:
+        sum_sq += _rms_norm_blk_sumsq(v5, 5 * BLOCK_SIZE, n_cols, BLOCK_SIZE)
+    if NUM_BLOCKS > 6:
+        sum_sq += _rms_norm_blk_sumsq(v6, 6 * BLOCK_SIZE, n_cols, BLOCK_SIZE)
+    if NUM_BLOCKS > 7:
+        sum_sq += _rms_norm_blk_sumsq(v7, 7 * BLOCK_SIZE, n_cols, BLOCK_SIZE)
+
+    mean_sq = sum_sq / n_cols
+    rms = tl.sqrt(mean_sq + eps)
+    inv_rms = 1.0 / rms
+
+    _rms_norm_blk_store(out_ptr, v0, w0, inv_rms, 0 * BLOCK_SIZE, n_cols,
+                        BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 1:
+        _rms_norm_blk_store(out_ptr, v1, w1, inv_rms, 1 * BLOCK_SIZE, n_cols,
+                            BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 2:
+        _rms_norm_blk_store(out_ptr, v2, w2, inv_rms, 2 * BLOCK_SIZE, n_cols,
+                            BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 3:
+        _rms_norm_blk_store(out_ptr, v3, w3, inv_rms, 3 * BLOCK_SIZE, n_cols,
+                            BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 4:
+        _rms_norm_blk_store(out_ptr, v4, w4, inv_rms, 4 * BLOCK_SIZE, n_cols,
+                            BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 5:
+        _rms_norm_blk_store(out_ptr, v5, w5, inv_rms, 5 * BLOCK_SIZE, n_cols,
+                            BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 6:
+        _rms_norm_blk_store(out_ptr, v6, w6, inv_rms, 6 * BLOCK_SIZE, n_cols,
+                            BLOCK_SIZE, HAS_WEIGHT)
+    if NUM_BLOCKS > 7:
+        _rms_norm_blk_store(out_ptr, v7, w7, inv_rms, 7 * BLOCK_SIZE, n_cols,
+                            BLOCK_SIZE, HAS_WEIGHT)
+
+
+# Row-in-registers RMSNorm (``_rms_norm_rowreg_kernel``) for rows of up to
+# 8 x 1024 columns; VLLM_BI_RMSNORM_ROWREG=0 keeps the two-pass loop kernel.
+_BI_RMSNORM_ROWREG = os.environ.get("VLLM_BI_RMSNORM_ROWREG", "1") == "1"
+
+
 def rms_norm_batch_invariant(
     input: torch.Tensor,
     weight: torch.Tensor | None,
@@ -992,6 +1126,21 @@ def rms_norm_batch_invariant(
     output = torch.empty_like(input_2d)
     BLOCK_SIZE = 1024
     grid = (n_rows,)
+    num_blocks = triton.cdiv(n_cols, BLOCK_SIZE)
+    if _BI_RMSNORM_ROWREG and num_blocks <= 8:
+        _rms_norm_rowreg_kernel[grid](
+            input_2d,
+            weight if weight is not None else input_2d,
+            output,
+            input_2d.stride(0),
+            output.stride(0),
+            n_cols,
+            eps,
+            BLOCK_SIZE=BLOCK_SIZE,
+            NUM_BLOCKS=num_blocks,
+            HAS_WEIGHT=weight is not None,
+        )
+        return output.reshape(original_shape)
     _rms_norm_kernel[grid](
         input_2d,
         weight if weight is not None else input_2d,
