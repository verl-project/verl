diff --git a/vllm/v1/attention/ops/rocm_dsv4_mqa_logits_split.py b/vllm/v1/attention/ops/rocm_dsv4_mqa_logits_split.py
new file mode 100644
index 0000000000..16d264d72d
--- /dev/null
+++ b/vllm/v1/attention/ops/rocm_dsv4_mqa_logits_split.py
@@ -0,0 +1,346 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""KV-split launch of AITER's gfx950 gluon fp8 MQA-logits kernel for the
+DeepSeek-V4 sparse decode indexer.
+
+AITER's ``_gluon_fp8_mqa_logits_kernel`` runs one single-wave program per
+query row and walks the row's whole KV range in BLOCK_KV tiles. At decode a
+rank has only a few query rows (one per request) and thousands of compressed
+keys each, so a handful of waves run ~100 serial tiles while the GPU idles.
+
+This kernel is the same kernel body with a second grid axis: program
+``(row, chunk)`` handles keys ``[start + chunk * CHUNK, start + (chunk + 1) *
+CHUNK) ∩ [start, end)`` of the row. Every logit column is still computed by
+the same instructions (AITER's own ``mqa_logits_loop_double_buf`` with the same
+layouts and constexprs): one MFMA dot over HEAD_SIZE for each (head, key), the
+same relu / weighted head reduction / kv-scale multiply, and the column's
+value does not depend on the tile it lands in or on the other keys of the
+tile. So the logits are bitwise identical to the one-program-per-row launch
+(and to AITER's ``fp8_mqa_logits`` wrapper used by the prefill indexer and the
+trainer); only the number of programs changes.
+
+NAN_TO_NEG_INF additionally applies ``torch.nan_to_num(nan=-inf)`` to each
+stored logit (the decode path's next op), so the separate pass over the
+whole logits buffer is not needed for the columns the kernel writes.
+
+Import this module only on gfx950 with Triton >= 3.6 (it imports AITER's
+gluon kernel module).
+"""
+
+from aiter.ops.triton._gluon_kernels.gfx950.attention import (
+    fp8_mqa_logits as _aiter_gluon_mqa,
+)
+from triton.experimental import gluon
+from triton.experimental.gluon import language as gl
+
+from vllm.triton_utils import tl
+
+MQAAsyncKVLoader = _aiter_gluon_mqa.MQAAsyncKVLoader
+mqa_logits_loop_double_buf = _aiter_gluon_mqa.mqa_logits_loop_double_buf
+_load_kv_scales_block = _aiter_gluon_mqa._load_kv_scales_block
+_store_logits_block = _aiter_gluon_mqa._store_logits_block
+_mqa_dot = _aiter_gluon_mqa._mqa_dot
+relu_f32 = _aiter_gluon_mqa.relu_f32
+_weighted_sum_fma_fold = _aiter_gluon_mqa._weighted_sum_fma_fold
+
+_FLT_MAX: gl.constexpr = gl.constexpr(3.4028234663852886e38)
+
+
+@gluon.jit
+def _nan_to_num_neg_inf(x):
+    # torch.nan_to_num(x, nan=-inf): NaN -> -inf, +inf -> FLT_MAX,
+    # -inf -> -FLT_MAX, everything else unchanged.
+    y = gl.where(x == float("inf"), _FLT_MAX, x)
+    y = gl.where(x == float("-inf"), -_FLT_MAX, y)
+    return gl.where(x != x, float("-inf"), y)
+
+
+@gluon.jit
+def _mqa_logits_loop_nan_to_num(
+    kv_loader,
+    mfma_q,
+    w_block,
+    kv_scales_ptr,
+    logits_ptr,
+    start_ind,
+    end_ind,
+    num_full_tiles,
+    NUM_HEADS: gl.constexpr,
+    BLOCK_KV: gl.constexpr,
+    stride_logits_k,
+    mfma_layout: gl.constexpr,
+    dot_b_layout: gl.constexpr,
+    NUM_BUFFERS: gl.constexpr,
+    NUM_CHAINS: gl.constexpr,
+    USE_BUFFER_LOAD: gl.constexpr,
+    USE_BUFFER_STORE: gl.constexpr,
+):
+    # aiter's mqa_logits_loop_double_buf (same loads, waits, prefetches and
+    # per-tile score arithmetic, in the same order) with
+    # _nan_to_num_neg_inf applied to each tile right before its store.
+    store_arange = gl.arange(0, BLOCK_KV, layout=gl.SliceLayout(0, mfma_layout))
+    store_offsets = store_arange * stride_logits_k
+
+    kv_pos = start_ind
+    kv_scales_off: gl.int32 = 0
+
+    kv_loader.load_to_shared(
+        start_ind, buffer_id=0, USE_BUFFER_LOAD=USE_BUFFER_LOAD, masked=True
+    )
+    kv_loader.load_to_shared(
+        start_ind + BLOCK_KV, buffer_id=1, USE_BUFFER_LOAD=USE_BUFFER_LOAD,
+        masked=True,
+    )
+    relative_end: gl.int32 = end_ind - start_ind
+    buf_cur: gl.int32 = 0
+    for i in tl.range(0, num_full_tiles - 2):
+        kv_scales = _load_kv_scales_block(
+            kv_scales_ptr, kv_scales_off, BLOCK_KV, mfma_layout,
+            USE_BUFFER_LOAD, relative_end,
+        )
+        mfma_k = kv_loader.load_from_shared(
+            wait_count=1, target_layout=dot_b_layout, buffer_id=buf_cur
+        )
+        kv_loader.load_to_shared(
+            start_ind + (i + 2) * BLOCK_KV, buffer_id=buf_cur,
+            USE_BUFFER_LOAD=USE_BUFFER_LOAD,
+        )
+        scores = _mqa_dot(mfma_q, mfma_k, NUM_HEADS, BLOCK_KV, mfma_layout)
+        scores = relu_f32(scores)
+        scores = _weighted_sum_fma_fold(
+            scores, w_block, NUM_HEADS, BLOCK_KV, mfma_layout, NUM_CHAINS
+        )
+        scores = scores * kv_scales
+        scores = _nan_to_num_neg_inf(scores)
+        _store_logits_block(logits_ptr, store_offsets, scores, USE_BUFFER_STORE)
+
+        kv_scales_off += BLOCK_KV
+        logits_ptr += BLOCK_KV * stride_logits_k
+        kv_pos += BLOCK_KV
+        buf_cur = 1 - buf_cur
+
+    if num_full_tiles > 1:
+        kv_scales = _load_kv_scales_block(
+            kv_scales_ptr, kv_scales_off, BLOCK_KV, mfma_layout,
+            USE_BUFFER_LOAD, relative_end,
+        )
+        mfma_k = kv_loader.load_from_shared(
+            wait_count=1, target_layout=dot_b_layout, buffer_id=buf_cur
+        )
+        kv_loader.load_to_shared(
+            start_ind + num_full_tiles * BLOCK_KV, buffer_id=buf_cur,
+            USE_BUFFER_LOAD=USE_BUFFER_LOAD, masked=True,
+        )
+        scores = _mqa_dot(mfma_q, mfma_k, NUM_HEADS, BLOCK_KV, mfma_layout)
+        scores = relu_f32(scores)
+        scores = _weighted_sum_fma_fold(
+            scores, w_block, NUM_HEADS, BLOCK_KV, mfma_layout, NUM_CHAINS
+        )
+        scores = scores * kv_scales
+        scores = _nan_to_num_neg_inf(scores)
+        _store_logits_block(logits_ptr, store_offsets, scores, USE_BUFFER_STORE)
+
+        kv_scales_off += BLOCK_KV
+        logits_ptr += BLOCK_KV * stride_logits_k
+        kv_pos += BLOCK_KV
+        buf_cur = 1 - buf_cur
+
+    kv_scales = _load_kv_scales_block(
+        kv_scales_ptr, kv_scales_off, BLOCK_KV, mfma_layout, USE_BUFFER_LOAD,
+        relative_end, masked=True,
+    )
+    mfma_k = kv_loader.load_from_shared(
+        wait_count=1, target_layout=dot_b_layout, buffer_id=buf_cur
+    )
+    scores = _mqa_dot(mfma_q, mfma_k, NUM_HEADS, BLOCK_KV, mfma_layout)
+    scores = relu_f32(scores)
+    scores = _weighted_sum_fma_fold(
+        scores, w_block, NUM_HEADS, BLOCK_KV, mfma_layout, NUM_CHAINS
+    )
+    scores = scores * kv_scales
+    scores = _nan_to_num_neg_inf(scores)
+    mask = store_arange < (end_ind - kv_pos)
+    _store_logits_block(logits_ptr, store_offsets, scores, USE_BUFFER_STORE, mask=mask)
+
+    kv_scales_off += BLOCK_KV
+    logits_ptr += BLOCK_KV * stride_logits_k
+    kv_pos += BLOCK_KV
+    buf_cur = 1 - buf_cur
+
+    kv_scales = _load_kv_scales_block(
+        kv_scales_ptr, kv_scales_off, BLOCK_KV, mfma_layout, USE_BUFFER_LOAD,
+        relative_end, masked=True,
+    )
+    mfma_k = kv_loader.load_from_shared(
+        wait_count=0, target_layout=dot_b_layout, buffer_id=buf_cur
+    )
+    scores = _mqa_dot(mfma_q, mfma_k, NUM_HEADS, BLOCK_KV, mfma_layout)
+    scores = relu_f32(scores)
+    scores = _weighted_sum_fma_fold(
+        scores, w_block, NUM_HEADS, BLOCK_KV, mfma_layout, NUM_CHAINS
+    )
+    scores = scores * kv_scales
+    scores = _nan_to_num_neg_inf(scores)
+    mask = store_arange < (end_ind - kv_pos)
+    _store_logits_block(logits_ptr, store_offsets, scores, USE_BUFFER_STORE, mask=mask)
+
