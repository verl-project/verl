+def _dsv4_dequant_token(
+    out_row_ptr,
+    k_cache_ptr,
+    block_table_row_ptr,
+    pos,
+    block_stride,
+    CACHE_BLOCK_SIZE: tl.constexpr,
+    USE_FNUZ: tl.constexpr,
+):
+    # One token of the fp8_ds_mla paged cache -> 512 bf16, with exactly the
+    # arithmetic of _dequantize_and_gather_k_kernel (UE8M0 scale per 64 fp8
+    # values, then the 64 bf16 rope values copied).
