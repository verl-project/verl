+    pos_in_block = pos % CACHE_BLOCK_SIZE
+    block_ptr = k_cache_ptr + block.to(tl.int64) * block_stride
+    token_ptr = block_ptr + pos_in_block * 576
+    scale_ptr = block_ptr + CACHE_BLOCK_SIZE * 576 + pos_in_block * 8
+    for qb in tl.static_range(7):
+        offs = qb * 64 + tl.arange(0, 64)
+        x_uint8 = tl.load(token_ptr + offs)
+        if USE_FNUZ:
+            x_fp8 = x_uint8.to(tl.float8e4b8, bitcast=True)
+        else:
+            x_fp8 = x_uint8.to(tl.float8e4nv, bitcast=True)
+        x_float = x_fp8.to(tl.float32)
+        encoded_scale = tl.load(scale_ptr + qb)
+        scale = tl.exp2(encoded_scale.to(tl.float32) - 127.0)
+        tl.store(out_row_ptr + offs, (x_float * scale).to(tl.bfloat16))
+    rope = tl.arange(0, 64)
+    bf16_ptr = (token_ptr + 448).to(tl.pointer_type(tl.bfloat16))
+    tl.store(out_row_ptr + 448 + rope, tl.load(bf16_ptr + rope))
