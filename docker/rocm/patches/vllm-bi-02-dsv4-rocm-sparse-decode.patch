+def use_dsv4_sparse_decode() -> bool:
+    """Whether DeepSeek-V4 decode runs on the prefill kernels.
+
+    ``VLLM_DS4_DECODE_KERNEL=sparse``: decode tokens keep decode metadata (and
+    FULL CUDA/HIP graph support) but use the prefill sparse-attention kernel,
+    the prefill indexer score kernel and the prefill top-k selector, so a
+    decode token is computed exactly like the same token inside a prefill.
+    """
+    return envs.VLLM_DS4_DECODE_KERNEL.lower() == "sparse"
+
+
+def dsv4_sparse_decode_indexer_workspace(
+    num_reqs: int, capacity: int, head_dim: int
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Workspace views (K fp8, K scales, logits) for the sparse decode indexer:
+    ``capacity`` indexer-cache tokens per request, laid out request-major."""
+    n = num_reqs * capacity
+    return current_workspace_manager().get_simultaneous(
+        ((n, head_dim), current_platform.fp8_dtype()),
+        ((n,), torch.float32),
+        ((n,), torch.float32),
+    )
+
+
+@triton.jit
+def _dsv4_decode_indexer_k_gather_kernel(
+    k_cache_ptr,
+    block_table_ptr,
+    block_table_stride,
+    seq_lens_ptr,
+    k_out_ptr,
+    scale_out_ptr,
+    row_bounds_ptr,
+    num_reqs,
+    capacity,
+    cache_block_stride,
+    CACHE_BLOCK_SIZE: tl.constexpr,
+    HEAD_DIM: tl.constexpr,
+    BLOCK_T: tl.constexpr,
+):
+    # Copies the first seq_len[b] tokens (fp8 bytes + fp32 scale bits) of
+    # request b from the NORMAL-layout indexer cache to rows
+    # [b * capacity, b * capacity + seq_len[b]), the bytes
+    # _cp_gather_indexer_quant_cache_kernel copies for a prefill, and writes
+    # row_bounds = [starts (b * capacity) | ends | zeros] for the logits and
+    # top-k kernels.
+    b = tl.program_id(0)
+    seq_len = tl.load(seq_lens_ptr + b)
+    if tl.program_id(1) == 0:
+        tl.store(row_bounds_ptr + b, b * capacity)
+        tl.store(row_bounds_ptr + num_reqs + b, b * capacity + seq_len)
+        tl.store(row_bounds_ptr + 2 * num_reqs + b, 0)
+    t = tl.program_id(1) * BLOCK_T + tl.arange(0, BLOCK_T)
+    mask = t < seq_len
+    block = tl.load(
+        block_table_ptr + b * block_table_stride + t // CACHE_BLOCK_SIZE,
+        mask=mask,
+        other=0,
+    ).to(tl.int64)
+    off = t % CACHE_BLOCK_SIZE
+    src = k_cache_ptr + block * cache_block_stride
+    d = tl.arange(0, HEAD_DIM)
+    vals = tl.load(src[:, None] + off[:, None] * HEAD_DIM + d[None, :], mask=mask[:, None])
+    row = b.to(tl.int64) * capacity + t
+    tl.store(k_out_ptr + row[:, None] * HEAD_DIM + d[None, :], vals, mask=mask[:, None])
+    scale_src = (src + CACHE_BLOCK_SIZE * HEAD_DIM).to(tl.pointer_type(tl.int32))
+    scale = tl.load(scale_src + off, mask=mask)
+    tl.store(scale_out_ptr + row, scale, mask=mask)
+
+
+def _aiter_fp8_mqa_logits_into(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    k_scale: torch.Tensor,
+    weights: torch.Tensor,
+    ks: torch.Tensor,
+    ke: torch.Tensor,
+    logits: torch.Tensor,
+    stride_logits_s: int,
+) -> bool:
+    """Launch AITER's gfx950 gluon fp8_mqa_logits kernel (the kernel and launch
+    configuration of its ``fp8_mqa_logits`` wrapper, used by the prefill
+    indexer) into a caller-provided logits buffer with row stride
+    ``stride_logits_s``. Row i writes only columns [ks[i], ke[i]), each
+    computed independently of the others, so the scores equal those of the
+    wrapper. Returns False when that kernel is not the one the wrapper uses.
+    """
+    import sys
+
+    from vllm._aiter_ops import rocm_aiter_ops
+
+    if not (_ON_GFX950 and rocm_aiter_ops.is_enabled()):
+        return False
+    module = mqa_logits_module()
+    if module is None or not hasattr(module, "fp8_mqa_logits"):
+        return False
+    m = sys.modules[module.fp8_mqa_logits.__module__]
+    kernel = getattr(m, "_gluon_fp8_mqa_logits_kernel", None)
+    if (
+        kernel is None
+        or not getattr(m, "TRITON_GE_36", False)
+        or getattr(m, "arch", None) != "gfx950"
+        or not hasattr(m, "FOLDED_REDUCTED_SUPPORT")
+        or not hasattr(m, "ASYNC_COPY_SUPPORTS_DISTRIBUTED")
+    ):
+        return False
+    seq_len, num_heads, _ = q.shape
+    use_folded = m.FOLDED_REDUCTED_SUPPORT and num_heads > 16
+    limit = 2 * 1024 * 1024 * 1024
+    kernel[(seq_len,)](
+        Q_ptr=q,
+        KV_ptr=k,
+        kv_scales_ptr=k_scale,
+        weights_ptr=weights,
+        cu_start_ptr=ks,
+        cu_end_ptr=ke,
+        logits_ptr=logits,
+        seq_len=seq_len,
+        seq_len_kv=k.shape[0],
+        NUM_HEADS=num_heads,
+        HEAD_SIZE=q.shape[2],
+        stride_q_s=q.stride(0),
+        stride_q_h=q.stride(1),
+        stride_q_d=q.stride(2),
+        stride_kv_s=k.stride(0),
+        stride_kv_d=k.stride(1),
+        stride_w_s=weights.stride(0),
+        stride_w_h=weights.stride(1),
+        stride_logits_s=stride_logits_s,
+        stride_logits_k=1,
+        BLOCK_KV=32,
+        NUM_WARPS=1,
+        NUM_BUFFERS=2,
+        NUM_CHAINS=4 if use_folded else 0,
+        USE_BUFFER_LOAD=k.numel() * k.element_size() < limit,
+        USE_BUFFER_STORE=logits.numel() * logits.element_size() < limit,
+        num_warps=1,
+        waves_per_eu=3,
+        USE_PADDED_SHARED_LAYOUT=m.ASYNC_COPY_SUPPORTS_DISTRIBUTED,
+    )
+    return True
+
+
+def dsv4_sparse_decode_indexer_topk(
+    kv_cache: torch.Tensor,
+    q_fp8: torch.Tensor,
+    weights: torch.Tensor,
+    seq_lens: torch.Tensor,
+    block_table: torch.Tensor,
+    topk_indices: torch.Tensor,
+    max_model_len: int,
+    topk_tokens: int,
+    max_seq_len: int | None = None,
+) -> None:
+    """DeepSeek-V4 decode indexer on the prefill score + top-k kernels.
+
+    Graph-safe (no host sync, every shape fixed by the decode batch size and
+    ``C``) and batch invariant: request b's K occupies rows
+    ``[b * C, b * C + seq_len_b)`` of a request-major workspace, its logits
+    are written to the same positions of a ``[B * C]`` buffer (AITER's
+    prefill logits kernel with row stride 0, so no ``B x B * C`` matrix), and
+    ``top_k_per_row_prefill`` selects on the ``[B, C]`` view with row-local
+    columns. Scores and selection are elementwise / row-local, so the indices
+    equal those of the same token scored in a prefill.
+
+    Args:
+        kv_cache: DSv4 indexer cache ``[num_blocks, block_size, head_dim + 4]``
+            uint8, block-flat NORMAL layout (written by the compressor).
+        q_fp8: ``[B, H, D]`` fp8 decode queries (one token per request).
+        weights: ``[B, H]`` fp32 head weights.
+        seq_lens: ``[B]`` int32 compressed context length of each decode token.
+        block_table: ``[B, max_blocks]`` indexer-cache block table.
+        topk_indices: ``[B, topk_tokens]`` int32 output (request-local indices,
+            -1 padded).
+        max_model_len: compressed-token capacity per request.
+        max_seq_len: host upper bound of ``seq_lens``. Used for ``C`` outside
+            graph capture, so eager / piecewise steps size the workspace by
+            the batch's context; ``None`` (and any capture) uses capacity.
+    """
+    num_reqs, _, head_dim = q_fp8.shape
+    seq_lens = seq_lens.reshape(-1)[:num_reqs]
+    capacity = max_model_len
+    if max_seq_len is not None and not torch.cuda.is_current_stream_capturing():
+        capacity = max(1, min(capacity, max_seq_len))
+    k_fp8, k_scale, logits = dsv4_sparse_decode_indexer_workspace(
+        num_reqs, capacity, head_dim
+    )
+    row_bounds = torch.empty(3 * num_reqs, dtype=torch.int32, device=q_fp8.device)
+    ks, ke, row_starts = row_bounds.view(3, num_reqs)
+    block_t = 32
+    _dsv4_decode_indexer_k_gather_kernel[(num_reqs, triton.cdiv(capacity, block_t))](
+        kv_cache,
+        block_table,
+        block_table.stride(0),
+        seq_lens,
+        k_fp8.view(torch.uint8),
+        k_scale.view(torch.int32),
+        row_bounds,
+        num_reqs,
+        capacity,
+        kv_cache.stride(0),
+        CACHE_BLOCK_SIZE=kv_cache.shape[1],
+        HEAD_DIM=head_dim,
+        BLOCK_T=block_t,
+    )
+    if _aiter_fp8_mqa_logits_into(
+        q_fp8, k_fp8, k_scale, weights, ks, ke, logits, stride_logits_s=0
+    ):
+        logits.nan_to_num_(float("-inf"))
+        logits_2d = logits.view(num_reqs, capacity)
+    else:
+        # Reference / other-arch kernels: full [B, B * C] logits, diagonal view.
+        full = rocm_fp8_mqa_logits(q_fp8, (k_fp8, k_scale), weights, ks, ke)
+        logits_2d = full.as_strided(
+            (num_reqs, capacity),
+            (full.stride(0) + capacity * full.stride(1), full.stride(1)),
+            full.storage_offset(),
+        )
+    torch.ops._C.top_k_per_row_prefill(
+        logits_2d,
+        row_starts,
+        seq_lens,
+        topk_indices,
+        num_reqs,
+        logits_2d.stride(0),
+        logits_2d.stride(1),
+        topk_tokens,
+    )
+
