diff --git a/vllm/model_executor/layers/mhc.py b/vllm/model_executor/layers/mhc.py
index 23733f7693..65e1eb1b23 100644
--- a/vllm/model_executor/layers/mhc.py
+++ b/vllm/model_executor/layers/mhc.py
@@ -4,6 +4,7 @@ import torch
 
 # this import will also register the custom ops
 # import vllm.model_executor.kernels.mhc  # noqa: F401
+import vllm.envs as envs
 import vllm.model_executor.kernels.mhc as mhc_kernels
 from vllm._aiter_ops import is_aiter_found_and_supported
 from vllm.model_executor.custom_op import CustomOp
@@ -29,6 +30,25 @@ HAS_TILELANG_MHC = _has_tilelang_mhc()
 HAS_AITER_MHC = is_aiter_found_and_supported()
 
 
+def rocm_use_aiter_mhc(hidden_size: int) -> bool:
+    """Whether mHC pre/post run on AITER on ROCm.
+
+    Not in batch-invariant mode: AITER's ``mhc_pre`` splits its reductions by
+    the token count, so the same row gives different post/comb mixes in
+    different batches. Batch-invariant mode uses the TileLang kernels (one
+    split, see ``_tilelang_hc_prenorm_gemm``) and requires them.
+    """
+    if envs.VLLM_BATCH_INVARIANT:
+        if not HAS_TILELANG_MHC:
+            raise RuntimeError(
+                "VLLM_BATCH_INVARIANT=1 on ROCm needs the TileLang mHC kernels "
+                "(tilelang installed, not gfx942): AITER mhc_pre is not batch "
+                "invariant."
+            )
+        return False
+    return HAS_AITER_MHC and hidden_size % 256 == 0
+
+
