     assert x.shape[1] % n_splits == 0
     assert (x.shape[1] // n_splits) % n_thr == 0
-    use_default_config = tile_n == 12 and n_thr == 512
-    if n_splits == 1 and use_default_config and x.shape[0] >= 1024:
+    # The block-M (>= 1024 tokens) and 1024-thread (< 128 tokens) kernels
+    # reduce K in a different order than the default one. Choosing among them
+    # by token count makes a token's mixes depend on its batch (and decode
+    # differ from prefill), so batch-invariant mode always takes the default
+    # one-program-per-token kernel below.
+    token_count_dispatch = (
+        n_splits == 1
+        and tile_n == 12
+        and n_thr == 512
+        and not envs.VLLM_BATCH_INVARIANT
+    )
+    if token_count_dispatch and x.shape[0] >= 1024:
         hc_prenorm_gemm_block_m_tilelang(
             x,
             fn,
