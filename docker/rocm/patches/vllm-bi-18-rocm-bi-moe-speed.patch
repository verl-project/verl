+    NG: tl.constexpr = D // GROUP
+    cols = tl.arange(0, D)
+    base = in_ptr + row.to(tl.int64) * stride_in
+    g = tl.load(base + cols).to(tl.float32)
+    u = tl.load(base + D + cols).to(tl.float32)
+    if HAS_LIMIT:
+        g = tl.minimum(g, limit, tl.PropagateNan.ALL)
+    act = g / (libdevice.exp(-g) + 1.0)
+    if HAS_LIMIT:
+        u = tl.maximum(u, -limit, tl.PropagateNan.ALL)
+        u = tl.minimum(u, limit, tl.PropagateNan.ALL)
+    y = (act * u).to(tl.bfloat16).to(tl.float32)
+    y2 = tl.reshape(y, (NG, GROUP))
+    amax = tl.maximum(tl.max(tl.abs(y2), axis=1), eps)
+    scale = amax / fp8_max
+    q = tl.minimum(tl.maximum(y2 / scale[:, None], fp8_min), fp8_max)
+    out_row = row.to(tl.int64) * D
+    q_offs = out_row + tl.reshape(cols, (NG, GROUP))
+    tl.store(q_ptr + q_offs, q.to(q_ptr.dtype.element_ty))
+    tl.store(s_ptr + row.to(tl.int64) * NG + tl.arange(0, NG), scale)
+
+
+def swiglu_limit_group_quant_fp8(
+    input: torch.Tensor,
+    swiglu_limit: float | None,
+    local_ids: torch.Tensor | None = None,
+    group_size: int = 128,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Fused ``swiglu_limit_func`` + ``per_token_group_quant_fp8`` (bitwise).
+
+    ``input`` is [R, 2D] (gate | up), returns (q [R, D] fp8, scales [R, D/128]
+    fp32, row-major). With ``local_ids`` ([R], -1 = slot of another rank's
+    expert), such rows are skipped and their outputs left unwritten.
+    """
+    from vllm.model_executor.layers.quantization.utils.fp8_utils import (
+        get_fp8_min_max,
+    )
+
+    assert input.dim() == 2 and input.stride(1) == 1
+    assert input.dtype == torch.bfloat16
+    rows, d2 = input.shape
+    d = d2 // 2
+    assert d % group_size == 0 and triton.next_power_of_2(d) == d
+    fp8_min, fp8_max = get_fp8_min_max()
+    q = torch.empty((rows, d), dtype=current_platform.fp8_dtype(), device=input.device)
+    sc = torch.empty((rows, d // group_size), dtype=torch.float32, device=input.device)
+    if rows == 0:
+        return q, sc
+    has_limit = swiglu_limit is not None and swiglu_limit > 0
+    _swiglu_limit_group_quant_kernel[(rows,)](
+        input,
+        q,
+        sc,
+        local_ids if local_ids is not None else input,
+        input.stride(0),
+        float(swiglu_limit) if has_limit else 0.0,
+        1e-10,
+        fp8_min,
+        fp8_max,
+        D=d,
+        GROUP=group_size,
+        HAS_LIMIT=has_limit,
+        SKIP_NON_LOCAL=local_ids is not None,
+        num_warps=4,
+    )
+    return q, sc
+
+
+def prepare_local_expert_assignment(
+    topk_ids: torch.Tensor,
+    config: dict[str, Any],
+    expert_map: torch.Tensor,
+    num_local_experts: int,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Align only the token slots routed to this rank's experts.
+
+    Unlike ``_prepare_expert_assignment(..., expert_map)``, slots of experts
+    owned by other ranks get no M block at all (instead of a block with expert
+    id -1 whose programs write zeros), and the sorted ids are sized by the local
+    expert count, so the GEMM grids shrink. The GEMMs then leave the rows of
+    non-local slots unwritten: the caller must not read them (``moe_sum`` with
+    ``topk_ids``/``expert_map`` skips them). Each local slot row is computed
+    exactly as before (rows are independent), so its bits do not change.
+
+    Returns (sorted_token_ids, expert_ids, num_tokens_post_padded, local_ids),
+    local_ids = the local expert of every slot (-1 if not local).
+    """
+    assert expert_map.dtype == torch.int32 and expert_map.is_contiguous()
+    ids = topk_ids.contiguous()
+    n = ids.numel()
+    local_ids = torch.empty(ids.shape, dtype=torch.int32, device=ids.device)
+    if n > 0:
+        _local_expert_ids_kernel[(triton.cdiv(n, 1024),)](
+            ids, expert_map, local_ids, n, expert_map.numel(), BLOCK=1024
+        )
+    # num_experts = the local count: small batches take moe_align_block_size's
+    # one-kernel path; slots with local id -1 are not counted.
+    sorted_ids, expert_ids, ntp = moe_align_block_size(
+        local_ids, config["BLOCK_SIZE_M"], num_local_experts, None
+    )
+    return sorted_ids, expert_ids, ntp, local_ids
+
