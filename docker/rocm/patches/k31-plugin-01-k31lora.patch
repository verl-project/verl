+_ARANGE = {}
+
+
+def _arange_i32(n, dev):
+    """Constant int32 arange, cached when created outside CUDA-graph capture (a capture-time tensor lives in the graph
+    pool and is only written at replay, so it is never cached; a cached eager one is static memory -> capture-safe)."""
+    key = (n, str(dev))
+    t = _ARANGE.get(key)
+    if t is None:
+        t = torch.arange(n, device=dev, dtype=torch.int32)
+        if n <= 65536 and not torch.cuda.is_current_stream_capturing():
+            _ARANGE[key] = t
+    return t
+
+
+def _token_tiles(T, bm, dev):
+    """Tiles covering rows 0..T-1 of ONE (shared) weight: (0, i*bm, min((i+1)*bm, T)). Constant -> cached like _arange_i32."""
+    key = ("tt", T, bm, str(dev))
+    t = _ARANGE.get(key)
+    if t is None:
+        nt = triton.cdiv(T, bm)
+        r0 = _arange_i32(nt, dev) * bm
+        t = (torch.zeros(nt, device=dev, dtype=torch.int32), r0, torch.clamp(r0 + bm, max=T), bm)
+        if T <= 65536 and not torch.cuda.is_current_stream_capturing():
+            _ARANGE[key] = t
+    return t
+
+
+def _lora_glue(a, a_rows, tiles, A, B, scaling, shared_A, shared_B, chunk=None, out=None, nrows=None, tok_tiles=None):
+    """FUSED_GLUE expert-LoRA delta, same values as _expert_lora_delta:
+    shared A (d1, d3): the shrink a @ A^T is the same for every slot of a token -> computed once per TOKEN (T rows, not
+    T*k) and gathered by the expand (a_rows = tok); chunked A2 shrink: the 8 chunks in one launch + row-bounded tree8."""
+    if chunk is None and shared_A and tok_tiles is not None:
+        T = a.shape[0]
+        t = grouped_gemm(a, _arange_i32(T, a.device), A, tok_tiles, A.shape[1], shared_w=True)
+        rows = a_rows
+    elif chunk is not None and not shared_A and nrows is not None and A.shape[2] == N_CHUNKS * chunk:
+        t = tree8_rows(bf16_chunks_gemm(a, a_rows, A, tiles, A.shape[1], N_CHUNKS), nrows)
+        rows = _arange_i32(t.shape[0], t.device)
+    else:
+        return _expert_lora_delta(a, a_rows, tiles, A, B, scaling, shared_A, shared_B, chunk=chunk, out=out, nrows=nrows)
+    if LORA_INKERNEL_SCALE and B.dtype == torch.bfloat16 and B.stride(-1) == 1:
+        return grouped_gemm(t, rows, B, tiles, B.shape[1], shared_w=shared_B, wscale=scaling, out=out)
+    return grouped_gemm(t, rows, (B.float() * scaling).contiguous(), tiles, B.shape[1], shared_w=shared_B, out=out)
+
+
+def _expert_lora_delta(a, a_rows, tiles, A, B, scaling, shared_A, shared_B, chunk=None, gather=None, out=None, nrows=None):
+    """FP32 delta[r] = (a[a_rows[r]] @ A_e^T)_fp32 @ (B_e * s)^T_fp32  (A [E|1, r, K], B [E|1, N, r] BF16).
+    chunk/gather: contraction over the (TP-sharded) intermediate dim is done in the canonical N_CHUNKS split."""
+    if chunk is None:
+        t = grouped_gemm(a, a_rows, A, tiles, A.shape[1], shared_w=shared_A)          # FP32, no BF16 cast
+    else:
+        assert not shared_A
+        t = _chunked_contract(a, a_rows, A, tiles, A.shape[1], chunk, gather=gather, nrows=nrows)
+    ar = torch.arange(t.shape[0], device=t.device, dtype=torch.int32)
+    if LORA_INKERNEL_SCALE and B.dtype == torch.bfloat16 and B.stride(-1) == 1:
+        # same values as (B.float() * scaling), formed in the kernel's load: no per-call FP32 copy of B
+        return grouped_gemm(t, ar, B, tiles, B.shape[1], shared_w=shared_B, wscale=scaling, out=out)
+    bs = (B.float() * scaling).contiguous()
+    return grouped_gemm(t, ar, bs, tiles, B.shape[1], shared_w=shared_B, out=out)      # FP32-IEEE MFMA
+
+
+FUSED_COMBINE = os.environ.get("K31_BI_MOE_FUSED_COMBINE", "1") == "1"
+# fused glue (graph-safe path, k=16 fused combines): one pre-SiTU kernel (bf16 round + LoRA delta * mask + SiTU), LoRA
+# deltas written in place (no cat), row-bounded W2/A2 chunk-tree adds (only the rows this rank owns), mask folded into the
+# combine leaf, no torch bf16 cast of y (the leaf rounds). Same bits as the torch glue (opt-in until gated).
+FUSED_GLUE = os.environ.get("K31_BI_MOE_FUSED_GLUE", "0") == "1"
+# with FUSED_GLUE: tl.dot_scaled MXFP4 GEMMs (bitwise == dequant / a16w4, tests/scaled_eq.py). W2: all 8 canonical chunks in
+# one launch -> [8, R, H] partials -> row-bounded tree8 (same pairing). w13: scaled kernel, or the plug-in engine where it is
+# faster (gfx950 EP8 per layer: scaled wins T<=8 and T>=128, a16w4 at 16..64). Opt-in until gated in-engine.
+SCALED = os.environ.get("K31_BI_MOE_SCALED", "0") == "1"
+ROUTE_PAR = os.environ.get("K31_BI_MOE_ROUTE_PAR", "1") == "1"   # glue path: multi-program routing (same outputs)
+LORA_TOKEN_SHRINK = os.environ.get("K31_BI_MOE_LORA_TOKEN_SHRINK", "1") == "1"   # glue path: shared-A shrink per token, A2 shrink in one launch
+SCALED_W2_MAX_ROWS = int(os.environ.get("K31_BI_MOE_SCALED_W2_MAX_ROWS", "2048"))   # [8, R, H] FP32 partials bound
+LORA_INKERNEL_SCALE = os.environ.get("K31_BI_MOE_LORA_INKERNEL_SCALE", "1") == "1"   # expand: bf16 B * s in-kernel (same bits)
+LORA_VIEW_ONE_SLOT = os.environ.get("K31_BI_MOE_LORA_VIEW", "1") == "1"            # one-slot LoRA stack: view, not index_select
+FUSED_COMBINE_EP = os.environ.get("K31_BI_MOE_FUSED_COMBINE_EP", "1") == "1"   # EP: leaf scatter + tree kernels (stable tie-break: duplicate topk_ids, e.g. the trainer dispatch sentinel, are safe and == torch)
+FUSED_ROUTE = os.environ.get("K31_BI_MOE_FUSED_ROUTE", "1") == "1"            # one-launch routing (bitwise == torch)
+ROUTE_MAX_SLOTS = int(os.environ.get("K31_BI_MOE_ROUTE_MAX_SLOTS", "1024"))   # fused one-program routing: GPU time wins only for few
+ROUTE_MAX_E = int(os.environ.get("K31_BI_MOE_ROUTE_MAX_E", "128"))            # local experts (EP) and <= 1024 slots; TP-wide E (896) -> torch path
+# (11/05 profiler GPU time, gfx950: EP8 E=112: 41/64/95 us fused vs 98/110/127 torch at 256/512/1024 slots; TP8 E=896: fused 2x slower)
+TOK_CHUNK = int(os.environ.get("K31_BI_MOE_TOK_CHUNK", "1024"))   # bounds memory; rows are independent -> same bits
+# Row tile for large token blocks (trainer: K31_BI_MOE_TOK_CHUNK=8192 K31_BI_MOE_BM_LARGE=128). Bit-free: rows are independent and
+# tl.dot elements are tile-shape invariant on gfx950 (tests/test_moe_chunk_bm.py: bitwise == defaults, base + expert LoRA, EP4).
+BM_LARGE = int(os.environ.get("K31_BI_MOE_BM_LARGE", "64"))
+GRAPH_SAFE = os.environ.get("K31_BI_MOE_GRAPH", "1") == "1"   # device-side tiling, no host syncs (graph-capturable; bitwise == host path)
+# GRAPH_SAFE GEMM outputs: rows not covered by any tile (EP non-local slots at the tail) were zero-filled for the torch combine.
+# The fused combines (k=16, default) mask those rows at the leaf (row -1), so they can stay uninitialised; set per forward.
+_ZERO_INIT = [True]
+ZERO_UNCOVERED = os.environ.get("K31_BI_MOE_ZERO_UNCOVERED", "auto")   # auto | 1 (always zero, old behaviour)
+
+
+@torch.no_grad()
+def bi_moe_forward(x, w13, s13, w2, s2, topk_weights, topk_ids, beta, linear_beta=None, lora=None,
+                   n_global=None, chunk_gather=None, expert_map=None, leaf_reduce=None):
+    """Token-chunked driver of _bi_moe_forward_tokens (every rank of a TP/EP group sees the same T, so the per-chunk
+    collectives stay matched). Arguments as in _bi_moe_forward_tokens."""
+    T = x.shape[0]
+    if T <= TOK_CHUNK:
+        return _bi_moe_forward_tokens(x, w13, s13, w2, s2, topk_weights, topk_ids, beta, linear_beta, lora,
+                                      n_global, chunk_gather, expert_map, leaf_reduce)
+    def lsl(i):
+        if lora is None or "token_mask" not in lora:
+            return lora
+        return dict(lora, token_mask=lora["token_mask"][i:i + TOK_CHUNK])
+    outs = [_bi_moe_forward_tokens(x[i:i + TOK_CHUNK], w13, s13, w2, s2, topk_weights[i:i + TOK_CHUNK],
+                                   topk_ids[i:i + TOK_CHUNK], beta, linear_beta, lsl(i), n_global, chunk_gather,
+                                   expert_map, leaf_reduce) for i in range(0, T, TOK_CHUNK)]
+    return torch.cat(outs)
+
+
+def _bi_moe_forward_tokens(x, w13, s13, w2, s2, topk_weights, topk_ids, beta, linear_beta=None, lora=None,
+                           n_global=None, chunk_gather=None, expert_map=None, leaf_reduce=None):
+    """x BF16 [T, H]; w13 uint8 [E, 2N, H/2], s13 uint8 [E, 2N, H/32]; w2 uint8 [E, H, N/2], s2 [E, H, N/32];
+    topk_weights FP32 [T, k]; topk_ids [T, k]. lora (optional): dict of BF16 factors A1, A3 [E|1, r, H], B1, B3 [E|1, N, r],
+    A2 [E|1, r, N], B2 [E|1, H, r] (N = this rank's intermediate slice), "scaling" float, and shared_<name> bools
+    (default: A1, A3, B2 shared [1, ...]; B1, B3, A2 per expert).
+    n_global: full intermediate size (N_local * tp); chunk_gather: TP all-gather of FP32 chunk partials (TP>1);
+    expert_map: global -> local expert id (-1 = not on this rank) for EP; leaf_reduce: FP32 sum over the EP group.
+    Returns BF16 [T, H] (identical on every rank of the TP / EP group)."""
+    T, H = x.shape
+    k = topk_ids.shape[1]
+    E = w13.shape[0]
+    N2 = w13.shape[1]
+    n_global = n_global or N2 // 2
+    chunk = n_global // N_CHUNKS
+    assert n_global % N_CHUNKS == 0 and (N2 // 2) % chunk == 0 and chunk % BLOCK_K == 0
+    x = x.contiguous()
+    fused_comb = FUSED_COMBINE and k == 16 and (leaf_reduce is None or FUSED_COMBINE_EP)
+    _ZERO_INIT[0] = ZERO_UNCOVERED == "1" or not fused_comb   # torch combine reads every row -> uncovered rows must be 0
+    gids = topk_ids.reshape(-1).to(torch.int64)
+    ids = gids if expert_map is None else expert_map[gids].to(torch.int64)
+    local = ids >= 0
+    bucket = torch.where(local, ids, E)
+    bm = (16 if T <= 256 else (BM_LARGE if T >= 1024 else 64)) if TUNED else BLOCK_M   # one BM per forward (tiles shared by all GEMMs)
+    rows_slot = None
+    if GRAPH_SAFE and FUSED_ROUTE and bucket.numel() <= ROUTE_MAX_SLOTS and E <= ROUTE_MAX_E:
+        # one-launch stable counting sort + tiles (bitwise == the torch routing below; tests/route_check.py)
+        order, rows_slot, tok, counts, tiles = (route_par if (FUSED_GLUE and ROUTE_PAR) else route_fused)(
+            bucket, E, k, bm, triton.cdiv(bucket.numel(), bm) + min(E, bucket.numel()))
+    else:
+        order_all = torch.argsort(bucket, stable=True)  # local slots grouped by expert, ascending
+        counts = torch.zeros(E + 1, dtype=torch.int64, device=x.device).scatter_add_(
+            0, bucket, torch.ones_like(bucket))[:E]                      # = bincount, but no host sync (graph-safe)
+        if GRAPH_SAFE:
+            # all slots stay in the arrays (non-local ones at the tail, never covered by a tile -> rows stay 0)
+            order = order_all
+            tiles = _tiles_device(counts, triton.cdiv(order.numel(), bm) + min(E, order.numel()), bm)
+        else:
+            n_loc = int(local.sum())
+            order = order_all[:n_loc]
+            tiles = _tiles(counts, bm)
+        tok = (order // k).to(torch.int32)
+    if FUSED_GLUE and GRAPH_SAFE and fused_comb:
+        return _glue_tail(x, w13, s13, w2, s2, topk_weights, topk_ids, beta, linear_beta, lora, chunk_gather, expert_map,
+                          leaf_reduce, local, order, rows_slot, tok, counts, tiles, chunk)
+    add13 = add2 = None
+    if lora is not None:
+        sh = lambda n, d: lora.get("shared_" + n, d)
+        d1 = _expert_lora_delta(x, tok, tiles, lora["A1"], lora["B1"], lora["scaling"], sh("A1", True), sh("B1", False))
+        d3 = _expert_lora_delta(x, tok, tiles, lora["A3"], lora["B3"], lora["scaling"], sh("A3", True), sh("B3", False))
+        add13 = torch.cat([d1, d3], dim=1)
+        if "token_mask" in lora:
+            add13 = add13 * lora["token_mask"][tok.long()][:, None]
+    gu = grouped_gemm(x, tok, w13, tiles, N2, scale=s13).to(torch.bfloat16)
+    pre = gu.float() if add13 is None else gu.float() + add13
+    act = situ_fp32(pre, beta, linear_beta)
+    ar = torch.arange(act.shape[0], device=x.device, dtype=torch.int32)
+    if lora is not None:
+        add2 = _expert_lora_delta(act, ar, tiles, lora["A2"], lora["B2"], lora["scaling"],
+                                  lora.get("shared_A2", False), lora.get("shared_B2", True), chunk=chunk, gather=chunk_gather)
+        if "token_mask" in lora:
+            add2 = add2 * lora["token_mask"][tok.long()][:, None]
+    y = _chunked_contract(act, ar, w2, tiles, H, chunk, scale=s2, gather=chunk_gather).to(torch.bfloat16)
+    wsel = topk_weights.reshape(-1)[order].to(torch.float32)
+    if GRAPH_SAFE:
+        wsel = torch.where(local[order], wsel, torch.zeros_like(wsel))   # non-local tail rows contribute exactly 0
+    if FUSED_COMBINE and leaf_reduce is None and k == 16:
+        if rows_slot is None:
+            rows_slot = torch.full((T * k,), -1, dtype=torch.int32, device=x.device)
+            rows_slot[order] = torch.arange(order.numel(), dtype=torch.int32, device=x.device)
+        w_slot = torch.zeros((T * k,), dtype=torch.float32, device=x.device)
+        w_slot[order] = wsel
+        return combine16(y, add2, w_slot.view(T, k), rows_slot.view(T, k), topk_ids)
+    if FUSED_COMBINE and FUSED_COMBINE_EP and leaf_reduce is not None and k == 16:
+        # EP: slot-order leaves (one kernel) -> all-reduce -> tree (one kernel); non-local slots -> row -1 -> exact +0
+        rows_ep = torch.full((T * k,), -1, dtype=torch.int32, device=x.device)
+        rows_ep[order] = torch.where(local[order], torch.arange(order.numel(), dtype=torch.int32, device=x.device),
+                                     torch.full_like(order, -1, dtype=torch.int32))
+        return combine16_ep(y, add2, topk_weights.to(torch.float32).reshape(T, k), rows_ep.view(T, k), topk_ids, leaf_reduce)
+    yf = y.float() if add2 is None else y.float() + add2
+    leaf = wsel[:, None] * yf
+    slots = torch.zeros((T * k, H), dtype=torch.float32, device=x.device)
+    slots[order] = leaf
+    if leaf_reduce is not None:
+        slots = leaf_reduce(slots)          # EP: exactly one rank holds each slot's leaf; x + 0 is exact
+    out = tree_combine_expert_ascending(slots.view(T, k, H), topk_ids).to(torch.bfloat16)
+    return torch.where(out == 0, torch.zeros_like(out), out)          # -0 -> +0 (trainer)
+
+
+def _glue_tail(x, w13, s13, w2, s2, topk_weights, topk_ids, beta, linear_beta, lora, chunk_gather, expert_map,
+               leaf_reduce, local, order, rows_slot, tok, counts, tiles, chunk):
+    """FUSED_GLUE tail of _bi_moe_forward_tokens (after routing): same values as the torch glue, fewer and row-bounded
+    kernels. Rows >= nrows (= this rank's local slots; all rows without EP) are never computed nor read."""
+    T, H = x.shape
+    k = topk_ids.shape[1]
+    N2 = w13.shape[1]
+    R = tok.numel()
+    dev = x.device
+    nrows = counts.sum().reshape(1)
+    nr = nrows if chunk_gather is None else None          # TP gather path: keep the plain tree (all rows are local)
+    mask = lora.get("token_mask") if lora is not None else None
+    add13 = add2 = None
+    if lora is not None:
+        sh = lambda n, d: lora.get("shared_" + n, d)  # noqa: E731
+        add13 = torch.empty((R, N2), dtype=torch.float32, device=dev)
+        tt = _token_tiles(T, tiles[3], dev) if LORA_TOKEN_SHRINK else None
+        _lora_glue(x, tok, tiles, lora["A1"], lora["B1"], lora["scaling"], sh("A1", True), sh("B1", False),
+                   out=add13[:, :N2 // 2], tok_tiles=tt)
+        _lora_glue(x, tok, tiles, lora["A3"], lora["B3"], lora["scaling"], sh("A3", True), sh("B3", False),
+                   out=add13[:, N2 // 2:], tok_tiles=tt)
+    if SCALED:
+        eng = _engine_fn(16 * ENGINE_AUTO_MIN_T, x.shape[1])   # the configured engine regardless of the auto threshold
+        if eng is not None and 16 <= T <= 64:
+            gu = eng(x, tok, w13, tiles, N2, scale=s13)
+        else:
+            gu = scaled_gemm(x, tok, w13, s13, tiles, N2)[0]
+    else:
+        gu = grouped_gemm(x, tok, w13, tiles, N2, scale=s13)
+    act = pre_situ(gu, add13, mask, tok, nrows, beta, linear_beta)
+    del gu, add13
+    ar = _arange_i32(R, dev)
+    if lora is not None:
+        if chunk_gather is None and LORA_TOKEN_SHRINK:
+            add2 = _lora_glue(act, ar, tiles, lora["A2"], lora["B2"], lora["scaling"], lora.get("shared_A2", False),
+                              lora.get("shared_B2", True), chunk=chunk, nrows=nrows)
+        else:
+            add2 = _expert_lora_delta(act, ar, tiles, lora["A2"], lora["B2"], lora["scaling"], lora.get("shared_A2", False),
+                                      lora.get("shared_B2", True), chunk=chunk, gather=chunk_gather, nrows=nr)
+    if SCALED and chunk_gather is None and R <= SCALED_W2_MAX_ROWS and w2.shape[2] * 2 == N_CHUNKS * chunk:
+        y = tree8_rows(scaled_gemm(act, ar, w2, s2, tiles, H, chunks=N_CHUNKS), nrows)
+    else:
+        y = _chunked_contract(act, ar, w2, tiles, H, chunk, scale=s2, gather=chunk_gather, nrows=nr)   # FP32; leaf rounds
+    m2 = mask if add2 is not None else None
+    tw = topk_weights.to(torch.float32).reshape(T, k)
+    if leaf_reduce is None:
+        if rows_slot is None:
+            rows_slot = torch.full((T * k,), -1, dtype=torch.int32, device=dev)
+            rows_slot[order] = torch.arange(order.numel(), dtype=torch.int32, device=dev)
+        if expert_map is not None:                       # (not a vLLM case) non-local slots -> row -1 -> exact +0
+            rows_slot = torch.where(local, rows_slot, -1)
+        return combine16(y, add2, tw, rows_slot.view(T, k), topk_ids, mask=m2)
+    if rows_slot is not None:
+        rows_ep = torch.where(local, rows_slot, -1)
+    else:
+        rows_ep = torch.full((T * k,), -1, dtype=torch.int32, device=dev)
+        rows_ep[order] = torch.where(local[order], torch.arange(order.numel(), dtype=torch.int32, device=dev),
+                                     torch.full_like(order, -1, dtype=torch.int32))
+    return combine16_ep(y, add2, tw, rows_ep.view(T, k), topk_ids, leaf_reduce, mask=m2)
+
+
+# ------------------------------------------------------------------------------------------------ vLLM integration
+def _lora_from_context_graph(ctx, num_tokens):
+    """Graph-safe variant (no host syncs): the adapter slot is chosen on device (max of the token->slot map; RL uses one
+    adapter), the stacked buffers are indexed with that device tensor, and a per-token mask (1 = LoRA token) scales the
+    deltas. With one adapter on every token (RL) this is bit-identical to the host path."""
+    if ctx is None:
+        return None
+    m = getattr(ctx, "local_token_lora_mapping", None)
+    if m is None:
+        m = ctx.punica_wrapper.token_mapping_meta.token_lora_mapping
+    m = m[:num_tokens]
+    slot = m.amax().clamp(min=0).reshape(1).to(torch.int64)
+    # one adapter slot (max_loras=1, the RL case): a view of the only slot, no per-layer copy of the factors (same data);
+    # otherwise gather the device-chosen slot
+    pick = lambda t: t[0] if (LORA_VIEW_ONE_SLOT and t.shape[0] == 1) else t.index_select(0, slot)[0]  # noqa: E731
+    a1, a3 = pick(ctx.w13_lora_a_stacked[0]), pick(ctx.w13_lora_a_stacked[1])
+    b1, b3 = pick(ctx.w13_lora_b_stacked[0]), pick(ctx.w13_lora_b_stacked[1])
+    a2, b2 = pick(ctx.w2_lora_a_stacked[0]), pick(ctx.w2_lora_b_stacked[0])
+    return {"A1": a1, "A3": a3, "B1": b1, "B3": b3, "A2": a2, "B2": b2, "scaling": 1.0,
+            "shared_A1": a1.shape[0] == 1, "shared_A3": a3.shape[0] == 1, "shared_B1": b1.shape[0] == 1,
+            "shared_B3": b3.shape[0] == 1, "shared_A2": a2.shape[0] == 1, "shared_B2": b2.shape[0] == 1,
+            "token_mask": (m == slot[0]).to(torch.float32)}
+
+
+def _lora_from_context(ctx, num_tokens):
+    """vLLM MoELoRAContext -> bi_moe_forward lora dict for the ONE adapter active on this batch (RL: one adapter id).
+    Stacked buffers (image lora/layers/fused_moe.py): w13_lora_a = (w1, w3) each [L, E|1, r, H]; w13_lora_b = (w1, w3)
+    each [L, E, N, r]; w2_lora_a [L, E, r, N]; w2_lora_b [L, E|1, H, r]; B is stored pre-scaled (bf16(B*s)), which is
+    exact for s = alpha/r = 2, so scaling = 1 reproduces the trainer's fp32 B*s bit for bit."""
+    if ctx is None:
+        return None
+    meta = getattr(ctx.punica_wrapper, "token_mapping_meta", None)
+    if meta is not None and bool(meta.no_lora_flag_cpu.item()):
+        return None          # no LoRA in this batch (the mapping tensors are NOT refreshed then: stale)
+    m = getattr(ctx, "local_token_lora_mapping", None)
+    if m is None:
+        m = ctx.punica_wrapper.token_mapping_meta.token_lora_mapping[:num_tokens]
+    m = m[:num_tokens]
+    if m.numel() == 0 or bool((m < 0).all()):
+        return None
+    slot = int(m.max())
+    if not bool(((m == slot) | (m < 0)).all()):
+        raise NotImplementedError("K31_BI_MOE: more than one expert-LoRA adapter in a batch")
+    if bool((m < 0).any()):
+        raise NotImplementedError("K31_BI_MOE: mixed LoRA / no-LoRA tokens in a batch")
+    if hasattr(ctx, "adapter_enabled") and not bool(ctx.adapter_enabled[slot]):
+        return None
+    a1, a3 = ctx.w13_lora_a_stacked[0][slot], ctx.w13_lora_a_stacked[1][slot]
+    b1, b3 = ctx.w13_lora_b_stacked[0][slot], ctx.w13_lora_b_stacked[1][slot]
+    a2, b2 = ctx.w2_lora_a_stacked[0][slot], ctx.w2_lora_b_stacked[0][slot]
+    return {"A1": a1, "A3": a3, "B1": b1, "B3": b3, "A2": a2, "B2": b2, "scaling": 1.0,
+            "shared_A1": a1.shape[0] == 1, "shared_A3": a3.shape[0] == 1, "shared_B1": b1.shape[0] == 1,
+            "shared_B3": b3.shape[0] == 1, "shared_A2": a2.shape[0] == 1, "shared_B2": b2.shape[0] == 1}
+
+
+def enabled() -> bool:
+    return os.environ.get("VLLM_BATCH_INVARIANT", "0") == "1" and os.environ.get("K31_BI_MOE", "0") == "1"
+
+
+def install():
+    """Under VLLM_BATCH_INVARIANT=1 and K31_BI_MOE=1: keep the MXFP4 experts in raw checkpoint layout (no AITER shuffle)
+    and route AiterMxfp4Experts.apply through bi_moe_forward. Requires bf16 routed activations
+    (VLLM_ROCM_USE_AITER_MOE_SITUV2=0). TP>1 and EP>1 (DP=1) via the canonical chunk / leaf reductions."""
+    if not enabled():
+        return "off"
+    import importlib
+    O = importlib.import_module("vllm.model_executor.layers.fused_moe.oracle.mxfp4")
+    if getattr(O, "_k31_bi_moe", False):
+        return "on"
+    orig_convert = O.convert_weight_to_mxfp4_moe_kernel_format
+
+    def convert(mxfp4_backend, layer, w13_weight, w2_weight, w13_weight_scale, w2_weight_scale,
+                w13_bias=None, w2_bias=None, *a, **kw):
+        if mxfp4_backend == O.Mxfp4MoeBackend.AITER_MXFP4_BF16:
+            return (w13_weight.data, w2_weight.data, w13_weight_scale.data, w2_weight_scale.data, w13_bias, w2_bias)
+        return orig_convert(mxfp4_backend, layer, w13_weight, w2_weight, w13_weight_scale, w2_weight_scale,
+                            w13_bias, w2_bias, *a, **kw)
+
+    O.convert_weight_to_mxfp4_moe_kernel_format = convert
+
+    # Force the backend: whatever moe_backend is requested (e.g. "emulation" for expert LoRA), under K31_BI_MOE the
+    # experts are the BI ones (AITER_MXFP4_BF16 slot -> raw layout via `convert`, AiterMxfp4Experts.apply -> BI).
+    from vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe import AiterMxfp4Experts as _AE
+    orig_select = O.select_mxfp4_moe_backend
+
+    def select(config, *a, **kw):
+        be, cls = orig_select(config, *a, **kw)
+        if be != O.Mxfp4MoeBackend.AITER_MXFP4_BF16:
+            import logging
+            logging.getLogger("vllm").warning("K31_BI_MOE: overriding MXFP4 MoE backend %s -> AITER_MXFP4_BF16 (BI experts)", be)
+        return O.Mxfp4MoeBackend.AITER_MXFP4_BF16, _AE
+
+    O.select_mxfp4_moe_backend = select
+    for mod in ("vllm.model_executor.layers.quantization.mxfp4",
+                "vllm.model_executor.layers.quantization.online.mxfp4",
+                "vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors_moe."
+                "compressed_tensors_moe_w4a4_mxfp4",
+                "vllm.model_executor.layers.quantization.inc.schemes.inc_mxfp4_moe",
+                "vllm.model_executor.layers.quantization.quark.quark_moe"):
+        try:
+            m = importlib.import_module(mod)
+            if hasattr(m, "convert_weight_to_mxfp4_moe_kernel_format"):
+                m.convert_weight_to_mxfp4_moe_kernel_format = convert
+            if hasattr(m, "select_mxfp4_moe_backend"):
+                m.select_mxfp4_moe_backend = select
+        except Exception:
+            pass
+
+    from vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe import AiterMxfp4Experts
+
+    def apply(self, output, hidden_states, w1, w2, topk_weights, topk_ids, activation, global_num_experts,
+              expert_map, a1q_scale, a2_scale, workspace13, workspace2, expert_tokens_meta,
+              apply_router_weight_on_input):
+        assert hidden_states.dtype == torch.bfloat16 and a1q_scale is None, \
+            "K31_BI_MOE needs bf16 routed activations: set VLLM_ROCM_USE_AITER_MOE_SITUV2=0"
+        assert not apply_router_weight_on_input
+        mc = self.moe_config
+        qc = self.quant_config
+        pc = mc.moe_parallel_config
+        assert pc.dp_size == 1, "K31_BI_MOE: DP>1 (token dispatch) not supported yet"
+        gather = reduce = None
+        rank = 0
+        if expert_map is not None and expert_map.numel() == global_num_experts + 1:
+            # AITER-style 0/1 local-expert mask (+ sentinel): convert to the canonical -1 / local-slot map
+            m = expert_map[:global_num_experts] > 0
+            expert_map = torch.where(m, torch.cumsum(m.to(torch.int32), 0) - 1, torch.full_like(m, -1, dtype=torch.int32))
+        n_global = None
+        if pc.use_ep and pc.ep_size > 1:
+            from vllm.distributed import get_ep_group
+            grp = get_ep_group()
+            rank = pc.ep_rank
+
+            def reduce(t, grp=grp):
+                torch.distributed.all_reduce(t, group=grp.device_group)
+                return t
+        elif pc.tp_size > 1:
+            from vllm.distributed import get_tp_group
+            grp = get_tp_group()
+            rank = pc.tp_rank
+            n_global = (w1.shape[1] // 2) * pc.tp_size
+            unp = getattr(mc, "intermediate_size_per_partition_unpadded", None)
+            assert unp in (None, w1.shape[1] // 2), f"K31_BI_MOE: padded intermediate {unp} vs {w1.shape[1] // 2}"
+
+            def gather(P, grp=grp, ws=pc.tp_size):
+                outp = torch.empty((ws * P.shape[0],) + tuple(P.shape[1:]), dtype=P.dtype, device=P.device)
+                torch.distributed.all_gather_into_tensor(outp, P.contiguous(), group=grp.device_group)
+                return outp
+        if not getattr(AiterMxfp4Experts, "_k31_logged", False):
+            AiterMxfp4Experts._k31_logged = True
+            import logging
+            logging.getLogger("vllm").warning("K31_BI_MOE: bi_moe_forward active (BI MXFP4 experts, graph_safe=%s, "
+                                              "lora_ctx=%s, tp=%d ep=%d)", GRAPH_SAFE,
+                                              getattr(self, "_lora_context", None) is not None, pc.tp_size, pc.ep_size)
+        lora = (_lora_from_context_graph if GRAPH_SAFE else _lora_from_context)(
+            getattr(self, "_lora_context", None), hidden_states.shape[0])
+        out = bi_moe_forward(hidden_states, w1, qc.w1_scale, w2, qc.w2_scale, topk_weights, topk_ids,
+                             mc.activation_situ_beta, mc.activation_situ_linear_beta,
+                             lora=lora, n_global=n_global, chunk_gather=gather,
+                             expert_map=expert_map if (pc.use_ep and pc.ep_size > 1) else None, leaf_reduce=reduce)
+        # the full result is now identical on every rank of the group; the runner sums the group's outputs next, so
+        # rank 0 returns it and the others 0 (x + 0 is exact in any reduction order)
+        if rank == 0:
+            output.copy_(out)
+        else:
+            output.zero_()
+
+    AiterMxfp4Experts.apply = apply
+    # expert LoRA (vLLM FusedMoEWithLoRA hands a MoELoRAContext to LoRA-capable experts); needs K31LORA_EXPERTS=1 so the
+    # MoE config keeps is_lora_enabled, and "experts" in --lora-target-modules (+ --enable-moe-shared-loras)
+    from vllm.model_executor.layers.fused_moe.experts.lora_experts_mixin import LoRAExpertsMixin
+    # FusedMoEWithLoRA.set_mapping asserts isinstance(fused_experts, LoRAExpertsMixin); that is the module's only
+    # runtime use of the name, so widen it to a tuple that also admits the BI AITER experts (bases can't be changed).
+    import vllm.lora.layers.fused_moe as FML
+    if not isinstance(FML.LoRAExpertsMixin, tuple):
+        FML.LoRAExpertsMixin = (LoRAExpertsMixin, AiterMxfp4Experts)
+    AiterMxfp4Experts.set_lora_context = LoRAExpertsMixin.set_lora_context
+    AiterMxfp4Experts.supports_lora = staticmethod(lambda: True)
+    AiterMxfp4Experts._lora_context = None
+    AiterMxfp4Experts.consumes_expert_mask = False      # get the canonical -1/local-slot expert_map
+    AiterMxfp4Experts._supports_batch_invariance = staticmethod(lambda: True)
+    O._k31_bi_moe = True
+    try:  # loud guard: another plugin (e.g. k31xlora) replacing the experts would bypass the BI MoE
+        import logging
+        logging.getLogger("vllm").warning("K31_BI_MOE installed: AiterMxfp4Experts.apply -> bi_moe_forward. Do NOT also "
+                                          "load k31xlora (its experts class is not BI).")
+    except Exception:
+        pass
+    return "on"
