index 0000000000000000000000000000000000000000..a12163da56f873b12223cd261c54456aa2ec29c8
--- /dev/null
+++ b/kimi-k31/k31lora/k31lora/persist_sleep.py
@@ -0,0 +1,64 @@
+"""Persistent host backup for vLLM sleep(level=1) (CuMemAllocator), experimental (opt-in).
+
+vLLM's sleep(1) allocates a fresh `torch.empty(size, pin_memory=True)` per weight allocation on EVERY sleep. That is slow
+(~80 s for the full K3.1 at TP8: pinning ~1.6 TB of fresh memory) and goes through PyTorch's CachingHostAllocator,
+which rounds sizes up (2.7 TB peak for 1.6 TB of weights) and keeps the blocks pinned after wake.
+Here each allocation gets ONE exactly-sized pageable host buffer, pinned once with cudaHostRegister and reused on every
+sleep, so later sleeps are a plain D2H copy and wakes a plain H2D copy. Host cost = size of the weights, held persistently.
+install() must run in each worker process (worker extension / plugin)."""
+import time
+import torch
+
+_STATS = {}
+
+
+def install():
+    from vllm.device_allocator import cumem as C
+    A = C.CuMemAllocator
+    if getattr(A, "_k31_persist", False):
+        return "already"
+    try:
+        from vllm.platforms import current_platform
+        cudart = current_platform.cudart()
+    except Exception:
+        cudart = torch.cuda.cudart()
+
+    def sleep(self, offload_tags=None):
+        if offload_tags is None:
+            offload_tags = (A.default_tag,)
+        elif isinstance(offload_tags, str):
+            offload_tags = (offload_tags,)
+        pool = self.__dict__.setdefault("_k31_pool", {})
+        t0 = time.time(); new_bytes = 0; tot = 0; bak = 0; t_alloc = 0.0
+        for ptr, data in self.pointer_to_data.items():
+            if data.is_asleep:
+                continue
+            handle = data.handle
+            tot += handle[1]
+            if data.tag in offload_tags:
+                size = handle[1]; bak += size
+                buf = pool.get(ptr)
+                if buf is None or buf.numel() != size:
+                    ta = time.time()
+                    buf = torch.empty(size, dtype=torch.uint8)
+                    rc = cudart.cudaHostRegister(buf.data_ptr(), size, 0)
+                    if rc not in (0, None) and str(rc) not in ("0", "cudaError_t.cudaSuccess", "hipSuccess"):
+                        raise RuntimeError(f"cudaHostRegister failed: {rc}")
+                    pool[ptr] = buf; new_bytes += size; t_alloc += time.time() - ta
+                C.libcudart.cudaMemcpy(buf.data_ptr(), ptr, size)
+                data.cpu_backup_tensor = buf
+            try:
+                C.unmap_and_release(handle)
+            finally:
+                data.is_asleep = True
+        _STATS.update({"sleep_s": round(time.time() - t0, 2), "alloc_register_s": round(t_alloc, 2),
+                       "new_pinned_GB": round(new_bytes / 1e9, 1), "backup_GB": round(bak / 1e9, 1),
+                       "freed_GB": round(tot / 1e9, 1), "pool_GB": round(sum(b.numel() for b in pool.values()) / 1e9, 1)})
+
+    A.sleep = sleep
+    A._k31_persist = True
+    return "installed"
+
+
+def stats():
+    return dict(_STATS)
