index 0000000000000000000000000000000000000000..4cfcbcc34a62beaffb59821e0b6910b2610b994d
--- /dev/null
+++ b/kimi-k31/k31lora/k31lora/__init__.py
@@ -0,0 +1,124 @@
+"""k31lora: vLLM general plugin that makes the ROCm Kimi-K3/K3.1 model LoRA-capable for DENSE modules
+(vLLM f5926fb, the ROCm Kimi-K3.1 build, declares no SupportsLoRA for the amd/ path).
+Loaded in every vLLM process via the `vllm.general_plugins` entry point; put this directory on PYTHONPATH.
+
+Three patches:
+1. re-register KimiK3{,1}ForConditionalGeneration -> k31lora.model.KimiK3LoRAForConditionalGeneration
+   (SupportsLoRA + packed_modules_mapping);
+2. with LoRA enabled, vLLM marks EVERY FusedMoE as LoRA-enabled, and the MXFP4 kernel oracle then rejects
+   AiterMxfp4Experts ("kernel does not support LoRA") even when the experts are not LoRA targets. Unless
+   K31LORA_EXPERTS=1, force FusedMoEConfig.is_lora_enabled=False: the experts stay on AITER MXFP4 and are never
+   wrapped (keep "experts" out of --lora-target-modules; expert LoRA has no ROCm MXFP4 kernel in this image).
+3. TP>1: the KDA in_proj (_KimiGDNMergedColumnParallelLinear) stores its replicated f_a shard as size*tp_size and appends
+   a zero padding slice. vLLM's LoRA then fails "Cannot determine how to split lora_b ... into 7 slices". Port of the
+   zm vllm/kimi-k3.1 fix (lora/layers/column_parallel_linear.py): replicated slices read rank 0's shard, and a packed
+   adapter list shorter than n_slices is padded with None (padding slice gets no LoRA).
+4. With LoRA enabled, wrapped params are named `<mod>.base_layer.weight`, but amd/linear.py KimiLinearModel.load_weights
+   looks up `params_dict[<mod>.weight]`, so vLLM's in-place `reload_weights()` (sleep(2) wake reload, verl-31) and plain
+   load_weights with checkpoint names fail with KeyError. Alias each `.base_layer.` param under its unwrapped name too.
+5. Opt-in K31_PERSIST_SLEEP=1: vLLM sleep(level=1) backs weights up into ONE persistent, exactly-sized host buffer per
+   allocation (pinned once via cudaHostRegister, reused every sleep) instead of fresh pinned tensors from PyTorch's
+   CachingHostAllocator. Measured on full K3.1 TP8 + LoRA: sleep 80 s -> 7.3 s (first sleep 37 s), host peak 2.7 TB ->
+   1.64 TB held persistently, no _host_emptyCache needed. See k31lora/persist_sleep.py.
+6. Opt-in, BI only (VLLM_BATCH_INVARIANT=1 and K31_BI_LORA_F32ADD=1): single-rounding LoRA expand epilogue
+   bf16(fp32(delta) + fp32(base)). See k31lora/bi_lora.py.
+7. Opt-in, BI only (VLLM_BATCH_INVARIANT=1 and K31_BI_MOE=1, needs VLLM_ROCM_USE_AITER_MOE_SITUV2=0, TP1/EP1): BI MXFP4
+   routed experts = exact dequant + pinned Triton grouped GEMM + expert-id-ascending FP32 tree (k31lora/bi_moe.py,
+   importable by the trainer so trainer == rollout).
+"""
+import os
+
+
+def register():
+    from vllm.platforms import current_platform
+    if not current_platform.is_rocm():
+        return
+    from vllm import ModelRegistry
+    for arch in ("KimiK3ForConditionalGeneration", "KimiK31ForConditionalGeneration"):
+        ModelRegistry.register_model(arch, "k31lora.model:KimiK3LoRAForConditionalGeneration")
+    if os.environ.get("K31LORA_EXPERTS", "0") != "1":
+        from vllm.model_executor.layers.fused_moe import config as moe_cfg
+        cls = moe_cfg.FusedMoEConfig
+        if not getattr(cls, "_k31lora_patched", False):
+            orig = cls.__init__
+
+            def __init__(self, *a, **k):
+                k["is_lora_enabled"] = False
+                orig(self, *a, **k)
+
+            cls.__init__ = __init__
+            cls._k31lora_patched = True
+    _patch_replicated_shard()
+    _patch_base_layer_alias()
+    if os.environ.get("K31_PERSIST_SLEEP", "0") == "1":
+        from . import persist_sleep
+        persist_sleep.install()
+    from . import bi_lora
+    bi_lora.install()
+    bi_lora.allow_nonbi_attention()
+    bi_lora.force_bi_all_reduce()
+    bi_lora.bi_inplace_addmm()
+    bi_lora.bi_small_m_tiles()   # ROCm BI matmul: small-M tiles, same BLOCK_K (bitwise); opt-out K31_BI_MM_SMALLM=0
+    from . import bi_moe
+    bi_moe.install()
+    from . import bi_attnres
+    bi_attnres.install()     # BI only; opt-out K31_BI_ATTNRES=0 (pins AttnRes tiling to (1, 4) for every batch)
+
+
+def _patch_base_layer_alias():
+    from vllm.models.kimi_k3.amd.linear import KimiLinearModel as KM
+    if getattr(KM, "_k31lora_alias", False):
+        return
+    orig = KM.load_weights
+
+    def load_weights(self, weights):
+        if not any(".base_layer." in n for n, _ in self.named_parameters()):
+            return orig(self, weights)
+        orig_np = self.named_parameters
+
+        # Present ONLY unwrapped names: params_dict lookups by checkpoint name work, and
+        # RoutedExperts.make_expert_params_mapping (which assumes experts are wrapped whenever any
+        # `.base_layer.` param exists) builds the plain expert mapping (experts are never LoRA-wrapped here).
+        def named_parameters(*a, **k):
+            for n, p in orig_np(*a, **k):
+                yield n.replace(".base_layer.", "."), p
+
+        def strip(ws):
+            for w in ws:
+                yield (w[0].replace(".base_layer.", "."),) + tuple(w[1:])
+
+        self.named_parameters = named_parameters
+        try:
+            return orig(self, strip(weights))
+        finally:
+            del self.named_parameters
+
+    KM.load_weights, KM._k31lora_alias = load_weights, True
+
+
+def _patch_replicated_shard():
+    from vllm.lora.layers.column_parallel_linear import MergedColumnParallelLinearWithLoRA as L
+    if getattr(L, "_k31lora_patched", False):
+        return
+    orig_init, orig_set = L.__init__, L.set_lora
+
+    def __init__(self, base_layer, *a, **k):
+        orig_init(self, base_layer, *a, **k)
+        shard = getattr(self.base_layer, "replicated_shard_id", None)
+        rep = (shard,) if shard is not None else ((0, 1) if type(self.base_layer).__name__ == "KimiK3MergedQKVGateLinear" else ())
+        if rep:
+            ids = list(self.output_ids)
+            for s_ in rep:
+                if s_ < self.n_slices:
+                    ids[s_] = 0
+            self.output_ids = tuple(ids)
+
+    def set_lora(self, index, lora_a, lora_b, *a, **k):
+        if (getattr(self.base_layer, "replicated_shard_id", None) is not None and isinstance(lora_b, list)
+                and len(lora_b) < self.n_slices):
+            miss = self.n_slices - len(lora_b)
+            lora_a = list(lora_a) + [None] * miss
+            lora_b = list(lora_b) + [None] * miss
+        return orig_set(self, index, lora_a, lora_b, *a, **k)
+
+    L.__init__, L.set_lora, L._k31lora_patched = __init__, set_lora, True
diff --git a/kimi-k31/k31lora/k31lora/bi_attnres.py b/kimi-k31/k31lora/k31lora/bi_attnres.py
new file mode 100644
index 0000000000000000000000000000000000000000..35901e7052d4fe38b0f01a9644f56f32a73fcd08
--- /dev/null
+++ b/kimi-k31/k31lora/k31lora/bi_attnres.py
@@ -0,0 +1,76 @@
+"""k31lora.bi_attnres (same function names and the same _k31_bi_pinned marker as a standalone k31bi_attnres,
+so the two coexist and installing is idempotent).
+
+Batch-invariant AttnRes for Kimi-K3.1 on ROCm (vLLM f5926fb `amd/ops/attn_res.py`).
+
+Found by a full-model all-BI decode probe: the first diverging tensor is layer 12's MoE INPUT, i.e. the
+output of `_apply_attn_res` at the first AttnRes block boundary (attn_res_block_size 12). `attn_res()` picks the kernel
+tiling from the BATCH size:
+    if num_tokens >= 256 or num_blocks <= 1:  block_l, num_warps = 1, 4
+    else:                                     block_l, num_warps = 4, 8
+BLOCK_L sets how many source blocks each online-softmax step combines, and num_warps the reduction layout, so the FP32
+rounding of a token's row depends on how many OTHER tokens share the step (decode alone M=1 vs a decode token batched with
+prefill chunks, M >= 256). Layers before the first block boundary have num_blocks <= 1 (always tile 1/4), and the 4-layer
+proxy never reaches a boundary, which is why both were bitwise.
+
+Under VLLM_BATCH_INVARIANT=1 this plugin pins the tiling for every batch (default 1 / 4, the long-sequence path;
+override K31_BI_ATTNRES_CFG="block_l,num_warps"). The kernel and its arithmetic are the image's own `_attn_res_kernel`;
+only the launch parameters are fixed. Patches `vllm.models.kimi_k3.amd.ops.attn_res.attn_res` and the name imported into
+`vllm.models.kimi_k3.amd.linear`. Opt-out: K31_BI_ATTNRES=0. The trainer must call the same op with the same pin."""
+import os
+
+
+def _pinned_attn_res(orig_mod):
+    import torch
+    from vllm.model_executor.layers.quantization.utils.quant_utils import get_fp8_min_max
+    from vllm.triton_utils import triton
+
+    kernel = orig_mod._attn_res_kernel
+    bl, nw = (int(v) for v in os.environ.get("K31_BI_ATTNRES_CFG", "1,4").split(","))
+
+    def attn_res(prefix, delta, blocks, norm_weight, qk_weight, output_norm_weight, num_blocks, block_write_idx, eps,
+                 output_norm_eps, *, quant_dtype=None):
+        num_tokens, hidden_size = prefix.shape
+        assert prefix.stride(-1) == 1
+        assert delta is None or delta.stride(-1) == 1
+        assert blocks.stride(-1) == 1
+        assert norm_weight.stride(-1) == 1
+        assert qk_weight.stride(-1) == 1
+        assert output_norm_weight is None or output_norm_weight.stride(-1) == 1
+        if quant_dtype is not None:
+            assert quant_dtype in (torch.float8_e4m3fn, torch.float8_e4m3fnuz)
+        output = torch.empty_like(prefix, dtype=quant_dtype or prefix.dtype, memory_format=torch.contiguous_format)
+        scale = (torch.empty((num_tokens, 1), device=prefix.device, dtype=torch.float32)
+                 if quant_dtype is not None else None)
+        if num_tokens == 0:
+            return output if scale is None else (output, scale)
+        kernel[(num_tokens,)](
+            prefix, delta, blocks, norm_weight, qk_weight, output_norm_weight, output, scale,
+            prefix.stride(0), 0 if delta is None else delta.stride(0), blocks.stride(0), blocks.stride(1),
+            output.stride(0), num_blocks, hidden_size, block_write_idx, eps, output_norm_eps,
+            HAS_DELTA=delta is not None, WRITE_BLOCK=block_write_idx >= 0,
+            APPLY_OUTPUT_NORM=output_norm_weight is not None,
+            QUANT_MAX=0.0 if quant_dtype is None else get_fp8_min_max()[1],
+            BLOCK_L=bl,                                   # PINNED (default: 1 if num_tokens >= 256 else 4)
+            BLOCK_D=triton.next_power_of_2(hidden_size),
+            num_warps=nw,                                 # PINNED (default: 4 if num_tokens >= 256 else 8)
+            num_stages=2,
+        )
+        return output if scale is None else (output, scale)
+
+    attn_res._k31_bi_pinned = (bl, nw)
+    return attn_res
+
+
+def install():
+    import importlib
+    if os.environ.get("VLLM_BATCH_INVARIANT", "0") != "1" or os.environ.get("K31_BI_ATTNRES", "1") != "1":
+        return False
+    ops = importlib.import_module("vllm.models.kimi_k3.amd.ops.attn_res")
+    if getattr(ops.attn_res, "_k31_bi_pinned", None):
+        return True
+    fn = _pinned_attn_res(ops)
+    ops.attn_res = fn
+    lin = importlib.import_module("vllm.models.kimi_k3.amd.linear")
+    lin.attn_res = fn
+    return True
diff --git a/kimi-k31/k31lora/k31lora/bi_lora.py b/kimi-k31/k31lora/k31lora/bi_lora.py
new file mode 100644
index 0000000000000000000000000000000000000000..b41e3c667c2348fd477e3cb09a9b4a2180214195
--- /dev/null
+++ b/kimi-k31/k31lora/k31lora/bi_lora.py
@@ -0,0 +1,156 @@
+"""Overlay patch 6 (opt-in, BI only): single-rounding LoRA epilogue for dense LoRA under VLLM_BATCH_INVARIANT=1.
+
+vLLM's punica expand (vllm/lora/ops/triton_ops/kernel_utils.py do_expand_kernel) does
+    tiled_c = accumulator.to(bf16); tiled_c += bf16(base_out)          -> bf16(bf16(delta) + base)   (two roundings)
+With K31_BI_LORA_F32ADD=1 it becomes
+    tiled_c = (accumulator + fp32(base_out)).to(bf16)                   -> bf16(fp32(delta) + fp32(base)) (one rounding)
+i.e. the zm "LoRA leaf" form minus the fp32 base GEMM output (our base GEMM still rounds to bf16 once). Both forms are
+row-local and batch-invariant once the GEMMs are; this one is just the more accurate contract, and the trainer adapter
+must mirror whichever is chosen. Implemented by re-compiling do_expand_kernel from the installed source with the
+epilogue line changed, and rebinding it in lora_expand_op (Triton resolves the callee from that module's globals)."""
+import inspect
+import os
+import re
+
+
+def install():
+    if os.environ.get("VLLM_BATCH_INVARIANT", "0") != "1" or os.environ.get("K31_BI_LORA_F32ADD", "0") != "1":
+        return "off"
+    from vllm.lora.ops.triton_ops import kernel_utils as KU
+    from vllm.lora.ops.triton_ops import lora_expand_op as LE
+    if getattr(LE, "_k31_f32add", False):   # register() may run twice (k31xlora calls k31lora.register())
+        return "f32add"
+    src = inspect.getsource(KU)
+    old = re.compile(r"(\n(\s*)if ADD_INPUTS:\n\s*tiled_out = tl\.load\(c_ptr, mask=c_mask\)\n)\s*tiled_c \+= tiled_out\n")
+    m = old.search(src)
+    if m is None:
+        raise RuntimeError("k31lora bi_lora: expand epilogue pattern not found; vLLM changed")
+    ind = m.group(2) + "    "
+    new = m.group(1) + f"{ind}tiled_c = (accumulator + tiled_out.to(tl.float32)).to(cur_lora_ptr.dtype.element_ty)\n"
+    src = src[: m.start()] + new + src[m.end():]
+    import importlib.util
+    import tempfile
+    d = os.environ.get("K31_BI_TMP", tempfile.gettempdir())
+    path = os.path.join(d, f"k31_kernel_utils_f32add_{os.getpid()}.py")   # per process: no write races
+    with open(path, "w") as f:   # triton needs a real source file for inspect
+        f.write(src)
+    spec = importlib.util.spec_from_file_location(f"k31_kernel_utils_f32add_{os.getpid()}", path)
+    m2 = importlib.util.module_from_spec(spec); spec.loader.exec_module(m2)
+    LE.do_expand_kernel = m2.do_expand_kernel
+    LE._k31_f32add = True
+    return "f32add"
+
+
+def allow_nonbi_attention():
+    """TEST ONLY (K31_BI_ALLOW_NONBI_ATTN=1 with VLLM_BATCH_INVARIANT=1): the image's ROCm DSA attention backends and MXFP4 MoE experts refuse BI
+    mode (ROCM_AITER_MLA_SPARSE and the AITER-FA MLA prefill: "batch invariance not supported"), so no K3.1 engine starts
+    under BI. This lets them start anyway (they are NOT batch-invariant) so probes can localize the other layers;
+    the DSA layer is then expected to be the first divergence. Never use for real BI runs."""
+    if os.environ.get("VLLM_BATCH_INVARIANT", "0") != "1" or os.environ.get("K31_BI_ALLOW_NONBI_ATTN", "0") != "1":
+        return "off"
+    from vllm.v1.attention.backends.mla.rocm_aiter_mla_sparse import ROCMAiterMLASparseBackend
+    from vllm.v1.attention.backends.mla.prefill.aiter_flash_attn import AiterFlashAttnPrefillBackend
+    for cls in (ROCMAiterMLASparseBackend, AiterFlashAttnPrefillBackend):
+        if getattr(cls, "_k31_allow_nonbi", False):
+            continue
+        orig = cls.validate_configuration.__func__
+
+        def validate_configuration(c, *a, _orig=orig, **k):
+            return [r for r in _orig(c, *a, **k) if r != "batch invariance not supported"]
+
+        cls.validate_configuration = classmethod(validate_configuration)
+        if hasattr(cls, "supports_batch_invariance"):
+            cls.supports_batch_invariance = classmethod(lambda c: True)
+        cls._k31_allow_nonbi = True
+    # MoE: the MXFP4 expert oracle also refuses BI ("AiterMxfp4Experts ... does not support batch invariance").
+    # Let the default (non-BI) experts start too; the MoE layers are then an expected divergence.
+    from vllm.model_executor.layers.fused_moe import modular_kernel as MK
+    if not getattr(MK.FusedMoEExperts, "_k31_allow_nonbi", False):
+        from vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe import AiterMxfp4Experts
+        for c in (MK.FusedMoEExperts, AiterMxfp4Experts):
+            c._supports_batch_invariance = staticmethod(lambda: True)
+        MK.FusedMoEExperts._k31_allow_nonbi = True
+    # Every other attention backend that does not declare BI (KDA "KIMI_K3_KDA_ROCM", DSA indexer "DEEPSEEK_V32_INDEXER",
+    # ...): flip the base-class default. Backends that set it explicitly keep their own answer.
+    from vllm.v1.attention.backend import AttentionBackend
+    AttentionBackend.supports_batch_invariance = classmethod(lambda c: True)
+    return "allowed"
+
+
+def force_bi_all_reduce():
+    """DIAGNOSTIC ONLY, not needed (VLLM_BATCH_INVARIANT=1 and K31_BI_AR=1): route every floating-point TP all-reduce
+    through vLLM's all_reduce_batch_invariant (all-gather + ordered sum) instead of the custom all-reduce.
+    Measured 11/05: vLLM's ROCm custom all-reduce gives the SAME bits as all_reduce_batch_invariant at every size
+    (7 KB-14.7 MB, bf16/fp32, all ranks) and is 3-4x faster at decode sizes; full-model BI rollout and the TP8 --bi 1 RL
+    gate (trainer fixed-order-sum VTP) are bitwise with it unset. (The old TP8 bs1-vs-bsN decode divergence was addmm_,
+    see bi_inplace_addmm.)"""
+    if os.environ.get("VLLM_BATCH_INVARIANT", "0") != "1" or os.environ.get("K31_BI_AR", "0") != "1":
+        return "off"
+    from vllm.distributed.device_communicators.custom_all_reduce import CustomAllreduce
+    if getattr(CustomAllreduce, "_k31_bi_ar", False):
+        return "on"
+    orig = CustomAllreduce.should_custom_ar
+
+    def should_custom_ar(self, inp):
+        if inp.is_floating_point():
+            return False
+        return orig(self, inp)
+    CustomAllreduce.should_custom_ar = should_custom_ar
+    CustomAllreduce._k31_bi_ar = True
+    return "on"
+
+
+_ADDMM_LIB = None
+
+
+def bi_inplace_addmm():
+    """VLLM_BATCH_INVARIANT=1 (opt-out K31_BI_ADDMM_=0): vLLM's BI mode overrides aten::addmm / addmm.out but NOT the
+    in-place aten::addmm_, which therefore stays on hipBLASLt (not row-invariant). The Kimi-K3 latent-MoE TP>1 tail uses
+    `hidden_shard.addmm_(latent, up_proj_shard.t())` (amd/latent_moe_runner.py:114): decode bs1 vs bsN diverged there.
+    Route addmm_ through vLLM's batch-invariant addmm."""
+    global _ADDMM_LIB
+    if os.environ.get("VLLM_BATCH_INVARIANT", "0") != "1" or os.environ.get("K31_BI_ADDMM_", "1") != "1":
+        return "off"
+    if _ADDMM_LIB is not None:
+        return "on"
+    import torch
+    from vllm.model_executor.determinism.batch_invariant import _addmm_impl
+    from vllm.platforms import current_platform
+
+    def addmm_(self, mat1, mat2, *, beta=1, alpha=1):
+        return self.copy_(_addmm_impl(self, mat1, mat2, beta, alpha, None))
+
+    _ADDMM_LIB = torch.library.Library("aten", "IMPL")
+    _ADDMM_LIB.impl("aten::addmm_", addmm_, current_platform.dispatch_key)
+    return "on"
+
+
+def bi_small_m_tiles():
+    """VLLM_BATCH_INVARIANT=1 on ROCm (opt-out K31_BI_MM_SMALLM=0): small-M tiles for vLLM's BI persistent matmul.
+    vLLM's M-bucketed config table (batch_invariant_configs._get_matmul_config) is only populated for CUDA arch families, so
+    on gfx950 every BF16 BI GEMM runs 128x128x64 tiles, mostly padding at decode M. This keeps BLOCK_K = 64 (the default,
+    hence the same per-element K-reduction order) and varies only BLOCK_M/N/warps/stages by M. Verified 11/05: all 36
+    candidate configs are bitwise == the default for K in {512..12288} x N in {256..20480} x M in 1..64,96,128; ~2x at decode."""
+    if os.environ.get("VLLM_BATCH_INVARIANT", "0") != "1" or os.environ.get("K31_BI_MM_SMALLM", "1") != "1":
+        return "off"
+    import torch
+    from vllm.platforms import current_platform
+    if not current_platform.is_rocm():
+        return "off"
+    from vllm.model_executor.determinism import batch_invariant as BI
+    if getattr(BI, "_k31_small_m", False):
+        return "on"
+    orig = BI._get_matmul_config
+
+    def _get_matmul_config(M, N, K, dtype, default):
+        if dtype == torch.bfloat16 and M <= 64 and default.get("BLOCK_SIZE_K") == 64:
+            bn = 128 if N >= 16384 else 64
+            bm = 16 if M <= 32 else 64
+            if N >= 16384:
+                bm = 32 if M <= 16 else 64
+            return {"BLOCK_SIZE_M": bm, "BLOCK_SIZE_N": bn, "BLOCK_SIZE_K": 64, "GROUP_SIZE_M": 8,
+                    "num_stages": 3, "num_warps": 4}
+        return orig(M, N, K, dtype, default)
+    BI._get_matmul_config = _get_matmul_config
+    BI._k31_small_m = True
+    return "on"
