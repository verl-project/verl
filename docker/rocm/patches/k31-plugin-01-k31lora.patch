+import torch
+from vllm.model_executor.models.interfaces import SupportsLoRA
+from vllm.models.kimi_k3.amd.model import KimiK3ForConditionalGeneration as _Base
+
+
+class KimiK3LoRAForConditionalGeneration(_Base, SupportsLoRA):
+    # HF (adapter) module name -> fused vLLM module. Order = output-slice order of the fused layer.
+    #   KDA  in_proj_qkvgfab: [q | k | v | g | f_a | b]   (amd/kda.py split: 3*proj, proj, head_dim, heads)
+    #   DSA  fused_qkv_a_proj: [q_a | kv_a(+rope)]  (amd/dsa.py:656; K3.1's full-attn layers are all DSA, g_proj separate).
+    #   (amd/linear.py's non-DSA MLA may fuse g into it as a 3rd slice; not used by K3.1.)
+    packed_modules_mapping = {
+        "in_proj_qkvgfab": ["q_proj", "k_proj", "v_proj", "g_proj", "f_a_proj", "b_proj"],
+        "fused_qkv_a_proj": ["q_a_proj", "kv_a_proj_with_mqa"],
+        "gate_up_proj": ["gate_proj", "up_proj"],
+    }
+    embedding_modules: dict = {}
+    # experts are MXFP4 AITER (no LoRAExpertsMixin on ROCm); keep them out via --lora-target-modules.
+    is_3d_moe_weight = True
diff --git a/kimi-k31/k31lora/k31lora/persist_sleep.py b/kimi-k31/k31lora/k31lora/persist_sleep.py
