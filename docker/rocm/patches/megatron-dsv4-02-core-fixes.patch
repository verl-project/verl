+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+"""The checkpoint-load state template of the precision-aware optimizer must match FusedAdam.step()."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from megatron.core.optimizer import _init_adam_optimizer_state
+
+te_optimizers = pytest.importorskip("transformer_engine.pytorch.optimizers")
+
+
+def _make(params):
+    return te_optimizers.FusedAdam(
+        params,
+        lr=1e-3,
+        master_weights=True,
+        use_decoupled_grad=True,
+        master_weight_dtype=torch.float32,
+        store_param_remainders=True,
+        exp_avg_dtype=torch.float32,
+        exp_avg_sq_dtype=torch.float32,
+    )
+
+
+def _params():
+    torch.manual_seed(0)
+    return [
+        torch.nn.Parameter(torch.randn(4, 8, device="cuda", dtype=torch.bfloat16)),
+        torch.nn.Parameter(torch.randn(8, device="cuda", dtype=torch.float32)),
+    ]
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="FusedAdam needs a GPU")
+def test_init_state_matches_step_initialization_for_mixed_dtypes():
+    config = SimpleNamespace(use_precision_aware_optimizer=True, store_param_remainders=True)
+
+    template = _make(_params())
+    _init_adam_optimizer_state(template, config)
+    # Before the fix, the FP32 parameter got an int16 'master_param' and this asserted.
+    template.state_dict()
+
+    stepped_params = _params()
+    stepped = _make(stepped_params)
+    for p in stepped_params:
+        p.decoupled_grad = torch.zeros_like(p, dtype=torch.float32)
+    stepped.step()
+
+    for p_t, p_s in zip(template.param_groups[0]["params"], stepped.param_groups[0]["params"]):
+        assert set(template.state[p_t]) == set(stepped.state[p_s])
+        for name in template.state[p_t]:
+            assert template.state[p_t][name].dtype == stepped.state[p_s][name].dtype, (p_t.dtype, name)
+    assert template.state[template.param_groups[0]["params"][0]]["master_param"].dtype == torch.int16
+    assert template.state[template.param_groups[0]["params"][1]]["master_param"].dtype == torch.float32
