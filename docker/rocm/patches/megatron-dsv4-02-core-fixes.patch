+def _init_adam_optimizer_state(opt, config=None):
+    """Initialize missing Adam state (the template a distributed-checkpoint load fills in).
+
+    With the precision-aware TE FusedAdam this must create exactly the state FusedAdam.step()
+    creates: parameter remainders (int16) replace the FP32 master only for BF16 parameters and
+    only when the optimizer itself stores remainders. Passing the config flag for every parameter
+    gave FP32 parameters an int16 'master_param', and FusedAdam.state_dict() then asserts.
+    """
+    for group in opt.param_groups:
+        for p in group['params']:
+            if len(opt.state[p]) == 0:
+                if config is None or not config.use_precision_aware_optimizer:
+                    opt.state[p]['exp_avg'] = torch.zeros_like(p.data)
+                    opt.state[p]['exp_avg_sq'] = torch.zeros_like(p.data)
+                else:
+                    store_remainders = getattr(
+                        opt, "store_param_remainders", config.store_param_remainders
+                    )
+                    opt.initialize_state(p, bool(store_remainders) and p.dtype == torch.bfloat16)
