diff --git a/tests/unit_tests/transformer/experimental_attention_variant/test_csa_cp_layout_torch_fallback.py b/tests/unit_tests/transformer/experimental_attention_variant/test_csa_cp_layout_torch_fallback.py
new file mode 100644
index 000000000..2c8299bd0
--- /dev/null
+++ b/tests/unit_tests/transformer/experimental_attention_variant/test_csa_cp_layout_torch_fallback.py
@@ -0,0 +1,222 @@
+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+"""The PyTorch fallback of the DSv4 CP layout kernels must follow the CuTeDSL kernels exactly.
+
+``build_attention_indices`` and ``CompressorInputCompact`` run CuTeDSL kernels on CUDA and a PyTorch fallback
+elsewhere (ROCm, CPU). The reference here is a scalar Python transliteration of each CuTe kernel, one (row, col)
+at a time, written from the kernel source, not from the fallback. Integer outputs and the compaction copy (and its
+scatter-add backward) are compared exactly on random packed batches: CP=1 and CP-rank slices (global_start > 0,
+boundary rows), ratio 1/4/128, all three index modes, invalid / out-of-range top-k ids and -1 rank rows. CPU only.
+"""
+import random
+
+import torch
+
+from megatron.core.transformer.experimental_attention_variant.csa_utils import (
+    cp_layout_kernels as img,
+)
+
+
+# ------------------------------------------------------------------ transliterations of the CuTe kernels
+def k_indices(cu, cu_c, topk, s2r, gs, l_local, d_window, W, ratio, cw, mode):
+    """_build_attention_indices_kernel; mode 0 selected, 1 all visible, 2 indexer loss."""
+    total = W + cw; n_seq = len(cu) - 1; rows_s2r = len(s2r); base = d_window + l_local
+    out = [[-1] * total for _ in range(l_local)]; length = [0] * l_local; irm = [[-1] * cw for _ in range(l_local)]
+    for row in range(l_local):
+        gq = gs + row; ssf, scs, scl = -1, 0, 0
+        for s in range(n_seq):
+            if cu[s] <= gq < cu[s + 1]:
+                ssf = cu[s]
+                if ratio > 1 and cw > 0:
+                    scs = cu_c[s]; scl = cu_c[s + 1] - scs
+        if mode != 0:
+            for col in range(total):
+                tv, rmv, ln = -1, -1, 0
+                if ssf >= 0:
+                    ws = max(gq - W + 1, ssf); wc = gq - ws + 1
+                    if mode == 2:
+                        if col < cw:
+                            cid = topk[row][col]
+                            if 0 <= cid < scl:
+                                sm = scs + cid
+                                if sm < rows_s2r:
+                                    rmv = s2r[sm]
+                                    if rmv >= 0:
+                                        tv = base + rmv
+                        else:
+                            wcol = col - cw
+                            if wcol < wc:
+                                pos = ws + wcol
+                                tv = pos - (gs - d_window) if pos < gs else d_window + pos - gs
+                    else:
+                        cc = 0
+                        if ratio > 1 and cw > 0:
+                            cc = min((gq - ssf + 1) // ratio, cw, scl)
+                        ln = wc + cc
+                        if col < wc:
+                            pos = ws + col
+                            tv = pos - (gs - d_window) if pos < gs else d_window + pos - gs
+                        elif col < ln:
+                            sm = scs + col - wc
+                            if sm < rows_s2r:
+                                r = s2r[sm]
+                                if r >= 0:
+                                    tv = base + r
+                elif total > 0 and mode != 2:
+                    ln = 1
+                    if col == 0:
+                        tv = 0
+                out[row][col] = tv
+                if mode == 2:
+                    if col < cw:
+                        irm[row][col] = rmv
+                elif col == 0:
+                    length[row] = ln
+        else:
+            if ssf >= 0:
+                wcol_out = 0; ws = max(gq - W + 1, ssf); wc = gq - ws + 1
+                for wcol in range(W):
+                    if wcol < wc:
+                        pos = ws + wcol
+                        out[row][wcol_out] = pos - (gs - d_window) if pos < gs else d_window + pos - gs
+                        wcol_out += 1
+                if ratio > 1 and cw > 0:
+                    for c in range(cw):
+                        cid = topk[row][c]
+                        if 0 <= cid < scl:
+                            sm = scs + cid
+                            if sm < rows_s2r and s2r[sm] >= 0:
+                                out[row][wcol_out] = base + s2r[sm]; wcol_out += 1
+                length[row] = wcol_out
+            elif total > 0:
+                out[row][0] = 0; length[row] = 1
+    return out, length, irm
+
+
+def k_compact_src(cu, gs, l_local, ratio, d_comp, compact_len):
+    """_compressor_input_compact_fwd_kernel: per compact row, (src_global, comp_id)."""
+    res = []
+    for row in range(compact_len):
+        src, vid, run = -1, -1, 0
+        for s in range(len(cu) - 1):
+            ss, se = cu[s], min(cu[s + 1], gs + l_local)
+            if ss < se and gs < se:
+                fg = (max(gs - d_comp - ss, 0) + ratio - 1) // ratio
+                vt = max((se - ss) // ratio - fg, 0) * ratio
+                if run <= row < run + vt:
+                    lv = row - run; cid = fg + lv // ratio
+                    src = ss + cid * ratio + lv % ratio; vid = cid
+                run += vt
+        res.append((src, vid))
+    return res
+
+
+def k_compact_bwd_rows(cu, gs, l_local, ratio, d_comp, d_window, compact_len):
+    """_compressor_input_compact_bwd_kernel: per output row (boundary rows then local rows), its compact row or -1."""
+    res = []
+    for out_row in range(d_window + l_local):
+        src = gs + (out_row - d_window); cr, run = -1, 0
+        for s in range(len(cu) - 1):
+            ss, se_full = cu[s], cu[s + 1]; se = min(se_full, gs + l_local)
+            if ss < se and gs < se:
+                fg = (max(gs - d_comp - ss, 0) + ratio - 1) // ratio
+                sg = (se - ss) // ratio
+                vt = max(sg - fg, 0) * ratio
+                if ss <= src < se_full:
+                    off = src - ss; cid = off // ratio
+                    if fg <= cid < sg:
+                        cr = run + (cid - fg) * ratio + off % ratio
+                run += vt
+        res.append(cr if 0 <= cr < compact_len else -1)
+    return res
+
+
+# ------------------------------------------------------------------ random cases
+def rand_case(rng):
+    n_seq = rng.randint(1, 5)
+    lens = [rng.choice([1, 3, rng.randint(1, 40), rng.randint(100, 700)]) for _ in range(n_seq)]
+    cu = [0]
+    for L in lens:
+        cu.append(cu[-1] + L)
+    T = cu[-1]
+    if rng.random() < 0.5:   # CP=1
+        gs, l_local = 0, T
+    else:                    # a CP rank's slice
+        gs = rng.randint(0, T - 1); l_local = rng.randint(1, T - gs)
+    ratio = rng.choice([1, 4, 128])
+    return cu, gs, l_local, ratio
+
+
+def check_indices(rng, cu, gs, l_local, ratio):
+    W = rng.choice([1, 8, 128]); d_window = 0 if gs == 0 else rng.choice([0, W - 1, W])
+    cw = 0 if ratio == 1 else rng.choice([0, 1, 7, 64, 512])
+    cl = [(cu[s + 1] - cu[s]) // ratio if ratio > 1 else 0 for s in range(len(cu) - 1)]
+    cu_c = [0]
+    for c in cl:
+        cu_c.append(cu_c[-1] + c)
+    rows = max(cu_c[-1], 1) + rng.choice([0, 0, 3])          # sometimes extra rows; sometimes truncated below
+    if rng.random() < 0.2:
+        rows = max(1, cu_c[-1] - 2)
+    s2r = [rng.choice([-1] + list(range(4 * rows))) if rng.random() < 0.1 else i * 2 for i in range(rows)]
+    ok_modes = []
+    for mode in (0, 1, 2):
+        if mode in (0, 2) and cw == 0:
+            continue
+        topk = [[rng.choice([-1, -5, rng.randint(0, 3 * max(cl + [1])), rng.randint(0, max(max(cl + [1]) - 1, 0))])
+                 for _ in range(cw)] for _ in range(l_local)] if mode in (0, 2) else None
+        t_topk = torch.tensor(topk, dtype=torch.int32).reshape(l_local, cw) if topk is not None else None
+        got = img.build_attention_indices(torch.tensor(cu, dtype=torch.int32), gs, l_local, d_window, W, ratio, cw,
+                                          t_topk, torch.tensor(cu_c, dtype=torch.int32),
+                                          torch.tensor(s2r, dtype=torch.int32), for_indexer_loss=(mode == 2))
+        ref = k_indices(cu, cu_c, topk, s2r, gs, l_local, d_window, W, ratio, cw, mode)
+        assert got[0].tolist() == ref[0], f"topk_idxs mode {mode} cu={cu} gs={gs} l={l_local} W={W} r={ratio} cw={cw}"
+        if mode == 2:
+            assert got[1] is None and got[2].tolist() == ref[2], f"indexer_rank_major mode 2 cu={cu}"
+        else:
+            assert got[1].tolist() == ref[1], f"topk_length mode {mode} cu={cu} gs={gs} r={ratio} cw={cw}"
+        ok_modes.append(mode)
+    return ok_modes
+
+
+def check_compact(rng, cu, gs, l_local, ratio):
+    d_comp = 8 if ratio == 4 else ratio
+    d_window = 0 if gs == 0 else min(gs, rng.choice([d_comp, d_comp + 5]))
+    if gs > 0 and d_window < min(gs, d_comp):
+        return False
+    H = rng.choice([4, 6])
+    hl = torch.randn(l_local, 2, H, dtype=torch.bfloat16)
+    bh = torch.randn(d_window, 2, H, dtype=torch.bfloat16)
+    cap = max(1, (l_local + d_comp) // ratio)
+    cap = cap if rng.random() < 0.8 else max(1, cap // 3)        # sometimes too small: overflow rows are dropped
+    hl_ = hl.clone().requires_grad_(True); bh_ = bh.clone().requires_grad_(True)
+    out, ids = img.CompressorInputCompact.apply(hl_, bh_, torch.tensor(cu, dtype=torch.int32), gs, ratio, d_comp, cap)
+    src = k_compact_src(cu, gs, l_local, ratio, d_comp, cap * ratio)
+    exp = torch.zeros_like(out)
+    for r, (sg, _) in enumerate(src):
+        if sg >= 0:
+            exp[r] = bh[sg - (gs - d_window)] if sg < gs else hl[sg - gs]
+    assert torch.equal(out, exp), f"compact fwd values cu={cu} gs={gs} r={ratio}"
+    assert ids.tolist() == [src[g * ratio][1] for g in range(cap)], f"comp_ids cu={cu} gs={gs} r={ratio}"
+    g = torch.randn_like(out)
+    out.backward(g)
+    rows = k_compact_bwd_rows(cu, gs, l_local, ratio, d_comp, d_window, cap * ratio)
+    eb = torch.stack([g[r] if r >= 0 else torch.zeros_like(g[0]) for r in rows]) if rows else torch.zeros(0, 2, H)
+    assert torch.equal(bh_.grad, eb[:d_window].to(bh_.grad.dtype)), f"compact bwd boundary cu={cu} gs={gs}"
+    assert torch.equal(hl_.grad, eb[d_window:].to(hl_.grad.dtype)), f"compact bwd local cu={cu} gs={gs}"
+    return True
+
+
+def test_cpu_tensors_take_the_torch_fallback():
+    assert not img._cute_usable(torch.zeros(1))
+
+
+def test_torch_fallback_matches_cute_kernel_semantics():
+    rng = random.Random(20261017)
+    n_idx = {0: 0, 1: 0, 2: 0}; n_cmp = 0; n_cp1 = 0
+    for it in range(400):
+        cu, gs, l_local, ratio = rand_case(rng)
+        n_cp1 += gs == 0 and l_local == cu[-1]
+        for m in check_indices(rng, cu, gs, l_local, ratio):
+            n_idx[m] += 1
+        if ratio > 1:
+            n_cmp += check_compact(rng, cu, gs, l_local, ratio)
+    assert min(n_idx.values()) > 50 and n_cmp > 50 and n_cp1 > 100, (n_idx, n_cmp, n_cp1)
