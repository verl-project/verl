diff --git a/experimental/lite/tests/unit/primitive/test_visible_vjp_unit.py b/experimental/lite/tests/unit/primitive/test_visible_vjp_unit.py
new file mode 100644
index 000000000..7bd533711
--- /dev/null
+++ b/experimental/lite/tests/unit/primitive/test_visible_vjp_unit.py
@@ -0,0 +1,86 @@
+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+"""visible_forward: value from the visible implementation, VJP from the native recompute; deployed_values STE."""
+import torch
+import torch.nn.functional as F
+
+from megatron.lite.primitive.ops.visible_vjp import (
+    deployed_values,
+    run_deferred_restores,
+    visible_forward,
+)
+
+
+def test_value_is_visible_gradient_is_native():
+    torch.manual_seed(0)
+    x = torch.randn(4, 8, requires_grad=True)
+    w = torch.randn(3, 8, requires_grad=True)
+
+    def visible(t):
+        return (F.linear(t, w) + 1.0).detach()  # a different value, no graph
+
+    def native(t):
+        return F.linear(t, w)
+
+    y = visible_forward(visible, native, x)
+    assert torch.equal(y, F.linear(x, w).detach() + 1.0)
+    g = torch.randn_like(y)
+    y.backward(g)
+    assert torch.allclose(x.grad, g @ w.detach())
+    assert torch.allclose(w.grad, g.t() @ x.detach())
+
+
+def test_integer_and_non_tensor_inputs_pass_through():
+    table = torch.randn(10, 4, requires_grad=True)
+    ids = torch.tensor([1, 3, 3])
+
+    def native(i, scale):
+        return F.embedding(i, table) * scale
+
+    y = visible_forward(lambda i, scale: F.embedding(i, table).detach() * scale, native, ids, 2.0)
+    assert y.requires_grad  # joins the graph through the anchor even with integer input
+    y.sum().backward()
+    expected = torch.zeros_like(table)
+    expected[1] += 2.0
+    expected[3] += 4.0
+    assert torch.equal(table.grad, expected)
+
+
+def test_tuple_outputs_with_partial_gradients():
+    x = torch.randn(5, requires_grad=True)
+
+    def native(t):
+        return t * 2.0, t * 3.0
+
+    a, b = visible_forward(lambda t: (t * 2.0, t * 3.0), native, x)
+    a.sum().backward()
+    assert torch.equal(x.grad, torch.full_like(x, 2.0))
+
+
+def test_deployed_values_dx_uses_served_value_dw_reaches_master():
+    torch.manual_seed(1)
+    master = torch.nn.Parameter(torch.randn(3, 8))
+    original = master.data
+    served = (master.data * 4).round() / 4  # stand-in for dequant(quant(master))
+    x = torch.randn(2, 8, requires_grad=True)
+
+    def native(t):
+        with deployed_values([master], lambda m: (m * 4).round() / 4):
+            return F.linear(t, master)
+
+    y = visible_forward(lambda t: F.linear(t, served).detach(), native, x)
+    g = torch.randn_like(y)
+    y.backward(g)
+    assert torch.allclose(x.grad, g @ served)  # dX at the served value
+    assert torch.allclose(master.grad, g.t() @ x.detach())  # dW onto the master
+    assert master.data.data_ptr() == original.data_ptr()  # restored after the backward
+
+
+def test_deployed_values_inactive_is_identity_and_restore_is_deferred():
+    p = torch.nn.Parameter(torch.ones(2))
+    with deployed_values([p], lambda m: m * 0, active=False):
+        assert torch.equal(p.data, torch.ones(2))
+    with deployed_values([p], lambda m: m * 0):
+        pass
+    assert torch.equal(p.data, torch.zeros(2))  # still swapped: restore waits for the backward
+    run_deferred_restores()
+    assert torch.equal(p.data, torch.ones(2))
