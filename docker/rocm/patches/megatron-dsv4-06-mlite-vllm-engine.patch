@@ -0,0 +1,56 @@
+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+"""Weight reload for mLite impl=vllm_engine's private vLLM engine, done the way verl's rollout does it.
+
+The trainer's engine must hold exactly the bytes the rollout holds after a weight sync, so it reloads through the
+same verl calls the rollout worker makes for a quantized model (``vLLMColocateWorkerExtension.update_weights_from_ipc``
+for one bucket): verl's vLLM quantization hooks installed before the engine is built, then
+``prepare_quanted_weights_for_loading`` -> ``load_quanted_weights`` (+ buffer updates) ->
+``process_quanted_weights_after_loading``. Selected with
+``impl_cfg.engine_weight_loader = "verl_mlite.engine.vllm_refit"`` (verl_mlite's default for impl=vllm_engine).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+import torch
+
+
+def prepare_engine() -> None:
+    from verl.utils.vllm.vllm_quant_utils import apply_vllm_quant_patches
+
+    apply_vllm_quant_patches()
+
+
+def load_weights(llm, model, weights: Iterable[tuple[str, torch.Tensor]]) -> int:
+    from verl.utils.vllm.vllm_quant_utils import (
+        is_quantized_model,
+        load_quanted_weights,
+        prepare_quanted_weights_for_loading,
+        process_quanted_weights_after_loading,
+    )
+    from verl.workers.rollout.vllm_rollout.weight_update_utils import (
+        apply_buffer_updates,
+        drop_tied_alias_updates,
+        split_buffer_updates,
+    )
+
+    weights = list(weights)
+
+    def reload(worker) -> int:
+        runner = worker.model_runner
+        if runner.model is not model:
+            raise RuntimeError("engine worker does not hold the trainer's bound model")
+        if not is_quantized_model(runner.vllm_config):
+            raise NotImplementedError("verl_mlite.engine.vllm_refit handles quantized (FP8) models only")
+        with torch.no_grad():
+            state = prepare_quanted_weights_for_loading(model)
+            params, buffers, named_buffers = split_buffer_updates(model, weights)
+            updates = drop_tied_alias_updates(model, params)
+            loaded = load_quanted_weights(updates, runner) if updates else []
+            apply_buffer_updates(model, buffers, named_buffers=named_buffers)
+            process_quanted_weights_after_loading(model, state)
+        return len(loaded)
+
+    (count,) = llm.collective_rpc(reload)
+    return count
