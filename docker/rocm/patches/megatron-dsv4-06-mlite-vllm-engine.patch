+def _connect_grad_stats_groups(optimizer) -> None:
+    """Run one all-reduce on each gradient-statistics group of ``optimizer``.
+
+    NCCL/RCCL set up a communicator's buffers on its first collective, with a raw
+    device allocation. For these groups that is otherwise the grad-norm all-reduce of
+    the first step, when the device is fullest; connect them while memory is free."""
+    groups = []
+    for opt in getattr(optimizer, "chained_optimizers", [optimizer]):
+        if not hasattr(opt, "get_grad_stats_parallel_group"):
+            continue  # not a Megatron optimizer (fsdp2: its groups already carry FSDP2's collectives)
+        group = opt.get_grad_stats_parallel_group()
+        if all(group is not g for g in groups):
