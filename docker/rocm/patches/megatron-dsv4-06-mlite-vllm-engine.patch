+def test_colocated_ref_runtime_plugins_survive_in_place_resolve() -> None:
+    """verl calls OmegaConf.resolve(config) on the whole tree; the ref's mirrored
+    mapping must be storable in place, including the default empty mapping."""
+    config_root = Path(__file__).parents[3] / "examples" / "verl" / "verl_mlite" / "config"
+    engine = OmegaConf.load(config_root / "engine" / "mlite.yaml")
+    ref = OmegaConf.load(config_root / "ref" / "mlite_ref.yaml")
+    for actor_plugins in ({}, {"dynamic_context_parallel": {"enabled": False}}):
+        actor_engine = OmegaConf.merge(
+            engine, {"impl_cfg": {"runtime_plugins": actor_plugins}}
+        )
+        root = OmegaConf.create(
+            {
+                "actor_rollout_ref": {
+                    "actor": {"engine": actor_engine},
+                    "ref": {"engine": ref.engine},
+                }
+            }
+        )
+        OmegaConf.resolve(root)
+        assert (
+            OmegaConf.to_container(root.actor_rollout_ref.ref.engine.impl_cfg.runtime_plugins)
+            == actor_plugins
+        )
