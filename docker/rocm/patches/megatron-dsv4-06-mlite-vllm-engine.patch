+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+"""DeepSeek-V4 ``impl=vllm_engine``: rollout-identical forward from an in-process vLLM engine, Lite backward.
+
+The counterpart of ``impl=vllm`` for platforms where DeepSeek-V4's vLLM kernels cannot be called outside the vLLM
+model (ROCm): the trainer runs a private vLLM engine configured like the rollout and takes over its model forward
+for one teacher-forced prefill per micro-batch (``vllm_engine.model``), so the forward value is the rollout's own
+computation and the gradient is the Lite model's native recompute at the same discrete choices.
+
+Everything trainable is the impl=lite model: parameters, optimizer, checkpoint, export and weight sync are
+unchanged. The engine holds the served weights; after each optimizer step it is refit before its next forward,
+from the same weight-sync stream the rollout receives (or, if configured, from this trainer's own export).
+
+Scope: PP = VPP = TP = CP = 1, THD-packed micro-batches, one engine per actor rank (DP = EP engines over the
+trainer's ranks with ``engine_data_parallel_size``). Optimizer: impl=lite's, ``dist_opt`` or ``fsdp2``; with
+``fsdp2`` the visible forward runs under the Lite modules' FSDP2 hooks (``vllm_engine.model``), and export and
+weight sync read the sharded masters as impl=lite does.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import time
+from collections.abc import Iterable, Iterator, Mapping
+from dataclasses import dataclass, field
+from typing import Any
+
+import torch
+import torch.nn as nn
+
+from megatron.lite.model.deepseek_v4.config import DeepseekV4Config
+from megatron.lite.model.deepseek_v4.lite import protocol as lite
+from megatron.lite.model.deepseek_v4.lite.protocol import (  # noqa: F401  (protocol surface)
+    MODULE_MAP,
+    SUPPORTS_LOCAL_EXPERT_SHARD,
+    build_model_config,
+    export_hf_weights,
+    is_expert_param,
+    load_hf_weights,
+    pack_r3_replay_mask,
+    pack_routed_experts,
+    save_hf_weights,
+    unpack_forward_output,
+    vocab_size,
+)
+from megatron.lite.model.deepseek_v4.lite.resync import deployed_block_fp8_value
+from megatron.lite.primitive.bundle import ModelBundle
+from megatron.lite.primitive.ckpt.hf_weights import unwrap_model
+from megatron.lite.primitive.parallel.thd import parallel_state_from_model
+from megatron.lite.primitive.vllm_engine import (
+    InProcessEngineConfig,
+    build_inprocess_engine,
+    register_model_class,
+    resolve_weight_loader,
+)
+
+_REFIT_SOURCES = {"weight_sync", "export"}
+
+
+@dataclass(frozen=True)
+class ImplConfig(lite.ImplConfig):
+    # ---- the private engine; kernel-selecting settings must match the rollout's
+    engine_gpu_memory_utilization: float = 0.15
+    engine_kv_cache_memory_bytes: int | None = None
+    engine_max_model_len: int = 8192
+    engine_max_num_batched_tokens: int = 65536
+    engine_data_parallel_size: int = 1
+    engine_kv_cache_dtype: str = "fp8"
+    engine_moe_backend: str | None = "triton"
+    engine_tokenizer_mode: str | None = "deepseek_v4"
+    # How the engine reloads weights: "vllm" (vLLM reload_weights) or the import path of a
+    # loader module (primitive.vllm_engine.resolve_weight_loader); use the rollout's loader.
+    engine_weight_loader: str = "vllm"
+    # Refit source after an update: "weight_sync" (the stream sent to the rollout, observed
+    # via extras["weight_sync_observer"]) or "export" (this trainer's own export).
+    engine_refit_source: str = "weight_sync"
+    # ---- served-value contract: must equal the weight-sync export's resync_config
+    resync_config: Mapping[str, Any] = field(
+        default_factory=lambda: {"expert_dtype": "fp8", "fp8_scale_rule": "checkpoint"}
+    )
+    # Logits >= this index are -inf at rollout (e.g. verl masks ids beyond the tokenizer).
+    rollout_vocab_size: int | None = None
+    # ---- test mode (off in production): dual-path and weight-sync-vs-export checks, receipts
+    consistency_checks: bool = False
+    receipt_path: str | None = None
+
+    def __post_init__(self) -> None:
+        if self.engine_refit_source not in _REFIT_SOURCES:
+            raise ValueError(f"engine_refit_source must be one of {sorted(_REFIT_SOURCES)}")
+
+
+def _validate(model_cfg: DeepseekV4Config, impl_cfg: ImplConfig) -> None:
+    p = impl_cfg.parallel
+    unsupported = {
+        name: size
+        for name, size in (("tp", p.tp), ("pp", p.pp), ("vpp", p.vpp), ("cp", p.cp), ("etp", p.etp or 1))
+        if size > 1
+    }
+    if unsupported:
+        raise NotImplementedError(f"DeepSeek V4 impl=vllm_engine supports PP/VPP/TP/CP/ETP = 1; got {unsupported}")
+    if impl_cfg.engine_data_parallel_size > 1 and p.ep != impl_cfg.engine_data_parallel_size:
+        raise ValueError("engine_data_parallel_size > 1 requires it to equal the actor EP size")
+    if not impl_cfg.use_thd:
+        raise NotImplementedError("DeepSeek V4 impl=vllm_engine consumes THD-packed micro-batches (use_thd=True)")
+
+
+def _sha256(tensor: torch.Tensor) -> tuple[str, tuple[int, ...], str]:
+    value = tensor.detach().contiguous().cpu()
+    return str(value.dtype), tuple(value.shape), hashlib.sha256(value.view(torch.uint8).numpy()).hexdigest()
+
+
+class VisibleEngine:
+    """The private engine, the visible/native binding, and their weight-version bookkeeping."""
+
+    def __init__(self, model_cfg: DeepseekV4Config, impl_cfg: ImplConfig, chunks: list[nn.Module]):
+        self.model_cfg = model_cfg
+        self.impl_cfg = impl_cfg
+        self._chunks = chunks
+        self.llm = None
+        self.vllm_model = None
+        self.binding = None
+        self._loader, self._prepare = resolve_weight_loader(impl_cfg.engine_weight_loader)
+        self.policy_version = 0        # optimizer steps taken
+        self.engine_version = 0        # policy version the engine serves
+        self.refits = 0
+        self._pending: list[tuple[str, torch.Tensor]] | None = None
+        self._local_experts: set[int] | None = None
+        self._armed = False
+        self._expected_tokens = 0
+        self._build_graph = True
+        self._hidden = None
+        self._calls = 0
+        self._last_refit: dict[str, Any] = {}
+        self._nograd_log_probs: dict[tuple[int, str], torch.Tensor] = {}
+
+    # ------------------------------------------------------------------ construction
+    @property
+    def lite_model(self) -> nn.Module:
+        return unwrap_model(self._chunks[0])
+
+    def build(self) -> None:
+        if self.binding is not None:
+            return
+        from vllm.models.deepseek_v4 import DeepseekV4ForCausalLM
+
+        from megatron.lite.model.deepseek_v4.vllm_engine.model import (
+            ARCHITECTURE,
+            VisibleDeepseekV4,
+            training_visible_model_class,
+        )
+
+        lite_model = self.lite_model
+        if not hasattr(lite_model, "_fp8_source_scales_valid"):
+            raise RuntimeError("impl=vllm_engine: build the engine after the HF weights are loaded")
+        c = self.impl_cfg
+        if self._prepare is not None:
+            self._prepare()
+        register_model_class(ARCHITECTURE, training_visible_model_class(DeepseekV4ForCausalLM))
+        self.llm, self.vllm_model = build_inprocess_engine(
+            c.hf_path,
+            InProcessEngineConfig(
+                gpu_memory_utilization=c.engine_gpu_memory_utilization,
+                kv_cache_memory_bytes=c.engine_kv_cache_memory_bytes,
+                max_model_len=c.engine_max_model_len,
+                max_num_batched_tokens=c.engine_max_num_batched_tokens,
+                data_parallel_size=c.engine_data_parallel_size,
+                kv_cache_dtype=c.engine_kv_cache_dtype,
+                moe_backend=c.engine_moe_backend,
+                tokenizer_mode=c.engine_tokenizer_mode,
+            ),
+        )
+        resync_config = dict(c.resync_config)
+        model_cfg = self.model_cfg
+        self.binding = VisibleDeepseekV4(
+            self.vllm_model,
+            lite_model,
+            model_cfg,
+            deployed_value=lambda w: deployed_block_fp8_value(w, model_cfg, resync_config=resync_config),
+            max_tokens=c.engine_max_num_batched_tokens,
+        )
+        self.vllm_model.bind_training_forward(self._engine_forward)
+        if c.engine_data_parallel_size > 1:
+            routed = next(
+                layer.ffn.experts.routed_experts
+                for layer in self.vllm_model.model.layers
+                if getattr(getattr(getattr(layer, "ffn", None), "experts", None), "routed_experts", None) is not None
+            )
+            self._local_experts = {g for g, local in enumerate(routed._expert_map.tolist()) if local >= 0}
+
+    # ------------------------------------------------------------------ weights
+    def mark_updated(self) -> None:
+        """After an optimizer step (or checkpoint load): the engine is stale until refit."""
+        self.policy_version += 1
+        if self.lite_model._fp8_source_scales_valid:
+            raise RuntimeError("source scales still bound after an update: the served value would not move")
+
+    def _keeps(self, name: str) -> bool:
+        if self._local_experts is None:
+            return True
+        marker = ".experts."
+        if marker not in name:
+            return True
+        expert = name.split(marker, 1)[1].split(".", 1)[0]
+        return not expert.isdigit() or int(expert) in self._local_experts
+
+    def observe_weight_sync(self, weights: Iterable[tuple[str, torch.Tensor]]) -> Iterator[tuple[str, torch.Tensor]]:
+        """Pass the rollout's weight-sync stream through, keeping a CPU copy (only the tensors this engine loads)
+        for the next refit: the engine then holds exactly the bytes the rollout received."""
+        kept: list[tuple[str, torch.Tensor]] = []
+        for name, tensor in weights:
+            if self._keeps(name):
+                kept.append((name, tensor.detach().to("cpu", copy=True)))
+            yield name, tensor
+        self._pending = kept
+
+    def _own_export(self) -> Iterator[tuple[str, torch.Tensor]]:
+        ps = parallel_state_from_model(self.lite_model)
+        stream = export_hf_weights(
+            self.lite_model, self.model_cfg, ps, target="block_fp8", resync_config=dict(self.impl_cfg.resync_config)
+        )
+        return ((n, t) for n, t in stream if self._keeps(n))
+
+    def refit(self, weights: Iterable[tuple[str, torch.Tensor]], *, source: str = "explicit") -> int:
+        self.build()
+        loaded = self._loader(self.llm, self.vllm_model, weights)
+        self.engine_version = self.policy_version
+        self.refits += 1
+        self._last_refit["source"] = source
+        return loaded
+
+    def _ensure_current(self) -> None:
+        if self.engine_version == self.policy_version:
+            return
+        pending, self._pending = self._pending, None
+        if pending is not None:
+            if self.impl_cfg.consistency_checks:
+                self._check_weight_sync_vs_export(pending)
+            self.refit(pending, source="weight_sync")
+        elif self.impl_cfg.engine_refit_source == "export":
+            self.refit(self._own_export(), source="export")
+        else:
+            raise RuntimeError(
+                "impl=vllm_engine: the policy was updated but no weight sync was observed since; refusing to run a "
+                "forward on stale engine weights (engine_refit_source='export' refits from this trainer instead)"
+            )
+
+    def _check_weight_sync_vs_export(self, synced: list[tuple[str, torch.Tensor]]) -> None:
+        """Test mode: the observed weight sync must equal this trainer's own export, per tensor (block-FP8 pairs
+        compared by dequantized value: a power-of-two block may re-encode as half scale / double codes)."""
+        own = dict(self._own_export())
+        theirs = dict(synced)
+        mismatched = []
+        for name in sorted(set(own) | set(theirs)):
+            a, b = own.get(name), theirs.get(name)
+            if a is None or b is None:
+                mismatched.append(name)
+            elif _sha256(a) != _sha256(b):
+                mismatched.append(name)
+        pairs = {n[: -len(".weight")] for n in mismatched if n.endswith(".weight")} | {
+            n[: -len(".scale")] for n in mismatched if n.endswith(".scale")
+        }
+        encoding_only = set()
+        for base in pairs:
+            w, s = f"{base}.weight", f"{base}.scale"
+            if all(k in own and k in theirs for k in (w, s)) and own[w].shape == theirs[w].shape:
+                if torch.equal(_dequant(own[w], own[s]), _dequant(theirs[w], theirs[s])):
+                    encoding_only |= {w, s}
+        mismatched = [n for n in mismatched if n not in encoding_only]
+        self._last_refit["weight_sync_vs_export"] = {
+            "synced": len(theirs), "own": len(own), "mismatch": len(mismatched), "encoding_only": len(encoding_only),
+        }
+        if mismatched:
+            raise RuntimeError(f"weight sync != own export for {len(mismatched)} tensors, e.g. {mismatched[:5]}")
+
+    # ------------------------------------------------------------------ forward
+    def _engine_forward(self, input_ids: torch.Tensor, positions: torch.Tensor):
+        """Called by the engine's model forward. Not armed / a DP dummy step: None (run the plain model)."""
+        if not self._armed or input_ids.numel() != self._expected_tokens:
+            return None
+        # The engine runs the model under inference_mode; build the native graph only when the caller of
+        # hidden_states() wants gradients (the old-logprob pass does not: its graph would only hold activations).
+        with torch.inference_mode(False), torch.set_grad_enabled(self._build_graph):
+            hidden = self.binding.forward(input_ids.clone(), positions.clone())
+        self._hidden = hidden
+        self._calls += 1
+        self._ids = input_ids.clone()
+        return hidden.detach()
+
+    def hidden_states(self, sequences: list[list[int]], flat_ids: torch.Tensor) -> torch.Tensor:
+        """Final hidden states of the packed ``sequences`` (one engine prefill), with the native graph attached."""
+        from vllm import SamplingParams
+        from vllm.inputs import TokensPrompt
+
+        self.build()
+        self._ensure_current()
+        self._calls, self._expected_tokens, self._armed = 0, flat_ids.numel(), True
+        self._build_graph = torch.is_grad_enabled()
+        try:
+            self.llm.generate(
+                [TokensPrompt(prompt_token_ids=s) for s in sequences], SamplingParams(max_tokens=1), use_tqdm=False
+            )
+        finally:
+            self._armed = False
+        hidden, self._hidden = self._hidden, None
+        ids = getattr(self, "_ids", None)
+        if self._calls != 1 or hidden is None or not torch.equal(ids.to(flat_ids.device), flat_ids):
+            raise RuntimeError(
+                f"the engine did not run the micro-batch as one in-order prefill (calls={self._calls}); "
+                "engine_max_num_batched_tokens must cover the largest micro-batch"
+            )
+        return hidden
+
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        position_ids: torch.Tensor | None = None,
+        labels: torch.Tensor | None = None,
+        loss_mask: torch.Tensor | None = None,
+        temperature: float | torch.Tensor = 1.0,
+        calculate_entropy: bool = False,
+        packed_seq_params: Any = None,
+        **_: Any,
+    ) -> dict[str, torch.Tensor]:
+        """The Lite model's forward contract (THD-packed): ``{"log_probs": [1, T], "entropy": [1, T]}``."""
+        from megatron.lite.model.deepseek_v4.vllm_engine.model import selected_log_probs
+
+        if packed_seq_params is None or labels is None:
+            raise NotImplementedError("impl=vllm_engine expects THD-packed input with labels")
+        cu = packed_seq_params.cu_seqlens_q.tolist()
+        padded = getattr(packed_seq_params, "cu_seqlens_q_padded", None)
+        if padded is not None and padded.tolist() != cu:
+            raise NotImplementedError("impl=vllm_engine: padded THD packing is not supported")
+        flat_ids = input_ids.reshape(-1)
+        sequences = [flat_ids[cu[i] : cu[i + 1]].tolist() for i in range(len(cu) - 1)]
+        hidden = self.hidden_states(sequences, flat_ids)
+        with torch.inference_mode(False), torch.set_grad_enabled(torch.is_grad_enabled()):
+            out = selected_log_probs(
+                self.binding.logits(hidden),
+                labels.reshape(-1),
+                temperature=temperature,
+                vocab_limit=self.impl_cfg.rollout_vocab_size,
+                calculate_entropy=calculate_entropy,
+            )
+        result = {k: v.view(1, -1) for k, v in out.items()}
+        if self.impl_cfg.consistency_checks or self.impl_cfg.receipt_path:
+            self._test_mode_checks(sequences, cu, out["log_probs"], loss_mask)
+        return result
+
+    # ------------------------------------------------------------------ test mode
+    def _test_mode_checks(self, sequences, cu, log_probs, loss_mask) -> None:
+        """Dual-path contract: a grad-enabled forward must equal the no-grad forward of the same sequence at the same
+        policy version, bitwise (old-logprob and update forwards are different calls). Optional JSON receipts."""
+        version = self.policy_version
+        flat = log_probs.detach().float().cpu()
+        dual = {"version": version, "matched": 0, "tokens": 0, "mismatch": 0, "unmatched": 0}
+        for i, seq in enumerate(sequences):
+            key = (version, hashlib.sha1(str(seq).encode()).hexdigest())
+            value = flat[cu[i] : cu[i + 1]]
+            if not torch.is_grad_enabled():
+                self._nograd_log_probs[key] = value
+                continue
+            reference = self._nograd_log_probs.get(key)
+            if reference is None:
+                dual["unmatched"] += 1
+                continue
+            mask = (
+                loss_mask.reshape(-1)[cu[i] : cu[i + 1]].bool().cpu()
+                if loss_mask is not None
+                else torch.ones_like(value, dtype=torch.bool)
+            )
+            dual["matched"] += 1
+            dual["tokens"] += int(mask.sum())
+            dual["mismatch"] += int(((value != reference) | torch.isnan(value))[mask].sum())
+        for key in [k for k in self._nograd_log_probs if k[0] < version]:
+            del self._nograd_log_probs[key]
+        if self.impl_cfg.consistency_checks and dual["mismatch"]:
+            raise RuntimeError(f"grad-enabled forward != no-grad forward at policy version {version}: {dual}")
+        if self.impl_cfg.receipt_path:
+            with open(self.impl_cfg.receipt_path, "a") as f:
+                f.write(json.dumps({
+                    "t": time.time(), "grad": torch.is_grad_enabled(), "requires_grad": bool(log_probs.requires_grad),
+                    "seqs": len(sequences), "tokens": int(flat.numel()), "policy_version": version,
+                    "engine_version": self.engine_version, "refits": self.refits, "last_refit": self._last_refit,
+                    "dual_path": dual,
+                }) + "\n")
+
+
+def _dequant(weight: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
+    rows, cols = weight.shape[-2], weight.shape[-1]
+    expanded = scale.float().repeat_interleave(128, -2)[..., :rows, :].repeat_interleave(128, -1)[..., :cols]
+    return weight.float() * expanded
+
+
+def build_model(model_cfg: DeepseekV4Config, *, impl_cfg: ImplConfig) -> ModelBundle:
+    _validate(model_cfg, impl_cfg)
+    lite_cfg = lite.ImplConfig(
+        **{f: getattr(impl_cfg, f) for f in lite.ImplConfig.__dataclass_fields__}
+    )
+    # fsdp2 as impl=vllm sets it up: FP32 shards (gradients reduce and accumulate in FP32, as under dist_opt)
+    # and forward inputs left uncast. No effect under dist_opt.
+    bundle = lite.build_model(
+        model_cfg, impl_cfg=lite_cfg, fsdp2_use_fp32_shards=True, fsdp2_cast_forward_inputs=False
+    )
+    engine = VisibleEngine(model_cfg, impl_cfg, bundle.chunks)
+
+    lite_post_step = bundle.extras["post_optimizer_step_hook"]
+
+    def post_optimizer_step() -> None:
+        lite_post_step()
+        engine.mark_updated()
+
+    lite_post_load = bundle.extras.get("post_model_load_hook")
+
+    def post_model_load_hook():
+        # The runtime calls this after loading the HF weights: build the engine now (it
+        # loads the same checkpoint, so engine and masters agree at the initial policy).
+        result = lite_post_load() if lite_post_load is not None else None
+        engine.build()
+        return result
+
+    def forward_step(model: nn.Module, batch) -> dict[str, torch.Tensor]:
+        return engine.forward(**lite._prepare_model_forward_kwargs(model, batch))
+
+    bundle.forward_step = forward_step
+    bundle.extras.update(
+        post_optimizer_step_hook=post_optimizer_step,
+        post_model_load_hook=post_model_load_hook,
+        weight_sync_observer=engine.observe_weight_sync,
+        visible_engine=engine,
+    )
+    return bundle
