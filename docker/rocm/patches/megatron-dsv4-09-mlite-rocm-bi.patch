+def rocm_aligned_selected_log_probs(
+    hidden_states: torch.Tensor,
+    lm_head_weight: torch.Tensor,
+    labels: torch.Tensor,
+    temperature: float,
+    chunk_size: int,
+    *,
+    calculate_entropy: bool,
+    vocab_limit: int | None,
+) -> tuple[torch.Tensor, torch.Tensor | None]:
+    """The ROCm rollout's selected log-probabilities, with an LM-head VJP.
+
+    On ROCm the rollout runs the V1 sampler: BF16 logits from the
+    batch-invariant persistent GEMM, logits past the tokenizer masked, FP32,
+    divided by the temperature, batch-invariant log-softmax
+    (``selected_log_probs`` of impl=vllm_engine, the measured contract).  Under
+    batch invariance ``F.linear`` dispatches to the same persistent kernel, so
+    the differentiable logits are the visible ones.
+    """
+    from vllm.model_executor.layers.batch_invariant import linear_batch_invariant
+
+    from megatron.lite.model.deepseek_v4.vllm_engine.model import selected_log_probs
+
+    if chunk_size <= 0:
+        raise ValueError("logprob_chunk_size must be positive")
+    selected_chunks = []
+    entropy_chunks = []
+    grad_enabled = torch.is_grad_enabled()
+    for start in range(0, hidden_states.shape[0], chunk_size):
+        stop = min(start + chunk_size, hidden_states.shape[0])
+        chunk_labels = labels[start:stop]
+        chunk_hidden = hidden_states[start:stop]
+        with torch.no_grad():
+            visible = selected_log_probs(
+                linear_batch_invariant(chunk_hidden.detach(), lm_head_weight.detach()),
+                chunk_labels,
+                temperature=temperature,
+                vocab_limit=vocab_limit,
+                calculate_entropy=calculate_entropy,
+            )
+        selected = visible["log_probs"]
+        entropy = visible.get("entropy")
+        if grad_enabled:
+            logits = F.linear(chunk_hidden, lm_head_weight)
+            if vocab_limit is not None and vocab_limit < logits.shape[-1]:
+                logits = logits.masked_fill(
+                    torch.arange(logits.shape[-1], device=logits.device) >= vocab_limit,
+                    float("-inf"),
+                )
+            differentiable, differentiable_entropy = (
+                _differentiable_log_probs_and_entropy(
+                    logits,
+                    chunk_labels,
+                    temperature,
+                    calculate_entropy=calculate_entropy,
+                )
+            )
+            selected = selected + (differentiable - differentiable.detach())
+            if calculate_entropy:
+                assert differentiable_entropy is not None
+                differentiable_entropy = torch.nan_to_num(differentiable_entropy)
+                entropy = entropy + (
+                    differentiable_entropy - differentiable_entropy.detach()
+                )
+        selected_chunks.append(selected)
+        if calculate_entropy:
+            entropy_chunks.append(entropy)
+    selected = torch.cat(selected_chunks, dim=0)
+    entropy = torch.cat(entropy_chunks, dim=0) if calculate_entropy else None
+    return selected, entropy
