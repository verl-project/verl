+                return _ROCmEPSlotValues.forward(
+                    _NoGradContext(), hidden_states, topk_weights, topk_ids, self, *w13, *w2
+                )
+        return _ROCmEPSlotValues.apply(
+            hidden_states, topk_weights, topk_ids, self, *w13, *w2
+        )
+
+
+class _NoGradContext:
+    """Stand-in autograd context for the forward-only path."""
+
+    def save_for_backward(self, *tensors):
