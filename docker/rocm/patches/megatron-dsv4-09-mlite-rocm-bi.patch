+"""Backward accumulation of repeated rows: FP32 sums, run-to-run deterministic."""
+
+from __future__ import annotations
+
+import pytest
+import torch
+
+from megatron.lite.model.deepseek_v4.vllm.primitive.dense import FP32GradEmbedding
+from megatron.lite.model.deepseek_v4.vllm.primitive.rocm import (
+    deterministic_row_gather,
+)
+
+pytestmark = pytest.mark.gpus(1)
+
+_DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
+
+
+def _relative(actual: torch.Tensor, expected: torch.Tensor) -> float:
+    return float((actual.double() - expected).norm() / expected.norm())
+
+
+def test_deterministic_row_gather_values_and_vjp() -> None:
+    generator = torch.Generator(device=_DEVICE).manual_seed(0)
+    source = torch.randn(300, 64, generator=generator, device=_DEVICE)
+    # Heavily repeated rows (the sparse-attention lists repeat KV rows).
+    index = torch.randint(0, 40, (4096,), generator=generator, device=_DEVICE)
+    grad = torch.randn(index.numel(), 64, generator=generator, device=_DEVICE)
+
+    leaf = source.clone().requires_grad_(True)
+    rows = deterministic_row_gather(leaf, index)
+    assert torch.equal(rows, source.index_select(0, index))
+    rows.backward(grad)
+    expected = torch.zeros_like(source, dtype=torch.float64).index_add_(
+        0, index, grad.double()
+    )
+    assert _relative(leaf.grad, expected) < 1e-6
+
+    for _ in range(4):
+        again = source.clone().requires_grad_(True)
+        deterministic_row_gather(again, index).backward(grad)
+        assert torch.equal(again.grad, leaf.grad)
+
+
+@pytest.mark.parametrize("count", [1000, 3072, 3073])
+def test_embedding_grad_is_summed_in_fp32(count: int) -> None:
+    generator = torch.Generator(device=_DEVICE).manual_seed(count)
+    module = FP32GradEmbedding(512, 256, device=_DEVICE, dtype=torch.bfloat16)
+    ids = torch.full((count,), 7, device=_DEVICE)
+    ids[::3] = torch.randint(0, 512, ids[::3].shape, generator=generator, device=_DEVICE)
+    grad = torch.randn(count, 256, generator=generator, device=_DEVICE).to(torch.bfloat16)
+
+    output = module(ids)
+    assert torch.equal(output, torch.nn.functional.embedding(ids, module.weight))
+    output.backward(grad)
+    expected = torch.zeros(module.weight.shape, dtype=torch.float64, device=_DEVICE)
+    expected.index_add_(0, ids, grad.double())
+    # One BF16 rounding of the FP32 sums (PyTorch's own backward reaches
+    # ~1e-2 here for count <= 3072).
+    assert _relative(module.weight.grad, expected) < 3e-3
+
+    first = module.weight.grad.clone()
+    module.weight.grad = None
+    module(ids).backward(grad)
+    assert torch.equal(module.weight.grad, first)
