+        compressors run the rollout's kernels; each request is then attended
+        by ``combine_topk_swa_indices`` + ``rocm_sparse_attn_prefill`` over
+        BF16 rows dequantized from its own FP8 caches, exactly as the rollout's
+        ``_forward_prefill`` lowers a request.  VJPs: the straight-through
+        Lite graphs of the same math (q/k, compressor), the FP32 gather
+        attention over the same index lists, and the o-projection VJP.
+        """
+        config = self.config
+        if self.ps is not None and self.ps.cp_size > 1:
+            raise NotImplementedError("DS4 impl=vllm on ROCm supports CP=1 only")
+        if self.indexer_loss_coeff:
+            raise NotImplementedError(
+                "DS4 impl=vllm on ROCm does not implement the indexer auxiliary loss"
+            )
+        self._bind_input_projection_source_scales()
