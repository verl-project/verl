+class _ROCmEPSlotValues(torch.autograd.Function):
+    """Per-slot routed outputs with the rollout's kernels, BF16-master VJP.
+
+    Forward: all-gather the EP group's tokens and routes (as the rollout's
+    all-gather backend does), run Triton fused MoE for this rank's experts,
+    and return every slot's value to its token's rank (a sum in which exactly
+    one rank contributes a nonzero, so it is exact).  The caller reproduces the
+    rollout's per-rank ``moe_sum`` and rank-order reduction from these values.
+    """
+
+    @staticmethod
+    def forward(ctx, hidden, topk_weights, topk_ids, experts, *weights):
+        ps = experts.ps
+        group = ps.ep_group if ps.ep_size > 1 else None
+        ep_size = ps.ep_size
+        if group is not None:
+            local = torch.tensor([hidden.shape[0]], dtype=torch.int64, device=hidden.device)
+            counts = [torch.empty_like(local) for _ in range(ep_size)]
+            dist.all_gather(counts, local, group=group)
+            sizes = [int(count.item()) for count in counts]
+        else:
+            sizes = [hidden.shape[0]]
+        rank = ps.ep_rank if group is not None else 0
+        hidden_all = _gather_rows(hidden.detach(), group, sizes)
+        weights_all = _gather_rows(topk_weights.detach().contiguous(), group, sizes)
+        ids_all = _gather_rows(topk_ids.contiguous(), group, sizes)
+
+        num_local = experts.num_local_experts
+        local_start = rank * num_local
+        w13 = weights[:num_local]
+        w2 = weights[num_local:]
+        packed_w13 = experts.grouped_fp8.pack_weight(("w13", 0), w13)
+        packed_w2 = experts.grouped_fp8.pack_weight(("w2", 0), w2)
+        expert_map = torch.full(
+            (experts.num_experts,), -1, dtype=torch.int32, device=hidden.device
+        )
+        expert_map[local_start : local_start + num_local] = torch.arange(
+            num_local, dtype=torch.int32, device=hidden.device
+        )
+        slot_values, gate_up = rocm.routed_slot_values(
+            hidden_all,
+            weights_all,
+            ids_all,
+            packed_w13.qweight,
+            packed_w13.scales,
+            packed_w2.qweight,
+            packed_w2.scales,
+            expert_map,
+            num_experts=experts.num_experts,
+            swiglu_limit=experts.swiglu_limit,
+        )
+        output = _reduce_scatter_rows(slot_values, group, sizes, rank)
+
+        local_expert = ids_all.long() - local_start
+        owned = (local_expert >= 0) & (local_expert < num_local)
+        token_index, slot_index = owned.nonzero(as_tuple=True)
+        route_expert = local_expert[token_index, slot_index]
+        order = torch.sort(route_expert, stable=True).indices
+        token_index, slot_index = token_index[order], slot_index[order]
+        counts = torch.bincount(route_expert, minlength=num_local).tolist()
+        ctx.group, ctx.sizes, ctx.rank = group, sizes, rank
+        ctx.counts = counts
+        ctx.swiglu_limit = experts.swiglu_limit
+        ctx.num_local = num_local
+        ctx.save_for_backward(
+            hidden_all,
+            weights_all,
+            token_index,
+            slot_index,
+            gate_up[token_index, slot_index].contiguous(),
+            *weights,
+        )
+        return output
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        (
+            hidden_all,
+            weights_all,
+            token_index,
+            slot_index,
+            gate_up,
+            *weights,
+        ) = ctx.saved_tensors
+        num_local = ctx.num_local
+        w13 = weights[:num_local]
+        w2 = weights[num_local:]
+        grad_all = _gather_rows(grad_output.contiguous(), ctx.group, ctx.sizes)
+        grad_routes = grad_all[token_index, slot_index]
+        route_weights = weights_all[token_index, slot_index].float()
+        hidden_routes = hidden_all[token_index]
+        activated = swiglu_with_probs(gate_up, None, ctx.swiglu_limit)
+
+        counts = ctx.counts
+        expert_rows = []
+        offset = 0
+        for count in counts:
+            expert_rows.append(slice(offset, offset + count))
+            offset += count
+        # FC2: router-weight and activation gradients, expert by expert.
+        grad_act = torch.empty_like(activated)
+        grad_route_weights = torch.empty_like(route_weights)
+        grad_w2: list[torch.Tensor] = []
+        for expert, rows in enumerate(expert_rows):
+            if rows.stop == rows.start:
+                grad_w2.append(torch.zeros_like(w2[expert]))
+                continue
+            act = activated[rows]
+            grad = grad_routes[rows]
+            # d weight = <dY, act @ W2^T>: keep the GEMM output in FP32 (BF16
+            # operands, FP32 accumulate) instead of rounding it to BF16.
+            unweighted = torch.mm(act, w2[expert].t(), out_dtype=torch.float32)
+            grad_route_weights[rows] = (grad.float() * unweighted).sum(-1)
+            grad_unweighted = (grad.float() * route_weights[rows, None]).to(grad.dtype)
+            grad_w2.append(grad_unweighted.t() @ act)
+            grad_act[rows] = grad_unweighted @ w2[expert]
+        # One SwiGLU VJP over all routes (one dynamic-shape compile).
+        try:
+            grad_gate_up = dynamic_clamped_swiglu_vjp(grad_act, gate_up, ctx.swiglu_limit)
+        except torch._dynamo.exc.FailOnRecompileLimitHit:
+            from megatron.lite.model.deepseek_v4.vllm.primitive.dense import (
+                _clamped_swiglu_vjp,
+            )
+
+            grad_gate_up = _clamped_swiglu_vjp(grad_act, gate_up, ctx.swiglu_limit)
+        # FC1.
+        grad_hidden_routes = torch.empty_like(hidden_routes)
+        grad_w13: list[torch.Tensor] = []
+        for expert, rows in enumerate(expert_rows):
+            if rows.stop == rows.start:
+                grad_w13.append(torch.zeros_like(w13[expert]))
+                continue
+            grad_w13.append(grad_gate_up[rows].t() @ hidden_routes[rows])
+            grad_hidden_routes[rows] = grad_gate_up[rows] @ w13[expert]
+
+        tokens, top_k = weights_all.shape
+        grad_slots = hidden_all.new_zeros(
+            (tokens, top_k, hidden_all.shape[1]), dtype=torch.float32
+        )
+        grad_slots[token_index, slot_index] = grad_hidden_routes.float()
+        grad_weights_all = weights_all.new_zeros((tokens, top_k), dtype=torch.float32)
+        grad_weights_all[token_index, slot_index] = grad_route_weights
+        grad_hidden = _reduce_scatter_rows(
+            grad_slots.sum(dim=1), ctx.group, ctx.sizes, ctx.rank
+        ).to(hidden_all.dtype)
+        grad_weights = _reduce_scatter_rows(
+            grad_weights_all, ctx.group, ctx.sizes, ctx.rank
+        )
+        return grad_hidden, grad_weights, None, None, *grad_w13, *grad_w2
+
+
+class _ROCmVisibleExperts(Experts):
+    """Routed experts on ROCm: the rollout's per-slot values for local experts."""
+
+    def __init__(
+        self,
+        config: DeepseekV4Config,
+        ps: ParallelState,
+        *,
+        cache_deployment_weights: bool,
+    ) -> None:
+        super().__init__(config, ps)
+        self.ps = ps
