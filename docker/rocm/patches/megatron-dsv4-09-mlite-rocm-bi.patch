+"""ROCm kernel selection for the DS4 vLLM-visible training forward.
+
+``impl=vllm`` evaluates each sub-module with the kernel the rollout runs.  On
+ROCm with ``VLLM_BATCH_INVARIANT=1`` the DeepSeek-V4 rollout does not use the
+NVIDIA kernel library (DeepGEMM, FlashMLA, DeepEP, CuTe DSL); it runs:
+
+  - block-FP8 linears on vLLM's fixed-config Triton GEMM
+    (``TritonFp8BlockScaledMMKernel``) after ``QuantFP8`` group-128 activation
+    quantization, with the checkpoint's FP32 block scales;
+  - mHC pre on TileLang without the fused RMSNorm, followed by the BI RMSNorm;
+  - the ROCm sparse-attention prefill (``combine_topk_swa_indices`` +
+    ``rocm_sparse_attn_prefill``) over BF16 rows dequantized from the FP8 cache;
+  - ``rocm_inv_rope_einsum`` (BF16 wo_a) followed by the block-FP8 ``wo_b``;
+  - Triton fused MoE per rank, ``moe_sum`` over the rank's top-k slots, and the
+    batch-invariant rank-order FP32 reduce-scatter of the all-gather EP combine.
+
+This module binds those entry points.  Callers select it by platform
+(:func:`is_rocm`); the NVIDIA bindings stay where they are.
+"""
+
+from __future__ import annotations
+
+import functools
+from collections.abc import Sequence
+
+import torch
+
+BLOCK_SHAPE = (128, 128)
+
+
+def is_rocm() -> bool:
+    return torch.version.hip is not None
+
+
+# ---------------------------------------------------------------------------
+# Block-FP8 linear
+# ---------------------------------------------------------------------------
+
+
+@functools.lru_cache(maxsize=1)
+def _activation_quantizer():
+    """The rollout's block-FP8 activation quantizer (QuantFP8, dynamic, 1x128)."""
+    from vllm.config import VllmConfig, set_current_vllm_config
+    from vllm.model_executor.layers.quantization.input_quant_fp8 import QuantFP8
+    from vllm.model_executor.layers.quantization.utils.quant_utils import GroupShape
+
+    with set_current_vllm_config(VllmConfig()):
+        return QuantFP8(
+            static=False,
+            group_shape=GroupShape(1, BLOCK_SHAPE[1]),
+            num_token_padding=None,
+            use_ue8m0=False,
+        )
+
+
+def quantize_activation(x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """``Fp8BlockScaledMMLinearKernel.apply_weights``'s input quantization (eager)."""
+    return _activation_quantizer().forward_hip(x)
+
+
+def block_fp8_gemm(
+    x: torch.Tensor, qweight: torch.Tensor, scales: torch.Tensor
+) -> torch.Tensor:
+    """BF16 ``x @ dequant(qweight, scales).T`` with the rollout's ROCm BI GEMM."""
+    from vllm.model_executor.layers.quantization.utils.fp8_utils import (
+        w8a8_triton_block_scaled_mm,
+    )
+
+    if x.ndim != 2 or x.shape[1] != qweight.shape[1]:
+        raise ValueError("activation K does not match packed weight K")
+    if x.shape[0] == 0:
+        return x.new_empty((0, qweight.shape[0]))
+    q_input, input_scale = quantize_activation(x.contiguous())
+    with torch.no_grad():
+        return w8a8_triton_block_scaled_mm(
+            q_input,
+            qweight,
+            input_scale,
+            scales,
+            list(BLOCK_SHAPE),
+            torch.bfloat16,
+        )
+
+
+def dequantize_block_fp8_bf16(
+    qweight: torch.Tensor, scales: torch.Tensor
+) -> torch.Tensor:
+    """``_get_cached_wo_a_bf16``'s dequantization: FP32 product, one BF16 rounding."""
+    from vllm.v1.attention.ops.rocm_aiter_mla_sparse import _expand_2d_block_scales
+
+    expanded = _expand_2d_block_scales(scales, qweight.shape[-2], qweight.shape[-1])
+    return (qweight.to(torch.float32) * expanded).to(torch.bfloat16)
+
+
+def shared_swiglu(x: torch.Tensor, limit: float) -> torch.Tensor:
+    """``SiluAndMulWithClamp.forward_native`` (alpha 1, beta 0), the ROCm path."""
+    d = x.shape[-1] // 2
+    gate = torch.clamp(x[..., :d], max=limit)
+    up = torch.clamp(x[..., d:], min=-limit, max=limit)
+    return gate * torch.sigmoid(1.0 * gate) * (up + 0.0)
+
+
+# ---------------------------------------------------------------------------
+# mHC pre (unfused RMSNorm under batch invariance)
+# ---------------------------------------------------------------------------
+
+
+def mhc_pre_then_norm(
+    residual: torch.Tensor,
+    fn: torch.Tensor,
+    scale: torch.Tensor,
+    base: torch.Tensor,
+    norm_weight: torch.Tensor,
+    *,
+    rms_eps: float,
+    hc_eps: float,
+    post_mult: float,
+    iters: int,
+    norm_eps: float,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """``MHCPreOp.forward_hip`` (TileLang, one split) then ``RMSNorm`` (BI)."""
+    from vllm.model_executor.kernels.mhc.tilelang import mhc_pre_tilelang
+    from vllm.model_executor.layers.batch_invariant import rms_norm_batch_invariant
+
+    post, comb, layer_input = mhc_pre_tilelang(
+        residual,
+        fn,
+        scale,
+        base,
+        rms_eps,
+        hc_eps,
+        hc_eps,
+        post_mult,
+        iters,
+        1,
+    )
+    normed = rms_norm_batch_invariant(layer_input, norm_weight.data, norm_eps)
+    return post, comb, normed
+
+
+# ---------------------------------------------------------------------------
+# Attention
+# ---------------------------------------------------------------------------
+
+
+def inverse_rope(
+    o: torch.Tensor, positions: torch.Tensor, cos_sin_cache: torch.Tensor, rope_dim: int
+) -> torch.Tensor:
+    from vllm.v1.attention.ops.rocm_aiter_mla_sparse import _fused_inverse_rope_gptj
+
+    return _fused_inverse_rope_gptj(o, positions, cos_sin_cache, rope_dim)
+
+
+def wo_a_einsum(inverse: torch.Tensor, wo_a_bf16: torch.Tensor) -> torch.Tensor:
+    """``rocm_inv_rope_einsum``'s contraction ([T, G, D] x [G, R, D] -> [T, G, R])."""
+    return torch.einsum("tgd,grd->tgr", inverse, wo_a_bf16)
+
+
+def sparse_prefill_request(
+    q: torch.Tensor,
+    workspace: torch.Tensor,
+    topk_indices: torch.Tensor,
+    *,
+    seq_len: int,
+    query_len: int,
+    window_size: int,
+    compress_ratio: int,
+    top_k: int,
+    n_compressed_rows: int,
+    scale: float,
+    head_dim: int,
+    nope_head_dim: int,
+    rope_head_dim: int,
+    attn_sink: torch.Tensor,
+) -> torch.Tensor:
+    """One request's sparse prefill exactly as ``_forward_prefill`` lowers it.
+
+    ``workspace`` is ``[N + seq_len, D]``: the request's compressed rows at
+    ``[0, N)`` and its SWA rows (all ``seq_len`` tokens) at ``[N, N + seq_len)``.
+    ``q`` holds the last ``query_len`` tokens of the request.  The attention list
+    of each token is built by vLLM's own ``combine_topk_swa_indices`` (top-k part
+    then the chronological window), so list order -- the order the ragged kernel
+    accumulates in -- is the rollout's.
+    """
+    from vllm.models.deepseek_v4.amd.rocm import combine_topk_swa_indices
+    from vllm.v1.attention.ops.rocm_aiter_mla_sparse import rocm_sparse_attn_prefill
+
+    device = q.device
+    rows = workspace.shape[0]
+    query_start_loc = torch.tensor([0, query_len], dtype=torch.int32, device=device)
+    seq_lens = torch.tensor([seq_len], dtype=torch.int32, device=device)
+    gather_lens = torch.tensor([seq_len], dtype=torch.int32, device=device)
+    combined, combined_lens = combine_topk_swa_indices(
+        topk_indices,
+        query_start_loc,
+        seq_lens,
+        gather_lens,
+        window_size,
+        compress_ratio,
+        top_k,
+        rows,
+        n_compressed_rows,
+    )
+    output = torch.empty_like(q)
+    rocm_sparse_attn_prefill(
+        q=q,
+        kv=workspace.view(-1, 1, workspace.shape[-1]),
+        indices=combined,
+        topk_length=combined_lens,
+        scale=scale,
+        head_dim=head_dim,
+        nope_head_dim=nope_head_dim,
+        rope_head_dim=rope_head_dim,
+        attn_sink=attn_sink,
+        output=output,
+    )
+    return output, combined, combined_lens
+
+
+def indexer_topk_request(
+    q_fp8: torch.Tensor,
+    weights: torch.Tensor,
+    k_fp8: torch.Tensor,
+    k_scale: torch.Tensor,
+    positions: torch.Tensor,
+    *,
+    ratio: int,
+    out: torch.Tensor,
+) -> None:
+    """One request's C4 indexer top-k as ``rocm_aiter_sparse_attn_indexer`` prefills.
+
+    Logits of the request's queries against its own compressed K (FP8 rows and
+    FP32 scales exactly as the cache holds them), then the batch-invariant
+    deterministic top-k: row-local ascending indices, -1 padded, into ``out``.
+    """
+    from vllm.v1.attention.ops.rocm_aiter_mla_sparse import (
+        dsv4_det_topk_per_row,
+        rocm_fp8_mqa_logits,
+    )
+
+    rows = q_fp8.shape[0]
+    row_starts = torch.zeros(rows, dtype=torch.int32, device=q_fp8.device)
+    row_ends = (
+        torch.div(positions + 1, ratio, rounding_mode="floor")
+        .clamp_max(k_fp8.shape[0])
+        .to(torch.int32)
+    )
+    logits = rocm_fp8_mqa_logits(
+        q_fp8, (k_fp8, k_scale), weights, row_starts, row_ends
+    )
+    dsv4_det_topk_per_row(
+        logits, row_starts, row_ends, out, rows, out.shape[-1]
+    )
+
+
+class _DeterministicRowGather(torch.autograd.Function):
+    """``source.index_select(0, index)`` with a run-to-run deterministic VJP.
+
+    ``index_select``'s backward is ``index_add_``, whose CUDA/HIP kernel adds
+    repeated rows with atomics (nondeterministic order unless the global
+    deterministic mode is on).  ``index_put_(accumulate=True)`` sorts the
+    indices and sums each row's contributions sequentially, in index order:
+    the same FP32 sums, in a fixed order, independent of any global flag.
+    """
+
+    @staticmethod
+    def forward(ctx, source: torch.Tensor, index: torch.Tensor) -> torch.Tensor:
+        ctx.save_for_backward(index)
+        ctx.source_rows = source.shape[0]
+        return source.index_select(0, index)
+
+    @staticmethod
+    def backward(ctx, grad_output: torch.Tensor):
+        (index,) = ctx.saved_tensors
+        grad_source = grad_output.new_zeros(
+            (ctx.source_rows, *grad_output.shape[1:])
+        )
+        grad_source.index_put_((index,), grad_output, accumulate=True)
+        return grad_source, None
+
+
+def deterministic_row_gather(source: torch.Tensor, index: torch.Tensor) -> torch.Tensor:
+    """Rows ``source[index]`` (same values as ``index_select``); deterministic backward."""
+    if not (torch.is_grad_enabled() and source.requires_grad):
+        return source.index_select(0, index)
+    return _DeterministicRowGather.apply(source, index)
+
+
+def sparse_attention_reference(
+    q: torch.Tensor,
+    workspace: torch.Tensor,
+    combined: torch.Tensor,
+    combined_lens: torch.Tensor,
+    sink: torch.Tensor,
+    scale: float,
+    *,
+    chunk_rows: int = 512,
+) -> torch.Tensor:
+    """Differentiable FP32 gather attention over the same lists (the VJP graph)."""
+    width = combined.shape[-1]
+    columns = torch.arange(width, device=combined.device)
+    outputs = []
+    for start in range(0, q.shape[0], chunk_rows):
+        stop = min(start + chunk_rows, q.shape[0])
+        idx = combined[start:stop].long()
+        valid = (columns.unsqueeze(0) < combined_lens[start:stop].unsqueeze(1)) & (
+            idx >= 0
+        )
+        safe = torch.where(valid, idx, torch.zeros_like(idx))
+        kv = deterministic_row_gather(workspace.float(), safe.reshape(-1)).view(
+            stop - start, width, -1
+        )
+        scores = torch.einsum("thd,tkd->thk", q[start:stop].float(), kv) * scale
+        scores = scores.masked_fill(~valid.unsqueeze(1), float("-inf"))
+        logits = torch.cat(
+            (
+                scores,
+                sink.float().view(1, -1, 1).expand(scores.shape[0], -1, 1),
+            ),
+            dim=-1,
+        )
+        probs = torch.softmax(logits, dim=-1)[..., :-1]
+        outputs.append(torch.einsum("thk,tkd->thd", probs, kv).to(q.dtype))
+    return torch.cat(outputs, dim=0)
+
+
+# ---------------------------------------------------------------------------
+# MoE
+# ---------------------------------------------------------------------------
+
+
+def route(
+    logits: torch.Tensor,
+    *,
+    topk: int,
+    renormalize: bool,
+    routed_scaling_factor: float,
+    correction_bias: torch.Tensor | None,
+    input_ids: torch.Tensor | None,
+    hash_table: torch.Tensor | None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """``FusedTopKBiasRouter``'s ``fused_topk_bias`` (sqrtsoftplus) on ROCm.
+
+    ``logits`` are the BF16-rounded router logits in FP32.  Returns FP32
+    weights (routed scale folded in) and int32 global expert ids.
+    """
+    from vllm.model_executor.layers.fused_moe.router.fused_topk_bias_router import (
+        fused_topk_bias,
+    )
+
+    return fused_topk_bias(
+        hidden_states=logits,
+        gating_output=logits,
+        scoring_func="sqrtsoftplus",
+        e_score_correction_bias=correction_bias,
+        topk=topk,
+        renormalize=renormalize,
+        indices_type=None,
+        input_tokens=input_ids,
+        hash_indices_table=hash_table,
+        routed_scaling_factor=routed_scaling_factor,
+    )
+
+
+def routed_slot_values(
+    hidden: torch.Tensor,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    w13: torch.Tensor,
+    w13_scale: torch.Tensor,
+    w2: torch.Tensor,
+    w2_scale: torch.Tensor,
+    expert_map: torch.Tensor,
+    *,
+    num_experts: int,
+    swiglu_limit: float,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """``TritonExperts.apply`` up to (excluding) ``moe_sum``.
+
+    Returns the per-slot outputs ``[M, K, H]`` (router weight applied in the
+    kernel's FP32 accumulator, BF16; exact zeros for slots of experts this rank
+    does not own) and the GEMM1 output ``[M, K, 2I]`` (the SwiGLU VJP input).
+    Every row is computed independently with the batch-invariant fixed config,
+    so a slot's value does not depend on the other rows in the call.
+    """
+    from vllm.model_executor.layers.fused_moe.fused_moe import (
+        _prepare_expert_assignment,
+        invoke_fused_moe_triton_kernel,
+        try_get_optimal_moe_config,
+    )
+    from vllm.model_executor.layers.fused_moe.utils import (
+        moe_kernel_quantize_input,
+        swiglu_limit_func,
+    )
+    from vllm.platforms import current_platform
+    from vllm.triton_utils import tl
+
+    tokens, top_k = topk_ids.shape
+    block_shape = list(BLOCK_SHAPE)
+    fp8 = current_platform.fp8_dtype()
+    n = w13.shape[1]
+    cache1 = hidden.new_empty((tokens, top_k, n))
+    cache3 = hidden.new_empty((tokens, top_k, w2.shape[1]))
+    if tokens == 0:
+        return cache3, cache1
+    config = try_get_optimal_moe_config(
+        w13.size(), w2.size(), top_k, "fp8_w8a8", tokens, block_shape=block_shape
+    )
+    kernel_kwargs = dict(
+        compute_type=tl.bfloat16,
+        use_fp8_w8a8=True,
+        use_int8_w8a8=False,
+        use_int8_w8a16=False,
+        use_int4_w4a16=False,
+        per_channel_quant=False,
+        block_shape=block_shape,
+        B_bias=None,
+    )
+    a1q, a1q_scale = moe_kernel_quantize_input(
+        hidden.contiguous(), None, fp8, False, block_shape
+    )
+    sorted_token_ids, expert_ids, num_tokens_post_padded = _prepare_expert_assignment(
+        topk_ids,
+        config,
+        tokens,
+        top_k,
+        num_experts,
+        expert_map,
+        block_shape=block_shape,
+    )
+    invoke_fused_moe_triton_kernel(
+        a1q,
+        w13,
+        cache1,
+        a1q_scale,
+        w13_scale,
+        None,
+        sorted_token_ids,
+        expert_ids,
+        num_tokens_post_padded,
+        False,
+        top_k,
+        config,
+        **kernel_kwargs,
+    )
+    cache2 = hidden.new_empty((tokens * top_k, n // 2))
+    swiglu_limit_func(cache2, cache1.view(-1, n), swiglu_limit)
+    a2q, a2q_scale = moe_kernel_quantize_input(cache2, None, fp8, False, block_shape)
+    invoke_fused_moe_triton_kernel(
+        a2q,
+        w2,
+        cache3,
+        a2q_scale,
+        w2_scale,
+        topk_weights,
+        sorted_token_ids,
+        expert_ids,
+        num_tokens_post_padded,
+        True,
+        1,
+        config,
+        **kernel_kwargs,
+    )
+    return cache3, cache1
+
+
+# ---------------------------------------------------------------------------
+# Expert-parallel combine of the all-gather / reduce-scatter backend
+# ---------------------------------------------------------------------------
+
+
+def rollout_ep_combine(
+    route_values: torch.Tensor,
+    topk_ids: torch.Tensor,
+    *,
+    num_experts: int,
+    rollout_ep: int,
+) -> torch.Tensor:
+    """Reproduce the rollout's routed sum for its EP layout, bitwise.
+
+    Rank ``r`` of a rollout EP group of size ``E`` owns experts
+    ``[r * n / E, (r + 1) * n / E)`` (linear placement).  Its ``moe_sum`` adds
+    all ``K`` slots of a token in slot order in FP32 starting from 0 -- slots
+    of other ranks hold exact zeros -- and rounds to BF16; the batch-invariant
+    reduce-scatter then adds the ``E`` partials in rank order in FP32 starting
+    from rank 0's and rounds once.  ``route_values`` is ``[T, K, H]`` BF16
+    (router weight applied), ``topk_ids`` ``[T, K]`` global expert ids.
+    """
+    if num_experts % rollout_ep:
+        raise ValueError("rollout EP must divide the routed experts")
+    owner = torch.div(topk_ids.long(), num_experts // rollout_ep, rounding_mode="floor")
+    zero = route_values.new_zeros((), dtype=torch.float32)
+    total = None
+    for rank in range(rollout_ep):
+        partial = torch.zeros(
+            route_values.shape[0],
+            route_values.shape[2],
+            dtype=torch.float32,
+            device=route_values.device,
+        )
+        for slot in range(route_values.shape[1]):
+            mine = (owner[:, slot] == rank).unsqueeze(-1)
+            partial = partial + torch.where(mine, route_values[:, slot].float(), zero)
+        partial = partial.to(route_values.dtype).float()
+        total = partial if total is None else total + partial
+    return total.to(route_values.dtype)
+
+
+def owner_ranks(topk_ids: torch.Tensor, num_experts: int, ep: int) -> torch.Tensor:
+    return torch.div(topk_ids, num_experts // ep, rounding_mode="floor")
+
+
+__all__: Sequence[str] = (
+    "indexer_topk_request",
+    "route",
+    "routed_slot_values",
+    "shared_swiglu",
+    "block_fp8_gemm",
+    "dequantize_block_fp8_bf16",
+    "deterministic_row_gather",
+    "inverse_rope",
+    "is_rocm",
+    "mhc_pre_then_norm",
+    "quantize_activation",
+    "rollout_ep_combine",
+    "sparse_attention_reference",
+    "sparse_prefill_request",
+    "wo_a_einsum",
+)
