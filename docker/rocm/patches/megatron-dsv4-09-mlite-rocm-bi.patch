+class _EmbeddingFP32Grad(torch.autograd.Function):
+    """``F.embedding`` whose weight gradient is summed in FP32.
+
+    PyTorch's dense embedding backward adds BF16 partial sums into the BF16
+    weight gradient when there are at most 3072 indices, so a row repeated
+    many times accumulates in BF16 (1.7e-2 relative error at 3072 repeats,
+    1.7e-3 at 3073).  Here every row's contributions are summed in FP32
+    (sort-based, run-to-run deterministic) and rounded once.
+    """
+
+    @staticmethod
+    def forward(ctx, weight: torch.Tensor, input_ids: torch.Tensor):
+        ctx.save_for_backward(input_ids)
+        ctx.weight_shape = weight.shape
+        ctx.weight_dtype = weight.dtype
+        return F.embedding(input_ids, weight)
+
+    @staticmethod
+    def backward(ctx, grad_output: torch.Tensor):
+        (input_ids,) = ctx.saved_tensors
+        ids = input_ids.reshape(-1)
+        grad = grad_output.reshape(ids.numel(), -1).float()
+        rows, inverse = torch.unique(ids, sorted=True, return_inverse=True)
+        sums = grad.new_zeros((rows.numel(), grad.shape[-1]))
+        sums.index_put_((inverse,), grad, accumulate=True)
+        grad_weight = torch.zeros(
+            ctx.weight_shape, dtype=ctx.weight_dtype, device=grad.device
+        )
+        grad_weight.index_copy_(0, rows, sums.to(ctx.weight_dtype))
+        return grad_weight, None
+
