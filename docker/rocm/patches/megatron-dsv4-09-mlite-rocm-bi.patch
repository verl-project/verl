+def _gather_rows(
+    value: torch.Tensor, group, sizes: list[int]
+) -> torch.Tensor:
+    if len(sizes) == 1:
+        return value
+    width = max(sizes)
+    padded = value.new_zeros((width, *value.shape[1:]))
+    padded[: value.shape[0]] = value
+    gathered = value.new_empty((len(sizes) * width, *value.shape[1:]))
+    dist.all_gather_into_tensor(gathered, padded.contiguous(), group=group)
+    return torch.cat(
+        [gathered[rank * width : rank * width + size] for rank, size in enumerate(sizes)]
+    )
+
+
+def _reduce_scatter_rows(
+    value: torch.Tensor, group, sizes: list[int], rank: int
+) -> torch.Tensor:
+    if len(sizes) == 1:
+        return value
+    width = max(sizes)
+    padded = value.new_zeros((len(sizes), width, *value.shape[1:]))
+    offset = 0
+    for index, size in enumerate(sizes):
+        padded[index, :size] = value[offset : offset + size]
+        offset += size
+    output = value.new_empty((width, *value.shape[1:]))
+    dist.reduce_scatter_tensor(
+        output, padded.view(len(sizes) * width, *value.shape[1:]), group=group
+    )
+    return output[: sizes[rank]]
+
