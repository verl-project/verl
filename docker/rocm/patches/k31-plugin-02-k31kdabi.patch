+                               dt_bias, lower, norm_w, eps)
+            out.index_copy_(0, sel, o1)
+        # ---- row-engine decode for rd
+        rs = [slots[i] for i in rd]
+        tok, st = _to_dev([[qsl[i] for i in rd], rs], raw.device)
