+                if _CID_DEDUPE:
+                    ch = list({a: b for a, b in ch}.items())
+            if _NULL_TO_DUMMY:
+                ch = [(a, None if a == 0 else b) for a, b in ch]   # cid_dev[0] pinned to the dummy id
+            si, ci = _to_dev([[a for a, _ in ch], [self.dummy_id() if b is None else b for _, b in ch]], recurrent_state.device)
+            cid.index_copy_(0, si, ci.to(torch.int32))
+        _t3_check(self)
+
+    def full_decode(self, recurrent_state, state_idx, raw, g1f, b1, g2, conv_w, A_log, dt_bias, norm_w, eps):
+        """Decode-only batch, device-side end to end (no host lists, no syncs, static shapes: capturable by vLLM FULL graphs).
+        Rows map to compact ids via cid_dev (padded rows: null block 0 -> dummy id, its pos parked at 0 so nothing completes)."""
+        import torch
+        from .graphdec import decode_step_static
+
+        rows = self.rows
+        cid = self.ensure_cid(recurrent_state)
+        dm = self.dummy_id()
+        SL = cid.index_select(0, state_idx).to(torch_int64())
+        if _NULL_TO_DUMMY:
+            # Padded rows (null block 0) ALWAYS run on the parked dummy slot, whatever cid_dev[0] holds
+            SL = torch.where(state_idx == 0, torch.full_like(SL, dm), SL)
+        RSL = state_idx.to(torch_int64())
+        rows.pos_dev.narrow(0, dm, 1).zero_()
+        out = decode_step_static(self, rows, recurrent_state, SL, RSL, raw, g1f, b1, g2, conv_w, A_log, dt_bias, norm_w, eps)
+        # T3: a REAL row (state index != null block 0) resolved to the dummy slot = a lost mapping (H1/H2). Device-only,
+        # capturable, output-neutral; read at the next eager step by _t3_check.
+        rows.t3_bad_dev.add_(((SL == dm) & (state_idx != 0)).sum())
+        rows.tick_dev += 1
+        rows.lastuse_dev.index_copy_(0, SL, rows.tick_dev.expand(SL.numel()))
+        return out
+
+    def _rs(self, ids):
+        # ids never mapped through compact() (direct step() callers, tests) address the caller's state rows 1:1; the reserved
+        # dummy id (real == -2) addresses the null block row 0 (scratch), never a real request's row
+        return [self.real[c] if self.real[c] >= 0 else (0 if self.real[c] == -2 else c) for c in ids]
+
+    def step(self, recurrent_state, slots, has_init, qsl, raw, g1f, b1, g2, conv_w, A_log, dt_bias, lower, norm_w, eps):
