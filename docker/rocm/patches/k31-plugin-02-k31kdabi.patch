+"""k31kdabi: batch-invariant (BI) KDA for the ROCm Kimi-K3/K3.1 model (vLLM f5926fb, ROCm Kimi-K3.1 build).
+
+vLLM general plugin (entry point `vllm.general_plugins: k31kdabi = k31kdabi:register`); put `tracks/mlite/plugin` on PYTHONPATH.
+Active ONLY when `VLLM_BATCH_INVARIANT=1` (or the test switch `K31_KDA_BI=1`); otherwise `register()` does nothing and the default
+AMD KDA path is untouched.
+
+Contract (tracks/mlite/PHASE_D_KDA.md): the KDA core is FLA `chunk_kda` with every Triton autotuner pinned, chunks of 64 tokens
+aligned to the sequence start, the recurrent state materialized only at chunk boundaries, and a partial chunk recomputed from its
+boundary state. Measured on gfx950: FLA chunk_kda is batch-composition invariant and prefix invariant, and boundary state + tail
+recompute is bitwise equal to the full prefill. Every request (prefill, chunked prefill, decode, mixed) goes through:
+
+  conv   : the trainer's FP32 torch causal conv + SiLU (megatron primitive/kda.py `causal_conv_silu` expression) over
+           [3 history rows | new rows]; history = last 3 raw rows per state slot, in a buffer owned here
+  window : [cached tail rows (pos <= 63) | new rows]  (post-conv q|k|v, raw g, raw b), starting at the last boundary B
+  outputs: ONE chunk_kda call over the whole window with the boundary state (None for fresh sequences, exactly the trainer's
+           call; a request whose first chunk is still open also calls with initial_state=None), outputs of the new rows kept
+  state  : if the window crosses a boundary, a second chunk_kda call over the aligned prefix [B, B') gives the new boundary
+           state -> written to the request's recurrent-state slot (FLA [H, K, V] layout, owned here)
+  norm   : the trainer's FP32 torch gated RMSNorm (`gated_rms_norm` expression), weight BF16
+Spec decode and prefix caching are refused under BI.
+"""
+
+from __future__ import annotations
+
+import importlib
+import os
+import sys
+
+_CHUNK = 64
+_PINNED = False
+
+
+def bi_enabled() -> bool:
+    return os.environ.get("VLLM_BATCH_INVARIANT", "0") == "1" or os.environ.get("K31_KDA_BI", "0") == "1"
+
+
+def register():
+    if not bi_enabled():
+        return
+    from vllm.platforms import current_platform
+
+    if not current_platform.is_rocm():
+        return
+    mod = importlib.import_module("vllm.models.kimi_k3.amd.kda")
+    cls = mod.KimiK3DeltaAttention
+    if getattr(cls, "_k31kdabi_patched", False):
+        return
+    cls._k31kdabi_orig_forward = cls._forward
+    # Keep vLLM's breakable-cudagraph break on the KDA core op (the default _forward carries
+    # @eager_break_during_capture). Without it, vLLM PIECEWISE capture records _bi_forward's host-side work into the graph.
+    try:
+        from vllm.compilation.breakable_cudagraph import eager_break_during_capture
+        cls._forward = eager_break_during_capture(_bi_forward)
+    except ImportError:  # vLLM without breakable cudagraphs: BI runs must then be eager
+        cls._forward = _bi_forward
+    orig_init = cls.__init__
+
+    def __init__(self, *a, **k):
+        orig_init(self, *a, **k)
+        _init_bi_state(self)
+
+    cls.__init__ = __init__
+    cls._k31kdabi_patched = True
+    # vLLM refuses to start under VLLM_BATCH_INVARIANT unless the KDA attention backend declares BI support
+    # (v1/attention/selector.py, v1/worker/gpu/attn_utils.py -> KimiK3ROCmKDABackend.supports_batch_invariance()).
+    # With the forward above installed, the ROCm KDA layer is batch invariant, so declare it -- only here.
+    backend = cls.get_attn_backend(None) if callable(getattr(cls, "get_attn_backend", None)) else None
+    if backend is None:
+        backend = getattr(mod, "KimiK3ROCmKDABackend")
+    backend.supports_batch_invariance = classmethod(lambda c: True)
+
+
+# ----------------------------------------------------------------------------------------------- shared math
+def pin_fla_autotune():
+    """Same as megatron primitive/kda.py `pin_fla_autotune`: every Triton autotuner on the chunk_kda path -> configs[0]."""
+
+    global _PINNED
+    if _PINNED:
+        return
+    from triton.runtime.autotuner import Autotuner
+
+    importlib.import_module("fla.ops.kda")
+    importlib.import_module("fla.ops.kda.chunk_bwd")
+    pkgs = ("fla.ops.kda", "fla.ops.common", "fla.ops.gla", "fla.ops.utils", "fla.modules.l2norm")
+    for name, m in list(sys.modules.items()):
+        if m is None or not name.startswith(pkgs):
+            continue
+        for _attr, obj in list(vars(m).items()):
+            t = obj
+            for _ in range(8):
+                if t is None or isinstance(t, Autotuner):
+                    break
+                t = getattr(t, "fn", None)
+            if isinstance(t, Autotuner) and not getattr(t, "_k31_pinned", False):
+                t.configs = [t.configs[0]]
+                t._k31_pinned = True
+    apply_bi_fla_fix()
+    _PINNED = True
+
+
+# FLA 0.5.2 `fla/ops/kda/chunk_intra.py` (sha256 prefix) whose forward sub-chunk kernel takes the SAFE_GATE reference at
+# min(BC//2, T - i_ti - 1): the middle row of the 16-token sub-chunk, clamped to the last valid token. The clamp makes a row's
+# rounding depend on how many tokens follow it (measured: 1 of 63 window lengths differs). BI fix: reference = sub-chunk start
+# (T-independent, always valid; |g - g_start| <= 15 * 5/ln2 = 108 in log2 units, so exp2 stays in FP32 range, zm's bound).
+_FLA_INTRA_SHA = os.environ.get("K31_KDA_BI_FLA_SHA", "b59a1f2987d4577b")
+_FIXED = None
+
+
+def apply_bi_fla_fix():
+    """Swap FLA's forward intra sub-chunk kernel for the T-independent-reference variant (rollout AND trainer must call this)."""
+
+    global _FIXED
+    if _FIXED is not None:
+        return _FIXED
+    import hashlib
+    import importlib.util
+    import tempfile
+
+    src_mod = importlib.import_module("fla.ops.kda.chunk_intra")
+    path = src_mod.__file__
+    text = open(path).read()
+    sha = hashlib.sha256(text.encode()).hexdigest()
+    if not sha.startswith(_FLA_INTRA_SHA):
+        raise RuntimeError(f"K31 BI KDA: unexpected FLA chunk_intra.py (sha256 {sha[:16]}), re-derive the fix for this FLA version")
+    start = text.index("def chunk_kda_fwd_kernel_intra_sub_chunk(")
+    end = text.index("@dispatch('kda')", start)
+    body = text[start:end]
+    old_g = "b_gn = gather(b_g, tl.full([1, BK], min(BC//2, T - i_ti - 1), dtype=tl.int16), axis=0)"
+    old_p = "p_gn = g + (i_ti + min(BC // 2, T - i_ti - 1)) * HV*K + tl.arange(0, BK)"
+    if body.count(old_g) != 1 or body.count(old_p) != 1:
+        raise RuntimeError("K31 BI KDA: FLA sub-chunk kernel text not as expected")
+    body = body.replace(old_g, "b_gn = gather(b_g, tl.full([1, BK], 0, dtype=tl.int16), axis=0)")
+    body = body.replace(old_p, "p_gn = g + i_ti * HV*K + tl.arange(0, BK)")
+    fixed = text[:start] + body + text[end:]
+    cache = os.path.join(os.environ.get("K31_KDA_BI_CACHE", tempfile.gettempdir()), f"k31kdabi_fla_intra_{sha[:12]}.py")
+    if not os.path.exists(cache) or open(cache).read() != fixed:
+        tmp = cache + f".{os.getpid()}"
+        with open(tmp, "w") as f:
+            f.write(fixed)
+        os.replace(tmp, cache)
+    spec = importlib.util.spec_from_file_location("k31kdabi_fla_intra_fixed", cache)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["k31kdabi_fla_intra_fixed"] = mod
+    spec.loader.exec_module(mod)
+    kern = mod.chunk_kda_fwd_kernel_intra_sub_chunk
+    t = kern
+    from triton.runtime.autotuner import Autotuner
+
+    for _ in range(8):
+        if t is None or isinstance(t, Autotuner):
+            break
+        t = getattr(t, "fn", None)
+    if isinstance(t, Autotuner):
+        t.configs = [t.configs[0]]
+        t._k31_pinned = True
+    src_mod.chunk_kda_fwd_kernel_intra_sub_chunk = kern
+    _FIXED = cache
+    return cache
+
+
+def conv_silu_rows(ext, weight):
+    """Trainer's causal conv expression on [hist(3) | new] rows; returns SiLU(conv) FP32 for every row (first 3 discarded by caller).
+
+    ext [3 + L, C] bf16, weight [C, W] fp32. Same op order as megatron `causal_conv_silu`:
+    acc = x * w[:, W-1]; for s in 1..W-1: acc = acc + x[t-s] * w[:, W-1-s]."""
+    import torch
+    import torch.nn.functional as F
+
+    W = weight.shape[1]
+    xf = ext.float()
+    wf = weight.float()
+    acc = xf * wf[:, W - 1]
+    for shift in range(1, W):
+        shifted = F.pad(xf[: xf.shape[0] - shift], (0, 0, shift, 0))
+        acc = acc + shifted * wf[:, W - 1 - shift]
+    return F.silu(acc)
+
+
+def conv_silu_last(ext, weight):
+    """conv_silu_rows for the LAST row of each [R, W, C] window only (decode): the same per-element op sequence
+    (x[t] * w[W-1], then + x[t-s] * w[W-1-s] for s = 1..W-1, separate mul / add kernels, then SiLU) -> identical bits."""
+    import torch.nn.functional as F
+
+    W = weight.shape[1]
+    wf = weight.float()
+    acc = ext[:, W - 1].float() * wf[:, W - 1]
+    for shift in range(1, W):
+        acc = acc + ext[:, W - 1 - shift].float() * wf[:, W - 1 - shift]
+    return F.silu(acc)
+
+
+def gated_rms_norm(x, gate, weight, eps):
+    """Trainer's expression (megatron primitive/kda.py `gated_rms_norm`)."""
+    import torch
+
+    xf = x.float()
+    y = xf * torch.rsqrt(xf.square().sum(dim=-1, keepdim=True) / xf.shape[-1] + eps)
+    return y * weight.float() * torch.sigmoid(gate.float())
+
+
+def kda_chunk(q, k, v, g, beta_raw, A_log, dt_bias, lower, cu, init=None, final=False, cu_cpu=None):
+    """The contract call: exactly the trainer's FLA chunk_kda arguments (megatron primitive/kda.py `fla_functional`)."""
+    from fla.ops.kda import chunk_kda
+
+    return chunk_kda(
+        q=q, k=k, v=v, g=g, beta=beta_raw.float().sigmoid(), A_log=A_log, dt_bias=dt_bias,
+        initial_state=init, output_final_state=final, use_qk_l2norm_in_kernel=True, use_gate_in_kernel=True,
+        safe_gate=True, lower_bound=lower, cu_seqlens=cu,
+        **({"cu_seqlens_cpu": cu_cpu} if cu_cpu is not None else {}),  # same indices, no device->host sync in FLA
+    )
+
+
+# ----------------------------------------------------------------------------------------------- BI step (pure)
+def _to_dev(lists, dev):
+    """Several Python int lists -> device int64 tensors with ONE pinned host->device copy."""
+    import torch
+
+    sizes = [len(x) for x in lists]
+    flat = torch.empty(sum(sizes), dtype=torch.int64, pin_memory=True)
+    o = 0
+    for x, n in zip(lists, sizes):
+        if n:
+            flat[o:o + n] = torch.as_tensor(x, dtype=torch.int64)
+        o += n
+    return list(flat.to(dev, non_blocking=True).split(sizes))
+
+
+def _seg_arange(starts, lens, total, dev):
+    """concat_i arange(starts[i], starts[i] + lens[i]) on the GPU; `total` = sum(lens) known on the host (no sync)."""
+    import torch
+
+    n = lens.numel()
+    offs = torch.cumsum(lens, 0) - lens
+    rep = torch.repeat_interleave(torch.arange(n, device=dev), lens, output_size=total)
+    return starts.index_select(0, rep) + torch.arange(total, device=dev) - offs.index_select(0, rep)
+
+
+def _n_slots():
+    """Per-layer BI buffers are sized by concurrent requests, not by vLLM's state-cache block count (which can be ~1e5).
+    Resolved at layer construction (the vLLM config context exists there, not in the forward); fails loudly otherwise."""
+    env = os.environ.get("K31_KDA_BI_SLOTS")
+    if env:
+        return int(env)
+    from vllm.config import get_current_vllm_config
+
+    try:
+        max_num_seqs = get_current_vllm_config().scheduler_config.max_num_seqs
+    except Exception as exc:  # noqa: BLE001
+        raise RuntimeError("K31 BI KDA: cannot read max_num_seqs from the vLLM config; set K31_KDA_BI_SLOTS") from exc
+    if not max_num_seqs:
+        raise RuntimeError("K31 BI KDA: vLLM max_num_seqs unset; set K31_KDA_BI_SLOTS")
+    return 2 * int(max_num_seqs) + 8
+
+
+def _init_bi_state(layer):
+    """At KimiK3DeltaAttention construction: size (and, on a real device, allocate) the per-slot BI buffers, so they are
+    part of the model's memory when vLLM profiles and budgets the KV cache (the profile run skips the BI forward)."""
+    import torch
+
+    layer._k31_bi_slots = _n_slots()
+    w = getattr(getattr(layer, "conv1d", None), "weight", None)
+    if w is None or w.device.type != "cuda":
+        return
+    P, D, H = layer.local_projection_size, layer.head_dim, layer.local_num_heads
+    layer._bi_state = BIKDAState(layer._k31_bi_slots, P, H, D, w.shape[-1], w.device)
+    # The row-engine caches (~1.7 MB per slot per layer at TP8) must exist before vLLM's memory
+    # profiling too; created lazily at the first real decode they landed outside the KV-cache budget (~15 GB/GPU at 69 layers)
+    lower = getattr(layer, "gate_lower_bound", None)
+    if os.environ.get("K31_KDA_BI_ROW", "1") == "1" and lower is not None:
+        layer._bi_state.ensure_rows(w.device, lower)
+
+
+
+# Compact-map consistency under FULL decode graphs; each switch only for A/B gating (default ON):
+#   K31_KDA_BI_CID_DEDUPE    full_post's cid_dev push deduped, last mapping wins (a duplicate index_copy_ kept the
+#                            EARLIER (o, dummy) write -> a live request's graph decodes ran on the dummy slot)
+#   K31_KDA_BI_EVICT_PROTECT _evict skips ids whose owner state index is in the current batch (no (o, None)/(o, c') churn)
+#   K31_KDA_BI_NULL_DUMMY    state index 0 (vLLM null block, padded rows) is always the parked dummy id: never a fresh id in
+#                            compact(), cid_dev[0] pinned, full_decode masks state-0 rows to the dummy
+#   K31_KDA_BI_T3            0 (default): off | 1: log | raise: RuntimeError when a real FULL row hit the dummy slot or a push
+#                            carried a duplicate index (T3 detector; counter is always maintained on device, read only here)
+_CID_DEDUPE = os.environ.get("K31_KDA_BI_CID_DEDUPE", "1") == "1"
+_EVICT_PROTECT = os.environ.get("K31_KDA_BI_EVICT_PROTECT", "1") == "1"
+_NULL_TO_DUMMY = os.environ.get("K31_KDA_BI_NULL_DUMMY", "1") == "1"
+_T3 = os.environ.get("K31_KDA_BI_T3", "0")
+
+
+def _t3_check(st):
+    """Eager-step read of the T3 detectors (one D2H, only when K31_KDA_BI_T3 != 0)."""
+    if _T3 == "0":
+        return
+    rows = getattr(st, "rows", None)
+    bad = int(rows.t3_bad_dev.item()) if rows is not None and hasattr(rows, "t3_bad_dev") else 0
+    seen = getattr(st, "_t3_seen", (0, 0))
+    if (bad, st.dup_pushes) != seen:
+        st._t3_seen = (bad, st.dup_pushes)
+        msg = f"K31 BI KDA T3: real FULL rows on the dummy slot={bad}, duplicate-index pushes={st.dup_pushes}"
+        if _T3 == "raise":
+            raise RuntimeError(msg)
+        import logging
+
+        logging.getLogger("k31kdabi").warning(msg)
+
+
+def _all_padding_batch():
+    """True iff vLLM marks every token of this forward as padding (cudagraph warmup/capture dummy batches set
+    forward_context.is_padding all True; real steps mark only the padded tail). Called only on the rare fail-closed
+    path, so its host sync never touches normal steps."""
+    try:
+        from vllm.forward_context import get_forward_context, is_forward_context_available
+        if not is_forward_context_available():
+            return False
+        ip = getattr(get_forward_context(), "is_padding", None)
+        import torch
+        return isinstance(ip, torch.Tensor) and ip.numel() > 0 and bool(ip.all())
+    except Exception:  # noqa: BLE001
+        return False
+
+class BIKDAState:
+    """Per-layer BI state owned by the overlay: per slot tail rows (<= 63), pos, null flag, conv history (3 raw rows).
+    The boundary recurrent state lives in the caller's `recurrent_state[slot]` (FLA [H, K, V] fp32 layout)."""
+
+    def __init__(self, n_slots, P, H, D, W, device):
+        import torch
+
+        self.P, self.H, self.D, self.W = P, H, D, W
+        self.tail = torch.zeros((n_slots, _CHUNK - 1, 4 * P + H), dtype=torch.bfloat16, device=device)
+        self.hist = torch.zeros((n_slots, W - 1, 3 * P), dtype=torch.bfloat16, device=device)
+        self.pos = [0] * n_slots
+        self.null = [True] * n_slots
+        self.real = [-1] * n_slots  # compact id -> vLLM state index (the caller's recurrent_state row)
+        self._cid = {}  # vLLM state index -> compact id
+        self._lru = []  # compact ids, least recently used first
+        self._cid_changes = []  # (vLLM state index, compact id | None) since the last device push (FULL mode)
+        self.dup_pushes = 0     # pushes that carried a duplicate state index (deduped; see full_post)
+        # With graph decode, the LAST compact id is reserved as the dummy slot for padded graph batches
+        # (compact() only hands out ids whose real == -1, so -2 is never assigned)
+        if os.environ.get("K31_KDA_BI_GRAPH", "1") == "1":
+            self.real[n_slots - 1] = -2
+
+    def compact(self, state_idx, has_init):
+        """Map vLLM state indices to compact ids of this object's per-slot buffers (n_slots ~ 2 x max_num_seqs, not the cache's
+        block count). A new request (has_init False) takes a free or least-recently-used id; a continuing request must still
+        own its id (else its open-chunk rows are lost: fail closed)."""
+        out = []
+        # Never evict an id whose owner state index is in THIS batch: if vLLM reused a dead
+        # owner's index for a request of the same batch, evicting it here and re-mapping it below queued (o, None) then
+        # (o, c') -> duplicate index in full_post's push. Victim choice only; slots are re-initialized at prefill (bit-neutral).
+        protect = {self._cid[s] for s in state_idx if s in self._cid} if _EVICT_PROTECT else set()
+        dm = self.dummy_id() if self.real[-1] == -2 else None
+        for s, hi in zip(state_idx, has_init):
+            if s == 0 and dm is not None and _NULL_TO_DUMMY:
+                # State index 0 = vLLM's null block (warmup/capture all-padding batches, padded
+                # FULL rows): ALWAYS the reserved dummy id, never a fresh id, never in _cid / _lru / the push (else
+                # cid_dev[0] became a real id c0 that padded FULL rows scribbled into, and c0 is the first victim after a wake)
+                out.append(dm)
+                continue
+            c = self._cid.get(s)
+            if c is None:
+                if hi and not _all_padding_batch():
+                    raise RuntimeError(f"K31 BI KDA: state {s} continues but its open-chunk rows were evicted; raise K31_KDA_BI_SLOTS")
+                # A dummy all-padding batch (vLLM cudagraph warmup/capture) may "continue" a state it never
+                # prefilled: give it a fresh id, treated as cold below (output is discarded; a real request always
+                # re-initializes its slot at prefill)
+                if -1 in self.real:
+                    c = self.real.index(-1)
+                else:
+                    c = self._evict(out, protect)
+                    old = self.real[c]
+                    del self._cid[old]
+                    self._cid_changes.append((old, None))
+                self.real[c] = s
+                self._cid[s] = c
+                self._cid_changes.append((s, c))
+            if c in self._lru:
+                self._lru.remove(c)
+            self._lru.append(c)
+            out.append(c)
+        return out
+
+    def _evict(self, taken, protect=()):
+        """Victim compact id for a new request. FULL mode: requests that decode only inside vLLM's CUDA graphs never touch the
+        host LRU, so pick the least recently used by the DEVICE last-use table (one D2H, only on eviction). `protect`: ids
+        whose owner index is in the current batch (skipped unless nothing else is left)."""
+        cand = [x for x in self._lru if x not in taken and x not in protect] or [x for x in self._lru if x not in taken]
+        rows = getattr(self, "rows", None)
+        if _full_mode() and rows is not None and hasattr(rows, "lastuse_dev"):
+            lu = rows.lastuse_dev.tolist()
+            return min(cand, key=lambda x: lu[x])
+        return cand[0]
+
+    # ------------------------------------------------------------------------------------- FULL decode-graph support
+    def ensure_rows(self, device, lower):
+        if hasattr(self, "rows"):
+            return self.rows
+        import torch
+
+        if os.environ.get("K31_KDA_BI_GRAPH", "1") == "1" or _full_mode():
+            from .graphdec import GraphDecoder, StaticRowDecoder
+
+            self.rows = StaticRowDecoder(self.tail.shape[0], self.H, self.D, device, lower, self.D ** -0.5, self._rs)
