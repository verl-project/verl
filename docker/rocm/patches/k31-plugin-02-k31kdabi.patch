+            o1 = self._step_p1(recurrent_state, p1_slots, [has_init[i] for i in p1], q2, raw.index_select(0, sel),
+                               g1f.index_select(0, sel), b1.index_select(0, sel), g2.index_select(0, sel), conv_w, A_log,
+                               dt_bias, lower, norm_w, eps)
+            out.index_copy_(0, sel, o1)
+            tok = torch.tensor([qsl[i] for i in rd], dtype=torch.int64).pin_memory().to(raw.device, non_blocking=True)
+            o2 = self._step_graph(recurrent_state, [slots[i] for i in rd], None, raw.index_select(0, tok), g1f.index_select(0, tok),
+                                  b1.index_select(0, tok), g2.index_select(0, tok), conv_w, A_log, dt_bias, norm_w, eps)
