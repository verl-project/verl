+"""CUDA-graph-capturable BI KDA decode on the row engine (K31_KDA_BI_GRAPH=1, needs K31_KDA_BI_ROW=1).
+
+Kernels, StaticRowDecoder and decode_step_static are verified bitwise against the eager row path and phase 1;
+GraphDecoder below integrates them. Every all-decode, all-warm batch of R requests replays a CUDA graph
+captured per (layer, R); everything else (prefill, first decode after prefill = warm-up, mixed batches) runs eagerly.
+"""
+from __future__ import annotations
+
+import os as _os
+
+import torch
+
+from . import conv_silu_rows, gated_rms_norm
+from . import rowkern as RK
+from .rowdec import BT, RowDecoder
+
+_CHUNK = 64
+_PROF_NO_COMPLETE = False
+_COMPLETE_FLA = _os.environ.get("K31_KDG_COMPLETE", "row") == "fla"
+_LEAN = True
+
+import triton
+import triton.language as tl
+from fla.ops.utils.op import exp2 as _exp2
+
+
+@triton.jit
+def b_complete(SLOT, RSLOT, POS, S0, SH, KC, G, VN, H0, H, K: tl.constexpr, V: tl.constexpr, BT: tl.constexpr):
+    """Next boundary state for (request r, head h) iff row t == BT-1 closed the chunk (else no-op), in place in H0 (vLLM's
+    recurrent_state, FLA [K, V] fp32 layout). Mirrors FLA chunk_gated_delta_rule_fwd_kernel_h_blockdim64 for ONE chunk with
+    USE_GK (KDA): h_k *= exp2(g_last_k); h += dot(kg_blk [64, BT], bf16(v_new) [BT, V]) per 64-row K block, with
+    kg = bf16(k * exp2(g_last - g)) as recompute_w_u_fwd_kda_kernel stores it and v_new = the row engine's VN rows."""
+    r = tl.program_id(0)
+    h = tl.program_id(1)
+    t = tl.load(POS + r)
+    if t != BT - 1:
+        return
+    s = tl.load(SLOT + r).to(tl.int64)
+    b = s * H + h
+    # H0 may be a strided view (vLLM paged state cache): slot stride S0, head stride SH; each [K, V] head block contiguous
+    rb = tl.load(RSLOT + r).to(tl.int64) * S0 + h * SH
+    kc = KC + b * BT * K
+    gg = G + b * BT * K
+    vn = VN + b * BT * V
+    h0 = H0 + rb
+    o_t = tl.arange(0, BT)
+    o_v = tl.arange(0, V)
+    b_v = tl.load(vn + o_t[:, None] * V + o_v[None, :])                       # [BT, V] bf16 (= bf16(fp32 v_new))
+    for i_k in tl.static_range(K // 64):
+        o_k = i_k * 64 + tl.arange(0, 64)
+        b_h = tl.load(h0 + o_k[:, None] * V + o_v[None, :]).to(tl.float32)    # [64, V]
+        b_gn = tl.load(gg + (BT - 1) * K + o_k).to(tl.float32)                # g at the chunk's last row
+        b_h *= _exp2(b_gn)[:, None]
+        b_k = tl.load(kc + o_k[:, None] + o_t[None, :] * K)                    # [64, BT] (k^T, bf16)
+        b_gk = tl.load(gg + o_k[:, None] + o_t[None, :] * K).to(tl.float32)   # [64, BT]
+        b_kg = (b_k * _exp2(b_gn[:, None] - b_gk)).to(b_k.dtype)
+        b_h += tl.dot(b_kg, b_v)
+        tl.store(h0 + o_k[:, None] * V + o_v[None, :], b_h.to(H0.dtype.element_ty))
+
+
+@triton.jit
+def b_scatter(SLOT, POS, QN, KN, VV, sv, GRAW, sg, BETA_IN, Q, KC, VC, GR, GRT, BETA, H, D: tl.constexpr, BT: tl.constexpr):
+    """Pure copies of request r's new row into slot caches at row t: Q/KC/VC/GR [S, H, BT, D], GRT [S, BT, H, D], BETA [S, H, BT].
+    QN/KN [R, H, D] contiguous; VV / GRAW rows of stride sv / sg (elements); BETA_IN [R, H] fp32 (already sigmoid)."""
+    r = tl.program_id(0)
+    h = tl.program_id(1)
+    s = tl.load(SLOT + r).to(tl.int64)
+    t = tl.load(POS + r).to(tl.int64)
+    o = tl.arange(0, D)
+    src = (r * H + h).to(tl.int64) * D + o
+    dst = ((s * H + h) * BT + t) * D + o
+    tl.store(Q + dst, tl.load(QN + src))
+    tl.store(KC + dst, tl.load(KN + src))
+    tl.store(VC + dst, tl.load(VV + r.to(tl.int64) * sv + h * D + o))
+    g = tl.load(GRAW + r.to(tl.int64) * sg + h * D + o)
+    tl.store(GR + dst, g)
+    tl.store(GRT + ((s * BT + t) * H + h) * D + o, g)
+    tl.store(BETA + (s * H + h) * BT + t, tl.load(BETA_IN + r * H + h))
+
+
+@triton.jit
+def b_scatter_g(SLOT, POS, GC, G, H, D: tl.constexpr, BT: tl.constexpr):
+    """G[s, h, t, :] = GC[r, t, h, :] (fp32 copy of the cumsum row t)."""
+    r = tl.program_id(0)
+    h = tl.program_id(1)
+    s = tl.load(SLOT + r).to(tl.int64)
+    t = tl.load(POS + r).to(tl.int64)
+    o = tl.arange(0, D)
+    tl.store(G + ((s * H + h) * BT + t) * D + o, tl.load(GC + ((r.to(tl.int64) * BT + t) * H + h) * D + o))
+
+
+@triton.jit
+def _conv_last_kernel(HIST, SLOT, RAW, sr, W, ACC, C, BLOCK: tl.constexpr):
+    """Lean v2: conv_silu_rows' expression for the new row (pre-SiLU, FP32) + the hist shift, one launch.
+    acc = x3*w3; acc = acc + x2*w2; acc = acc + x1*w1; acc = acc + x0*w0 (x0..x2 = the slot's hist rows, x3 = the new raw row),
+    every product and sum rounded separately (launch with enable_fp_fusion=False), then hist[s] = (x1, x2, x3)."""
+    r = tl.program_id(0)
+    s = tl.load(SLOT + r).to(tl.int64)
+    offs = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < C
+    h = HIST + s * 3 * C
+    x0 = tl.load(h + offs, mask=m, other=0.0)
+    x1 = tl.load(h + C + offs, mask=m, other=0.0)
+    x2 = tl.load(h + 2 * C + offs, mask=m, other=0.0)
+    x3 = tl.load(RAW + r.to(tl.int64) * sr + offs, mask=m, other=0.0)
+    w0 = tl.load(W + offs * 4 + 0, mask=m, other=0.0)
+    w1 = tl.load(W + offs * 4 + 1, mask=m, other=0.0)
+    w2 = tl.load(W + offs * 4 + 2, mask=m, other=0.0)
+    w3 = tl.load(W + offs * 4 + 3, mask=m, other=0.0)
+    acc = x3.to(tl.float32) * w3
+    acc = acc + x2.to(tl.float32) * w2
+    acc = acc + x1.to(tl.float32) * w1
+    acc = acc + x0.to(tl.float32) * w0
+    tl.store(ACC + r.to(tl.int64) * C + offs, acc, mask=m)
+    tl.store(h + offs, x1, mask=m)
+    tl.store(h + C + offs, x2, mask=m)
+    tl.store(h + 2 * C + offs, x3, mask=m)
+
+
+@triton.jit
+def _tail_kernel(TAIL, SLOT, POS, QKV, sq, G1, sg, B1, sb, P3, P4, NC, C63, BLOCK: tl.constexpr):
+    """K1 lean v2: tail[s, t, :] = (qkv | g1 | b1) of the new row when t < 63 (pure copy; t = the position before this row)."""
+    r = tl.program_id(0)
+    s = tl.load(SLOT + r).to(tl.int64)
+    t = tl.load(POS + r).to(tl.int64)
+    if t >= C63:
+        return
+    offs = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < NC
+    rr = r.to(tl.int64)
+    a = tl.load(QKV + rr * sq + offs, mask=m & (offs < P3), other=0.0)
+    b = tl.load(G1 + rr * sg + (offs - P3), mask=m & (offs >= P3) & (offs < P4), other=0.0)
+    c = tl.load(B1 + rr * sb + (offs - P4), mask=m & (offs >= P4), other=0.0)
+    v = tl.where(offs < P3, a, tl.where(offs < P4, b, c))
+    tl.store(TAIL + (s * C63 + t) * NC + offs, v, mask=m)
+
+
+@triton.jit
+def b_scatter2(SLOT, POS, QN, KN, sqk, VV, sv, GRAW, sg, BETA_IN, Q, KC, VC, GR, BETA, H, D: tl.constexpr, BT: tl.constexpr):
+    """b_scatter without the GRT mirror and with strided q/k rows (QN/KN = views into one [R, 2H, D] l2norm output)."""
+    r = tl.program_id(0)
+    h = tl.program_id(1)
+    s = tl.load(SLOT + r).to(tl.int64)
+    t = tl.load(POS + r).to(tl.int64)
+    o = tl.arange(0, D)
+    rr = r.to(tl.int64)
+    dst = ((s * H + h) * BT + t) * D + o
+    tl.store(Q + dst, tl.load(QN + rr * sqk + h * D + o))
+    tl.store(KC + dst, tl.load(KN + rr * sqk + h * D + o))
+    tl.store(VC + dst, tl.load(VV + rr * sv + h * D + o))
+    tl.store(GR + dst, tl.load(GRAW + rr * sg + h * D + o))
+    tl.store(BETA + (s * H + h) * BT + t, tl.load(BETA_IN + r * H + h))
+
+
+_LEAN2 = _os.environ.get("K31_KDA_BI_LEAN2", "1") == "1"   # default ON (gated in-engine); =0: lean v1
+
+
+class StaticRowDecoder(RowDecoder):
+    """RowDecoder with device-side positions and a sync-free decode step (graph-capturable)."""
+
+    def __init__(self, *a, **k):
+        super().__init__(*a, **k)
+        self.pos_dev = torch.zeros(len(self.pos), dtype=torch.int32, device=self.Q.device)
+
+    # host <-> device position mirrors (eager only, outside graphs)
+    def pos_from_host(self):
+        self.pos_dev.copy_(torch.tensor(self.pos, dtype=torch.int32))
+
+    def pos_to_host(self):
+        self.pos = [int(x) for x in self.pos_dev.tolist()]
+
+    def ensure_grt(self):
+        """Eager: GRT [S, BT, H, D] = GR in FLA's [B, T, H, S] layout (rows > pos may be stale: an inclusive scan's row t never
+        reads later rows; verified bitwise by kdagraph_gate.py)."""
+        if _LEAN2:   # lean v2 never reads GRT (per-row b_gate reads GR): don't allocate the [S, BT, H, D] mirror
+            self.GRT = None
+            return
+        if getattr(self, "GRT", None) is None:
+            self.GRT = self.GR.transpose(1, 2).contiguous()
+
+    def rows_static(self, recurrent_state, SL, RSL, q, k, v, graw, braw, A_log, dt_bias):
+        """Device-only version of RowDecoder._rows for R = SL.numel() requests (one new row each). Returns core [R, H, D] BF16."""
+        from fla.modules.l2norm import l2norm_fwd
+        from fla.ops.kda.chunk_fwd import chunk_kda_fwd
+        from fla.ops.kda.gate import kda_gate_chunk_cumsum
+        from fla.ops.utils.constant import RCP_LN2
+
+        H, D = self.H, self.D
+        R = SL.shape[0]
+        dev = q.device
+        PO = self.pos_dev.index_select(0, SL)                   # int32 [R]
+        tt = PO.to(torch.int64)
+        grid = (R, H)
+        if _LEAN2:
+            # one l2norm over q|k (row-local, same pinned config), strided scatter, per-row gate cumsum (rowkern.b_gate)
+            from .rowdec import _gate_cfg
+
+            qk = l2norm_fwd(q_k_pair(q, k).reshape(1, R, 2 * H, D))
+            qk = qk[0] if isinstance(qk, tuple) else qk
+            qk = qk.reshape(R, 2 * H, D)
+            assert v.stride(1) == 1 and graw.stride(1) == 1
+            beta_in = braw.reshape(R, H).float().sigmoid()
+            b_scatter2[grid](SL, PO, qk, qk[:, H:], 2 * H * D, v, v.stride(0), graw, graw.stride(0), beta_in,
+                             self.Q, self.KC, self.VC, self.GR, self.BETA, H, D=D, BT=BT, num_warps=1)
+            BS, nw = _gate_cfg()
+            RK.b_gate[(R, H, triton.cdiv(D, BS))](SL, PO, self.GR, self.G, A_log, dt_bias, self.lower, RCP_LN2, H, S=D, BT=BT,
+                                                   BS=BS, num_warps=nw)
+        elif _LEAN:
+            qn = l2norm_fwd(q.contiguous().reshape(1, R, H, D))
+            qn = qn[0] if isinstance(qn, tuple) else qn
+            kn = l2norm_fwd(k.contiguous().reshape(1, R, H, D))
+            kn = kn[0] if isinstance(kn, tuple) else kn
+            assert v.stride(1) == 1 and graw.stride(1) == 1
+            beta_in = braw.reshape(R, H).float().sigmoid()
+            b_scatter[grid](SL, PO, qn.contiguous(), kn.contiguous(), v, v.stride(0), graw, graw.stride(0), beta_in,
+                            self.Q, self.KC, self.VC, self.GR, self.GRT, self.BETA, H, D=D, BT=BT, num_warps=1)
+            gc = kda_gate_chunk_cumsum(self.GRT.index_select(0, SL), A_log, chunk_size=BT, scale=RCP_LN2, dt_bias=dt_bias,
+                                       lower_bound=self.lower)   # [R, BT, H, D] fp32; rows > t stale (unused by row t)
+            b_scatter_g[grid](SL, PO, gc, self.G, H, D=D, BT=BT, num_warps=1)
+        else:
+            q, k, v, graw, braw = (x.contiguous() for x in (q, k, v, graw, braw))
+            qn = l2norm_fwd(q.reshape(1, R, H, D))
+            qn = qn[0] if isinstance(qn, tuple) else qn
+            kn = l2norm_fwd(k.reshape(1, R, H, D))
+            kn = kn[0] if isinstance(kn, tuple) else kn
+            hh = torch.arange(H, device=dev)
+            idx = (SL[:, None], hh[None, :], tt[:, None])
+            self.Q[idx] = qn.reshape(R, H, D)
+            self.KC[idx] = kn.reshape(R, H, D)
+            self.VC[idx] = v.reshape(R, H, D)
+            self.GR[idx] = graw.reshape(R, H, D)
+            self.BETA[idx] = braw.reshape(R, H).float().sigmoid()
+            # g_cum of row t of each open chunk: fixed-shape batch, rows > t zero (the varlen call's masked loads)
+            ar = torch.arange(BT, device=dev)
+            gin = self.GR.index_select(0, SL).transpose(1, 2)        # [R, BT, H, D]
+            gin = torch.where((ar[None, :] <= tt[:, None])[:, :, None, None], gin, torch.zeros((), dtype=gin.dtype, device=dev))
+            gc = kda_gate_chunk_cumsum(gin.contiguous(), A_log, chunk_size=BT, scale=RCP_LN2, dt_bias=dt_bias,
+                                       lower_bound=self.lower)       # [R, BT, H, D] fp32
+            self.G[idx] = gc[torch.arange(R, device=dev), tt]        # [R, H, D]
+        AQK = torch.zeros(R, H, BT, dtype=torch.bfloat16, device=dev)
+        AKK = torch.zeros(R, H, BT, dtype=torch.bfloat16, device=dev)
+        W = torch.empty(R, H, D, dtype=torch.bfloat16, device=dev)
+        U = torch.empty(R, H, D, dtype=torch.bfloat16, device=dev)
+        O = torch.empty(R, H, D, dtype=torch.bfloat16, device=dev)
+        SL32 = SL.to(torch.int32)
+        RSL32 = RSL.to(torch.int32)
+        RK.b_diag[grid](SL32, PO, self.Q, self.KC, self.G, self.BETA, AQK, self.AD, self.AP, self.scale, H, K=D, BT=BT, BC=16,
+                        num_warps=1)
+        RK.b_inter[grid](SL32, PO, self.Q, self.KC, self.G, self.BETA, AQK, self.AD, self.AF, AKK, self.scale, H, K=D, BT=BT,
+                         BC=16, num_warps=4)
+        RK.b_wu[grid](SL32, PO, self.KC, self.VC, self.G, self.BETA, AKK, W, U, H, K=D, V=D, BT=BT, num_warps=2)
+        if recurrent_state.stride(3) != 1 or recurrent_state.stride(2) != D:
+            raise RuntimeError(f"k31kdagraph: per-head state must be a contiguous [K, V] block, strides {recurrent_state.stride()}")
+        S0, SH = recurrent_state.stride(0), recurrent_state.stride(1)
+        RK.b_stage_a[grid](SL32, RSL32, PO, S0, SH, self.Q, self.G, U, W, AQK, recurrent_state, self.VN, O, self.scale, H, K=D, V=D,
+                           BT=BT, R=16, num_warps=4)
+        # chunk completion, always run; keep the new boundary state only where row t closed the chunk
+        if _PROF_NO_COMPLETE:   # timing only (wrong bits at chunk ends)
+            self.pos_dev.index_copy_(0, SL, ((PO + 1) % BT).to(torch.int32))
+            return O
+        if _COMPLETE_FLA:   # reference variant: FLA chunk_kda_fwd on all R cached chunks, kept where t == BT-1
+            tq = lambda X: X.index_select(0, SL).transpose(1, 2).contiguous()  # noqa: E731  [R, BT, H, D]
+            beta = self.BETA.index_select(0, SL).transpose(1, 2).contiguous()   # [R, BT, H]
+            h0 = recurrent_state.index_select(0, RSL)
+            out = chunk_kda_fwd(q=tq(self.Q), k=tq(self.KC), v=tq(self.VC), g=tq(self.GR), beta=beta, scale=self.scale,
+                                initial_state=h0, output_final_state=True, safe_gate=True, lower_bound=self.lower,
+                                use_gate_in_kernel=True, A_log=A_log, dt_bias=dt_bias)
+            done = (tt == BT - 1)[:, None, None, None]
+            recurrent_state.index_copy_(0, RSL, torch.where(done, out[1], h0))
+        else:               # masked row-engine completion: work only for (request, head) programs whose chunk just closed
+            b_complete[grid](SL32, RSL32, PO, S0, SH, self.KC, self.G, self.VN, recurrent_state, H, K=D, V=D, BT=BT, num_warps=4)
+        self.pos_dev.index_copy_(0, SL, ((PO + 1) % BT).to(torch.int32))
+        return O
+
+
+def decode_step_static(st, rows, recurrent_state, SL, RSL, raw, g1f, b1, g2, conv_w, A_log, dt_bias, norm_w, eps):
+    """Graph-capturable equivalent of BIKDAState.step's row-engine branch for an all-decode, all-warm batch.
+    st: k31kdabi.BIKDAState (tail / hist / P / H / D / W); rows: StaticRowDecoder sharing st's slot ids.
+    raw [R, 3P] pre-conv q|k|v, g1f [R, P], b1 [R, H], g2 [R, H, D]. Returns normed core [R, H, D] BF16.
+    Phase-1 bookkeeping: tail row at pos (if pos < 63), pos -> (pos+1) % 64 (device: rows.pos_dev; st.pos host list is NOT
+    updated here; call sync_st_from_device() before handing a slot back to phase 1)."""
+    P, Wm = st.P, st.W - 1
+    if _LEAN2:
+        return _decode_step_lean2(st, rows, recurrent_state, SL, RSL, raw, g1f, b1, g2, conv_w, A_log, dt_bias, norm_w, eps)
+    with torch.no_grad():
+        ext = torch.cat([st.hist.index_select(0, SL), raw[:, None]], 1)                        # [R, W, 3P]
+        if _LEAN:
+            # conv_silu_rows' expression for the LAST row of each block only (same elementwise kernels, same order)
+            xf, wf = ext.float(), conv_w.float()
+            acc = xf[:, Wm] * wf[:, Wm]
+            for shift in range(1, Wm + 1):
+                acc = acc + xf[:, Wm - shift] * wf[:, Wm - shift]
+            qkv = torch.nn.functional.silu(acc).to(raw.dtype)
+        else:
+            qkv = conv_silu_rows(ext.reshape(-1, ext.shape[-1]), conv_w).reshape(ext.shape)[:, Wm].to(raw.dtype)
+        st.hist.index_copy_(0, SL, ext[:, 1:].contiguous())
+        PO = rows.pos_dev.index_select(0, SL).to(torch.int64)                                   # pos before this row
+        core = rows.rows_static(recurrent_state, SL, RSL, qkv[:, :P], qkv[:, P:2 * P], qkv[:, 2 * P:], g1f, b1, A_log, dt_bias)
+        new_rows = torch.cat([qkv, g1f, b1], 1)                                                 # [R, 4P+H]
+        C = st.tail.shape[1]                                                                   # 63
+        pc = PO.clamp(max=C - 1)
+        old = st.tail[SL, pc]
+        st.tail[SL, pc] = torch.where((PO < C)[:, None], new_rows, old)                        # pos == 63: unchanged
+        return gated_rms_norm(core, g2, norm_w, eps).to(torch.bfloat16)
+
+
+
+
+def q_k_pair(q, k):
+    """q, k are adjacent column blocks of the post-conv qkv rows: return the contiguous [R, 2P] q|k block."""
+    if q.data_ptr() + q.shape[1] * q.element_size() == k.data_ptr() and q.stride() == k.stride():
+        return q.as_strided((q.shape[0], 2 * q.shape[1]), q.stride()).contiguous()
+    return torch.cat([q, k], 1)
+
+
+def _decode_step_lean2(st, rows, recurrent_state, SL, RSL, raw, g1f, b1, g2, conv_w, A_log, dt_bias, norm_w, eps):
+    """decode_step_static with fused glue (lean v2): conv-last + hist shift in one kernel, tail update in one kernel; same
+    bits (pure copies + the trainer's conv op order with separately rounded mul / add)."""
+    P = st.P
+    R = SL.shape[0]
+    C = 3 * P
+    with torch.no_grad():
+        acc = torch.empty((R, C), dtype=torch.float32, device=raw.device)
+        cw = conv_w if (conv_w.dtype == torch.float32 and conv_w.is_contiguous()) else conv_w.float().contiguous()
+        assert raw.stride(1) == 1 and st.hist.is_contiguous()
+        _conv_last_kernel[(R, triton.cdiv(C, 1024))](st.hist, SL, raw, raw.stride(0), cw, acc, C, BLOCK=1024, num_warps=4,
+                                                     enable_fp_fusion=False)
+        qkv = torch.nn.functional.silu(acc).to(raw.dtype)
+        PO = rows.pos_dev.index_select(0, SL)                                                   # int32, pos before this row
+        core = rows.rows_static(recurrent_state, SL, RSL, qkv[:, :P], qkv[:, P:2 * P], qkv[:, 2 * P:], g1f, b1, A_log, dt_bias)
+        NC = st.tail.shape[2]
+        assert g1f.stride(1) == 1 and b1.stride(1) == 1 and st.tail.is_contiguous()
+        _tail_kernel[(R, triton.cdiv(NC, 1024))](st.tail, SL, PO, qkv, qkv.stride(0), g1f, g1f.stride(0), b1, b1.stride(0),
+                                                 C, 4 * P, NC, st.tail.shape[1], BLOCK=1024, num_warps=4)
+        return gated_rms_norm(core, g2, norm_w, eps).to(torch.bfloat16)
+
+
+_SHARED_POOL = _os.environ.get("K31_KDA_BI_GRAPH_SHARED_POOL", "1") == "1"   # default ON; =0: one private pool per graph
+# One mempool per device for every KDA decode graph (all layers, all buckets). Safe: graphs replay strictly one at a time on
+# one stream, each replay's output is cloned before the next replay, and every persistent tensor (slot caches,
+# recurrent_state, io inputs) is allocated outside capture. Private pools grow with layers x buckets (proxy TP1: OOM at R=128).
+_POOLS = {}
+
+_BUCKETS = sorted({int(x) for x in _os.environ.get("K31_KDA_BI_GRAPH_BUCKETS",
+                                                  "1,2,4,8,16,24,32,48,64,96,128,192,256").split(",") if x})
+
+
+class GraphDecoder:
+    """Per-layer graph cache for decode_step_static: one CUDA graph per batch-size BUCKET (K31_KDA_BI_GRAPH_BUCKETS),
+    so the number of graphs per layer stays bounded under serving. A batch of R requests runs in the smallest bucket Rb >= R;
+    rows R..Rb-1 are padding: they point at the reserved dummy compact slot (BIKDAState.real[-1] == -2), read request 0's state
+    row (read-only), get zero inputs, and the dummy slot's position is parked at 0 before every step, so its chunk completion
+    (b_complete writes only at t == 63) never fires. R > the largest bucket: decode_step_static eagerly (still sync-free)."""
+
+    def __init__(self, st, rows):
+        self.st, self.rows = st, rows
+        self.graphs = {}
+        self.warm_r = set()
+        self.n_replay = 0
+        self.dummy = len(st.real) - 1
+        assert st.real[self.dummy] == -2, "graph decode needs the reserved dummy slot (set K31_KDA_BI_GRAPH=1 before BIKDAState)"
+
+    def _bucket(self, R):
+        return next((b for b in _BUCKETS if b >= R), None)
+
+    def step(self, recurrent_state, slots, real_slots, raw, g1f, b1, g2, conv_w, A_log, dt_bias, norm_w, eps):
+        st, rows = self.st, self.rows
+        rows.ensure_grt()
+        R = len(slots)
+        dev = raw.device
+        Rb = self._bucket(R)
+        if Rb is None:
+            ids = torch.tensor(slots + real_slots, dtype=torch.int64).pin_memory().to(dev, non_blocking=True)
+            return decode_step_static(st, rows, recurrent_state, ids[:R], ids[R:], raw, g1f, b1, g2, conv_w, A_log, dt_bias,
+                                      norm_w, eps)
+        pad = Rb - R
+        ids = torch.tensor(slots + [self.dummy] * pad + real_slots + [real_slots[0]] * pad,
+                           dtype=torch.int64).pin_memory().to(dev, non_blocking=True)
+        SL, RSL = ids[:Rb], ids[Rb:]
+        rows.pos_dev[self.dummy] = 0                      # park the dummy slot: its completion can never fire
+        if Rb not in self.warm_r:
+            # first time at this bucket: run eagerly (compiles every kernel; a correct step), capture on the next occurrence
+            padz = lambda x: torch.cat([x, x.new_zeros((pad,) + tuple(x.shape[1:]))]) if pad else x  # noqa: E731
+            out = decode_step_static(st, rows, recurrent_state, SL, RSL, padz(raw), padz(g1f), padz(b1), padz(g2), conv_w,
+                                     A_log, dt_bias, norm_w, eps)
+            self.warm_r.add(Rb)
+            return out[:R]
+        # A graph bakes in recurrent_state's address: vLLM allocates the real KV cache AFTER its cudagraph memory
+        # profiling (whose dummy decode batches can warm slots and capture here), so re-key on the state tensor
+        # Also key on the persistent parameters the graph bakes (conv_w / A_log / dt_bias: vLLM passes the module's own
+        # tensors, updated in place by weight sync); norm_w is staged by copy every replay (callers may pass a per-call .to() temp)
+        key = (Rb, recurrent_state.data_ptr(), tuple(recurrent_state.stride()), conv_w.data_ptr(), A_log.data_ptr(),
+               dt_bias.data_ptr())
+        if getattr(self, "_state_key", None) != key[1:]:
+            self.graphs.clear()
+            self._state_key = key[1:]
+        g = self.graphs.get(Rb)
+        if g is None:
+            mk = lambda x: x.new_zeros((Rb,) + tuple(x.shape[1:]))  # noqa: E731  padding rows stay zero forever
+            io = {"SL": SL.clone(), "RSL": RSL.clone(), "raw": mk(raw), "g1f": mk(g1f), "b1": mk(b1), "g2": mk(g2),
+                  "norm_w": norm_w.clone()}
+            graph = torch.cuda.CUDAGraph()
+            torch.cuda.synchronize()
+            m0 = torch.cuda.memory_reserved()
+            pool = None
+            if _SHARED_POOL:
+                dev_i = torch.cuda.current_device()
+                pool = _POOLS.get(dev_i)
+                if pool is None:
+                    pool = _POOLS[dev_i] = torch.cuda.graph_pool_handle()
+            with torch.cuda.graph(graph, pool=pool):
+                io["out"] = decode_step_static(st, rows, recurrent_state, io["SL"], io["RSL"], io["raw"], io["g1f"], io["b1"],
+                                               io["g2"], conv_w, A_log, dt_bias, io["norm_w"], eps)
+            torch.cuda.synchronize()
+            self.cap_bytes = getattr(self, "cap_bytes", {})
+            self.cap_bytes[Rb] = torch.cuda.memory_reserved() - m0
+            g = self.graphs[Rb] = (graph, io)
+        graph, io = g
+        io["SL"].copy_(SL)
+        io["RSL"].copy_(RSL)
+        io["raw"][:R].copy_(raw)
+        io["g1f"][:R].copy_(g1f)
+        io["b1"][:R].copy_(b1)
+        io["g2"][:R].copy_(g2)
+        io["norm_w"].copy_(norm_w)
+        if pad:   # rows of a larger earlier batch may linger in R..Rb-1 of a reused bucket: zero them
+            for k in ("raw", "g1f", "b1", "g2"):
+                io[k][R:].zero_()
+        graph.replay()
+        self.n_replay += 1
+        return io["out"][:R].clone()
