+            qkv = conv_silu_last(ext, conv_w).to(raw.dtype)
+            self.hist.index_copy_(0, st, ext[:, 1:])
+            cold = [j for j, s_ in enumerate(rs) if not self.rows.warm[s_]]
+            if cold:
