+    def dummy_id(self):
+        return len(self.real) - 1
+
+    def ensure_cid(self, recurrent_state):
+        """cid_dev[vLLM state index] -> compact id (int32), default = the reserved dummy id (null block 0, unassigned indices,
+        padded graph rows). Rebuilt if the state cache moves (vLLM allocates it after its memory profiling)."""
+        import torch
+
+        key = (recurrent_state.data_ptr(), recurrent_state.shape[0])
+        if getattr(self, "_cid_key", None) == key:
+            return self.cid_dev
+        self.cid_dev = torch.full((recurrent_state.shape[0],), self.dummy_id(), dtype=torch.int32, device=recurrent_state.device)
+        self._cid_key = key
+        self._cid_changes = [(s_, c) for s_, c in self._cid.items() if s_ != 0 or not _NULL_TO_DUMMY]   # cid_dev[0] pinned
+        return self.cid_dev
+
+    def full_pre(self, recurrent_state, slots):
+        """Eager step in FULL mode, before step(): the device is the truth for pos (graph replays advanced it); refresh the host
+        lists of the slots this step touches (one D2H)."""
+        rows = self.rows
+        vals = rows.pos_dev.index_select(0, _to_dev([slots], recurrent_state.device)[0]).tolist()
+        for s_, p_ in zip(slots, vals):
+            self.pos[s_] = int(p_)
+            rows.pos[s_] = int(p_)
+
+    def full_post(self, recurrent_state, slots, A_log, dt_bias):
+        """Eager step in FULL mode, after step(): warm every touched slot that holds state (so FULL decode never sees a cold slot),
+        then push host truth to the device: pos_dev, GRT rows, last-use, and the cid_dev deltas."""
+        import torch
+
+        rows = self.rows
+        cold = [s_ for s_ in dict.fromkeys(slots) if not rows.warm[s_]]
+        if cold:
+            for s_ in cold:
+                if self.null[s_]:
+                    recurrent_state[self._rs([s_])[0]].zero_()  # boundary state not materialized yet: zero == None for FLA
+                    self.null[s_] = False
+            rows.warm_up(recurrent_state, cold, [self.tail[s_, :self.pos[s_]] for s_ in cold], A_log, dt_bias)
+        uniq = list(dict.fromkeys(slots))
+        d, p = _to_dev([uniq, [rows.pos[s_] for s_ in uniq]], recurrent_state.device)
+        rows.pos_dev.index_copy_(0, d, p.to(torch.int32))
+        if rows.GRT is not None:
+            rows.GRT.index_copy_(0, d, rows.GR.index_select(0, d).transpose(1, 2).contiguous())
+        rows.tick_dev += 1
+        rows.lastuse_dev.index_copy_(0, d, rows.tick_dev.expand(d.numel()))
+        self._dev_dirty.difference_update(uniq)
+        if self._cid_changes:
+            cid = self.ensure_cid(recurrent_state)
+            ch = self._cid_changes
+            self._cid_changes = []
+            # One index_copy_ with a DUPLICATE state index is nondeterministic (it left
+            # cid_dev[o] = dummy for a live request -> its FULL-graph decodes ran on the dummy slot). Dedupe, last mapping
+            # wins (= the host map). State index 0 is vLLM's null block (padded graph rows): always the dummy id.
+            if len({a for a, _ in ch}) != len(ch):
