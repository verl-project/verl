# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
"""Preserve the public base's exact TE binary; never compile or fake its version."""

import importlib.metadata as md
import shutil
import subprocess
import sys
from pathlib import Path

source = md.distribution('transformer_engine')
assert source.version == '2.19.0+5e52befd', source.version
site = Path(
    subprocess.check_output(
        [
            '/opt/runtime/.venv/bin/python',
            '-c',
            'import sysconfig;print(sysconfig.get_path("purelib"))',
        ],
        text=True,
    ).strip()
)
base = Path(source.locate_file(''))
entries = list(base.glob('transformer_engine*'))
assert any(x.name == 'transformer_engine' for x in entries)
assert any(x.name == source._path.name for x in entries)
for original in entries:
    target = site / original.name
    if original.is_dir():
        shutil.copytree(original, target, dirs_exist_ok=True, symlinks=False)
    else:
        shutil.copy2(original, target, follow_symlinks=True)
EOF
COPY <<'EOF' fix-cusparselt-tag.py
# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
"""Reproduce the reference runtime's cuSPARSELt wheel-tag correction (aarch64 only).

PyPI's nvidia_cusparselt_cu13-0.8.1-py3-none-manylinux2014_aarch64.whl declares
`Tag: py3-none-manylinux2014_sbsa` inside its WHEEL file, which `pip check`
rejects. The reference runtime carries the same library and METADATA bytes with
the tag rewritten to manylinux2014_aarch64; this applies that one-line change,
updates RECORD, and requires the result to equal the reference WHEEL digest.
"""

import base64
import hashlib
import importlib.metadata as md
import json
import sys
from pathlib import Path

EXPECTED = {  # urlsafe-b64 sha256 from the reference RECORD
    "WHEEL_before": "9EEww1DEpSYdq-rReTwY88G51UoHWvABWuRF6Sy_8Bs",
    "WHEEL_after": "ABAV42k93WKqnYKLN0BIVQbWApIm1M5UwJVvVB4zSLM",
}
OLD, NEW = "Tag: py3-none-manylinux2014_sbsa", "Tag: py3-none-manylinux2014_aarch64"


def digest(data: bytes) -> str:
    return base64.urlsafe_b64encode(hashlib.sha256(data).digest()).rstrip(b"=").decode()


dist = md.distribution("nvidia-cusparselt-cu13")
assert dist.version == "0.8.1", dist.version
info = Path(dist._path)  # the installed .dist-info directory
wheel, record = info / "WHEEL", info / "RECORD"
before = wheel.read_bytes()
assert digest(before) == EXPECTED["WHEEL_before"], "unexpected cuSPARSELt WHEEL"
after = before.decode().replace(OLD, NEW).encode()
assert digest(after) == EXPECTED["WHEEL_after"], "rewrite does not match the reference"
wheel.write_bytes(after)
name = f"{info.name}/WHEEL"
lines = record.read_text().splitlines()
updated = [
    f"{name},sha256={EXPECTED['WHEEL_after']},{len(after)}" if l.startswith(name + ",") else l
    for l in lines
]
assert sum(l.startswith(name + ",") for l in lines) == 1
record.write_text("\n".join(updated) + "\n")
json.dump(
    {
        "dist_info": str(info),
        "old_tag": OLD,
        "new_tag": NEW,
        "wheel_sha256_before": EXPECTED["WHEEL_before"],
        "wheel_sha256_after": EXPECTED["WHEEL_after"],
    },
    open(sys.argv[1], "w"),
    indent=2,
)
print("cuSPARSELt WHEEL tag set to manylinux2014_aarch64 (reference digest)")
EOF

# Runtime venv: every package pinned; Transformer Engine is the base image's binary, copied unchanged.
RUN apt-get update && apt-get install -y --no-install-recommends libdw-dev libelf-dev && rm -rf /var/lib/apt/lists/*
RUN python -m venv --without-pip /opt/runtime/.venv \
 && python copy-te.py \
 && grep -F '+cu130' requirements-runtime.txt > req-cu130.txt \
 && grep -vF '+cu130' requirements-runtime.txt > req-pypi.txt \
 && python -m pip --python /opt/runtime/.venv/bin/python install --no-deps --index-url https://pypi.org/simple -r req-pypi.txt \
 && python -m pip --python /opt/runtime/.venv/bin/python install --no-deps --index-url https://pypi.org/simple \
      --extra-index-url https://download.pytorch.org/whl/cu130 -r req-cu130.txt \
 && /opt/runtime/.venv/bin/python fix-cusparselt-tag.py /opt/runtime/cusparselt-tag.json \
 && python -m pip --python /opt/runtime/.venv/bin/python install --no-deps \
      "git+https://github.com/Ascend/TransferQueue.git@${TRANSFER_QUEUE_SHA}"

# vLLM: wheel natives + branch Python tree + batch-invariant extension rebuilt for sm_100 from the same tree.
WORKDIR /opt/ds41/vllm
RUN mkdir -p pkg site obj \
 && curl -fL -o vllm.whl "${VLLM_WHEEL}" \
 && python -m pip download --no-deps --only-binary :all: --index-url https://pypi.org/simple flashinfer-python==0.7.2 -d . \
 && printf '%s  vllm.whl\n%s  flashinfer_python-0.7.2-py3-none-any.whl\n' "${VLLM_WHEEL_SHA256}" "${FLASHINFER_WHEEL_SHA256}" | sha256sum -c - \
 && python -c 'import zipfile; zipfile.ZipFile("vllm.whl").extractall("pkg"); zipfile.ZipFile("flashinfer_python-0.7.2-py3-none-any.whl").extractall("site")' \
 && rm vllm.whl flashinfer_python-0.7.2-py3-none-any.whl \
 && git clone https://github.com/ISEEKYAN/vllm.git src && git -C src checkout "${VLLM_SHA}" \
 && cp -a src/vllm/. pkg/vllm/
RUN export PATH=/usr/local/cuda/bin:$PATH \
 && PY=/opt/runtime/.venv/bin/python \
 && eval "$($PY -c 'import shlex, torch, torch.utils.cpp_extension as c; drop = {"-D__CUDA_NO_HALF_OPERATORS__", "-D__CUDA_NO_HALF_CONVERSIONS__", "-D__CUDA_NO_BFLOAT16_CONVERSIONS__", "-D__CUDA_NO_HALF2_OPERATORS__"}; print("TINC=" + shlex.quote(" ".join("-I" + p for p in c.include_paths(device_type="cuda")))); print("NVF=" + shlex.quote(" ".join(f for f in c.COMMON_NVCC_FLAGS if f not in drop))); print("ABI=%d" % int(torch._C._GLIBCXX_USE_CXX11_ABI)); print("TLIB=" + shlex.quote(c.library_paths(device_type="cuda")[0]))')" \
 && COMMON="-O3 -DNDEBUG -DENABLE_FP8 -D_GLIBCXX_USE_CXX11_ABI=$ABI -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_vllm_batch_invariant_C $TINC -Isrc/csrc -I/usr/include/python3.12" \
 && pids=() \
 && for f in $(cd src/csrc/batch_invariant && ls *.cu | sed 's/\.cu$//'); do \
      nvcc -c src/csrc/batch_invariant/$f.cu -o obj/$f.o $COMMON $NVF -gencode arch=compute_100,code=sm_100 -std=c++20 \
           -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_BFLOAT16_CONVERSIONS__ --compress-mode=size -Xcompiler -fPIC & pids+=($!); \
    done \
 && g++ -c src/csrc/batch_invariant/torch_bindings.cpp -o obj/torch_bindings.o $COMMON -std=c++20 -fPIC -I/usr/local/cuda/include \
 && for p in "${pids[@]}"; do wait "$p"; done \
 && g++ -shared -o pkg/vllm/_vllm_batch_invariant_C.so obj/*.o -L$TLIB -lc10 -lc10_cuda -ltorch -ltorch_cpu -ltorch_cuda \
      -L/usr/local/cuda/lib64 -lcudart -Wl,-rpath,$TLIB \
 && test "$(cuobjdump --list-elf pkg/vllm/_vllm_batch_invariant_C.so | grep -c sm_100)" -gt 0 \
 && rm -rf obj && find pkg -name __pycache__ -prune -exec rm -rf {} +

# DeepGEMM with the MegaMoE LoRA hooks (the commit pinned by the branch's cmake/external_projects/deepgemm.cmake),
# built like vLLM's tools/build_deepgemm_C.py and installed over the wheel's vendored copy (whose envs.py is kept).
WORKDIR /opt/ds41/deepgemm
RUN git clone https://github.com/ISEEKYAN/DeepGEMM.git src && git -C src checkout "${DEEPGEMM_SHA}" \
 && git -C src submodule update --init --recursive \
 && cd src && touch scripts/__init__.py \
 && PATH=/usr/local/cuda/bin:$PATH DG_USE_LOCAL_VERSION=0 MAX_JOBS=16 /opt/runtime/.venv/bin/python setup.py build_ext --inplace --force \
 && D=/opt/ds41/vllm/pkg/vllm/third_party/deep_gemm \
 && cp deep_gemm/_C_extension.abi3.so deep_gemm/_C.py "$D"/ \
 && for f in deep_gemm/*.py deep_gemm/mega/*.py deep_gemm/utils/*.py deep_gemm/testing/*.py deep_gemm/legacy/*.py; do \
      [ "$(basename "$f")" = envs.py ] || { mkdir -p "$D/$(dirname "${f#deep_gemm/}")"; cp "$f" "$D/${f#deep_gemm/}"; }; \
    done \
 && rm -rf "$D/include/deep_gemm" && cp -a deep_gemm/include/deep_gemm "$D/include/deep_gemm" \
 && find "$D" -name __pycache__ -prune -exec rm -rf {} +

# fast-hadamard-transform.
RUN git clone https://github.com/Dao-AILab/fast-hadamard-transform.git /opt/ds41/fht-src \
 && git -C /opt/ds41/fht-src checkout "${FHT_SHA}" \
 && cd /opt/ds41/fht-src && TORCH_CUDA_ARCH_LIST=10.0a MAX_JOBS=16 python -m pip --python /opt/runtime/.venv/bin/python install \
      --no-build-isolation --no-deps --target /opt/ds41/fht/site .

WORKDIR /workspace
ENV PATH=/opt/runtime/.venv/bin:/usr/local/cuda/bin:$PATH \
    PYTHONPATH=/opt/ds41/vllm/site:/opt/ds41/vllm/pkg:/opt/ds41/vllm/pkg/vllm/third_party:/opt/ds41/fht/site \
    VLLM_BATCH_INVARIANT=1 VLLM_BI_BF16_GEMM=tensor_core VLLM_BI_MXFP8_GEMM=tensor_core VLLM_BI_MXFP8_PREQUANT=1 \
    VLLM_BI_MHC_OVERLAP=1 VLLM_BI_REPLAY_STAGE_LAYERS=2 \
    VLLM_BATCH_INVARIANT_KERNEL_LIB=/opt/ds41/vllm/pkg/vllm/_vllm_batch_invariant_C.so \
    VLLM_MEGAMOE_LORA_FUSED=1 VLLM_LORA_OVERLAP_SHRINK=1 \
    CUBLAS_WORKSPACE_CONFIG=:4096:8
