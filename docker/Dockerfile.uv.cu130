# Build the cu13 (CUDA 13.0 / torch 2.11) slice of verl's uv-managed image.
#
# One universal uv.lock covers every backend (backends are PEP 621 extras; the
# mutually exclusive ones live in pyproject.toml [tool.uv].conflicts). This
# Dockerfile builds its cu130 slice — vllm / sglang / fsdp / megatron / cpu —
# on nvidia/cuda:13.0.2. The cu12.9/torch-2.9.1 and trtllm worlds are deferred
# in pyproject.toml (recover their old image from git history).
#
# Build time BAKEs the full uv cache: the `prefetch` stage resolves every
# backend's wheels plus the git-source builds from the committed lock into a
# real image layer (deliberately no cache mount). No fixed .venv is baked — at
# container start `uv run --extra <engine> --extra <trainer>` (what examples/
# scripts call) materializes the requested combo into the single
# /workspace/verl/.venv from that cache, offline. Pick a conflict-free combo.
#
# One Dockerfile for x86_64 AND aarch64 (GH200/GB200): each layer resolves its
# arch at build time and the lock carries both. Ascend NPU is out of scope
# (see docker/ascend/*). The base is a superset of the upstream sglang / vllm
# "basic" stages (RDMA/IB, OpenMPI, NUMA, GDRCopy, gcc-10, uv tunables).
#
# Build (context = repo root, needs the committed uv.lock):
#
#     docker build -f docker/Dockerfile.uv.cu130 -t verl:uv-cu130 .
#
# The base is a multi-arch manifest, so on arm64 that command (or
# `--platform linux/arm64`) builds aarch64. Cross-building from x86_64 runs
# every expensive layer (apt install, GDRCopy, prefetch CUDA compiles) under
# QEMU — prefer arm64 hardware, or attach a remote arm64 host as a NATIVE
# buildx node (`user@arm-host` is a placeholder; check `ssh <host> docker
# version` first). See docker/README.md "GB200 / aarch64" for the QEMU-only
# fallback.
#
#     # cross-build only (QEMU):
#     docker run --privileged --rm tonistiigi/binfmt --install arm64
#     # remote native arm64 node:
#     docker buildx create --name verl-arm --driver docker-container \
#         --platform linux/arm64 ssh://user@arm-host --use
#     docker buildx build --platform linux/arm64 -f docker/Dockerfile.uv.cu130 \
#         -t verl:uv-cu130-arm64 --load .
#
# Run (pick the combo at run time):
#
#     docker run --rm -it --gpus all verl:uv-cu130 bash
#     uv run --frozen --all-packages --extra sglang --extra megatron \
#         python3 -m verl.trainer.main_ppo ...
#
# Named stages: --target=prefetch (baked cache, no source) or --target=lock
# (regenerate uv.lock to extract it).
#
# Build args: CUDA_VERSION (CUDA dev base), CUDA_BASE_IMAGE (Docker Hub mirror
# for it), UBUNTU_MIRROR (apt), PIP_DEFAULT_INDEX (pip), GITHUB_ARTIFACTORY
# (github mirror). These cover RUN steps but NOT the `FROM` pull — BuildKit
# resolves the base before build args apply, so for an egress proxy set it on
# the builder: `docker buildx create --driver docker-container --use
# --driver-opt env.https_proxy=http://proxy:8118 ...`.
#
# Build with BuildKit: only the prefetch cache is baked; the `lock` and apt
# steps use cache mounts for faster rebuilds. See the "Run from the uv Docker
# image" section of docs/start/install.rst.

ARG CUDA_VERSION=13.0.2
# Docker Hub repository of the CUDA base image, so a site with slow/blocked
# docker.io can point at an internal mirror without editing this file
# (--build-arg CUDA_BASE_IMAGE=<mirror>/nvidia/cuda; an arm64 mirror must carry
# the arm64 manifest). The proxy caveat for this `FROM` pull is in the header.
ARG CUDA_BASE_IMAGE=nvidia/cuda
FROM ${CUDA_BASE_IMAGE}:${CUDA_VERSION}-devel-ubuntu24.04 AS base

ARG CUDA_VERSION
ARG TARGETARCH
ARG DEBIAN_FRONTEND=noninteractive

# cuDNN / NCCL — see https://developer.nvidia.com/cudnn-downloads
# These ARGs control the apt deb versions installed below and MUST match
# whatever uv resolves into uv.lock. The backend extras don't pin cuDNN /
# NCCL — torch's wheel pins them transitively (e.g. torch 2.11.0+cu130 ->
# nvidia-cudnn-cu13==9.19.0.56, nvidia-nccl-cu13==2.28.9). After bumping a
# torch pin and re-running `python manage_envs.py lock`, grep the resolved
# versions out of the lockfile and update these ARGs:
#
#     grep -E 'nvidia-(cudnn|nccl)-cu13' uv.lock
ARG NCCL_VERSION=2.28.9-1

# Source to build from. Override VERL_REF for tags / commits.
ARG VERL_REPO=https://github.com/verl-project/verl.git
ARG VERL_REF=main

# Mirrors / index overrides (kept compatible with the sglang/vllm Dockerfiles).
ARG UBUNTU_MIRROR
ARG PIP_DEFAULT_INDEX
ARG GITHUB_ARTIFACTORY=github.com
ARG GDRCOPY_VERSION=2.5.1
# NVSHMEM, installed as a system pip package below (see the rationale there).
ARG NVSHMEM_VERSION=3.4.5

ENV CUDA_HOME=/usr/local/cuda \
    GDRCOPY_HOME=/usr/src/gdrdrv-${GDRCOPY_VERSION}/

# Add GKE default lib and bin locations (mirrors vllm + sglang base layers).
ENV PATH="${PATH}:/usr/local/nvidia/bin" \
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/nvidia/lib:/usr/local/nvidia/lib64"

# Replace Ubuntu sources if a mirror was supplied (sglang-style override).
RUN if [ -n "${UBUNTU_MIRROR}" ]; then \
        find /etc/apt -name '*.list' -o -name '*.sources' | xargs -r \
            sed -i "s|http://.*archive.ubuntu.com|${UBUNTU_MIRROR}|g; s|http://.*security.ubuntu.com|${UBUNTU_MIRROR}|g"; \
    fi

# ---------------------------------------------------------------------------
# System dependencies — superset of `sglang/docker/Dockerfile` (lines 60-127)
# and `vllm/docker/Dockerfile` (lines 100-114) basic stages.
# ---------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,id=verl-uv-apt \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        software-properties-common \
        netcat-openbsd \
        kmod \
        unzip \
        openssh-client \
        openssh-server \
        sudo \
        curl \
        wget \
        lsof \
        locales \
        vim \
        build-essential \
        ccache \
        cmake \
        ninja-build \
        perl \
        patchelf \
        git \
        git-lfs \
        gcc-10 \
        g++-10 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        libopenmpi-dev \
        libnuma1 \
        libnuma-dev \
        numactl \
        ffmpeg \
        libibverbs-dev \
        libibverbs1 \
        libibumad3 \
        librdmacm-dev \
        librdmacm1 \
        libnl-3-200 \
        libnl-route-3-200 \
        libnl-route-3-dev \
        libnl-3-dev \
        ibverbs-providers \
        infiniband-diags \
        perftest \
        libgoogle-glog-dev \
        libgtest-dev \
        libjsoncpp-dev \
        libunwind-dev \
        libboost-all-dev \
        libssl-dev \
        libgrpc-dev \
        libgrpc++-dev \
        libprotobuf-dev \
        protobuf-compiler \
        protobuf-compiler-grpc \
        pybind11-dev \
        libhiredis-dev \
        libcurl4-openssl-dev \
        libczmq4 \
        libczmq-dev \
        libfabric-dev \
        devscripts \
        debhelper \
        fakeroot \
        dkms \
        check \
        libsubunit0 \
        libsubunit-dev \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-10 110 --slave /usr/bin/g++ g++ /usr/bin/g++-10 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Generate locale (sglang base layer).
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# ---------------------------------------------------------------------------
# cuDNN + NCCL — actively installed following https://developer.nvidia.com/cudnn-downloads
# The base image is -devel (no cuDNN); we install it explicitly so the version
# is visible, pinned, and reproducible. These system libs must match the
# nvidia-cudnn-cu13 / nvidia-nccl-cu13 pip wheels that torch pins transitively
# in uv.lock (CUDNN_VERSION / NCCL_VERSION ARGs above).
# ---------------------------------------------------------------------------
RUN CUDA_VERSION_MAJOR=$(echo ${CUDA_VERSION} | cut -d '.' -f 1) \
    && apt-get update && apt-get install -y --no-install-recommends --allow-downgrades --allow-change-held-packages \
        cudnn9-cuda-${CUDA_VERSION_MAJOR} \
        libcudnn9-cuda-${CUDA_VERSION_MAJOR} \
        libcudnn9-dev-cuda-${CUDA_VERSION_MAJOR} \
        libcudnn9-headers-cuda-${CUDA_VERSION_MAJOR} \
        libnccl2=${NCCL_VERSION}+cuda${CUDA_VERSION%.*} \
        libnccl-dev=${NCCL_VERSION}+cuda${CUDA_VERSION%.*} \
    && rm -rf /var/lib/apt/lists/* \
    && echo "=== Installed cuDNN $(dpkg-query -W -f='${Version}' libcudnn9-cuda-${CUDA_VERSION_MAJOR}) ===" \
    && echo "=== Installed NCCL  $(dpkg-query -W -f='${Version}' libnccl2) ==="

# Override pip global index if requested.
RUN if [ -n "${PIP_DEFAULT_INDEX}" ]; then \
        python3 -m pip config --global set global.index-url "${PIP_DEFAULT_INDEX}" || true; \
    fi

# ---------------------------------------------------------------------------
# GDRCopy — pulled from sglang base. Required by DeepEP / GPUDirect on
# both sglang and vllm runtime stacks.
# ---------------------------------------------------------------------------
RUN mkdir -p /tmp/gdrcopy && cd /tmp \
    && curl --retry 3 --retry-delay 2 -fsSL -o v${GDRCOPY_VERSION}.tar.gz \
        https://${GITHUB_ARTIFACTORY}/NVIDIA/gdrcopy/archive/refs/tags/v${GDRCOPY_VERSION}.tar.gz \
    && tar -xzf v${GDRCOPY_VERSION}.tar.gz && rm v${GDRCOPY_VERSION}.tar.gz \
    && cd gdrcopy-${GDRCOPY_VERSION}/packages \
    && CUDA=/usr/local/cuda ./build-deb-packages.sh \
    && dpkg -i gdrdrv-dkms_*.deb libgdrapi_*.deb gdrcopy-tests_*.deb gdrcopy_*.deb \
    && cd / && rm -rf /tmp/gdrcopy

# DeepEP IBGDA symlink fix (sglang base).
RUN ln -sf /usr/lib/$(uname -m)-linux-gnu/libmlx5.so.1 /usr/lib/$(uname -m)-linux-gnu/libmlx5.so

# NVSHMEM as a SYSTEM pip package, not through uv: the prebuilt deep-ep wheel
# links against it with `-Wl,-rpath,$NVSHMEM_DIR/lib` baked in, and the
# wheelhouse builds it against exactly this dist-packages path — so NVSHMEM has
# to sit here, at this version, for the wheel to resolve libnvshmem_host.so.3 at
# run time. Keep the path and NVSHMEM_VERSION in step with that build (see the
# wheelhouse note in pyproject.toml's [tool.uv.sources]). A venv copy would not
# do: every `uv sync` combo gets its own venv, none of them at a fixed path.
# (torch pulls the same 3.4.5 into venvs transitively; harmless dup.)
RUN pip3 install --break-system-packages nvidia-nvshmem-cu13==${NVSHMEM_VERSION}
ENV NVSHMEM_DIR=/usr/local/lib/python3.12/dist-packages/nvidia/nvshmem

# CCCL headers (libcudacxx/cub/thrust) at a stable path on CPATH for the
# remaining source builds, same as Dockerfile.stable.vllm. Separator
# inside the expansion so an unset CPATH leaves no trailing ":" (an empty entry
# means "."). The empty ARG only declares the name for BuildKit's UndefinedVar
# check; an ENV of the same name still wins the expansion.
RUN CUDA_TARGET=$(case "$(uname -m)" in aarch64) echo sbsa-linux;; *) echo x86_64-linux;; esac) \
    && ln -sfn /usr/local/cuda/targets/${CUDA_TARGET}/include/cccl /usr/local/cuda-cccl
ARG CPATH=""
ENV CPATH=/usr/local/cuda-cccl${CPATH:+:${CPATH}}

# Hopper+Blackwell archs. No CUDA kernel is compiled from source in this image
# any more — fast-hadamard-transform, the last one, now comes prebuilt from the
# wheelhouse alongside deep-ep / flash-mla — but torch's cpp_extension reads
# this for any runtime JIT compile (flashinfer, DeepEP's hybrid-EP backend), so
# it stays. It was never what bounded fast-hadamard's build anyway: that
# setup.py derives its own gencode flags from the toolkit version and ignores
# this variable entirely.
ENV TORCH_CUDA_ARCH_LIST="9.0;10.0"

# ---------------------------------------------------------------------------
# uv — single static binary. We bake the full uv cache from the committed
# uv.lock via manage_envs.py (the `prefetch` stage); at run time `uv run` (or an
# explicit `manage_envs.py sync`) materializes the combination you want into
# .venv from it. Put uv on PATH and copy across the uv tunables that vllm sets.
# ---------------------------------------------------------------------------
COPY --from=ghcr.io/astral-sh/uv:0.11.16 /uv /uvx /bin/

# UV_CACHE_DIR pins the cache to a known path; the `prefetch` stage bakes it
# into the image there (no cache mount) so the runtime `uv sync` resolves
# offline. UV_LINK_MODE=copy lets that runtime venv copy out of the baked
# (read-only) cache layer.
ENV UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY="unsafe-best-match" \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/root/.cache/uv

# megatron-core's package_info.py appends `git rev-parse --short HEAD` to
# __version__ unless NO_VCS_VERSION=1, producing 0.18.0+<hash>. uv then sees a
# mismatch with the locked 0.18.0 and reinstalls it on every `uv run` — racing
# across 100+ Ray workers. Set it here so the prefetch-baked wheel AND every
# runtime `uv run` build the clean 0.18.0.
ENV NO_VCS_VERSION=1

# Enable CUDA forward compatibility by setting '-e VLLM_ENABLE_CUDA_COMPATIBILITY=1'.
# Only needed for datacenter/professional GPUs with older drivers.
# See: https://docs.nvidia.com/deploy/cuda-compatibility/
ENV VLLM_ENABLE_CUDA_COMPATIBILITY=0

# ---------------------------------------------------------------------------
# deps: dependency metadata + the uv driver + the extra inputs `uv lock` needs
# to build verl's OWN metadata. Staged *before* the full source so the expensive
# `prefetch` cache bake below is invalidated only when the dependencies actually
# change, not on unrelated source edits.
#
# verl's [project] (pyproject.toml) declares version/dependencies/authors/urls
# as DYNAMIC, supplied by setup.py + verl/version/version — so pyproject.toml +
# uv.lock alone are NOT enough: the `prefetch` step below first runs `uv lock`,
# which drives the setuptools build backend to extract that metadata and fails
# without those files ("No configuration found for dynamic 'authors'"). Stage
# them too. The verl *package* tree is still absent (find_packages() returns [],
# fine for metadata-only resolution); README.md is only read for the package
# long-description, so a stub stands in — which also keeps README edits from
# busting the prefetch cache. (`final` COPYs the real verl tree over these.)
# ---------------------------------------------------------------------------
FROM base AS deps
WORKDIR /workspace/verl
COPY pyproject.toml uv.lock manage_envs.py setup.py ./
COPY verl/version/version ./verl/version/version
RUN printf 'verl\n' > README.md

# ---------------------------------------------------------------------------
# prefetch: BAKE this image's uv cache. `manage_envs.py prefetch cu130 dev`
# syncs the conflict-free runtime combos (vllm+fsdp, vllm+megatron, sglang+fsdp,
# sglang+megatron, cpu) into throwaway envs purely to fill UV_CACHE_DIR
# (/root/.cache/uv) with every wheel & built artifact those backends need from
# uv.lock. The only native compiles left are the git-sourced megatron-core /
# mbridge: apex / TransformerEngine / flash-attn / deep-ep / flash-mla /
# fast-hadamard-transform and megatron-bridge come prebuilt from the
# wheelhouse, vllm / sglang / sglang-kernel from PyPI.
# The `cu130 dev` scope keeps this image to its torch-2.11 world. (The deferred
# cu12.9 / torch-2.9.1 world is commented out in pyproject.toml.) It passes
# --no-install-project, so only deps are cached and this
# layer is independent of the verl source tree. NOTE: unlike every other uv
# step there is deliberately NO `--mount=type=cache` here, so the warmed cache
# is committed as an image layer and ships *inside* the image; the runtime
# `uv run` / `uv sync` then resolves from it offline.
# ---------------------------------------------------------------------------
FROM deps AS prefetch
RUN python3 manage_envs.py prefetch cu130 dev -- --frozen

# ---------------------------------------------------------------------------
# source / lock: full source tree, used only to (re)generate uv.lock. Build
# `--target=lock` to refresh the lockfile and copy it back out:
#
#     docker build -f docker/Dockerfile.uv.cu130 --target=lock -t verl:uv-cu130-lock .
#     docker create --name verl-tmp verl:uv-cu130-lock
#     docker cp verl-tmp:/workspace/verl/uv.lock ./uv.lock
#     docker rm verl-tmp
# ---------------------------------------------------------------------------
FROM base AS source
WORKDIR /workspace/verl
COPY . /workspace/verl

FROM source AS lock
RUN --mount=type=cache,target=/root/.cache/uv,id=verl-uv-cache \
    python3 manage_envs.py lock

# ---------------------------------------------------------------------------
# final: the runtime image. Inherits the full baked uv cache from `prefetch`,
# adds the verl source, and bakes NO fixed .venv. The container starts in a
# shell and needs no install step: `uv run --extra ...` installs the requested
# extras into /workspace/verl/.venv from the baked cache (fast / offline, no
# network) and runs from it, and that venv's bin is already on PATH so it
# activates in place. The combination must be conflict-free (see
# [tool.uv].conflicts), e.g.:
#
#     docker run --rm -it --gpus all verl:uv-cu130 bash
#     # then, inside the container:
#     bash examples/grpo_trainer/run_qwen3_8b_fsdp.sh
#     # ... or spell the command out:
#     uv run --frozen --all-packages --extra sglang --extra megatron \
#         python3 -m verl.trainer.main_ppo ...
#
# The cuDNN / NCCL pip wheels this installs (nvidia-cudnn-cu13 /
# nvidia-nccl-cu13, from torch's transitive pins) must match the apt debs above.
# ---------------------------------------------------------------------------
FROM prefetch AS final

# ---------------------------------------------------------------------------
# Runtime host compiler — gcc-13 (CUDA 13.0 supports gcc <= 15).
#
# `base` pins the default compiler to gcc-10 (mirrors vllm's basic stage), which
# is fine for the prefetch git-source builds (megatron-core / mbridge compile
# with it; every native backend ships prebuilt). But sglang
# JIT-compiles its custom kernels (e.g. custom_all_reduce_push) at RUNTIME in
# C++20, which uses std::bit_cast — a libstdc++ feature that only exists in
# GCC >= 11. With gcc-10 as nvcc's host compiler that JIT dies with `namespace
# "std" has no member "bit_cast"`, surfaced by sglang as `Capture cuda graph
# failed: ninja exited with status 2`. Flip the RUNTIME default to gcc-13
# (already present via build-essential). This lives in `final`, DOWNSTREAM of
# `prefetch`, so it does NOT invalidate the expensive prefetch cache — only this
# cheap layer rebuilds. The trailing `--version` calls fail the build loudly if
# gcc-13 is somehow absent.
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 130 --slave /usr/bin/g++ g++ /usr/bin/g++-13 \
    && update-alternatives --set gcc /usr/bin/gcc-13 \
    && gcc --version && g++ --version

COPY . /workspace/verl
ENV VIRTUAL_ENV="/workspace/verl/.venv" \
    PATH="/workspace/verl/.venv/bin:${PATH}"
CMD ["bash"]


# ---------------------------------------------------------------------------
# Nsight Systems — same release the stable images ship (docker/Dockerfile.stable
# .{vllm,sglang}), so profiles are comparable across them. verl's nsys profiler
# (global_profiler.tool=nsys) shells out to `nsys` through Ray's nsight
# runtime-env plugin, so the binary has to be on PATH; the CUDA base's own
# /usr/local/cuda/bin/nsys is older and shadows the deb's /usr/local/bin/nsys,
# so replace it. The symlink targets are the paths the deb's postinst registers
# with update-alternatives; their directory carries the arch in its name
# (target-linux-x64 / host-linux-x64 on amd64, target-linux-sbsa-armv8 /
# host-linux-armv8 on arm64), so they are globbed rather than hardcoded — each
# arch's deb ships exactly one match. `test -x` plus the trailing `nsys
# --version` fail the build loudly if that layout ever moves (`ln -s` would
# otherwise happily create a dangling link). apt resolves the deb's own Qt / X11
# dependencies (libxcb-cursor0 and friends) from the archive.
# ---------------------------------------------------------------------------
ARG NSIGHT_VERSION=2025.6.1
ARG NSIGHT_BUILD=2025.6.1.190-1
RUN NSIGHT_ARCH=$(if [ "$(uname -m)" = "aarch64" ]; then echo arm64; else echo amd64; fi) \
    && NSIGHT_CHANNEL=$(echo ${NSIGHT_VERSION} | cut -d. -f1,2 | tr . _) \
    && NSIGHT_DEB=nsight-systems-${NSIGHT_VERSION}_${NSIGHT_BUILD}_${NSIGHT_ARCH}.deb \
    && curl --retry 3 --retry-delay 2 -fsSL -o /tmp/${NSIGHT_DEB} \
        https://developer.nvidia.com/downloads/assets/tools/secure/nsight-systems/${NSIGHT_CHANNEL}/${NSIGHT_DEB} \
    && apt-get update && apt-get install -y /tmp/${NSIGHT_DEB} \
    && rm -f /tmp/${NSIGHT_DEB} \
    && rm -rf /var/lib/apt/lists/* \
    && NSIGHT_ROOT=/opt/nvidia/nsight-systems/${NSIGHT_VERSION} \
    && NSYS_BIN="$(ls -1 ${NSIGHT_ROOT}/target-linux-*/nsys | head -n1)" \
    && NSYS_UI="$(ls -1 ${NSIGHT_ROOT}/host-linux-*/nsys-ui | head -n1)" \
    && test -x "${NSYS_BIN}" && test -x "${NSYS_UI}" \
    && ln -sf "${NSYS_BIN}" /usr/local/cuda/bin/nsys \
    && ln -sf "${NSYS_UI}" /usr/local/cuda/bin/nsys-ui \
    && nsys --version